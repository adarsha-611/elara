<aside id="profileSidebar" class="bg-[#3D2B24] p-8 rounded-[2rem] shadow-2xl border border-[#4D3A32]">
    <div class="text-center pb-8 mb-8 border-b border-white/5">
        <div class="relative inline-block group">
            <div class="w-20 h-20 bg-[#2D2421] text-[#A68B67] flex items-center justify-center mx-auto mb-4 rounded-full text-2xl font-light border border-white/10 overflow-hidden transition-all duration-500 group-hover:border-[#A68B67] group-hover:shadow-[0_0_20px_rgba(166,139,103,0.2)]">
                <% if (user.profileImage) { %>
<img src="<%= user.profileImage && user.profileImage.startsWith('http') ? user.profileImage : '/uploads/profiles/' + user.profileImage %>" alt="Profile" class="w-full h-full object-cover opacity-90 group-hover:opacity-100">
                <% } else { %>
                    <span class="tracking-widest font-display italic text-[#A68B67]"><%= user.fullName.charAt(0).toUpperCase() %></span>
                <% } %> 
            </div>
        </div>
        
        <h3 class="text-lg font-display italic text-white tracking-wide"><%= user.fullName %></h3>
        <p class="text-[11px] text-gray-400 mt-1 font-medium lowercase opacity-80"><%= user.email %></p>
        <p class="text-[9px] uppercase tracking-[0.2em] text-[#A68B67] mt-3 font-bold">Premium Member</p>
    </div>
    
    <nav class="flex flex-col gap-2">
        <% 
            const menuItems = [
                { name: 'My Profile', link: '/profile', icon: 'user' },
                { name: 'My Orders', link: '/profile/orders', icon: 'package' },
                { name: 'Wallet Balance', link: '/profile/wallet', icon: 'wallet' },
                { name: 'Manage Address', link: '/profile/address', icon: 'map-pin' },
                { name: 'Refer & Earn', link: '/profile/referral', icon: 'gift' }
            ];
        %>

        <% menuItems.forEach(item => { %>
            <a href="<%= item.link %>" 
               class="flex items-center gap-4 px-6 py-3.5 rounded-xl transition-all duration-400 group 
            <%= path === item.link ? 'bg-[#A68B67] text-white shadow-lg' : 'text-gray-400 hover:bg-white/5 hover:text-white' %>">                
                <div class="transition-transform duration-300 group-hover:scale-110 <%= path === item.link ? 'text-white' : 'text-[#A68B67]' %>">
                    <% if(item.icon === 'user') { %>
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
                    <% } else if(item.icon === 'package') { %>
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path><polyline points="3.27 6.96 12 12.01 20.73 6.96"></polyline><line x1="12" y1="22.08" x2="12" y2="12"></line></svg>
                    <% } else if(item.icon === 'wallet') { %>
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="5" width="20" height="14" rx="2"></rect><line x1="2" y1="10" x2="22" y2="10"></line></svg>
                    <% } else if(item.icon === 'map-pin') { %>
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 1 1 18 0z"></path><circle cx="12" cy="10" r="3"></circle></svg>
                    <% } else if(item.icon === 'gift') { %>
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="7" width="20" height="14" rx="2" ry="2"></rect><path d="M12 7v14M2 12h20"></path></svg>
                    <% } %>
                </div>
                <span class="text-[11px] uppercase tracking-[0.15em] font-semibold"><%= item.name %></span>
            </a>
        <% }) %>

        <div class="my-6 border-t border-white/5"></div>

        <a href="#" id="logoutBtn" class="flex items-center gap-4 px-6 py-3.5 rounded-xl text-red-400/70 hover:bg-red-500/10 hover:text-red-400 transition-all duration-300 group">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="group-hover:-translate-x-1 transition-transform">
                <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path>
                <polyline points="16 17 21 12 16 7"></polyline>
                <line x1="21" y1="12" x2="9" y2="12"></line>
            </svg>
            <span class="text-[11px] uppercase tracking-[0.15em] font-semibold">Log Out</span>
        </a>
    </nav>
</aside>

<style>
    body {
        overflow-y: scroll; /* prevents layout shift from scrollbar appearing/disappearing */
    }

    #profileSidebar {
        position: absolute;
        left: 104px;
        top: 90px;
        width: 288px;
        min-width: 288px;
        max-width: 288px;
        z-index: 100;
        max-height: calc(100vh - 110px);
        overflow-y: auto;
    }

    @media (max-width: 768px) {
        #profileSidebar {
            position: relative;
            left: 0;
            top: 0;
            width: 100%;
            min-width: unset;
            max-width: 100%;
            max-height: unset;
            margin-bottom: 1.5rem;
        }
    }
</style>

<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<script>
    (function () {
        const sidebar = document.getElementById('profileSidebar');
        const footer  = document.querySelector('footer');

        if (!sidebar || !footer) return;

        const FIXED_LEFT    = 104;
        const FIXED_TOP     = 90;
        const GAP           = 20;

        function update() {
            const footerRect  = footer.getBoundingClientRect();
            const sidebarH    = sidebar.offsetHeight;

            /* Bottom of sidebar if it were at FIXED_TOP */
            const sidebarBottom = FIXED_TOP + sidebarH;

            /* How far footer top is from viewport top */
            const footerFromTop = footerRect.top;

            if (sidebarBottom + GAP >= footerFromTop) {
                /* Push sidebar up so its bottom stays GAP px above footer */
                const newTop = footerFromTop - sidebarH - GAP;
                sidebar.style.top = Math.max(10, newTop) + 'px';
            } else {
                /* Normal position */
                sidebar.style.top = FIXED_TOP + 'px';
            }

            /* Left always stays fixed */
            sidebar.style.left = FIXED_LEFT + 'px';
        }

        window.addEventListener('scroll', update, { passive: true });
        window.addEventListener('resize', update);
        update();
    })();

    document.getElementById('logoutBtn').addEventListener('click', function (e) {
        e.preventDefault();
        Swal.fire({
            title: 'Are you sure?',
            text: 'You are about to logout from your account!',
            icon: 'warning',
            showCancelButton: true,
            confirmButtonColor: '#A68B67',
            cancelButtonColor: '#d33',
            confirmButtonText: 'Yes, logout!',
            cancelButtonText: 'Cancel',
            background: '#f2f4f5',
            color: '#151617',
            iconColor: '#A68B67'
        }).then(function (result) {
            if (result.isConfirmed) {
                window.location.href = '/logout';
            }
        });
    });
</script>