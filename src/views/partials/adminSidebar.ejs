                    </span> 
                    <span class="label">Coupons</span>
                </a>
            </li>
            <li class="<%= activePage === 'offers' ? 'active' : '' %>">
            <a href="/admin/offers">
        <span class="icon">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z"/>
                <line x1="7" y1="7" x2="7.01" y2="7"/>
            </svg>
        </span> 
        <span class="label">Offers</span>
    </a>
</li>
<li class="<%= activePage === 'salesReport' ? 'active' : '' %>">
                <a href="/admin/sales-report">
                    <span class="icon">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M15 5l-1.761 1.761a2 2 0 0 0 0 2.828L15 11.35"/><path d="M9 11.35l1.761-1.761a2 2 0 0 0 0-2.828L9 5"/><rect x="2" y="5" width="20" height="14" rx="2"/></svg>
