    <div class="sidebar-footer">
        <a href="#" class="logout-link" id="logoutBtn">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
            <span>Log Out</span>
        </a>
    </div>
</aside>

<!-- SweetAlert CSS and JS -->
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<script>
document.getElementById('logoutBtn').addEventListener('click', function(e) {
    e.preventDefault();
    
    Swal.fire({
        title: 'Are you sure?',
        text: "You are about to logout from the admin panel!",
        icon: 'warning',
        showCancelButton: true,
        confirmButtonColor: '#A68B67',
        cancelButtonColor: '#d33',
        confirmButtonText: 'Yes, logout!',
        cancelButtonText: 'Cancel'
    }).then((result) => {
        if (result.isConfirmed) {
            window.location.href = '/admin/logout';
        }
    });
});
</script>

<style>
    .admin-sidebar {
        width: 280px;
        background-color: #3D2B24; /* Deep Brown matching Profile */
        height: 100vh;
        position: fixed;
        left: 0;
        top: 0;
        display: flex;
        flex-direction: column;
        padding: 0;
        border-right: 1px solid rgba(255, 255, 255, 0.05);
        z-index: 1000;
        font-family: 'Lato', sans-serif;
    }

    .sidebar-header {
        padding: 60px 40px 40px;
        border-bottom: 1px solid rgba(255, 255, 255, 0.05);
    }

    .sidebar-logo {
        font-family: 'Playfair Display', serif;
        font-size: 32px;
        letter-spacing: 6px;
        font-weight: 300;
        margin: 0;
        color: #FFFFFF; /* White logo on dark bg */
        text-align: center;
    }

    .sidebar-tagline {
        font-size: 9px;
        text-transform: uppercase;
        letter-spacing: 0.4em;
        color: #A68B67; /* Gold Accent */
        text-align: center;
        margin-top: 8px;
        font-weight: 700;
        opacity: 0.8;
    }

    .sidebar-nav {
        padding: 30px 20px;
    }

    .sidebar-nav ul {
        list-style: none;
        padding: 0;
        margin: 0;
    }

    .sidebar-nav li {
        margin-bottom: 8px;
        position: relative;
    }

    .sidebar-nav a {
        display: flex;
        align-items: center;
        padding: 14px 20px;
        text-decoration: none;
        color: rgba(255, 255, 255, 0.5); /* Muted gray for inactive items */
        font-size: 11px;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.15em;
        border-radius: 12px;
        transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
    }

    .sidebar-nav a .icon {
        margin-right: 16px;
        display: flex;
        align-items: center;
        color: #A68B67; /* Always keep gold for icons */
        transition: all 0.3s ease;
    }

    /* Active State - Matches Profile Sidebar perfectly */
    .sidebar-nav li.active a {
        background-color: #A68B67; /* Gold background */
        color: #FFFFFF;
        box-shadow: 0 10px 20px rgba(0, 0, 0, 0.2);
        transform: translateX(5px);
    }

    .sidebar-nav li.active a .icon {
        color: #FFFFFF; /* Icon turns white on gold background */
        transform: scale(1.1);
    }

    .sidebar-nav a:hover:not(.active) {
        background-color: rgba(255, 255, 255, 0.05);
        color: #FFFFFF;
    }

    .sidebar-footer {
        margin-top: auto;
        padding: 30px 40px;
        border-top: 1px solid rgba(255, 255, 255, 0.05);
    }

    .logout-link {
        display: flex;
        align-items: center;
        gap: 12px;
        color: rgba(255, 255, 255, 0.4);
        text-decoration: none;
        font-size: 11px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.15em;
        transition: all 0.3s;
        cursor: pointer;
    }

    .logout-link svg {
        transition: transform 0.3s;
    }

    .logout-link:hover {
        color: #FF6B6B; /* Soft Red hover */
    }

    .logout-link:hover svg {
        transform: translateX(-3px);
    }
</style>