        flex-direction: column;
        padding: 0;
        border-right: 1px solid #EAE6E1;
        z-index: 1000;
        font-family: 'Lato', sans-serif;
    }

    .sidebar-header {
        padding: 60px 40px 40px;
    }

    .sidebar-logo {
        font-family: 'Playfair Display', serif;
        font-size: 32px;
        letter-spacing: 6px;
        font-weight: 400;
        margin: 0;
        color: #1A1A1A;
        text-align: center;
    }

    .sidebar-tagline {
        font-size: 9px;
        text-transform: uppercase;
        letter-spacing: 0.4em;
        color: #C5A371; /* Muted Gold */
        text-align: center;
        margin-top: 8px;
        font-weight: 700;
    }

    .sidebar-nav {
        padding: 0 20px;
    }

    .sidebar-nav ul {
        list-style: none;
        padding: 0;
        margin: 0;
    }

    .sidebar-nav li {
        margin-bottom: 4px;
        position: relative;
    }

    .sidebar-nav a {
        display: flex;
        align-items: center;
        padding: 14px 20px;
        text-decoration: none;
        color: #666;
        font-size: 13px;
        font-weight: 400;
        letter-spacing: 0.05em;
        border-radius: 12px;
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    }

    .sidebar-nav a .icon {
        margin-right: 16px;
        display: flex;
        align-items: center;
        opacity: 0.6;
        transition: all 0.3s ease;
    }

    /* Active State - Minimalist Luxury */
    .sidebar-nav li.active a {
        background-color: #FFFFFF;
        color: #1A1A1A;
        font-weight: 700;
        box-shadow: 0 10px 30px rgba(61, 43, 36, 0.04);
    }

    /* Left accent line for active item */
    .sidebar-nav li.active::before {
        content: "";
        position: absolute;
        left: -20px;
        top: 20%;
        height: 60%;
        width: 4px;
        background-color: #C5A371; /* Gold Accent */
        border-radius: 0 4px 4px 0;
    }

    .sidebar-nav li.active a .icon {
        color: #C5A371;
        opacity: 1;
        transform: scale(1.1);
    }

    .sidebar-nav a:hover:not(.active) {
        background-color: #F1EFE9;
        color: #1A1A1A;
    }

    .sidebar-footer {
        margin-top: auto;
        padding: 30px 40px;
        border-top: 1px solid #EAE6E1;
    }

    .logout-link {
        display: flex;
        align-items: center;
        gap: 12px;
        color: #999;
        text-decoration: none;
        font-size: 12px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.15em;
        transition: color 0.3s;
    }

    .logout-link:hover {
        color: #CC3333;
    }

    /* Global Layout Adjustments */
    .admin-layout {
        display: flex;
        min-height: 100vh;
        background-color: #FCFAFA;
    }

    .content-area {
        flex: 1;
        margin-left: 280px; /* Match sidebar width */
