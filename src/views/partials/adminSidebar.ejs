                    <span class="icon">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4Z"></path><line x1="3" y1="6" x2="21" y2="6"></line><path d="M16 10a4 4 0 0 1-8 0"></path></svg>
                    </span> 
                    <span class="label">Products</span>
                </a>
            </li>

            <li class="<%= activePage === 'orders' ? 'active' : '' %>">
                <a href="/admin/orders">
                    <span class="icon">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4Z"/><path d="M3 6h18"/><path d="M16 10a4 4 0 0 1-8 0"/></svg>
                    </span> 
                    <span class="label">Orders List</span>
                </a>
            </li>

            <li class="<%= activePage === 'users' || activePage === 'customers' ? 'active' : '' %>">
                <a href="/admin/users">
                    <span class="icon">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
                    </span> 
                    <span class="label">Customers</span>
                </a>
            </li>

            <li class="<%= activePage === 'category' || activeSidebar === 'category' ? 'active' : '' %>">
                <a href="/admin/category">
                    <span class="icon">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z"/><line x1="7" y1="7" x2="7.01" y2="7"/></svg>
                    </span> 
                    <span class="label">Category</span>
                </a>
            </li>

            <li class="<%= activePage === 'coupons' ? 'active' : '' %>">
                <a href="/admin/coupons">
                    <span class="icon">
