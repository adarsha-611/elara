<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>ELARA</title>

    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;500;600;700&family=Jost:wght@300;400;500;600&display=swap" rel="stylesheet">

    <link rel="stylesheet"
     href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">

    <style>
        body {
            font-family: 'Jost', sans-serif;
        }

        .header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 18px 60px;
            background: #F9F8F3;
            border-bottom: 1px solid #E0DCD0;
        }

        .logo {
            font-family: 'Playfair Display', serif;
            font-size: 24px;
            letter-spacing: 2px;
            color: #1A1A1A;
            font-weight: 600;
        }

        .nav-menu {
            display: flex;
            gap: 40px;
        }

        .nav-menu a {
            text-decoration: none;
            color: #1A1A1A;
            font-size: 14px;
            letter-spacing: 1px;
            transition: 0.3s;
        }

        .nav-menu a:hover {
            color: #C5A371;
        }

        .icons {
            display: flex;
            gap: 25px;
            align-items: center;
        }

        .icons a {
            font-size: 18px;
            color: #1A1A1A;
            text-decoration: none;
            transition: 0.3s;
        }

        .icons a:hover {
            color: #C5A371;
        }

        /* LOGIN / SIGNUP */
        .auth-buttons {
            display: flex;
            gap: 20px;
            align-items: center;
        }

        .auth-link {
            text-decoration: none;
            color: #1A1A1A;
            font-size: 13px;
            letter-spacing: 1px;
            font-weight: 500;
            transition: 0.3s;
        }

        .auth-link:hover {
            color: #C5A371;
        }

        .signup-btn {
            border: 1px solid #1A1A1A;
            padding: 8px 18px;
            border-radius: 6px;
            transition: all 0.3s;
        }

        .signup-btn:hover {
            background: #1A1A1A;
            color: #F9F8F3 !important;
        }
        
.nav-menu a.active {
    color: #C5A371;
    font-weight: 600; 
    border-bottom: 2px solid #C5A371; 
}

        /* Responsive */
        @media (max-width: 768px) {
            .nav-menu {
                display: none;
            }
        }
    </style>
</head>

<body>

<header class="header">

    <div class="logo">ELARA</div>

   <nav class="nav-menu">
    <a href="/home" class="<%= path === '/' ? 'active' : '' %>">HOME</a>
    <a href="/shop" class="<%= path === '/shop' ? 'active' : '' %>">SHOP</a>
    <a href="/about" class="<%= path === '/about' ? 'active' : '' %>">ABOUT US</a>
    
</nav>

    <% if (locals.user) { %>
        <div class="icons">
            <a href="/wishlist"><i class="fa-regular fa-heart"></i></a>
            <a href="/profile"><i class="fa-regular fa-user"></i></a>
           <a href="/cart" id="cart-icon-link" class="relative inline-block">
    <i class="fa fa-shopping-cart text-xl"></i>
    <% if(cartCount > 0){ %>
        <span id="cart-count" class="absolute -top-2 -right-2 bg-red-500 text-white text-xs px-2 rounded-full">
            <%= cartCount %>
        </span>
    <% } %>
</a>
        </div>
    <% } else { %>
        <div class="auth-buttons">
            <a href="/login" class="auth-link">LOGIN</a>
            <a href="/signup" class="auth-link signup-btn">SIGN UP</a>
        </div>
    <% } %>

</header>

<script>
    document.querySelectorAll('.nav-menu a').forEach(link => {
        if (link.href === window.location.href) {
            link.classList.add('active');
        }
    });

    async function updateCartCount() {
        try {
            const res = await fetch('/cart/count');
            const data = await res.json();
            const count = data.count || 0;

            const cartLink = document.getElementById("cart-icon-link");
            if (!cartLink) return;

            let cartEl = document.getElementById("cart-count");

            if (count > 0) {
                if (!cartEl) {
                    cartEl = document.createElement("span");
                    cartEl.id = "cart-count";
                    cartEl.className = "absolute -top-2 -right-2 bg-red-500 text-white text-xs px-2 rounded-full";
                    cartLink.appendChild(cartEl);
                }
                cartEl.innerText = count;
                cartEl.style.display = "inline-block";
            } else {
                if (cartEl) cartEl.style.display = "none";
            }

        } catch (err) {
            console.error("Cart count update failed");
        }
    }

 
    updateCartCount();

   
    window.updateCartCount = updateCartCount;
</script>
</body>
</html>