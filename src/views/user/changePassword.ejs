<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ELARA - Change Password</title>
    <link rel="stylesheet" href="/css/profile.css">
    <script src="https://cdn.tailwindcss.com"></script>
     <script>
        tailwind.config = {
          theme: {
            extend: {
              colors: {
                'elara-brown': '#7A5C4D',
                'elara-dark': '#3D2B24',
                'elara-ivory': '#FDFBF9',
                'elara-beige': '#F4F1EE'
              },
              fontFamily: {
                'display': ['Cormorant Garamond', 'serif'],
                'sans': ['Plus Jakarta Sans', 'sans-serif']
              }
            }
          }
        }
    </script>

   <style>
    /* ... existing sidebar/base styles ... */

    .main-content {
        padding: 40px;
        padding-top: 120px;
        display: flex;
        justify-content: center; /* Centers the entire wrapper in the viewport */
    }

    .content-wrapper {
        width: 100%;
        max-width: 1000px; /* Reduced from 1200px to make the overall layout more compact */
        display: flex;
        gap: 40px;
        align-items: start;
    }

    .profile-card {
        background: #fff;
        border-radius: 12px;
        box-shadow: 0 10px 30px rgba(0,0,0,0.05);
        padding: 50px;
        border: 1px solid #f0eee9;
        /* This makes the card a specific smaller size while remaining flexible */
        flex: 1;
        max-width: 600px; 
        margin-left: 230px;
    }

    .card-header h1 {
        font-family: 'Playfair Display', serif;
        font-size: 22px;
        color: #3D2B24;
        margin-bottom: 35px;
        letter-spacing: 1px;
        text-align: center;
        border-bottom: 1px solid #f0eee9;
        padding-bottom: 20px;
    }

    .profile-form {
        max-width: 400px; /* Keeps the actual inputs very focused and neat */
        margin: 0 auto;
    }

    .form-group {
        margin-bottom: 25px;
    }

    .form-group label {
        display: block;
        font-size: 10px;
        text-transform: uppercase;
        letter-spacing: 2px;
        color: #8b6f5f;
        margin-bottom: 10px;
        font-weight: 700;
    }

    .form-group input {
        width: 100%;
        padding: 14px 16px;
        border: 1px solid #e2ded5;
        border-radius: 8px;
        font-size: 14px;
        transition: all 0.3s ease;
        background-color: #faf9f6;
    }

    .form-group input:focus {
        outline: none;
        border-color: #A68B67;
        background-color: #fff;
        box-shadow: 0 0 0 4px rgba(166, 139, 103, 0.05);
    }

    .form-actions {
        margin-top: 40px;
        display: flex;
        flex-direction: column; /* Stacked buttons look very clean in small containers */
        gap: 12px;
        align-items: center;
    }

    .btn-primary {
        width: 100%; /* Full width button inside the 400px form */
        background-color: #3d1911;
        color: white;
        padding: 14px;
        border-radius: 8px;
        font-size: 11px;
        text-transform: uppercase;
        letter-spacing: 2px;
        font-weight: 700;
        transition: 0.3s;
    }

    .btn-secondary {
        font-size: 11px;
        text-transform: uppercase;
        letter-spacing: 1px;
        color: #1d1a18;
        font-weight: 600;
        text-decoration: none;
        background-color: #faf9f6;
        border: 1px solid #3D2B24;
    }
</style>

 <%- include('../partials/header') %>
<main class="main-content">

    <div class="content-wrapper">
        <%- include('../partials/profileSidebar', { user, path: '/profile' }) %>
        
        <section class="profile-card">
           <% if (locals.formError) { %>
    <div style="background:#fef2f2; border:1px solid #fecaca; color:#dc2626; 
                padding:12px 16px; border-radius:8px; font-size:13px; 
                text-align:center; margin-bottom:20px;">
        <%= formError %>
    </div>
<% } %>

<% if (locals.success && success.length > 0) { %>
    <div style="background:#f0fdf4; border:1px solid #bbf7d0; color:#16a34a;
                padding:12px 16px; border-radius:8px; font-size:13px;
                text-align:center; margin-bottom:20px;">
        <%= success %>
    </div>
<% } %>
            
            <div class="card-header">
                <h1>Security Update</h1>
            </div>

            <form action="/profile/change-password" method="POST" class="profile-form">
                <div class="form-group">
            <label>Current Password</label>
            <input type="password" name="currentPassword" 
                value="<%= locals.formData?.currentPassword || '' %>"
                placeholder="••••••••">
                            </div>

                <div class="form-group">
                   <label>New Password</label>
             <input type="password" name="newPassword"
                 value="<%= locals.formData?.newPassword || '' %>"
                 placeholder="Min. 8 characters">
                    </div>

<div class="form-group">
    <label>Confirm Password</label>
    <input type="password" name="confirmPassword"
           value="<%= locals.formData?.confirmPassword || '' %>"
           placeholder="Repeat new password">
</div>
                <div class="form-actions">
                    <button type="submit" class="btn btn-primary">Update Password</button>
                    <a href="/profile" class="btn btn-secondary">Go Back</a>
                </div>
            </form>
        </section>
    </div>
</main>
    <%- include('../partials/footer') %>

</body>
</html>