<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ELARA - Change Password</title>
    <link rel="stylesheet" href="/css/profile.css">
</head>
<body>
    <header class="navbar">
        <div class="nav-container">
           <div class="logo">ELARA</div>
            <nav class="nav-links">
                <a href="/home">HOME</a>
                <a href="#shop">SHOP</a>
                <a href="#about">ABOUT US</a>
                <a href="#contact">CONTACT</a>
            </nav>
            <div class="nav-icons">
                <a href="/wishlist">
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path></svg>
                </a>
                <a href="/profile">
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
                </a>
                <a href="/cart">
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="21" r="1"></circle><circle cx="20" cy="21" r="1"></circle><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path></svg>
                </a>
            </div>
        </div>
    </header>

    <div class="page-header">
        <h2>Change Password</h2>
    </div>

    <main class="main-content">
        <div class="content-wrapper">
<%- include('../partials/profileSidebar', { user: user, path: '/profile/change-password' }) %>

            <section class="profile-card">
                 <% if (error && error.length > 0) { %>
                    <div style="background: #f8d7da; color: #721c24; padding: 10px; margin-bottom: 10px;">
                        <%= error %>
                    </div>
                <% } %>
                
                <div class="card-header">
                    <h1>Security</h1>
                </div>

                <div class="profile-content">
                    <form action="/profile/change-password" method="POST" class="profile-form">
                        <div class="form-group">
                            <label>Current Password</label>
                            <input type="password" name="currentPassword" required>
                            <div style="text-align: right; margin-top: 5px;">
                                <a href="/forgot-password" style="font-size: 13px; color: #8b6f5f; text-decoration: none;">Forgot Password?</a>
                            </div>
                        </div>
                        <div class="form-group">
                            <label>New Password</label>
                            <input type="password" name="newPassword" required>
                        </div>
                        <div class="form-group">
                            <label>Confirm New Password</label>
                            <input type="password" name="confirmPassword" required>
                        </div>
                        
                        <div style="margin-top: 20px;">
                            <button type="submit" class="btn btn-primary">Update Password</button>
                            <a href="/profile" class="btn btn-secondary">Cancel</a>
                        </div>
                    </form>
                </div>
            </section>
        </div>
    </main>
</body>
</html>
