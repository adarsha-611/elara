<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Shop| Elara Jewelry</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;600&family=Poppins:wght@300;400;500&display=swap" rel="stylesheet">
    <style>
        :root {
            --bg-main: #FAF7F5;
            --text-dark: #4A302C;
            --accent-tan: #A17C6B;
            --border: #E0D6D0;
            --font-serif: 'Playfair Display', serif;
            --font-sans: 'Poppins', sans-serif;
        }

        body {
            background-color: var(--bg-main);
            color: var(--text-dark);
            font-family: var(--font-sans);
            margin: 0;
            line-height: 1.6;
        }

        .container { 
    max-width: 1200px; 
    margin: 60px auto; 
    padding: 0 20px;
    margin-top: 120px;
}

        .product-essential {
            display: grid;
            grid-template-columns: 1.2fr 0.8fr;
            gap: 60px;
            margin-bottom: 80px;
        }

        .main-image-zoom-container {
            position: relative;
            max-width: 520px;
            margin: 0 auto;
            background: #fff;
            border-radius: 6px;
            overflow: hidden;
            box-shadow: 0 10px 30px rgba(74, 48, 44, 0.06);
        }

        .img-zoom-wrapper {
            position: relative;
            width: 100%;
            height: 0;
            padding-bottom: 100%;
            overflow: hidden;
        }

        .zoomable {
            position: absolute;
            inset: 0;
            width: 100%;
            height: 100%;
            object-fit: contain;
            transition: transform 0.25s ease;
        }

        .img-zoom-wrapper:hover .zoomable {
            transform: scale(2.2);
            cursor: zoom-in;
        }

        .thumbnail-grid {
            display: flex;
            flex-wrap: wrap;
            gap: 12px;
            margin-top: 20px;
            justify-content: center;
        }

        .thumbnail-grid img {
            width: 80px;
            height: 80px;
            object-fit: cover;
            cursor: pointer;
            border: 2px solid transparent;
            border-radius: 6px;
            transition: all 0.25s ease;
        }

        .thumbnail-grid img.active,
        .thumbnail-grid img:hover {
            border-color: var(--accent-tan);
            transform: scale(1.08);
            box-shadow: 0 4px 12px rgba(161, 124, 107, 0.2);
        }

        .breadcrumb { 
            font-size: 0.8rem; 
            text-transform: uppercase; 
            letter-spacing: 1px; 
            color: var(--accent-tan); 
        }

        .product-title { 
            font-family: var(--font-serif); 
            font-size: 2.8rem; 
            margin: 10px 0; 
        }

        .product-price { 
            font-size: 1.8rem; 
            font-weight: 500; 
            margin-bottom: 20px; 
        }

        .config-group { 
            margin-bottom: 25px; 
        }

        .config-group label { 
            display: block; 
            font-weight: 500; 
            margin-bottom: 8px; 
            font-size: 0.9rem; 
        }

        .custom-select {
            width: 100%;
            padding: 12px;
            border: 1px solid var(--border);
            background: white;
            font-family: var(--font-sans);
            border-radius: 4px;
        }

        .qty-stepper {
            display: inline-flex;
            border: 1px solid var(--border);
            background: white;
            border-radius: 4px;
            overflow: hidden;
        }

        .qty-stepper button {
            border: none; 
            background: none; 
            padding: 10px 16px; 
            cursor: pointer;
            font-size: 1.1rem;
        }

        .qty-stepper input {
            width: 60px; 
            border: none; 
            text-align: center; 
            font-family: var(--font-sans);
            font-size: 1rem;
        }

        .action-buttons { 
            display: flex; 
            gap: 15px; 
            margin-top: 40px; 
        }

        .btn-primary {
            flex: 1;
            background: var(--accent-tan);
            color: white;
            border: none;
            padding: 18px;
            text-transform: uppercase;
            letter-spacing: 2px;
            font-weight: 600;
            cursor: pointer;
            border-radius: 4px;
            transition: 0.3s;
        }

        .btn-primary:hover { 
            background: var(--text-dark); 
        }

       .wishlist-icon {
    cursor: pointer;
    transition: all 0.3s ease;
    font-size: 20px;
}

.wishlist-icon:hover,
.wishlist-icon.active {
    color: #e74c3c;
    transform: scale(1.15);
}

.btn-wishlist {
    background: none;
    border: 1px solid #ddd;
    font-size: 24px;
    width: 45px;
    height: 45px;
    border-radius: 50%;
    cursor: pointer;
    transition: all 0.3s ease;
}

.btn-wishlist:hover,
.btn-wishlist.active {
    background-color: #fff0f0;
    color: #e74c3c;
    border-color: #e74c3c;
}

        .status-container { display: flex; align-items: center; gap: 15px; margin-bottom: 15px; }
        .stock-badge { font-size: 0.85rem; font-weight: 500; padding: 4px 12px; border-radius: 20px; text-transform: uppercase; }
        .stock-in { background: #e8f5e9; color: #2e7d32; }
        .stock-low { background: #fff3e0; color: #ef6c00; }
        .stock-out { background: #ffebee; color: #c62828; }
        .coupon-tag { background: #f4ece8; border: 1px dashed var(--accent-tan); color: var(--text-dark); padding: 5px 12px; font-size: 0.8rem; border-radius: 4px; }

        .highlights-list { list-style: none; padding: 0; margin: 20px 0; display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
        .highlights-list li { font-size: 0.85rem; display: flex; align-items: center; gap: 8px; }
        .highlights-list li::before { content: "✓"; color: var(--accent-tan); font-weight: bold; }

        .reviews-section { margin-top: 100px; border-top: 1px solid var(--border); padding-top: 60px; }
        .reviews-section h2 { font-family: var(--font-serif); font-size: 2.2rem; text-align: center; margin-bottom: 40px; }
        
        .reviews-header { 
            display: grid; 
            grid-template-columns: 1fr 1fr; 
            gap: 40px; 
            margin-bottom: 50px; 
            align-items: center; 
            background: #fff;
            padding: 40px;
            border-radius: 8px;
        }

        .rating-summary h2 { font-family: var(--font-serif); font-size: 3.5rem; margin: 0; color: var(--accent-tan); }
        .star-rating { color: #D4AF37; font-size: 1.2rem; }
        
        .progress-bar-container { margin: 12px 0; display: flex; align-items: center; gap: 15px; font-size: 0.9rem; }
        .progress-bg { flex: 1; height: 8px; background: #eee; border-radius: 4px; overflow: hidden; }
        .progress-fill { height: 100%; background: var(--accent-tan); border-radius: 4px; }

.review-card {
  background: #fff;
  padding: 28px;
  border-radius: 12px;
  margin-bottom: 22px;
  border: 1px solid var(--border);
  transition: 0.3s ease;
}

.review-card:hover {
  transform: translateY(-4px);
  box-shadow: 0 12px 25px rgba(0,0,0,0.06);
}

.review-meta {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
}

.review-left {
  display: flex;
  align-items: center;
  gap: 14px;
}

.review-avatar {
  width: 48px;
  height: 48px;
  border-radius: 50%;
  background: var(--accent-tan);
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 1.2rem;
  font-weight: 600;
}

.review-author {
  font-size: 1.05rem;
  font-weight: 600;
}

.star-rating {
  color: #D4AF37;
  font-size: 1.1rem;
  margin-top: 4px;
}

.review-date {
  font-size: 0.9rem;
  color: #777;
  white-space: nowrap;
}

.review-comment {
  margin-top: 14px;
  font-size: 1.05rem;
  line-height: 1.7;
  color: #444;
}

.reviews-section h2 {
  font-size: 2.4rem;
  margin-bottom: 50px;
}

.no-reviews {
  text-align: center;
  font-size: 1.1rem;
  color: #888;
  margin-top: 20px;
}

        
        .related-products { margin: 100px 0; }
        .section-title { font-family: var(--font-serif); font-size: 2.2rem; text-align: center; margin-bottom: 40px; }
        .product-grid { 
            display: grid; 
            grid-template-columns: repeat(3, 1fr); 
            gap: 30px; 
        }
        .p-card { transition: 0.3s; cursor: pointer; background: #fff; padding: 15px; border-radius: 6px; }
        .p-card:hover { transform: translateY(-5px); box-shadow: 0 10px 20px rgba(0,0,0,0.05); }
        .p-card img { width: 100%; border-radius: 4px; }
        .p-info { text-align: center; margin-top: 15px; }
        .p-name { font-family: var(--font-serif); font-size: 1.1rem; margin-bottom: 5px; }
        .p-price { color: var(--accent-tan); font-weight: 500; }

        .btn-disabled { background: #ccc !important; cursor: not-allowed !important; }

        @media (max-width: 768px) {
            .product-essential, .reviews-header, .product-grid { 
                grid-template-columns: 1fr; 
            }
        }
       .toast {
  position: fixed;
  top: 30px;
  left: 80%;
  transform: translateX(-50%) translateY(-20px);

  background: #16a34a;
  color: white;

  padding: 18px 35px;
  font-size: 16px;
  font-weight: 500;

  border-radius: 10px;
  box-shadow: 0 10px 30px rgba(0,0,0,0.15);

  opacity: 0;
  transition: all 0.3s ease;
  z-index: 9999;

  pointer-events: none;
}

.toast.show {
  opacity: 1;
  transform: translateX(-50%) translateY(0);
}
.toast.error {
  background: #c62828;
}

    </style>
</head>
<body>

    <%- include('../partials/header') %>

<div class="container">
    <section class="product-essential">
        <div class="product-gallery">
            <div class="main-image-zoom-container">
                <div class="img-zoom-wrapper">
                    <img src="<%= selectedVariant.images[0] %>" id="current-img" alt="<%= product.name %>" class="zoomable">
                </div>
            </div>

            <div class="thumbnail-grid" id="thumbnailGrid">
                <% selectedVariant.images.forEach((img, index) => { %>
                    <img src="<%= img %>" class="<%= index === 0 ? 'active' : '' %>" onclick="changeImage(this.src, this)" alt="Thumbnail <%= index + 1 %>">
                <% }) %>
            </div>
        </div>

        <div class="product-info-panel">
<nav class="breadcrumb">
    <a href="/home">Home</a> / 
    <a href="/shop">Shop</a> / 
    <%= product.name %>
</nav>            <h1 class="product-title text-dark"><%= product.name %></h1>

            <div class="status-container">
    <% const firstStock = selectedVariant.stock; %>

    <span 
        id="stock-status" 
        class="stock-badge 
        <%= firstStock === 0 ? 'stock-out' : 
            firstStock <= 3 ? 'stock-low' : 'stock-in' %>">

        <%= firstStock === 0 
            ? 'Out of Stock' 
            : firstStock <= 3 
                ? 'Only ' + firstStock + ' left!' 
                : 'In Stock' %>
    </span>

    
</div>


<div class="product-price" id="price">

  <% if (offerData) { %>

    <div style="display: flex; align-items: center; gap: 12px; flex-wrap: wrap;">

      <span style="font-size: 2rem; font-weight: 600; color: #4A302C;">
        ₹<%= offerData.finalPrice.toFixed(0) %>
      </span>

      <span style="text-decoration: line-through; color: #888; font-size: 1.1rem;">
        ₹<%= selectedVariant.price %>
      </span>

      <span style="
        background: #e8f5e9;
        color: #2e7d32;
        font-size: 0.85rem;
        font-weight: 600;
        padding: 4px 10px;
        border-radius: 20px;
      ">
      <% if (offerData.offer.discountType === "percentage") { %>
    <%= offerData.offer.discountValue %>% OFF
<% } else { %>
    ₹<%= offerData.offer.discountValue %> OFF
<% } %>
      </span>

    </div>

  <% } else { %>

    <span style="font-size: 2rem; font-weight: 600;">
      ₹<%= selectedVariant.price %>
    </span>

  <% } %>

</div>
            <div class="product-config">
                <div class="config-group">
                    <label>Select Metal Color</label>
               <select class="custom-select" id="colorSelect" onchange="changeVariant()">
    <% product.variants.forEach(function(variant){ %>
        <option 
    value="<%= variant._id %>"
    data-price="<%= variant.price %>"
    data-stock="<%= variant.stock %>"
    data-images='<%- JSON.stringify(variant.images) %>'
    <%= String(variant._id) === String(selectedVariant._id) ? 'selected' : '' %>>
    
    <%= variant.color %>
</option>
    <% }) %>
</select>

                </div>

             
            </div>

            <div class="product-description">
                <h3>Description</h3>
                <p><%= product.description %></p>
            </div>

          
            
            <div class="action-buttons">
<button 
    class="btn-primary" 
    id="cartBtn"
    onclick="handleCartBtn()">
    Add to Cart
</button>

<button 
    type="button"
    class="btn-wishlist <%= isWishlisted ? 'active' : '' %>"
    data-product-id="<%= product._id %>">
    <span class="heart-icon"><%= isWishlisted ? '♥' : '♡' %></span>
</button>         
</div>
        </div>
    </section>

    <section class="reviews-section">
        <h2>Customer Reviews</h2>

       <% if (reviews.length > 0) { %>

  <% reviews.forEach(review => { %>

   <div class="review-card">
  <div class="review-meta">

    <div class="review-left">
      
      <div class="review-avatar">
        <%= review.userId?.name?.charAt(0).toUpperCase() || "U" %>
      </div>

      <div>
        <div class="review-author">
          <%= review.userId?.name || "User" %>
        </div>

        <div class="star-rating">
          <%= "⭐".repeat(review.rating) %>
        </div>
      </div>
    </div>

    <span class="review-date">
      <%= new Date(review.createdAt).toLocaleDateString() %>
    </span>

  </div>

  <p class="review-comment">
    <%= review.comment %>
  </p>
</div>
  <% }) %>

<% } else { %>

  <p style="text-align:center; color:#888;">
    No reviews yet. Be the first to review!
  </p>

<% } %>
    </section>

  <section class="related-products">
    <h2 class="section-title">You Might Also Like</h2>
    <div class="product-grid">
        <% relatedProducts.forEach(p => { %>
            <div class="p-card">
                <a href="/productDetail/<%= p._id %>" class="block">
                    <div class="main-image-zoom-container" style="max-width: 100%; box-shadow: none;">
                        <div class="img-zoom-wrapper">
                            <img 
                                src="<%= p.variants?.[0]?.images?.[0] || '/images/placeholder.jpg' %>" 
                                alt="<%= p.name %>" 
                                style="object-fit: contain; width: 100%; height: auto;"
                            >
                        </div>
                    </div>
                </a>
                
                <div class="p-info">
                    <a href="/product/<%= p._id %>" class="block text-center">
                        <div class="p-name"><%= p.name %></div>
                    </a>
                    <div class="p-price">₹<%= p.variants?.[0]?.price || '—' %></div>
                </div>
            </div>
        <% }) %>
    </div>
</section>

</div>
<div id="toast" class="toast"></div>

<%- include('../partials/footer') %>
<script>
// ---------- TOAST ----------
function showToast(message, type = "success") {
  const toast = document.getElementById("toast");
  if (!toast) return;
  toast.innerText = message;
  toast.className = "toast show";
  if (type === "error") toast.classList.add("error");
  setTimeout(() => { toast.className = "toast"; }, 2500);
}

// ---------- GET VARIANT ----------
function getSelectedVariant() {
  const select = document.getElementById("colorSelect");
  return select ? select.value : null;
}

// ---------- CART STATE ----------
const cartVariants = <%- JSON.stringify(cartVariantIds) %>;

function updateCartButton(variantId) {
  const btn = document.getElementById("cartBtn");
  if (!btn) return;
  if (cartVariants.includes(variantId)) {
    btn.textContent = "Go to Cart";
    btn.style.background = "#4A302C";
    btn.onclick = () => window.location.href = "/cart";
  } else {
    btn.textContent = "Add to Cart";
    btn.style.background = "";
    btn.onclick = handleCartBtn;
  }
}

function handleCartBtn() {
  const variantId = getSelectedVariant();
  addToCart("<%= product._id %>", variantId, 1);
}

// ---------- ADD TO CART ----------
async function addToCart(productId, variantId, quantity = 1) {
  try {
    const res = await fetch("/cart/add", {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({ productId, variantId, quantity })
    });
    const data = await res.json();
    if (data.success) {
      showToast("Added to cart ✓");
      if (!cartVariants.includes(variantId)) cartVariants.push(variantId);
      updateCartButton(variantId);
      if (window.updateCartCount) window.updateCartCount();
    } else {
      showToast(data.message || "Failed", "error");
    }
  } catch (err) {
    console.error(err);
    showToast("Error", "error");
  }
}

// ---------- IMAGE CHANGE ----------
function changeImage(src, thumb) {
  document.getElementById("current-img").src = src;
  document.querySelectorAll("#thumbnailGrid img").forEach(img =>
    img.classList.remove("active")
  );
  thumb.classList.add("active");
}

// ---------- VARIANT CHANGE (single, complete function) ----------
async function changeVariant() {
  const colorSelect = document.getElementById("colorSelect");
  const selectedOption = colorSelect.options[colorSelect.selectedIndex];

  const variantId = selectedOption.value;
  const productId = "<%= product._id %>";
  const images = JSON.parse(selectedOption.dataset.images);
  const stock = parseInt(selectedOption.dataset.stock);
  const originalPrice = parseFloat(selectedOption.dataset.price);

  const currentImg = document.getElementById("current-img");
  const thumbnailGrid = document.getElementById("thumbnailGrid");
  const stockStatus = document.getElementById("stock-status");
  const priceEl = document.getElementById("price");

  // ✅ Update main image
  currentImg.src = images[0];

  // ✅ Update thumbnails
  thumbnailGrid.innerHTML = "";
  images.forEach((img, index) => {
    const thumb = document.createElement("img");
    thumb.src = img;
    if (index === 0) thumb.classList.add("active");
    thumb.onclick = () => changeImage(img, thumb);
    thumbnailGrid.appendChild(thumb);
  });

  // ✅ Update stock badge
  stockStatus.className = "stock-badge";
  if (stock === 0) {
    stockStatus.classList.add("stock-out");
    stockStatus.innerText = "Out of Stock";
  } else if (stock <= 3) {
    stockStatus.classList.add("stock-low");
    stockStatus.innerText = `Only ${stock} left!`;
  } else {
    stockStatus.classList.add("stock-in");
    stockStatus.innerText = "In Stock";
  }

  // ✅ Fetch offer for this variant
  try {
    const res = await fetch(`/variant-offer/${productId}/${variantId}`);
    const data = await res.json();

    if (data.success && data.offerData) {
      const discountText = data.offerData.offer.discountType === "percentage"
        ? `${data.offerData.offer.discountValue}% OFF`
        : `₹${data.offerData.offer.discountValue} OFF`;

      priceEl.innerHTML = `
        <div style="display:flex;gap:12px;align-items:center;flex-wrap:wrap;">
          <span style="font-size:2rem;font-weight:600;">₹${Math.round(data.offerData.finalPrice)}</span>
          <span style="text-decoration:line-through;color:#888;">₹${originalPrice}</span>
          <span style="background:#e8f5e9;color:#2e7d32;padding:4px 10px;border-radius:20px;font-size:0.8rem;">${discountText}</span>
        </div>`;
    } else {
      priceEl.innerHTML = `<span style="font-size:2rem;font-weight:600;">₹${originalPrice}</span>`;
    }
  } catch (err) {
    console.error(err);
    priceEl.innerHTML = `<span style="font-size:2rem;font-weight:600;">₹${originalPrice}</span>`;
  }

  // ✅ Update cart button state
  updateCartButton(variantId);
}

// ---------- PRODUCT AVAILABILITY ----------
const productId = "<%= product._id %>";

async function checkProductAvailability() {
  try {
    const res = await fetch(`/product-status/${productId}`);
    const data = await res.json();
    if (!data.available) {
      window.location.href = "/shop";
    }
  } catch (err) {
    console.error(err);
  }
}

// ---------- SINGLE DOMContentLoaded ----------
document.addEventListener("DOMContentLoaded", () => {
  // Set initial cart button state
  updateCartButton(getSelectedVariant());

  // Wishlist
  document.querySelectorAll(".btn-wishlist").forEach(btn => {
    btn.addEventListener("click", async function(e) {
      e.preventDefault();
      const productId = this.dataset.productId;
      const variantId = getSelectedVariant();

      try {
        const res = await fetch(`/wishlist/toggle/${productId}`, {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ variantId })
        });
        const data = await res.json();

        if (data.success) {
          if (data.status === "added") {
            this.classList.add("active");
            this.querySelector(".heart-icon").innerHTML = "♥";
            showToast("Added to wishlist");
          } else {
            this.classList.remove("active");
            this.querySelector(".heart-icon").innerHTML = "♡";
            showToast("Removed from wishlist");
          }
        } else {
          showToast(data.message || "Error", "error");
        }
      } catch (err) {
        console.error(err);
        showToast("Server error", "error");
      }
    });
  });

  // Availability check every 5 seconds
  setInterval(checkProductAvailability, 5000);
});
</script>
</body>
</html>