<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Matte Mauve Circle | Elara Jewelry</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;600&family=Poppins:wght@300;400;500&display=swap" rel="stylesheet">
    <style>
        :root {
            --bg-main: #FAF7F5;
            --text-dark: #4A302C;
            --accent-tan: #A17C6B;
            --border: #E0D6D0;
            --font-serif: 'Playfair Display', serif;
            --font-sans: 'Poppins', sans-serif;
        }

        body {
            background-color: var(--bg-main);
            color: var(--text-dark);
            font-family: var(--font-sans);
            margin: 0;
            line-height: 1.6;
        }

        .container { 
            max-width: 1200px; 
            margin: 60px auto; 
            padding: 0 20px; 
        }

        /* Product Section Layout */
        .product-essential {
            display: grid;
            grid-template-columns: 1.2fr 0.8fr;
            gap: 60px;
            margin-bottom: 80px;
        }

        /* ── Image Gallery ── */
        .main-image-zoom-container {
            position: relative;
            max-width: 520px;
            margin: 0 auto;
            background: #fff;
            border-radius: 6px;
            overflow: hidden;
            box-shadow: 0 10px 30px rgba(74, 48, 44, 0.06);
        }

        .img-zoom-wrapper {
            position: relative;
            width: 100%;
            height: 0;
            padding-bottom: 100%;
            overflow: hidden;
        }

        .zoomable {
            position: absolute;
            inset: 0;
            width: 100%;
            height: 100%;
            object-fit: contain;
            transition: transform 0.25s ease;
        }

        .img-zoom-wrapper:hover .zoomable {
            transform: scale(2.2);
            cursor: zoom-in;
        }

        .thumbnail-grid {
            display: flex;
            flex-wrap: wrap;
            gap: 12px;
            margin-top: 20px;
            justify-content: center;
        }

        .thumbnail-grid img {
            width: 80px;
            height: 80px;
            object-fit: cover;
            cursor: pointer;
            border: 2px solid transparent;
            border-radius: 6px;
            transition: all 0.25s ease;
        }

        .thumbnail-grid img.active,
        .thumbnail-grid img:hover {
            border-color: var(--accent-tan);
            transform: scale(1.08);
            box-shadow: 0 4px 12px rgba(161, 124, 107, 0.2);
        }

        /* ── Info Panel ── */
        .breadcrumb { 
            font-size: 0.8rem; 
            text-transform: uppercase; 
            letter-spacing: 1px; 
            color: var(--accent-tan); 
        }

        .product-title { 
            font-family: var(--font-serif); 
            font-size: 2.8rem; 
            margin: 10px 0; 
        }

        .product-price { 
            font-size: 1.8rem; 
            font-weight: 500; 
            margin-bottom: 20px; 
        }

        .config-group { 
            margin-bottom: 25px; 
        }

        .config-group label { 
            display: block; 
            font-weight: 500; 
            margin-bottom: 8px; 
            font-size: 0.9rem; 
        }

        .custom-select {
            width: 100%;
            padding: 12px;
            border: 1px solid var(--border);
            background: white;
            font-family: var(--font-sans);
            border-radius: 4px;
        }

        .qty-stepper {
            display: inline-flex;
            border: 1px solid var(--border);
            background: white;
            border-radius: 4px;
            overflow: hidden;
        }

        .qty-stepper button {
            border: none; 
            background: none; 
            padding: 10px 16px; 
            cursor: pointer;
            font-size: 1.1rem;
        }

        .qty-stepper input {
            width: 60px; 
            border: none; 
            text-align: center; 
            font-family: var(--font-sans);
            font-size: 1rem;
        }

        .action-buttons { 
            display: flex; 
            gap: 15px; 
            margin-top: 40px; 
        }

        .btn-primary {
            flex: 1;
            background: var(--accent-tan);
            color: white;
            border: none;
            padding: 18px;
            text-transform: uppercase;
            letter-spacing: 2px;
            font-weight: 600;
            cursor: pointer;
            border-radius: 4px;
            transition: 0.3s;
        }

        .btn-primary:hover { 
            background: var(--text-dark); 
        }

       .wishlist-icon {
    cursor: pointer;
    transition: all 0.3s ease;
    font-size: 20px;
}

.wishlist-icon:hover,
.wishlist-icon.active {
    color: #e74c3c;
    transform: scale(1.15);
}

.btn-wishlist {
    background: none;
    border: 1px solid #ddd;
    font-size: 24px;
    width: 45px;
    height: 45px;
    border-radius: 50%;
    cursor: pointer;
    transition: all 0.3s ease;
}

.btn-wishlist:hover,
.btn-wishlist.active {
    background-color: #fff0f0;
    color: #e74c3c;
    border-color: #e74c3c;
}

        /* --- NEW ENHANCEMENTS & FIXES --- */

        .status-container { display: flex; align-items: center; gap: 15px; margin-bottom: 15px; }
        .stock-badge { font-size: 0.85rem; font-weight: 500; padding: 4px 12px; border-radius: 20px; text-transform: uppercase; }
        .stock-in { background: #e8f5e9; color: #2e7d32; }
        .stock-low { background: #fff3e0; color: #ef6c00; }
        .stock-out { background: #ffebee; color: #c62828; }
        .coupon-tag { background: #f4ece8; border: 1px dashed var(--accent-tan); color: var(--text-dark); padding: 5px 12px; font-size: 0.8rem; border-radius: 4px; }

        .highlights-list { list-style: none; padding: 0; margin: 20px 0; display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
        .highlights-list li { font-size: 0.85rem; display: flex; align-items: center; gap: 8px; }
        .highlights-list li::before { content: "✓"; color: var(--accent-tan); font-weight: bold; }

        /* FIXED REVIEWS LAYOUT */
        .reviews-section { margin-top: 100px; border-top: 1px solid var(--border); padding-top: 60px; }
        .reviews-section h2 { font-family: var(--font-serif); font-size: 2.2rem; text-align: center; margin-bottom: 40px; }
        
        .reviews-header { 
            display: grid; 
            grid-template-columns: 1fr 1fr; 
            gap: 40px; 
            margin-bottom: 50px; 
            align-items: center; 
            background: #fff;
            padding: 40px;
            border-radius: 8px;
        }

        .rating-summary h2 { font-family: var(--font-serif); font-size: 3.5rem; margin: 0; color: var(--accent-tan); }
        .star-rating { color: #D4AF37; font-size: 1.2rem; }
        
        .progress-bar-container { margin: 12px 0; display: flex; align-items: center; gap: 15px; font-size: 0.9rem; }
        .progress-bg { flex: 1; height: 8px; background: #eee; border-radius: 4px; overflow: hidden; }
        .progress-fill { height: 100%; background: var(--accent-tan); border-radius: 4px; }

.review-card {
  background: #fff;
  padding: 28px;
  border-radius: 12px;
  margin-bottom: 22px;
  border: 1px solid var(--border);
  transition: 0.3s ease;
}

.review-card:hover {
  transform: translateY(-4px);
  box-shadow: 0 12px 25px rgba(0,0,0,0.06);
}

/* Header layout */
.review-meta {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
}

/* Left section */
.review-left {
  display: flex;
  align-items: center;
  gap: 14px;
}

/* Avatar */
.review-avatar {
  width: 48px;
  height: 48px;
  border-radius: 50%;
  background: var(--accent-tan);
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 1.2rem;
  font-weight: 600;
}

/* Name */
.review-author {
  font-size: 1.05rem;
  font-weight: 600;
}

/* Stars */
.star-rating {
  color: #D4AF37;
  font-size: 1.1rem;
  margin-top: 4px;
}

/* Date */
.review-date {
  font-size: 0.9rem;
  color: #777;
  white-space: nowrap;
}

/* Comment */
.review-comment {
  margin-top: 14px;
  font-size: 1.05rem;
  line-height: 1.7;
  color: #444;
}

/* Section spacing */
.reviews-section h2 {
  font-size: 2.4rem;
  margin-bottom: 50px;
}

/* Empty state */
.no-reviews {
  text-align: center;
  font-size: 1.1rem;
  color: #888;
  margin-top: 20px;
}

        
        .related-products { margin: 100px 0; }
        .section-title { font-family: var(--font-serif); font-size: 2.2rem; text-align: center; margin-bottom: 40px; }
        .product-grid { 
            display: grid; 
            grid-template-columns: repeat(3, 1fr); 
            gap: 30px; 
        }
        .p-card { transition: 0.3s; cursor: pointer; background: #fff; padding: 15px; border-radius: 6px; }
        .p-card:hover { transform: translateY(-5px); box-shadow: 0 10px 20px rgba(0,0,0,0.05); }
        .p-card img { width: 100%; border-radius: 4px; }
        .p-info { text-align: center; margin-top: 15px; }
        .p-name { font-family: var(--font-serif); font-size: 1.1rem; margin-bottom: 5px; }
        .p-price { color: var(--accent-tan); font-weight: 500; }

        .btn-disabled { background: #ccc !important; cursor: not-allowed !important; }

        @media (max-width: 768px) {
            .product-essential, .reviews-header, .product-grid { 
                grid-template-columns: 1fr; 
            }
        }
        .toast {
  position: fixed;
  top: 30px;
  left: 80%;
  transform: translateX(-50%) translateY(-20px);
  
  background: #16a34a; 
  color: white;
  
  padding: 18px 35px;   
  font-size: 16px;      
  font-weight: 500;
  
  border-radius: 10px;
  box-shadow: 0 10px 30px rgba(0,0,0,0.15);
  
  opacity: 0;
  transition: all 0.3s ease;
  z-index: 9999;
}

.toast.show {
  opacity: 1;
  transform: translateX(-50%) translateY(0);
}
.toast.error {
  background: #c62828;
}

    </style>
</head>
<body>

    <%- include('../partials/header') %>

<div class="container">
    <section class="product-essential">
        <div class="product-gallery">
            <div class="main-image-zoom-container">
                <div class="img-zoom-wrapper">
                    <img src="<%= product.variants[0].images[0] %>" id="current-img" alt="<%= product.name %>" class="zoomable">
                </div>
            </div>

            <div class="thumbnail-grid" id="thumbnailGrid">
                <% product.variants[0].images.forEach((img, index) => { %>
                    <img src="<%= img %>" class="<%= index === 0 ? 'active' : '' %>" onclick="changeImage(this.src, this)" alt="Thumbnail <%= index + 1 %>">
                <% }) %>
            </div>
        </div>

        <div class="product-info-panel">
            <nav class="breadcrumb">Home / <%= product.category %> / <%= product.name %></nav>
            <h1 class="product-title text-dark"><%= product.name %></h1>

            <div class="status-container">
    <% const firstStock = product.variants[0].stock; %>

    <span 
        id="stock-status" 
        class="stock-badge 
        <%= firstStock === 0 ? 'stock-out' : 
            firstStock <= 3 ? 'stock-low' : 'stock-in' %>">

        <%= firstStock === 0 
            ? 'Out of Stock' 
            : firstStock <= 3 
                ? 'Only ' + firstStock + ' left!' 
                : 'In Stock' %>
    </span>

    
</div>


<div class="product-price" id="price">

  <% if (offerData) { %>

    <div style="display: flex; align-items: center; gap: 12px; flex-wrap: wrap;">

      <!-- Final Price -->
      <span style="font-size: 2rem; font-weight: 600; color: #4A302C;">
        ₹<%= offerData.finalPrice.toFixed(0) %>
      </span>

      <!-- Original Price -->
      <span style="text-decoration: line-through; color: #888; font-size: 1.1rem;">
        ₹<%= product.variants[0].price %>
      </span>

      <!-- Discount Badge -->
      <span style="
        background: #e8f5e9;
        color: #2e7d32;
        font-size: 0.85rem;
        font-weight: 600;
        padding: 4px 10px;
        border-radius: 20px;
      ">
        <%= Math.round((offerData.discount / product.variants[0].price) * 100) %>% OFF
      </span>

    </div>

  <% } else { %>

    <span style="font-size: 2rem; font-weight: 600;">
      ₹<%= product.variants[0].price %>
    </span>

  <% } %>

</div>
            <div class="product-config">
                <div class="config-group">
                    <label>Select Metal Color</label>
                  <select class="custom-select" id="colorSelect" onchange="changeVariant()">
    <% product.variants.forEach(function(variant){ %>
        <option 
            value="<%= variant._id %>"
            data-price="<%= variant.price %>"
            data-stock="<%= variant.stock %>"
            data-images='<%- JSON.stringify(variant.images) %>'>
            <%= variant.color %>
        </option>
    <% }) %>
</select>

                </div>

             
            </div>

            <div class="product-description">
                <h3>Description</h3>
                <p><%= product.description %></p>
            </div>

          
            
            <div class="action-buttons">
            <button 
    class="btn-primary" 
    onclick="addToCart('<%= product._id %>', getSelectedVariant())">
    Add to Cart
</button>

<button 
    type="button"
    class="btn-wishlist" 
    data-product-id="<%= product._id %>">
    ♡
</button>            </div>
        </div>
    </section>

    <section class="reviews-section">
        <h2>Customer Reviews</h2>

       <% if (reviews.length > 0) { %>

  <% reviews.forEach(review => { %>

   <div class="review-card">
  <div class="review-meta">

    <div class="review-left">
      
      <!-- Avatar (First Letter) -->
      <div class="review-avatar">
        <%= review.userId?.name?.charAt(0).toUpperCase() || "U" %>
      </div>

      <div>
        <div class="review-author">
          <%= review.userId?.name || "User" %>
        </div>

        <div class="star-rating">
          <%= "⭐".repeat(review.rating) %>
        </div>
      </div>
    </div>

    <span class="review-date">
      <%= new Date(review.createdAt).toLocaleDateString() %>
    </span>

  </div>

  <p class="review-comment">
    <%= review.comment %>
  </p>
</div>
  <% }) %>

<% } else { %>

  <p style="text-align:center; color:#888;">
    No reviews yet. Be the first to review!
  </p>

<% } %>
    </section>

  <section class="related-products">
    <h2 class="section-title">You Might Also Like</h2>
    <div class="product-grid">
        <% relatedProducts.forEach(p => { %>
            <div class="p-card">
                <a href="/productDetail/<%= p._id %>" class="block">
                    <div class="main-image-zoom-container" style="max-width: 100%; box-shadow: none;">
                        <div class="img-zoom-wrapper">
                            <img 
                                src="<%= p.variants?.[0]?.images?.[0] || '/images/placeholder.jpg' %>" 
                                alt="<%= p.name %>" 
                                style="object-fit: contain; width: 100%; height: auto;"
                            >
                        </div>
                    </div>
                </a>
                
                <div class="p-info">
                    <a href="/product/<%= p._id %>" class="block text-center">
                        <div class="p-name"><%= p.name %></div>
                    </a>
                    <div class="p-price">₹<%= p.variants?.[0]?.price || '—' %></div>
                </div>
            </div>
        <% }) %>
    </div>
</section>

</div>
<div id="toast" class="toast"></div>
<%- include('../partials/footer') %>

<script>

// ---------- TOAST FUNCTION (GLOBAL) ----------
function showToast(message, type = "success") {
  const toast = document.getElementById("toast");
  if (!toast) return;

  toast.innerText = message;
  toast.className = "toast show";

  if (type === "error") {
    toast.classList.add("error");
  }

  setTimeout(() => {
    toast.className = "toast";
  }, 2500);
}


// ---------- QUANTITY BUTTONS ----------
document.querySelectorAll(".qty-box").forEach(box => {
  const minus = box.querySelector(".minus");
  const plus = box.querySelector(".plus");
  const input = box.querySelector(".qty-input");

  if (!minus || !plus || !input) return;

  minus.addEventListener("click", () => {
    let val = parseInt(input.value) || 1;
    if (val > 1) input.value = val - 1;
  });

  plus.addEventListener("click", () => {
    let val = parseInt(input.value) || 1;
    input.value = val + 1;
  });
});
function getSelectedVariant() {
  const select = document.getElementById("colorSelect");
  return select.value;
}

// ---------- ADD TO CART FUNCTION ----------
async function addToCart(productId, variantId = null) {
  try {

    const qtyInput = document.querySelector(".qty-input");
    const qty = qtyInput ? parseInt(qtyInput.value) : 1;

    const res = await fetch("/cart/add", {
      method: "POST",
      headers: {
        "Content-Type": "application/json"
      },
      body: JSON.stringify({
        productId,
        qty,
        variantId
      })
    });

    const data = await res.json();

    if (data.success) {
      showToast("Product added to cart 🛒");
    } else {
      showToast(data.message || "Failed to add product", "error");
    }

  } catch (error) {
    console.error(error);
    showToast("Server Error", "error");
  }
}

</script>
<script>
const currentImg = document.getElementById("current-img");
const thumbnailGrid = document.getElementById("thumbnailGrid");
const colorSelect = document.getElementById("colorSelect");
const priceEl = document.getElementById("price");
const stockStatus = document.getElementById("stock-status");

// ---------- Function to change subimage ----------
function changeImage(src, thumb) {
    currentImg.src = src;

    // remove active from all thumbnails
    thumbnailGrid.querySelectorAll("img").forEach(img => img.classList.remove("active"));

    // add active to clicked thumbnail
    thumb.classList.add("active");
}

// ---------- Function to change variant ----------
function changeVariant() {
    const selectedOption = colorSelect.options[colorSelect.selectedIndex];
    const images = JSON.parse(selectedOption.dataset.images);
    const price = selectedOption.dataset.price;
    const stock = selectedOption.dataset.stock;

    // Update main image
    currentImg.src = images[0];

    // Update price
    priceEl.innerHTML = `₹${price} <span style="font-size: 1rem; color: #888; text-decoration: line-through; margin-left: 10px;">₹${(price * 1.2).toFixed(0)}</span>`;

    // Update stock badge
    stockStatus.className = "stock-badge"; // reset
    if (stock == 0) {
        stockStatus.classList.add("stock-out");
        stockStatus.innerText = "Out of Stock";
    } else if (stock <= 3) {
        stockStatus.classList.add("stock-low");
        stockStatus.innerText = `Only ${stock} left!`;
    } else {
        stockStatus.classList.add("stock-in");
        stockStatus.innerText = "In Stock";
    }

    // Update thumbnails
    thumbnailGrid.innerHTML = "";
    images.forEach((img, index) => {
        const thumb = document.createElement("img");
        thumb.src = img;
        thumb.alt = `Thumbnail ${index+1}`;
        if(index === 0) thumb.classList.add("active");
        thumb.onclick = () => changeImage(img, thumb);
        thumbnailGrid.appendChild(thumb);
    });
}
</script>

<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<script>
const productId = "<%= product._id %>";

async function checkProductAvailability() {
    try {
        const res = await fetch(`/product-status/${productId}`);
        const data = await res.json();

        if (!data.available) {
            Swal.fire({
    toast: true,
    position: 'top-end',
    icon: 'warning',
    title: 'This product is no longer available',
    showConfirmButton: false,
    timer: 3000,
    background: '#4A302C',   
    color: '#fff',           
    iconColor: '#facc15',    
    customClass: {
        popup: 'rounded-lg shadow-lg'
    }
});

            setTimeout(() => {
                window.location.href = "/shop";
            }, 3000);
        }
    } catch (err) {
        console.error(err);
    }
}

setInterval(checkProductAvailability, 5000);
</script>
<script>
document.addEventListener('DOMContentLoaded', () => {

    document.querySelectorAll('.btn-wishlist').forEach(btn => {
        btn.addEventListener('click', async function(e) {
            e.preventDefault();
            e.stopImmediatePropagation();

            const productId = this.dataset.productId;
            if (!productId) {
                showToast("Product ID missing", "error");
                return;
            }

            console.log("🔄 Toggling wishlist for:", productId);

            try {
                const response = await fetch(`/wishlist/toggle/${productId}`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' }
                });

                console.log("Status:", response.status);

                const data = await response.json();   // This line was failing before
                console.log("Server returned:", data);

                if (data.success) {
                    if (data.status === "added") {
                        this.classList.add('active');
                        this.style.color = '#e74c3c';
                        this.innerHTML = '♥';
                        showToast("Added to wishlist ❤️");
                    } else if (data.status === "removed") {
                        this.classList.remove('active');
                        this.style.color = '';
                        this.innerHTML = '♡';
                        showToast("Removed from wishlist");
                    }
                } else {
                    showToast(data.message || "Failed to update wishlist", "error");
                }

            } catch (err) {
                console.error("Full Error:", err);
                showToast("Failed to update wishlist - Check console", "error");
            }
        });
    });
});
</script>

</body>
</html>