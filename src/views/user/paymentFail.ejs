<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Payment Failed — ELARA</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;600;700&family=Lato:wght@300;400;700&display=swap" rel="stylesheet"/>

  <style>
    *, *::before, *::after {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    :root {
      --gold:        #a3866a;
      --gold-dark:   #8a7055;
      --gold-light:  rgba(163, 134, 106, 0.12);
      --dark:        #3D2B24;
      --bg:          #FAF9F7;
      --white:       #ffffff;
      --text:        #333333;
      --muted:       #888888;
      --red:         #dc3545;
      --red-light:   #fdf0f0;
      --red-mid:     rgba(220, 53, 69, 0.12);
      --border:      rgba(163, 134, 106, 0.2);
      --radius-card: 16px;
      --radius-btn:  8px;
      --radius-sm:   6px;
      --shadow:      0 8px 40px rgba(61, 43, 36, 0.09), 0 2px 10px rgba(61, 43, 36, 0.05);
    }

    html, body {
      min-height: 100%;
    }

    body {
      font-family: 'Lato', sans-serif;
      background-color: var(--bg);
      color: var(--text);
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      min-height: 100vh;
      padding: 2.5rem 1rem;
    }

    /* ─── Brand ─── */
    .brand {
      display: flex;
      align-items: center;
      gap: 10px;
      margin-bottom: 2rem;
      animation: fadeDown 0.5s ease both;
    }

    .brand svg {
      width: 30px;
      height: 30px;
    }

    .brand-name {
      font-family: 'Playfair Display', serif;
      font-size: 22px;
      font-weight: 700;
      color: var(--dark);
      letter-spacing: 5px;
    }

    /* ─── Card ─── */
    .card {
      background: var(--white);
      border-radius: var(--radius-card);
      border: 0.5px solid var(--border);
      box-shadow: var(--shadow);
      max-width: 480px;
      width: 100%;
      padding: 2.75rem 2.5rem 2.25rem;
      display: flex;
      flex-direction: column;
      align-items: center;
      animation: fadeUp 0.55s ease 0.1s both;
    }

    /* ─── Icon ─── */
    .icon-wrap {
      width: 80px;
      height: 80px;
      border-radius: 50%;
      background: var(--red-light);
      border: 1.5px solid rgba(220, 53, 69, 0.14);
      display: flex;
      align-items: center;
      justify-content: center;
      margin-bottom: 1.5rem;
      animation: pulseRing 2.8s ease-in-out 0.6s infinite;
    }

    .icon-inner {
      width: 48px;
      height: 48px;
      border-radius: 50%;
      background: var(--red-mid);
      display: flex;
      align-items: center;
      justify-content: center;
    }

    /* ─── Heading ─── */
    h1 {
      font-family: 'Playfair Display', serif;
      font-size: 28px;
      font-weight: 700;
      color: var(--dark);
      text-align: center;
      margin-bottom: 0.75rem;
      letter-spacing: 0.2px;
    }

    .subtitle {
      font-size: 14.5px;
      font-weight: 300;
      color: #777;
      text-align: center;
      line-height: 1.8;
      max-width: 360px;
      margin-bottom: 1.75rem;
    }

    /* ─── Divider ─── */
    .divider {
      width: 100%;
      height: 0.5px;
      background: var(--border);
      margin-bottom: 1.5rem;
    }

    /* ─── Order Box ─── */
    .order-box {
      background: var(--bg);
      border: 0.5px solid rgba(163, 134, 106, 0.25);
      border-radius: 10px;
      width: 100%;
      padding: 1.1rem 1.3rem;
      margin-bottom: 1.75rem;
    }

    .order-box-title {
      font-size: 10px;
      font-weight: 700;
      color: var(--gold);
      letter-spacing: 2.5px;
      text-transform: uppercase;
      margin-bottom: 0.85rem;
    }

    .order-row {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 6px 0;
    }

    .order-label {
      font-size: 13px;
      color: var(--muted);
      font-weight: 300;
    }

    .order-value {
      font-size: 13.5px;
      color: var(--dark);
      font-weight: 400;
    }

    .order-value.amount {
      font-size: 14.5px;
      font-weight: 700;
      color: var(--gold);
    }

    .order-divider {
      height: 0.5px;
      background: rgba(163, 134, 106, 0.15);
      margin: 4px 0;
    }

    .status-badge {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      background: var(--red-light);
      border: 0.5px solid rgba(220, 53, 69, 0.2);
      border-radius: 20px;
      padding: 3px 11px;
      font-size: 11.5px;
      color: #b02a37;
      font-weight: 400;
    }

    .status-dot {
      width: 6px;
      height: 6px;
      border-radius: 50%;
      background: var(--red);
    }

    /* ─── Buttons ─── */
    .btn-group {
      width: 100%;
      display: flex;
      flex-direction: column;
      gap: 0.65rem;
      margin-bottom: 1.1rem;
    }

    .btn {
      width: 100%;
      padding: 13.5px 24px;
      border-radius: var(--radius-btn);
      font-family: 'Lato', sans-serif;
      font-size: 13px;
      font-weight: 700;
      letter-spacing: 1.8px;
      text-transform: uppercase;
      cursor: pointer;
      transition: background 0.2s ease, border-color 0.2s ease, transform 0.15s ease, color 0.2s ease;
      outline: none;
    }

    .btn:active {
      transform: translateY(0) scale(0.98);
    }

    .btn-primary {
      background: var(--gold);
      color: var(--white);
      border: none;
    }

    .btn-primary:hover {
      background: var(--gold-dark);
      transform: translateY(-1.5px);
    }

    .btn-secondary {
      background: transparent;
      color: var(--dark);
      border: 1px solid rgba(61, 43, 36, 0.32);
    }

    .btn-secondary:hover {
      background: rgba(61, 43, 36, 0.045);
      border-color: rgba(61, 43, 36, 0.55);
      transform: translateY(-1.5px);
    }

    /* ─── Support Link ─── */
    .support-link {
      font-size: 13px;
      color: var(--gold);
      text-decoration: none;
      border-bottom: 0.5px solid rgba(163, 134, 106, 0.4);
      padding-bottom: 1px;
      cursor: pointer;
      transition: color 0.15s, border-color 0.15s;
      margin-bottom: 1.5rem;
      display: inline-block;
    }

    .support-link:hover {
      color: var(--gold-dark);
      border-color: var(--gold-dark);
    }

    /* ─── Refund Note ─── */
    .refund-note {
      font-size: 12px;
      font-weight: 300;
      color: #aaa;
      text-align: center;
      line-height: 1.7;
      padding: 0 0.5rem;
    }

    .refund-note span {
      color: var(--gold);
      font-weight: 400;
    }

    /* ─── Footer brand ─── */
    .footer-brand {
      margin-top: 2rem;
      font-size: 10.5px;
      letter-spacing: 3px;
      color: #c4b5a5;
      text-align: center;
      text-transform: uppercase;
      animation: fadeDown 0.5s ease 0.3s both;
    }

    /* ─── Animations ─── */
    @keyframes fadeUp {
      from { opacity: 0; transform: translateY(18px); }
      to   { opacity: 1; transform: translateY(0); }
    }

    @keyframes fadeDown {
      from { opacity: 0; transform: translateY(-10px); }
      to   { opacity: 1; transform: translateY(0); }
    }

    @keyframes pulseRing {
      0%, 100% { box-shadow: 0 0 0 0 rgba(220, 53, 69, 0.12); }
      50%       { box-shadow: 0 0 0 8px rgba(220, 53, 69, 0.0); }
    }

    /* ─── Responsive ─── */
    @media (max-width: 520px) {
      .card {
        padding: 2rem 1.25rem 1.75rem;
        border-radius: 12px;
      }

      h1 {
        font-size: 24px;
      }

      .subtitle {
        font-size: 14px;
      }

      .btn {
        padding: 13px 16px;
        font-size: 12px;
      }
    }
  </style>
</head>
<body>

  <!-- Brand Logotype -->
  <div class="brand">
    <svg viewBox="0 0 30 30" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
      <polygon points="15,2 26,9.5 26,20.5 15,28 4,20.5 4,9.5"
               fill="none" stroke="#a3866a" stroke-width="1.2"/>
      <polygon points="15,6.5 21,10.5 21,19.5 15,23.5 9,19.5 9,10.5"
               fill="rgba(163,134,106,0.1)" stroke="#a3866a" stroke-width="0.7"/>
      <line x1="15" y1="2"    x2="15" y2="6.5"  stroke="#a3866a" stroke-width="0.9"/>
      <line x1="15" y1="23.5" x2="15" y2="28"   stroke="#a3866a" stroke-width="0.9"/>
      <line x1="4"  y1="9.5"  x2="9"  y2="10.5" stroke="#a3866a" stroke-width="0.9"/>
      <line x1="21" y1="10.5" x2="26" y2="9.5"  stroke="#a3866a" stroke-width="0.9"/>
      <line x1="4"  y1="20.5" x2="9"  y2="19.5" stroke="#a3866a" stroke-width="0.9"/>
      <line x1="21" y1="19.5" x2="26" y2="20.5" stroke="#a3866a" stroke-width="0.9"/>
    </svg>
    <span class="brand-name">ELARA</span>
  </div>

  <!-- Main Card -->
  <main class="card" role="main" aria-labelledby="page-title">

    <!-- Failure Icon -->
    <div class="icon-wrap" aria-hidden="true">
      <div class="icon-inner">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
          <circle cx="12" cy="12" r="10" stroke="#dc3545" stroke-width="1.5"/>
          <line x1="8.5" y1="8.5" x2="15.5" y2="15.5" stroke="#dc3545" stroke-width="1.7" stroke-linecap="round"/>
          <line x1="15.5" y1="8.5" x2="8.5" y2="15.5" stroke="#dc3545" stroke-width="1.7" stroke-linecap="round"/>
        </svg>
      </div>
    </div>

    <!-- Heading -->
    <h1 id="page-title">Payment Failed</h1>

    <p class="subtitle">
      We couldn't process your payment. This may be due to a network issue,
      card restriction, or insufficient balance. Please review your details and try again.
    </p>

    <div class="divider" role="separator"></div>

    <!-- Order Details -->
    <!-- Order Details — replace the entire order-box div -->
<div class="order-box" aria-label="Order summary">
  <div class="order-box-title">Order Summary</div>

  <div class="order-row">
    <span class="order-label">Order ID</span>
    <span class="order-value">#<%= order.orderId %></span>
  </div>
  <div class="order-divider"></div>

  <div class="order-row">
    <span class="order-label">Items</span>
    <span class="order-value">
      <%= order.items.map(i => i.productName).join(', ') %>
    </span>
  </div>
  <div class="order-divider"></div>

<div class="order-row">
    <span class="order-label">Amount</span>
    <span class="order-value amount">
        ₹ <%= (order.finalAmount || order.totalAmount).toLocaleString('en-IN') %>
    </span>
</div>
  <div class="order-divider"></div>

  <div class="order-row">
    <span class="order-label">Date</span>
    <span class="order-value">
      <%= new Date(order.createdAt).toLocaleDateString('en-IN', { year:'numeric', month:'long', day:'numeric' }) %>
    </span>
  </div>
  <div class="order-divider"></div>

  <div class="order-row">
    <span class="order-label">Status</span>
    <span class="status-badge">
      <span class="status-dot" aria-hidden="true"></span>
      Not charged
    </span>
  </div>
</div>

<!-- Buttons — fix the Back to Cart link -->
<div class="btn-group">
  <button class="btn btn-primary" id="retryBtn" onclick="handleRetry()">
    Try Again
  </button>
  <button class="btn btn-secondary" onclick="window.location.href='/profile/orders/<%= order._id %>'">
    View My Orders
  </button>
</div>

    <!-- Action Buttons -->
    <div class="btn-group">
      <button class="btn btn-secondary" onclick="window.location.href='/cart'">
        Back to Cart
      </button>
    </div>

    <!-- Support Link -->
    <a class="support-link" href="mailto:support@elarajewellery.com" aria-label="Contact customer support">
      Contact Support
    </a>

    <!-- Reassurance Note -->
    <p class="refund-note">
      Your card has <span>not been charged.</span> If any amount was deducted,<br>
      it will be refunded within <span>3–5 business days.</span>
    </p>

  </main>

  <!-- Footer -->
  <p class="footer-brand">Elara Jewellery &mdash; Est. 2009</p>
<script src="https://checkout.razorpay.com/v1/checkout.js"></script>
<script>
  const orderId = "<%= orderId %>";
  const razorpayKey = "<%= process.env.RAZORPAY_KEY_ID %>";  

  async function handleRetry() {
    const btn = document.getElementById('retryBtn');
    btn.textContent = 'Please wait…';
    btn.disabled = true;
    btn.style.opacity = '0.75';

    try {
      const res = await fetch(`/retry-payment/${orderId}`, { 
        method: "POST",
        headers: { "Content-Type": "application/json" }
      });

      const data = await res.json();

      if (!data.success) {
        alert(data.message || "Retry failed. Please try again.");
        btn.textContent = 'Try Again';
        btn.disabled = false;
        btn.style.opacity = '1';
        return;
      }

      // Use the exact amount sent from backend
      const options = {
        key: razorpayKey,
        amount: data.razorpayOrder.amount,        // ← Use backend amount
        currency: "INR",
        order_id: data.razorpayOrder.id,
        name: "ELARA Luxury Jewelry",
        description: "Retry Payment for Order #" + orderId,

        handler: async function (response) {
          const verifyRes = await fetch("/verify-payment", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({
              razorpay_order_id: response.razorpay_order_id,
              razorpay_payment_id: response.razorpay_payment_id,
              razorpay_signature: response.razorpay_signature,
              orderId: data.orderId
            })
          });

          const verifyData = await verifyRes.json();

          if (verifyData.success) {
            window.location.href = `/order-success/${data.orderId}`;
          } else {
            window.location.href = `/payment-failed/${data.orderId}`;
          }
        },

        theme: { color: "#a3866a" }
      };

      const rzp = new Razorpay(options);

      rzp.on("payment.failed", function () {
        window.location.href = `/payment-failed/${data.orderId}`;
      });

      rzp.open();

    } catch (err) {
      console.error(err);
      alert("Something went wrong. Please try again.");
    } finally {
      btn.textContent = 'Try Again';
      btn.disabled = false;
      btn.style.opacity = '1';
    }
  }
</script>

</body>
</html>