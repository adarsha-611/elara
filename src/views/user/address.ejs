<!-- address.ejs - Updated with SweetAlert and AJAX -->
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ELARA - My Addresses</title>
    <link rel="stylesheet" href="/css/profile.css">
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@600&family=Plus+Jakarta+Sans:wght@300;400;500;600&display=swap" rel="stylesheet">
    
    <script>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            'elara-brown': '#7A5C4D',
            'elara-dark': '#3D2B24',
            'elara-ivory': '#FDFBF9',
            'elara-beige': '#F4F1EE'
          },
          fontFamily: {
            'display': ['Cormorant Garamond', 'serif'],
            'sans': ['Plus Jakarta Sans', 'sans-serif']
          }
        }
      }
    }
    </script>

    <style>
        .modal {
            display: none;
            position: fixed;
            inset: 0;
            background: rgba(61, 43, 36, 0.4);
            backdrop-filter: blur(4px);
            justify-content: center;
            align-items: center;
            z-index: 1000;
        }
        .modal.show { display: flex; }
        
        .luxury-input {
            width: 100%;
            background-color: #fff;
            border: 1px solid #F4F1EE;
            border-radius: 0.75rem;
            padding: 0.75rem 1.25rem;
            font-size: 0.875rem;
            transition: all 0.2s;
            outline: none;
        }
        .luxury-input:focus {
            border-color: #7A5C4D;
            box-shadow: 0 4px 12px rgba(61, 43, 36, 0.03);
        }
        .luxury-input.is-invalid {
            border-color: #dc3545;
            background-color: #fff8f8;
        }
        .error-text {
            color: #dc3545;
            font-size: 0.75rem;
            margin-top: 4px;
            min-height: 1.2em;
        }
        
        .pagination {
            display: flex;
            align-items: center;
            gap: 10px;
            justify-content: center;
            margin-top: 2rem;
        }
        
        .pagination a {
            text-decoration: none;
            transition: all 0.3s ease;
            display: flex;
            align-items: center;
            justify-content: center;
        }
        
      .pagination a.page-num {
    width: 42px;
    height: 42px;
    border: 1px solid #F4F1EE;
    background-color: #FFFFFF;
    color: #3D2B24;
    font-size: 0.75rem;
    font-weight: 700;
    border-radius: 50%;
}
        
        .pagination a.page-num:hover:not(.active) {
            border-color: #7A5C4D;
            color: #7A5C4D;
        }
        
        .pagination a.page-num.active {
            background-color: #3D2B24;
            color: #FFFFFF;
            border-color: #3D2B24;
        }
        
        .pagination a.nav-btn {
    padding: 0 18px;
    height: 42px;
    color: #3D2B24;
    font-size: 10px;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.2em;
    border: 1px solid #F4F1EE;
    border-radius: 21px;
    background-color: #FFFFFF;
}

.pagination a.nav-btn:hover {
    background-color: #3D2B24;
    color: #FFFFFF;
    border-color: #3D2B24;
}
        
        .loading-spinner {
            display: inline-block;
            width: 16px;
            height: 16px;
            border: 2px solid #f3f3f3;
            border-top: 2px solid #7A5C4D;
            border-radius: 50%;
            animation: spin 1s linear infinite;
            margin-right: 8px;
        }
        
        @keyframes spin {
            0% { transform: rotate(0deg); }
            100% { transform: rotate(360deg); }
        }
    </style>
</head>
<body class="bg-elara-beige font-sans text-gray-900">

    <%- include('../partials/header') %>

    <main class="max-w-6xl mx-auto px-6 py-12" style="margin-top: 100px;">
        <div class="flex flex-col md:flex-row gap-10 items-start">
            
<div style="width: 288px; min-width: 288px; flex-shrink: 0;">
        <%- include('../partials/profileSidebar', { user: user, path: '/profile/address' }) %>
</div>

            <section class="flex-1 bg-elara-ivory rounded-3xl shadow-[0_20px_60px_rgba(61,43,36,0.05)] border border-white overflow-hidden">
                
                <div class="p-10 border-b border-elara-beige flex justify-between items-end">
                    <div>
                        <h1 class="text-3xl font-display italic text-elara-dark tracking-wide">My Addresses</h1>
                        <p class="text-[10px] uppercase tracking-[0.3em] text-elara-brown font-bold mt-2">Saved Shipping Locations</p>
                    </div>
                    <button onclick="openAddressModal()" class="px-8 py-3.5 bg-elara-dark text-white rounded-xl text-[10px] font-bold uppercase tracking-[0.2em] hover:bg-elara-brown transition-all shadow-md flex items-center gap-2 active:scale-95">
                        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
                        Add New Address
                    </button>
                </div>

                <div class="p-8 md:p-12" style="padding: 7rem;">
                    <!-- Flash Messages -->
                    <% if (success && success.length > 0) { %>
                        <div class="bg-green-50 text-green-700 px-6 py-4 rounded-xl text-sm border border-green-100 mb-8 font-medium italic">
                            <%= success %>
                        </div>
                    <% } %>
                    <% if (error && error.length > 0) { %>
                        <div class="bg-red-50 text-red-700 px-6 py-4 rounded-xl text-sm border border-red-100 mb-8 font-medium italic">
                            <%= error %>
                        </div>
                    <% } %>

                    <div class="grid grid-cols-1 gap-6" id="addressesContainer">
                        <% if (addresses && addresses.length > 0) { %>
                            <% addresses.forEach(addr => { %>
                                <div class="address-card group bg-white border border-elara-beige rounded-2xl p-8 flex justify-between items-start transition-all hover:border-elara-brown hover:shadow-sm" data-address-id="<%= addr._id %>">
                                    <div class="space-y-4">
                                        <div class="flex items-center gap-3">
                                            <span class="text-[9px] font-bold uppercase tracking-widest px-3 py-1 bg-elara-beige text-elara-brown rounded-md">
                                                <%= addr.addressType %>
                                            </span>
                                            <% if (addr.isDefault) { %>
                                                <span class="text-[9px] font-bold uppercase tracking-widest px-3 py-1 bg-elara-dark text-white rounded-md">Default</span>
                                            <% } %>
                                        </div>
                                        
                                        <div>
                                            <h3 class="text-xl font-display italic text-elara-dark mb-1"><%= addr.fullName %></h3>
                                            <p class="text-sm font-sans text-gray-400 tracking-widest"><%= addr.phoneNumber %></p>
                                        </div>
                                        
                                        <div class="text-sm text-gray-500 leading-relaxed font-light">
                                            <%= addr.street %><br>
                                            <%= addr.city %>, <%= addr.state %> — <span class="font-semibold text-elara-dark"><%= addr.pincode %></span>
                                        </div>
                                    </div>

                                    <div class="flex flex-col gap-2">
                                        <button 
                                            onclick="editAddress('<%= addr._id %>')"
                                            class="w-10 h-10 flex items-center justify-center rounded-xl bg-elara-beige text-elara-dark hover:bg-elara-brown hover:text-white transition-all shadow-sm"
                                            title="Edit">
                                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path></svg>
                                        </button>

                                        <button 
                                            onclick="deleteAddress('<%= addr._id %>')"
                                            class="w-10 h-10 flex items-center justify-center rounded-xl bg-white border border-elara-beige text-red-300 hover:bg-red-500 hover:text-white transition-all shadow-sm" 
                                            title="Delete">
                                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path><line x1="10" y1="11" x2="10" y2="17"></line><line x1="14" y1="11" x2="14" y2="17"></line></svg>
                                        </button>

                                        <% if (!addr.isDefault) { %>
                                            <button 
                                                onclick="setDefaultAddress('<%= addr._id %>')"
                                                class="w-10 h-10 flex items-center justify-center rounded-xl bg-white border border-elara-beige text-elara-brown hover:bg-elara-dark hover:text-white transition-all shadow-sm" 
                                                title="Set as Default">
                                                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon></svg>
                                            </button>
                                        <% } %>
                                    </div>
                                </div>
                            <% }) %>
                        <% } else { %>
                            <div class="text-center py-20 bg-white rounded-3xl border border-dashed border-elara-beige">
                                <p class="text-gray-400 italic font-display text-xl">You haven't saved any addresses yet.</p>
                            </div>
                        <% } %>
                    </div>

                    <% if (totalPages > 1) { %>
                    <div class="pagination">
                        <% if (currentPage > 1) { %>
                            <a href="?page=<%= currentPage - 1 %>" class="nav-btn">Prev</a>
                        <% } %>

                        <% for (let i = 1; i <= totalPages; i++) { %>
                            <a href="?page=<%= i %>" class="page-num <%= currentPage === i ? 'active' : '' %>">
                                <%= i %>
                            </a>
                        <% } %>

                        <% if (currentPage < totalPages) { %>
                            <a href="?page=<%= currentPage + 1 %>" class="nav-btn">Next</a>
                        <% } %>
                    </div>
                    <% } %>
                </div>
            </section>
        </div>
    </main>

    <!-- Address Modal -->
    <div id="addressModal" class="modal">
        <div class="bg-white rounded-3xl w-full max-w-lg overflow-hidden shadow-2xl border border-elara-beige transform transition-all">
            <div class="px-8 py-6 border-b border-elara-beige flex justify-between items-center bg-white">
                <h3 id="modalTitle" class="text-xl font-display italic text-elara-dark tracking-wide">Add New Address</h3>
                <button type="button" onclick="closeAddressModal()" class="text-gray-400 hover:text-elara-dark transition-colors">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 6L6 18M6 6l12 12"/></svg>
                </button>
            </div>

            <form id="addressForm" class="p-8">
                <input type="hidden" name="addressId" id="addressId" value="">

                <div class="grid grid-cols-2 gap-5 mb-4">
                    <div class="space-y-1.5">
                        <label class="text-[10px] uppercase tracking-widest text-elara-brown font-bold ml-1">Full Name *</label>
                        <input type="text" name="fullName" id="fullName" maxlength="20" class="luxury-input">
                        <div class="error-text" id="fullName-error"></div>
                    </div>
                    <div class="space-y-1.5">
                        <label class="text-[10px] uppercase tracking-widest text-elara-brown font-bold ml-1">Phone Number *</label>
                        <input type="tel" name="phoneNumber" id="phoneNumber" maxlength="10" class="luxury-input">
                        <div class="error-text" id="phoneNumber-error"></div>
                    </div>
                </div>

                <div class="space-y-1.5 mb-4">
                    <label class="text-[10px] uppercase tracking-widest text-elara-brown font-bold ml-1">Street Address *</label>
                    <input type="text" name="street" id="street" maxlength="50" class="luxury-input">
                    <div class="error-text" id="street-error"></div>
                </div>

                <div class="grid grid-cols-2 gap-5 mb-4">
                    <div class="space-y-1.5">
                        <label class="text-[10px] uppercase tracking-widest text-elara-brown font-bold ml-1">District / Town *</label>
                        <input type="text" name="city" id="city" maxlength="10" class="luxury-input">
                        <div class="error-text" id="city-error"></div>
                    </div>
                    <div class="space-y-1.5">
                        <label class="text-[10px] uppercase tracking-widest text-elara-brown font-bold ml-1">State *</label>
                        <input type="text" name="state" id="state" maxlength="10" class="luxury-input">
                        <div class="error-text" id="state-error"></div>
                    </div>
                </div>

                <div class="grid grid-cols-2 gap-5 mb-6">
                    <div class="space-y-1.5">
                        <label class="text-[10px] uppercase tracking-widest text-elara-brown font-bold ml-1">Pincode *</label>
                        <input type="text" name="pincode" id="pincode" maxlength="6" class="luxury-input">
                        <div class="error-text" id="pincode-error"></div>
                    </div>

                    <div class="space-y-1.5">
                        <label class="text-[10px] uppercase tracking-widest text-elara-brown font-bold ml-1">Address Type</label>
                        <div class="flex gap-6 pt-3">
                            <label class="flex items-center gap-2 text-xs text-elara-dark cursor-pointer font-medium">
                                <input type="radio" name="addressType" value="Home" id="typeHome" checked class="accent-elara-brown"> Home
                            </label>
                            <label class="flex items-center gap-2 text-xs text-elara-dark cursor-pointer font-medium">
                                <input type="radio" name="addressType" value="Work" id="typeWork" class="accent-elara-brown"> Work
                            </label>
                        </div>
                    </div>
                </div>

                <div class="mb-8 ml-1">
                    <label class="flex items-center gap-3 cursor-pointer group">
                        <input type="checkbox" name="isDefault" id="isDefault" class="w-4 h-4 rounded border-elara-beige text-elara-dark focus:ring-elara-brown accent-elara-dark">
                        <span class="text-[10px] uppercase tracking-widest text-gray-500 font-bold group-hover:text-elara-dark transition-colors">Make this my default address</span>
                    </label>
                </div>

                <div class="flex gap-4">
                    <button type="button" onclick="closeAddressModal()" class="flex-1 px-8 py-4 border border-elara-beige text-[10px] font-bold uppercase tracking-[0.2em] rounded-xl hover:bg-gray-50 transition-all active:scale-95">Cancel</button>
                    <button type="submit" id="submitBtn" class="flex-1 px-8 py-4 bg-elara-dark text-white text-[10px] font-bold uppercase tracking-[0.2em] rounded-xl hover:bg-elara-brown transition-all shadow-xl active:scale-95">Save Address</button>
                </div>
            </form>
        </div>
    </div>

    <%- include('../partials/footer') %>

    <script>
        let currentFormMode = 'add';
        
        // SweetAlert Toast Configuration
        const Toast = Swal.mixin({
            toast: true,
            position: 'top-end',
            showConfirmButton: false,
            timer: 3000,
            timerProgressBar: true
        });
        
        // Open Add Address Modal
        function openAddressModal() {
            currentFormMode = 'add';
            document.getElementById('modalTitle').textContent = "Add New Address";
            document.getElementById('addressForm').reset();
            document.getElementById('addressId').value = '';
            clearErrors();
            document.getElementById('addressModal').classList.add('show');
        }
        
        // Edit Address
        async function editAddress(addressId) {
            try {
                const response = await fetch(`/profile/address/get/${addressId}`);
                const data = await response.json();
                
                if (data.success) {
                    currentFormMode = 'edit';
                    const addr = data.address;
                    
                    document.getElementById('modalTitle').textContent = "Edit Address";
                    document.getElementById('addressId').value = addr._id;
                    document.getElementById('fullName').value = addr.fullName || '';
                    document.getElementById('phoneNumber').value = addr.phoneNumber || '';
                    document.getElementById('street').value = addr.street || '';
                    document.getElementById('city').value = addr.city || '';
                    document.getElementById('state').value = addr.state || '';
                    document.getElementById('pincode').value = addr.pincode || '';
                    
                    if (addr.addressType === 'Work') {
                        document.getElementById('typeWork').checked = true;
                    } else {
                        document.getElementById('typeHome').checked = true;
                    }
                    
                    document.getElementById('isDefault').checked = addr.isDefault || false;
                    
                    clearErrors();
                    document.getElementById('addressModal').classList.add('show');
                } else {
                    Toast.fire({
                        icon: 'error',
                        title: data.message || 'Failed to load address'
                    });
                }
            } catch (error) {
                console.error('Edit error:', error);
                Toast.fire({
                    icon: 'error',
                    title: 'Failed to load address details'
                });
            }
        }
        
        // Delete Address with SweetAlert Confirmation
        // Replace your deleteAddress function with this
async function deleteAddress(addressId) {
    const result = await Swal.fire({
        title: 'Delete Address?',
        text: "Are you sure you want to delete this address? This action cannot be undone.",
        icon: 'warning',
        showCancelButton: true,
        confirmButtonColor: '#d33',
        cancelButtonColor: '#7A5C4D',
        confirmButtonText: 'Yes, delete it!',
        cancelButtonText: 'Cancel'
    });
    
    if (result.isConfirmed) {
        Swal.fire({
            title: 'Deleting...',
            allowOutsideClick: false,
            didOpen: () => {
                Swal.showLoading();
            }
        });
        
        try {
            // Use GET method to match your route
            const response = await fetch(`/profile/address/delete/${addressId}`, {
                method: 'GET',
                headers: {
                    'X-Requested-With': 'XMLHttpRequest'
                }
            });
            
            const data = await response.json();
            
            if (data.success) {
                Swal.fire({
                    icon: 'success',
                    title: 'Deleted!',
                    text: 'Address has been deleted successfully.',
                    confirmButtonColor: '#7A5C4D'
                }).then(() => {
                    window.location.reload();
                });
            } else {
                Swal.fire({
                    icon: 'error',
                    title: 'Error!',
                    text: data.message || 'Failed to delete address',
                    confirmButtonColor: '#7A5C4D'
                });
            }
        } catch (error) {
            console.error('Delete error:', error);
            Swal.fire({
                icon: 'error',
                title: 'Error!',
                text: 'Something went wrong. Please try again.',
                confirmButtonColor: '#7A5C4D'
            });
        }
    }
}
        // Set Default Address with SweetAlert Confirmation
       async function setDefaultAddress(addressId) {
    if (!addressId) {
        Swal.fire({
            icon: 'error',
            title: 'Error!',
            text: 'No address selected',
            confirmButtonColor: '#7A5C4D'
        });
        return;
    }
    
    const result = await Swal.fire({
        title: 'Set as Default?',
        text: "Do you want to set this as your default shipping address?",
        icon: 'question',
        showCancelButton: true,
        confirmButtonColor: '#7A5C4D',
        cancelButtonColor: '#d33',
        confirmButtonText: 'Yes, set as default',
        cancelButtonText: 'Cancel'
    });
    
    if (result.isConfirmed) {
        // Show loading
        Swal.fire({
            title: 'Updating...',
            allowOutsideClick: false,
            didOpen: () => {
                Swal.showLoading();
            }
        });
        
        try {
            // Use GET method to match your route
            const response = await fetch(`/profile/address/setdefault/${addressId}`, {
                method: 'GET',
                headers: {
                    'X-Requested-With': 'XMLHttpRequest',
                    'Accept': 'application/json'
                }
            });
            
            // Check if response is ok
            if (!response.ok) {
                const errorText = await response.text();
                console.error("Response error:", errorText);
                throw new Error(`HTTP error! status: ${response.status}`);
            }
            
            const data = await response.json();
            console.log("Set default response:", data); // Debug
            
            if (data.success) {
                Swal.fire({
                    icon: 'success',
                    title: 'Success!',
                    text: data.message || 'Default address updated successfully',
                    confirmButtonColor: '#7A5C4D',
                    timer: 2000,
                    timerProgressBar: true
                }).then(() => {
                    window.location.reload();
                });
            } else {
                throw new Error(data.message || 'Failed to update default address');
            }
            
        } catch (error) {
            console.error('Set default error:', error);
            Swal.fire({
                icon: 'error',
                title: 'Error!',
                text: error.message || 'Something went wrong. Please try again.',
                confirmButtonColor: '#7A5C4D'
            });
        }
    }
}
        
        // Close Modal
        function closeAddressModal() {
            document.getElementById('addressModal').classList.remove('show');
            clearErrors();
        }
        
        // Clear Validation Errors
        function clearErrors() {
            document.querySelectorAll('.error-text').forEach(el => el.textContent = '');
            document.querySelectorAll('.luxury-input').forEach(el => el.classList.remove('is-invalid'));
        }
        
        // Display Validation Errors
        function displayErrors(errors) {
            clearErrors();
            errors.forEach(err => {
                const errorEl = document.getElementById(`${err.field}-error`);
                const inputEl = document.getElementById(err.field);
                if (errorEl && inputEl) {
                    errorEl.textContent = err.message;
                    inputEl.classList.add('is-invalid');
                }
            });
        }
        
        // Submit Form with AJAX
        document.getElementById('addressForm').addEventListener('submit', async function(e) {
            e.preventDefault();
            
            const formData = new FormData(this);
            const data = Object.fromEntries(formData.entries());
            data.isDefault = data.isDefault === 'on';
            
            const submitBtn = document.getElementById('submitBtn');
            const originalText = submitBtn.innerHTML;
            
            // Show loading state
            submitBtn.innerHTML = '<span class="loading-spinner"></span> Saving...';
            submitBtn.disabled = true;
            
            try {
                const url = currentFormMode === 'add' ? '/profile/address/add' : '/profile/address/edit';
                const method = 'POST';
                
                const response = await fetch(url, {
                    method: method,
                    headers: {
                        'Content-Type': 'application/json',
                        'X-Requested-With': 'XMLHttpRequest'
                    },
                    body: JSON.stringify(data)
                });
                
                const result = await response.json();
                
               if (result.success) {
            Swal.fire({
            icon: 'success',
            title: currentFormMode === 'add' ? 'Address Added!' : 'Address Updated!',
            text: result.message,
             confirmButtonColor: '#7A5C4D'
    }).then(() => {
        closeAddressModal();
        window.location.reload();
    });

} else {

    if (result.errors && result.errors.length > 0) {
        displayErrors(result.errors);
        return;
    }

    Swal.fire({
        icon: 'error',
        title: 'Error!',
        text: result.message || 'Something went wrong',
        confirmButtonColor: '#7A5C4D'
    });
}
                
            } catch (error) {
                console.error('Submit error:', error);
                Swal.fire({
                    icon: 'error',
                    title: 'Error!',
                    text: 'Something went wrong. Please try again.',
                    confirmButtonColor: '#7A5C4D'
                });
            } finally {
                submitBtn.innerHTML = originalText;
                submitBtn.disabled = false;
            }
        });
        
        // Close modal on outside click
        window.onclick = function(event) {
            const modal = document.getElementById('addressModal');
            if (event.target === modal) {
                closeAddressModal();
            }
        }
    </script>
</body>
</html>