<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ELARA - My Addresses</title>
    <link rel="stylesheet" href="/css/profile.css">
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@600&family=Plus+Jakarta+Sans:wght@300;400;500;600&display=swap" rel="stylesheet">
    
    <script>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            'elara-brown': '#7A5C4D',
            'elara-dark': '#3D2B24',
            'elara-ivory': '#FDFBF9',
            'elara-beige': '#F4F1EE'
          },
          fontFamily: {
            'display': ['Cormorant Garamond', 'serif'],
            'sans': ['Plus Jakarta Sans', 'sans-serif']
          }
        }
      }
    }
    </script>

    <style>
        /* Essential for Modal Functionality */
        .modal {
            display: none;
            position: fixed;
            inset: 0;
            background: rgba(61, 43, 36, 0.4);
            backdrop-filter: blur(4px);
            justify-content: center;
            align-items: center;
            z-index: 1000;
        }
        .modal.show { display: flex; }
        
        .luxury-input {
            width: 100%;
            background-color: #fff;
            border: 1px solid #F4F1EE;
            border-radius: 0.75rem;
            padding: 0.75rem 1.25rem;
            font-size: 0.875rem;
            transition: all 0.2s;
            outline: none;
        }
        .luxury-input:focus {
            border-color: #7A5C4D;
            box-shadow: 0 4px 12px rgba(61, 43, 36, 0.03);
        }
        .luxury-input.is-invalid {
            border-color: #dc3545;
        }
        .error-text {
            color: #dc3545;
            font-size: 0.75rem;
            margin-top: 4px;
            min-height: 1.2em;
        }
        /* Container spacing */
.elara-pagination-wrapper {
    display: flex;
    justify-content: center;
    margin: 4rem 0;
}

.pagination {
    display: flex;
    align-items: center;
    gap: 10px;
}

/* Base style for all links */
.pagination a {
    text-decoration: none;
    transition: all 0.3s ease;
    font-family: 'Lato', sans-serif;
    display: flex;
    align-items: center;
    justify-content: center;
}

/* The Square Page Numbers */
.pagination a.page-num {
    width: 42px;
    height: 42px;
    border: 1px solid #F4F1EE; /* elara-beige */
    background-color: #FFFFFF;
    color: #3D2B24; /* elara-dark */
    font-size: 0.75rem;
    font-weight: 700;
    border-radius: 4px; /* Essential for the sharp square look */
}

/* Hover state for page numbers */
.pagination a.page-num:hover:not(.active) {
    border-color: #7A5C4D; /* elara-brown */
    color: #7A5C4D;
    transform: translateY(-2px);
}

/* Active Page State */
.pagination a.page-num.active {
    background-color: #3D2B24; /* elara-dark */
    color: #FFFFFF;
    border-color: #3D2B24;
    box-shadow: 0 4px 15px rgba(61, 43, 36, 0.1);
}

/* Navigation (Prev/Next) Styling */
.pagination a.nav-btn {
    padding: 0 15px;
    height: 42px;
    color: #3D2B24;
    font-size: 10px;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.2em;
    opacity: 0.8;
}

.pagination a.nav-btn:hover {
    color: #7A5C4D;
    opacity: 1;
}
    </style>
</head>
<body class="bg-elara-beige font-sans text-gray-900">

    <%- include('../partials/header') %>

    <main class="max-w-6xl mx-auto px-6 py-12">
        <div class="flex flex-col md:flex-row gap-10 items-start">
            
            <div class="w-full md:w-72 shrink-0">
                <%- include('../partials/profileSidebar', { user: user, path: '/profile/address' }) %>
            </div>

            <section class="flex-1 bg-elara-ivory rounded-3xl shadow-[0_20px_60px_rgba(61,43,36,0.05)] border border-white overflow-hidden">
                
                <div class="p-10 border-b border-elara-beige flex justify-between items-end">
                    <div>
                        <h1 class="text-3xl font-display italic text-elara-dark tracking-wide">My Addresses</h1>
                        <p class="text-[10px] uppercase tracking-[0.3em] text-elara-brown font-bold mt-2">Saved Shipping Locations</p>
                    </div>
                    <button onclick="openAddressModal()" class="px-8 py-3.5 bg-elara-dark text-white rounded-xl text-[10px] font-bold uppercase tracking-[0.2em] hover:bg-elara-brown transition-all shadow-md flex items-center gap-2 active:scale-95">
                        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
                        Add New Address
                    </button>
                </div>

                <div class="p-8 md:p-12">
                    <% if (success && success.length > 0) { %>
                        <div class="bg-green-50 text-green-700 px-6 py-4 rounded-xl text-sm border border-green-100 mb-8 font-medium italic">
                            <%= success %>
                        </div>
                    <% } %>
                    <% if (error && error.length > 0) { %>
                        <div class="bg-red-50 text-red-700 px-6 py-4 rounded-xl text-sm border border-red-100 mb-8 font-medium italic">
                            <%= error %>
                        </div>
                    <% } %>

                    <div class="grid grid-cols-1 gap-6">
                        <% if (addresses && addresses.length > 0) { %>
                            <% addresses.forEach(addr => { %>
                                <div class="group bg-white border border-elara-beige rounded-2xl p-8 flex justify-between items-start transition-all hover:border-elara-brown hover:shadow-sm">
                                    <div class="space-y-4">
                                        <div class="flex items-center gap-3">
                                            <span class="text-[9px] font-bold uppercase tracking-widest px-3 py-1 bg-elara-beige text-elara-brown rounded-md">
                                                <%= addr.addressType %>
                                            </span>
                                            <% if (addr.isDefault) { %>
                                                <span class="text-[9px] font-bold uppercase tracking-widest px-3 py-1 bg-elara-dark text-white rounded-md">Default</span>
                                            <% } %>
                                        </div>
                                        
                                        <div>
                                            <h3 class="text-xl font-display italic text-elara-dark mb-1"><%= addr.fullName %></h3>
                                            <p class="text-sm font-sans text-gray-400 tracking-widest"><%= addr.phoneNumber %></p>
                                        </div>
                                        
                                        <div class="text-sm text-gray-500 leading-relaxed font-light">
                                            <%= addr.street %><br>
                                            <%= addr.city %>, <%= addr.state %> — <span class="font-semibold text-elara-dark"><%= addr.pincode %></span>
                                        </div>
                                    </div>

                                    <div class="flex flex-col gap-2">
                                        <button 
                                            onclick='openEditAddressModal(
                                                "<%= addr._id %>",
                                                <%= JSON.stringify(addr.fullName) %>,
                                                <%= JSON.stringify(addr.phoneNumber || "") %>,
                                                <%= JSON.stringify(addr.street) %>,
                                                <%= JSON.stringify(addr.city) %>,
                                                <%= JSON.stringify(addr.state) %>,
                                                <%= JSON.stringify(addr.pincode || "") %>,
                                                <%= JSON.stringify(addr.addressType) %>,
                                                <%= addr.isDefault %>
                                            )' 
                                            class="w-10 h-10 flex items-center justify-center rounded-xl bg-elara-beige text-elara-dark hover:bg-elara-brown hover:text-white transition-all shadow-sm"
                                            title="Edit">
                                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path></svg>
                                        </button>

                                        <a href="/profile/address/delete/<%= addr._id %>" 
                                           class="w-10 h-10 flex items-center justify-center rounded-xl bg-white border border-elara-beige text-red-300 hover:bg-red-500 hover:text-white transition-all shadow-sm" 
                                           title="Delete"
                                           onclick="confirmDelete(event, '<%= addr._id %>')">
                                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path><line x1="10" y1="11" x2="10" y2="17"></line><line x1="14" y1="11" x2="14" y2="17"></line></svg>
                                        </a>

                                        <% if (!addr.isDefault) { %>
                                            <a href="/profile/address/setdefault/<%= addr._id %>" 
                                               class="w-10 h-10 flex items-center justify-center rounded-xl bg-white border border-elara-beige text-elara-brown hover:bg-elara-dark hover:text-white transition-all shadow-sm" 
                                               title="Set as Default">
                                                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon></svg>
                                            </a>
                                        <% } %>
                                    </div>
                                </div>
                            <% }) %>
                        <% } else { %>
                            <div class="text-center py-20 bg-white rounded-3xl border border-dashed border-elara-beige">
                                <p class="text-gray-400 italic font-display text-xl">You haven't saved any addresses yet.</p>
                            </div>
                        <% } %>
                    </div>

                    <div class="elara-pagination-wrapper">
    <div class="pagination">
        <% if (currentPage > 1) { %>
            <a href="?page=<%= currentPage - 1 %>" class="nav-btn">Prev</a>
        <% } %>

        <% for (let i = 1; i <= totalPages; i++) { %>
            <a href="?page=<%= i %>" class="page-num <%= currentPage === i ? 'active' : '' %>">
                <%= i %>
            </a>
        <% } %>

        <% if (currentPage < totalPages) { %>
            <a href="?page=<%= currentPage + 1 %>" class="nav-btn">Next</a>
        <% } %>
    </div>
</div>
                </div>
            </section>
        </div>
    </main>

    <div id="addressModal" class="modal">
        <div class="bg-white rounded-3xl w-full max-w-lg overflow-hidden shadow-2xl border border-elara-beige transform transition-all">
            <div class="px-8 py-6 border-b border-elara-beige flex justify-between items-center bg-white">
                <h3 id="modalTitle" class="text-xl font-display italic text-elara-dark tracking-wide">Add New Address</h3>
                <button type="button" onclick="closeAddressModal()" class="text-gray-400 hover:text-elara-dark transition-colors">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 6L6 18M6 6l12 12"/></svg>
                </button>
            </div>

            <form id="addressForm" action="/profile/address/add" method="POST" class="p-8">
                <input type="hidden" name="addressId" id="addressId" value="">

                <div class="grid grid-cols-2 gap-5 mb-4">
                    <div class="space-y-1.5">
                        <label class="text-[10px] uppercase tracking-widest text-elara-brown font-bold ml-1">Full Name *</label>
                        <input type="text" name="fullName" id="fullName" maxlength="20" class="luxury-input">
                        <div class="error-text" id="fullName-error"></div>
                    </div>
                    <div class="space-y-1.5">
                        <label class="text-[10px] uppercase tracking-widest text-elara-brown font-bold ml-1">Phone Number *</label>
                        <input type="tel" name="phoneNumber" id="phoneNumber" maxlength="10" pattern="\d{10}" title="10-digit number only" class="luxury-input">
                        <div class="error-text" id="phoneNumber-error"></div>
                    </div>
                </div>

                <div class="space-y-1.5 mb-4">
                    <label class="text-[10px] uppercase tracking-widest text-elara-brown font-bold ml-1">Street Address *</label>
                    <input type="text" name="street" id="street" maxlength="50" class="luxury-input">
                    <div class="error-text" id="street-error"></div>
                </div>

                <div class="grid grid-cols-2 gap-5 mb-4">
                    <div class="space-y-1.5">
                        <label class="text-[10px] uppercase tracking-widest text-elara-brown font-bold ml-1">District / Town *</label>
                        <input type="text" name="city" id="city" maxlength="10" class="luxury-input">
                        <div class="error-text" id="city-error"></div>
                    </div>
                    <div class="space-y-1.5">
                        <label class="text-[10px] uppercase tracking-widest text-elara-brown font-bold ml-1">State *</label>
                        <input type="text" name="state" id="state" maxlength="10" class="luxury-input">
                        <div class="error-text" id="state-error"></div>
                    </div>
                </div>

                <div class="grid grid-cols-2 gap-5 mb-6">
                    <div class="space-y-1.5">
                        <label class="text-[10px] uppercase tracking-widest text-elara-brown font-bold ml-1">Pincode *</label>
                        <input type="text" name="pincode" id="pincode" maxlength="6" pattern="\d{6}" title="6-digit number only" class="luxury-input">
                        <div class="error-text" id="pincode-error"></div>
                    </div>

                    <div class="space-y-1.5">
                        <label class="text-[10px] uppercase tracking-widest text-elara-brown font-bold ml-1">Address Type</label>
                        <div class="flex gap-6 pt-3">
                            <label class="flex items-center gap-2 text-xs text-elara-dark cursor-pointer font-medium">
                                <input type="radio" name="addressType" value="Home" id="typeHome" checked class="accent-elara-brown"> Home
                            </label>
                            <label class="flex items-center gap-2 text-xs text-elara-dark cursor-pointer font-medium">
                                <input type="radio" name="addressType" value="Work" id="typeWork" class="accent-elara-brown"> Work
                            </label>
                        </div>
                    </div>
                </div>

                <div class="mb-8 ml-1">
                    <label class="flex items-center gap-3 cursor-pointer group">
                        <input type="checkbox" name="isDefault" id="isDefault" class="w-4 h-4 rounded border-elara-beige text-elara-dark focus:ring-elara-brown accent-elara-dark">
                        <span class="text-[10px] uppercase tracking-widest text-gray-500 font-bold group-hover:text-elara-dark transition-colors">Make this my default address</span>
                    </label>
                </div>

                <div class="flex gap-4">
                    <button type="button" onclick="closeAddressModal()" class="flex-1 px-8 py-4 border border-elara-beige text-[10px] font-bold uppercase tracking-[0.2em] rounded-xl hover:bg-gray-50 transition-all active:scale-95">Cancel</button>
                    <button type="submit" class="flex-1 px-8 py-4 bg-elara-dark text-white text-[10px] font-bold uppercase tracking-[0.2em] rounded-xl hover:bg-elara-brown transition-all shadow-xl active:scale-95">Save Address</button>
                </div>
            </form>
        </div>
    </div>

    <%- include('../partials/footer') %>

    <script>
        const addressModal = document.getElementById('addressModal');

        function openAddressModal() {
            document.getElementById('modalTitle').textContent = "Add New Address";
            document.getElementById('addressForm').action = "/profile/address/add";
            document.getElementById('addressForm').reset();
            document.getElementById('addressId').value = '';
            clearErrors();
            addressModal.classList.add('show');
        }

        function openEditAddressModal(id, fullName, phoneNumber, street, city, state, pincode, addressType, isDefault) {
            console.log("Editing address ID:", id);
            document.getElementById('modalTitle').textContent = "Edit Address";
            document.getElementById('addressForm').action = "/profile/address/edit";

            document.getElementById('addressId').value = id;
            document.getElementById('fullName').value = fullName || '';
            document.getElementById('phoneNumber').value = phoneNumber || '';
            document.getElementById('street').value = street || '';
            document.getElementById('city').value = city || '';
            document.getElementById('state').value = state || '';
            document.getElementById('pincode').value = pincode || '';

            document.getElementById('typeHome').checked = addressType !== 'Work';
            document.getElementById('typeWork').checked = addressType === 'Work';

            document.getElementById('isDefault').checked = !!isDefault;

            clearErrors();
            addressModal.classList.add('show');
        }

        function closeAddressModal() {
            addressModal.classList.remove('show');
            clearErrors();
        }

        function clearErrors() {
            document.querySelectorAll('.error-text').forEach(el => el.textContent = '');
            document.querySelectorAll('input').forEach(el => el.classList.remove('is-invalid'));
        }

        function showFieldErrors(errors) {
            clearErrors();
            if (!errors || !Array.isArray(errors)) return;

            errors.forEach(err => {
                const errorEl = document.getElementById(`${err.field}-error`);
                const inputEl = document.getElementById(err.field);
                if (errorEl && inputEl) {
                    errorEl.textContent = err.message;
                    inputEl.classList.add('is-invalid');
                }
            });
        }

        document.addEventListener('DOMContentLoaded', () => {
            const validationErrorsStr = '<%= typeof validationErrors !== "undefined" ? validationErrors : "" %>';
            const oldInputStr = '<%= typeof oldInput !== "undefined" ? oldInput : "" %>';
            const showModal = '<%= typeof showModalAfterError !== "undefined" ? showModalAfterError : "" %>';
            const formMode = '<%= typeof formMode !== "undefined" ? formMode : "" %>';

            if (validationErrorsStr || showModal) {
                try {
                    const errors = validationErrorsStr ? JSON.parse(validationErrorsStr) : [];
                    const oldInput = oldInputStr ? JSON.parse(oldInputStr) : {};

                    document.getElementById('fullName').value = oldInput.fullName || '';
                    document.getElementById('phoneNumber').value = oldInput.phoneNumber || '';
                    document.getElementById('street').value = oldInput.street || '';
                    document.getElementById('city').value = oldInput.city || '';
                    document.getElementById('state').value = oldInput.state || '';
                    document.getElementById('pincode').value = oldInput.pincode || '';
                    document.getElementById('addressId').value = oldInput.addressId || '';

                    document.getElementById('isDefault').checked = oldInput.isDefault === true || oldInput.isDefault === 'on';

                    if (oldInput.addressType === 'Work') {
                        document.getElementById('typeWork').checked = true;
                    } else {
                        document.getElementById('typeHome').checked = true;
                    }

                    showFieldErrors(errors);

                    if (formMode === 'edit' || showModal === 'edit') {
                        document.getElementById('modalTitle').textContent = 'Edit Address';
                        document.getElementById('addressForm').action = '/profile/address/edit';
                    } else {
                        document.getElementById('modalTitle').textContent = 'Add New Address';
                        document.getElementById('addressForm').action = '/profile/address/add';
                    }

                    addressModal.classList.add('show');
                } catch (e) {
                    console.error('Error parsing validation data:', e);
                }
            }
        });

        window.onclick = function(event) {
            if (event.target === addressModal) {
                closeAddressModal();
            }
        }
    </script>
</body>
</html>