<!-- views/user/address.ejs -->
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ELARA - My Addresses</title>
    <link rel="stylesheet" href="/css/profile.css">
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <style>
        .address-container {
            padding: 20px;
        }
        .address-header {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            margin-bottom: 30px;
        }
        .address-header h1 {
            font-size: 24px;
            color: #4a3b32;
            margin-bottom: 5px;
        }
        .address-header p {
            color: #777;
            font-size: 0.9em;
        }
        .add-btn {
            background-color: #a68b7c;
            color: white;
            border: none;
            padding: 10px 20px;
            border-radius: 5px;
            cursor: pointer;
            font-size: 0.9em;
            display: flex;
            align-items: center;
            gap: 5px;
        }
        .add-btn:hover {
            background-color: #8c7366;
        }
        
        .address-grid {
            display: grid;
            grid-template-columns: 1fr;
            gap: 20px;
        }
        
        .address-card {
            background: white;
            border-radius: 10px;
            padding: 25px;
            position: relative;
            box-shadow: 0 2px 5px rgba(0,0,0,0.05);
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
        }
        
        .address-details h3 {
            font-size: 18px;
            margin-bottom: 15px;
            display: flex;
            align-items: center;
            gap: 10px;
            color: #333;
        }
        
        .default-tag {
            background-color: #e8dcc6;
            color: #8c7366;
            font-size: 0.7em;
            padding: 2px 8px;
            border-radius: 4px;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }
        
        .address-text {
            color: #666;
            line-height: 1.6;
            font-size: 0.95em;
        }
        
        .address-actions {
            display: flex;
            gap: 10px;
        }
        
        .action-icon {
            width: 35px;
            height: 35px;
            display: flex;
            align-items: center;
            justify-content: center;
            background-color: #f5f5f5;
            border-radius: 5px;
            color: #555;
            text-decoration: none;
            transition: background 0.2s;
            border: none;
            cursor: pointer;
        }
        
        .action-icon:hover {
            background-color: #e0e0e0;
            color: #333;
        }

        /* Modal Styles */
        .modal {
            display: none;
            position: fixed;
            inset: 0;
            background: rgba(0,0,0,0.5);
            justify-content: center;
            align-items: center;
            z-index: 1000;
        }
        .modal.show {
            display: flex;
        }
        .modal-content {
            background: white;
            padding: 30px;
            border-radius: 10px;
            width: 500px;
            max-width: 90%;
        }
        .form-row {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 15px;
        }
        .form-group {
            margin-bottom: 15px;
        }
        .form-group label {
            display: block;
            margin-bottom: 5px;
            color: #555;
            font-size: 0.9em;
        }
        .form-group input {
            width: 100%;
            padding: 10px;
            border: 1px solid #ddd;
            border-radius: 5px;
            font-size: 1em;
        }
        .modal-buttons {
            display: flex;
            justify-content: flex-end;
            gap: 10px;
            margin-top: 25px;
        }
        .btn-cancel {
            background: #f5f5f5;
            color: #333;
            border: none;
            padding: 10px 20px;
            border-radius: 5px;
            cursor: pointer;
        }
        .btn-save {
            background-color: #a68b7c;
            color: white;
            border: none;
            padding: 10px 20px;
            border-radius: 5px;
            cursor: pointer;
        }
    </style>
</head>
<body>

    <%- include('../partials/header') %>

    <div class="page-header">
        <h2>Welcome, <%= user.fullName %></h2>
    </div>

    <main class="main-content">
        <div class="content-wrapper">

            <%- include('../partials/profileSidebar', { user: user, path: '/profile/address' }) %>

            <section class="profile-card" style="background-color: #fcf8f5;">
                
                <% if (success && success.length > 0) { %>
                    <div style="background: #d4edda; color: #155724; padding: 12px; margin-bottom: 20px; border-radius: 6px;">
                        <%= success %>
                    </div>
                <% } %>
                <% if (error && error.length > 0) { %>
                    <div style="background: #f8d7da; color: #721c24; padding: 12px; margin-bottom: 20px; border-radius: 6px;">
                        <%= error %>
                    </div>
                <% } %>

                <div class="address-container">
                    <div class="address-header">
                        <div>
                            <h1>My Addresses</h1>
                            <p>Manage your saved shipping and billing addresses for faster checkout.</p>
                        </div>
                        <button onclick="openAddressModal()" class="add-btn">
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <line x1="12" y1="5" x2="12" y2="19"></line>
                                <line x1="5" y1="12" x2="19" y2="12"></line>
                            </svg>
                            Add New Address
                        </button>
                    </div>

                    <div class="address-grid">
                        <% if (user.addresses && user.addresses.length > 0) { %>
                            <% user.addresses.forEach(addr => { %>
                                <div class="address-card">
                                    <div class="address-details">
                                        <div style="margin-bottom: 8px;">
                                            <span style="font-size: 0.75em; padding: 4px 10px; border-radius: 4px; background-color: #f0f0f0; color: #555; text-transform: uppercase; font-weight: 600; margin-right: 8px;">
                                                <%= addr.addressType %>
                                            </span>
                                            <% if (addr.isDefault) { %>
                                                <span class="default-tag">DEFAULT</span>
                                            <% } %>
                                        </div>
                                        <h3 style="margin-bottom: 5px;">
                                            <%= addr.fullName %>
                                            <span style="font-size: 0.9em; color: #666; font-weight: normal; margin-left: 10px;">
                                                <%= addr.phoneNumber %>
                                            </span>
                                        </h3>
                                        <div class="address-text">
                                            <%= addr.street %><br>
                                            <%= addr.city %>, <%= addr.state %> - <strong><%= addr.pincode %></strong>
                                        </div>
                                    </div>

                                    <div class="address-actions">
                                        <button 
                                            onclick='openEditAddressModal(
                                                "<%= addr._id %>",
                                                <%= JSON.stringify(addr.fullName) %>,
                                                <%= JSON.stringify(addr.phoneNumber) %>,
                                                <%= JSON.stringify(addr.street) %>,
                                                <%= JSON.stringify(addr.city) %>,
                                                <%= JSON.stringify(addr.state) %>,
                                                <%= JSON.stringify(addr.pincode) %>,
                                                <%= JSON.stringify(addr.addressType) %>,
                                                <%= addr.isDefault %>
                                            )'
                                            class="action-icon" 
                                            title="Edit">
                                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                                <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path>
                                                <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path>
                                            </svg>
                                        </button>

                                        <a href="/profile/address/delete/<%= addr._id %>" 
                                           class="action-icon delete-address" 
                                           title="Delete"
                                           onclick="return confirm('Are you sure you want to delete this address?')">
                                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                                <polyline points="3 6 5 6 21 6"></polyline>
                                                <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>
                                                <line x1="10" y1="11" x2="10" y2="17"></line>
                                                <line x1="14" y1="11" x2="14" y2="17"></line>
                                            </svg>
                                        </a>

                                        <% if (!addr.isDefault) { %>
                                            <a href="/profile/address/setdefault/<%= addr._id %>" 
                                               class="action-icon" 
                                               title="Set as Default">
                                                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                                    <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
                                                </svg>
                                            </a>
                                        <% } %>
                                    </div>
                                </div>
                            <% }) %>
                        <% } else { %>
                            <div style="text-align: center; padding: 60px 20px; color: #777;">
                                <p>You haven't saved any addresses yet.</p>
                            </div>
                        <% } %>
                    </div>
                </div>
            </section>
        </div>
    </main>

    <!-- ====================== -->
    <!--       MODAL            -->
    <!-- ====================== -->
    <div id="addressModal" class="modal">
        <div class="modal-content">
            <h3 id="modalTitle" style="margin-bottom: 24px; color: #333;">Add New Address</h3>

            <form id="addressForm" action="/profile/address/add" method="POST">
                <input type="hidden" name="addressId" id="addressId">

                <div class="form-row">
                    <div class="form-group">
                        <label>Full Name *</label>
                        <input type="text" name="fullName" id="fullName" required>
                    </div>
                    <div class="form-group">
                        <label>Phone Number</label>
                        <input type="tel" name="phoneNumber" id="phoneNumber" maxlength="10">
                    </div>
                </div>

                <div class="form-group">
                    <label>Address (House No, Street, Landmark) *</label>
                    <input type="text" name="street" id="street" required>
                </div>

                <div class="form-row">
                    <div class="form-group">
                        <label>District / Town *</label>
                        <input type="text" name="city" id="city" required>
                    </div>
                    <div class="form-group">
                        <label>State *</label>
                        <input type="text" name="state" id="state" required>
                    </div>
                </div>

                <div class="form-row">
                    <div class="form-group">
                        <label>Pincode</label>
                        <input type="text" name="pincode" id="pincode" maxlength="6">
                    </div>

                    <div class="form-group">
                        <label>Address Type</label>
                        <div style="display: flex; gap: 24px; margin-top: 8px;">
                            <label style="display: flex; align-items: center; gap: 6px; cursor: pointer;">
                                <input type="radio" name="addressType" value="Home" id="typeHome" checked> Home
                            </label>
                            <label style="display: flex; align-items: center; gap: 6px; cursor: pointer;">
                                <input type="radio" name="addressType" value="Work" id="typeWork"> Work
                            </label>
                        </div>
                    </div>
                </div>

                <div class="form-group" style="margin-top: 16px;">
                    <label style="display: flex; align-items: center; gap: 8px; cursor: pointer; color: #333;">
                        <input type="checkbox" name="isDefault" id="isDefault">
                        Make this my default address
                    </label>
                </div>

                <div class="modal-buttons">
                    <button type="button" onclick="closeAddressModal()" class="btn-cancel">Cancel</button>
                    <button type="submit" class="btn-save">Save Address</button>
                </div>
            </form>
        </div>
    </div>

    <script>
        const addressModal = document.getElementById('addressModal');

        function openAddressModal() {
            document.getElementById('modalTitle').textContent = "Add New Address";
            document.getElementById('addressForm').reset();
            document.getElementById('addressId').value = '';
            addressModal.classList.add('show');
        }

        function openEditAddressModal(id, fullName, phoneNumber, street, city, state, pincode, addressType, isDefault) {
            document.getElementById('modalTitle').textContent = "Edit Address";
            
            document.getElementById('addressId').value = id;
            document.getElementById('fullName').value = fullName;
            document.getElementById('phoneNumber').value = phoneNumber;
            document.getElementById('street').value = street;
            document.getElementById('city').value = city;
            document.getElementById('state').value = state;
            document.getElementById('pincode').value = pincode;

            if (addressType === 'Work') {
                document.getElementById('typeWork').checked = true;
            } else {
                document.getElementById('typeHome').checked = true;
            }

            document.getElementById('isDefault').checked = isDefault;

            addressModal.classList.add('show');
        }

        function closeAddressModal() {
            addressModal.classList.remove('show');
        }

        // Close when clicking outside
        window.onclick = function(event) {
            if (event.target === addressModal) {
                closeAddressModal();
            }
        }
    </script>

</body>
</html>