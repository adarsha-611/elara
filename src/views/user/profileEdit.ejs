<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ELARA - Edit Profile</title>

    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="/css/profile.css">
</head>
<body>
      <%- include('../partials/header') %>


    <div class="page-header">
        <h2>Edit Profile</h2>
    </div>

    <main class="main-content">
        <div class="content-wrapper">
       <%- include('../partials/profileSidebar', { user, path: '/profile' }) %>

            <!-- Main Content: Single Merged Card -->
            <div class="edit-profile-container" style="max-width: 800px; margin: 0 auto; width: 100%;">
                
                <section class="edit-section-card">
                    <!-- Section 1: Personal Details -->
                    <div class="edit-section-header">
                        <h2>Personal Details</h2>
                        <p>Update photo and name</p>
                    </div>

                    <form action="/profile/edit" method="POST" enctype="multipart/form-data" class="profile-form">
                        <!-- Image Section -->
                        <div class="profile-image-section">
                            <div class="avatar-container">
                                <div class="avatar-circle">
                                     <% if (user.profileImage) { %>
                                        <img src="/uploads/profiles/<%= user.profileImage %>" id="previewImg" style="width: 100%; height: 100%; object-fit: cover;">
                                    <% } else { %>
                                        <div class="avatar-icon">
                                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" width="50" height="50" style="color: #666;">
                                                <circle cx="12" cy="8" r="4"/>
                                                <path d="M6 21v-2a4 4 0 0 1 4-4h4a4 4 0 0 1 4 4v2"/>
                                            </svg>
                                        </div>
                                    <% } %>
                                </div>
                                <label class="camera-icon-btn">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="18" height="18">
                                        <path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"/>
                                        <circle cx="12" cy="13" r="4"/>
                                    </svg>
                                    <input type="file" name="profileImage" onchange="previewImage(event)" accept="image/*" style="display: none;">
                                </label>
                            </div>
                            
                            <script>
                                function previewImage(event) {
                                    const reader = new FileReader();
                                    reader.onload = function(){
                                        const output = document.getElementById('previewImg');
                                        if(output) {
                                            output.src = reader.result;
                                        } else {
                                            const container = document.querySelector('.avatar-circle');
                                            container.innerHTML = `<img src="${reader.result}" id="previewImg" style="width: 100%; height: 100%; object-fit: cover;">`;
                                        }
                                    }
                                    reader.readAsDataURL(event.target.files[0]);
                                }
                            </script>
                        </div>

                        <!-- Full Name Input -->
                        <div class="form-group">
                            <label>Full Name</label>
                            <input type="text" name="fullName" value="<%= user.fullName %>" maxlength="10" placeholder="Enter your full name">
                        </div>
                        
                        <div class="action-buttons">
                            <button type="submit" class="btn btn-primary">Save Changes</button>
                            <a href="/profile" class="btn btn-secondary" style="text-align: center;">Cancel</a>
                        </div>
                    </form>

                    <!-- Divider -->
                    <hr class="section-divider" style="margin: 40px 0; border: none; border-top: 1px solid #e0d8d0;">

                    <!-- Section 2: Email Update -->
                    <!-- Section 2: Email Update -->
            <div class="edit-section-header">
                 <h2>Update Email</h2>
                    <p>Securely change your email</p>
            </div>

            <% if (user.authType === "local") { %>
        <form action="/profile/email/update" method="POST" class="profile-form">
            <div class="form-group">
                <label>Current Email</label>
            <input type="email" value="<%= user.email %>" readonly disabled>
            </div>
        <div class="form-group">
        <label>New Email</label>
        <input type="email" name="newEmail" required placeholder="Enter new email address">
        </div>
    <div class="action-buttons">
        <button type="submit" class="btn btn-primary">Send Verification OTP</button>
    </div>
    </form>
    <% } else { %>
    <div class="form-group">
    <label>Email</label>
    <input 
        type="email" 
        value="<%= user.email %>" 
        disabled 
        class="disabled-input"
    >
</div>

<div class="oauth-info-box">
    <div class="oauth-icon">🔒</div>
    <div>
        <p class="oauth-title">Managed by Google</p>
        <p class="oauth-desc">
            Your email and password are managed by your Google account.
            To change them, please update them in Google settings.
        </p>
    </div>
</div>
        <% } %>

                </section>
                
            </div>
        </div>
    </main>
    <%- include('../partials/footer') %>

</body>
</html>
