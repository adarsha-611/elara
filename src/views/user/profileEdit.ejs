<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ELARA - Edit Profile</title>

    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@600&family=Plus+Jakarta+Sans:wght@300;400;500;600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.5.13/cropper.min.css">
    <script src="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.5.13/cropper.min.js"></script>
    <script>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            'elara-brown': '#7A5C4D',
            'elara-dark': '#3D2B24',
            'elara-ivory': '#FDFBF9',
            'elara-beige': '#F4F1EE'
          },
          fontFamily: {
            'display': ['Cormorant Garamond', 'serif'],
            'sans': ['Plus Jakarta Sans', 'sans-serif']
          }
        }
      }
    }
    </script>
</head>
<body class="bg-elara-beige font-sans text-gray-900"> <%- include('../partials/header') %>

    <main class="max-w-6xl mx-auto px-6 py-16">
        <div class="flex flex-col md:flex-row gap-10 items-start">
            
  <div style="width: 288px; min-width: 288px; flex-shrink: 0;">
                    <%- include('../partials/profileSidebar', { user, path: '/profile' }) %>
            </div>

            <section class="flex-1 bg-elara-ivory rounded-3xl shadow-[0_20px_60px_rgba(61,43,36,0.05)] border border-white overflow-hidden">
                
                <div class="p-10 pb-0">
                    <span class="text-[9px] uppercase tracking-[0.4em] text-elara-brown font-bold mb-2 block">Settings</span>
                    <h1 class="text-3xl font-display italic tracking-wide text-elara-dark">Edit Profile</h1>
                </div>

               <div class="p-10 md:p-14">

    <%# Show error/success flash messages %>
    <% if (locals.error && error.length > 0) { %>
        <div class="bg-red-50 border border-red-200 text-red-600 px-4 py-3 rounded-xl mb-6 text-sm text-center">
            <%= error %>
        </div>
    <% } %>

    <% if (locals.success && success.length > 0) { %>
        <div class="bg-green-50 border border-green-200 text-green-600 px-4 py-3 rounded-xl mb-6 text-sm text-center">
            <%= success %>
        </div>
    <% } %>

    <form action="/profile/edit" method="POST" enctype="multipart/form-data">
                        <div class="flex flex-col sm:flex-row items-center gap-10 mb-12">
                            <div class="relative">
                                <div class="w-28 h-28 rounded-full border-4 border-white shadow-md overflow-hidden bg-elara-beige flex items-center justify-center">
                                    <% if (user.profileImage) { %>
<img src="<%= user.profileImage && user.profileImage.startsWith('http') ? user.profileImage : '/uploads/profiles/' + user.profileImage %>" id="previewImg" class="w-full h-full object-cover">                                    <% } else { %>
                                        <div id="avatarPlaceholder" class="text-elara-brown opacity-30">
                                            <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
                                        </div>
                                    <% } %>
                                </div>
                                <label class="absolute bottom-1 right-1 bg-elara-brown text-white p-2.5 rounded-full cursor-pointer shadow-lg hover:bg-elara-dark transition-all scale-90">
                                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M23 19a2 2 0 0 1-2-2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"/><circle cx="12" cy="13" r="4"/></svg>
                                    <input type="file" name="profileImage" onchange="previewImage(event)" accept="image/*" class="hidden">
                                </label>
                            </div>

                            <div class="flex-1 w-full">
                                <label class="text-[10px] uppercase tracking-[0.25em] text-elara-brown font-bold mb-3 block">Full Name</label>
                                <input type="text" name="fullName" value="<%= user.fullName %>" maxlength="15" 
                                    class="w-full bg-white/50 border border-elara-beige rounded-xl px-5 py-3.5 text-elara-dark font-medium focus:border-elara-brown focus:bg-white outline-none transition-all shadow-sm"
                                    placeholder="Enter your name">
                            </div>
                        </div>

                        <div class="flex justify-end gap-5 pb-12 border-b border-elara-beige/50">
                            <a href="/profile" class="px-8 py-3 text-[10px] font-bold uppercase tracking-widest text-gray-400 hover:text-elara-dark transition-colors">Cancel</a>
                            <button type="submit" class="px-10 py-3.5 bg-elara-dark text-white rounded-xl text-[10px] font-bold uppercase tracking-[0.25em] hover:bg-elara-brown transition-all shadow-xl active:scale-95">Update Profile</button>
                        </div>
                    </form>

                    <div class="mt-14">
                        <div class="mb-8">
                            <h2 class="text-xl font-display italic text-elara-dark">Email Configuration</h2>
                            <p class="text-[9px] uppercase tracking-widest text-elara-brown mt-1 font-bold">Account Security</p>
                        </div>

                        <% if (user.authType === "local") { %>
                            <form action="/profile/email/update" method="POST" class="space-y-6 max-w-md">
                                <div>
                                    <label class="text-[10px] uppercase tracking-[0.2em] text-gray-400 font-bold mb-2 block">Current Address</label>
                                    <input type="email" value="<%= user.email %>" readonly disabled class="w-full text-sm font-medium text-gray-400 border border-transparent py-3 px-5 bg-elara-beige/30 rounded-xl cursor-not-allowed">
                                </div>
                                <div>
                                    <label class="text-[10px] uppercase tracking-[0.2em] text-elara-brown font-bold mb-2 block">New Destination Email</label>
                                    <input type="email" name="newEmail" required class="w-full text-sm font-medium text-elara-dark border border-elara-beige bg-white rounded-xl py-3 px-5 focus:border-elara-brown outline-none transition-all shadow-sm" placeholder="Enter new email address">
                                </div>
                                <button type="submit" class="px-8 py-3.5 border-2 border-elara-dark text-elara-dark rounded-xl text-[10px] font-bold uppercase tracking-[0.2em] hover:bg-elara-dark hover:text-white transition-all shadow-sm">Verify New Email</button>
                            </form>
                        <% } else { %>
                            <div class="p-8 rounded-2xl bg-white border border-elara-beige flex gap-6 items-start shadow-sm">
                                <div class="w-10 h-10 rounded-full bg-elara-beige flex items-center justify-center shrink-0">
                                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#7A5C4D" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg>
                                </div>
                                <div>
                                    <p class="text-xs font-bold uppercase tracking-widest text-elara-dark">Google Authenticated</p>
                                    <p class="text-sm text-gray-500 leading-relaxed mt-2 italic">
                                        Your security is managed via Google. Please visit your Google Account to modify your login credentials.
                                    </p>
                                </div>
                            </div>
                        <% } %>
                    </div>
                </div>

                <div class="bg-elara-dark/5 p-6 border-t border-elara-beige/30 text-center">
                    <div class="flex justify-center gap-1.5">
                        <div class="w-1 h-1 rounded-full bg-elara-brown opacity-30"></div>
                        <div class="w-1 h-1 rounded-full bg-elara-brown opacity-30"></div>
                        <div class="w-1 h-1 rounded-full bg-elara-brown opacity-30"></div>
                    </div>
                </div>
            </section>
        </div>
    </main>
    <!-- Crop Modal -->
<div id="cropModal" style="display:none; position:fixed; inset:0; z-index:1000;
     background:rgba(61,43,36,0.7); backdrop-filter:blur(4px);
     align-items:center; justify-content:center;">
    <div style="background:#FDFBF9; border-radius:20px; padding:30px;
                width:90%; max-width:420px; box-shadow:0 25px 60px rgba(0,0,0,0.2);">
        <p style="font-family:'Cormorant Garamond',serif; font-size:1.4rem;
                  color:#3D2B24; margin-bottom:16px; font-style:italic;">Crop Photo</p>

        <div style="width:100%; height:320px; overflow:hidden; border-radius:12px;
                    background:#F4F1EE; border:1px solid #e5e0d8;">
            <img id="cropImage" style="max-width:100%; display:block;">
        </div>

        <div style="display:flex; gap:12px; margin-top:20px;">
            <button onclick="closeCropModal()"
                style="flex:1; padding:12px; border:2px solid #3D2B24; color:#3D2B24;
                       border-radius:10px; font-size:0.75rem; font-weight:700;
                       text-transform:uppercase; letter-spacing:0.15em; cursor:pointer;
                       background:transparent; transition:0.2s;"
                onmouseover="this.style.background='#F4F1EE'"
                onmouseout="this.style.background='transparent'">
                Cancel
            </button>
            <button onclick="applyCrop()"
                style="flex:1; padding:12px; background:#3D2B24; color:white;
                       border:none; border-radius:10px; font-size:0.75rem; font-weight:700;
                       text-transform:uppercase; letter-spacing:0.15em; cursor:pointer;
                       transition:0.2s;"
                onmouseover="this.style.background='#7A5C4D'"
                onmouseout="this.style.background='#3D2B24'">
                Apply Crop
            </button>
        </div>
    </div>
</div>

<!-- Hidden input to hold cropped image data -->
<input type="hidden" name="croppedImage" id="croppedImageData">

    <%- include('../partials/footer') %>

   <script>
    let cropper = null;

    // Called when user picks a file
    function previewImage(event) {
        const file = event.target.files[0];
        if (!file) return;

        const reader = new FileReader();
        reader.onload = function (e) {
            const cropImage = document.getElementById('cropImage');
            cropImage.src = e.target.result;

            // Show modal
            const modal = document.getElementById('cropModal');
            modal.style.display = 'flex';

            // Destroy previous cropper if any
            if (cropper) cropper.destroy();

            // Init cropper — square aspect ratio for profile pic
            cropper = new Cropper(cropImage, {
                aspectRatio: 1,
                viewMode: 1,
                autoCropArea: 0.8,
                movable: true,
                zoomable: true,
                scalable: false,
                cropBoxResizable: true,
            });
        };
        reader.readAsDataURL(file);
    }

    function closeCropModal() {
        document.getElementById('cropModal').style.display = 'none';
        if (cropper) { cropper.destroy(); cropper = null; }
        // Clear file input so user can re-pick
        document.querySelector('input[name="profileImage"]').value = '';
    }

    function applyCrop() {
        if (!cropper) return;

        // Get cropped canvas and convert to base64
        const canvas = cropper.getCroppedCanvas({ width: 300, height: 300 });
        const croppedDataUrl = canvas.toDataURL('image/jpeg', 0.85);

        // Put cropped image in hidden field (sent to server)
        document.getElementById('croppedImageData').value = croppedDataUrl;

        const preview = document.getElementById('previewImg');
        const placeholder = document.getElementById('avatarPlaceholder');
        if (preview) {
            preview.src = croppedDataUrl;
        } else if (placeholder) {
            const container = placeholder.parentElement;
            container.innerHTML = `<img src="${croppedDataUrl}" id="previewImg" class="w-full h-full object-cover">`;
        }

        // Close modal
        document.getElementById('cropModal').style.display = 'none';
        if (cropper) { cropper.destroy(); cropper = null; }
    }
</script>
</body>
</html>