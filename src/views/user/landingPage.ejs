<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ELARA - Luxury Jewelry</title>
    <link rel="stylesheet" href="/css/landingPage.css">
</head>
<body>
    <!-- Navigation Bar -->
    <header class="navbar">
        <div class="nav-container">
            <div class="logo">ELARA</div>
            <nav class="nav-links">
                <a href="#home">HOME</a>
                <a href="#shop">SHOP</a>
                <a href="#about">ABOUT US</a>
                <a href="#contact">CONTACT</a>
            </nav>
            <div class="nav-buttons">
                <a href="/login" class="login-btn">Login</a>
                <a href="/signup" class="signup-btn">Signup</a>
            </div>
        </div>
    </header>

    <!-- Hero Section -->
    <section class="hero">
        <div class="hero-container">
            <div class="hero-image">
                <img src="/Images/Main.jfif" alt="Model wearing jewelry">
            </div>
            <div class="hero-text">
                <h1>WELCOME, ELARA</h1>
                <p>Where every piece is crafted to<br>illuminate your inner shine.</p>
            </div>
        </div>
    </section>

    <!-- Featured Images Section -->
    <section class="featured-images">
        <div class="featured-container">
            <div class="featured-item">
                <img src="/Images/model3.jpg" alt="Earring detail">
            </div>
            <div class="featured-item">
                <img src="/Images/model5.jfif" alt="Earring detail">
            </div>
            <div class="featured-item">
                <img src="/Images/model1.jpeg" alt="Earring detail">
            </div>
            <div class="featured-item">
                <img src="/Images/model6.jpg" alt="Earring detail">
            </div>
        </div>
    </section>

    <!-- Product Cards Section -->
    <section class="products">
        <div class="products-container">
            <div class="product-card">
                <div class="product-image">
                    <img src="/Images/landingpg-1.jpg" alt="Gold Stud Earrings">
                </div>
                <h3>Gold Stud Earrings</h3>
                <p class="price">₹1,299.00</p>
            </div>
            <div class="product-card">
                <div class="product-image">
                    <img src="/Images/landingpg-2.jfif" alt="Blossom Ear Hugs">
                </div>
                <h3>Blossom Ear Hugs</h3>
                <p class="price">₹1,599.00</p>
            </div>
            <div class="product-card">
                <div class="product-image">
                    <img src="/Images/landingpg-3.jpeg" alt="Rose Gold Stud Ring">
                </div>
                <h3>Rose Gold Stud Ring</h3>
                <p class="price">₹2,499.00</p>
            </div>
            <div class="product-card">
                <div class="product-image">
                    <img src="/Images/landingpg-4.jpeg" alt="Heaven Forever Ring">
                </div>
                <h3>Heaven Forever Ring</h3>
                <p class="price">₹1,899.00</p>
            </div>
            <div class="product-card">
                <div class="product-image">
                    <img src="/Images/landingpg-5.jpg" alt="Evolution Crown Ring">
                </div>
                <h3>Evolution Crown Ring</h3>
                <p class="price">₹2,199.00</p>
            </div>
        </div>
    </section>

    <!-- Highlight Section -->
    <section class="highlight">
        <div class="highlight-container">
            <div class="highlight-image">
                <img src="/Images/model4.jpeg" alt="Model in sunlight">
            </div>
            <div class="highlight-text">
                <p>Shine bright, embrace your glow.<br>Every jewel tells a story of you.</p>
            </div>
        </div>
    </section>

    <!-- Footer -->
    <footer class="footer">
        <div class="footer-container">
            <div class="footer-column">
                <h4>Exclusive</h4>
                <p>Subscribe</p>
                <p class="small-text">Get 10% off on your first order</p>
                <div class="subscribe-box">
                    <input type="email" placeholder="Enter your email">
                    <button>→</button>
                </div>
            </div>
            <div class="footer-column">
                <h4>Support</h4>
                <p>No 1, 2nd Floor,<br>Chennai Street, Tamil Nadu</p>
                <p>hishaaa@gmail.com</p>
                <p>+91 88 251 4582</p>
            </div>
            <div class="footer-column">
                <h4>Account</h4>
                <a href="#">My Account</a>
                <a href="#">Login / Register</a>
                <a href="#">Cart</a>
                <a href="#">Wishlist</a>
                <a href="#">Shop</a>
            </div>
            <div class="footer-column">
                <h4>Quick Link</h4>
                <a href="#">Privacy Policy</a>
                <a href="#">Terms Of Use</a>
                <a href="#">FAQ</a>
                <a href="#">Contact</a>
            </div>
            <div class="footer-column download">
                <h4>Download App</h4>
                <p class="small-text">Save $3 with App New User Only</p>
                <div class="app-download">
                    <div class="qr-code">
                        <div class="qr-placeholder"></div>
                    </div>
                    <div class="app-badges">
                        <div class="badge">Google Play</div>
                        <div class="badge">App Store</div>
                    </div>
                </div>
                <div class="social-icons">
                    <a href="#">f</a>
                    <a href="#">t</a>
                    <a href="#">in</a>
                    <a href="#">in</a>
                </div>
            </div>
        </div>
    </footer>
</body>
</html>