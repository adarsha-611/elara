<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
  <title>ElARA-Home</title>
  <!-- Tailwind CSS CDN + Google Fonts -->
  <script src="https://cdn.tailwindcss.com"></script>
  <!-- Custom Tailwind Configuration Override -->
  <script>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            gold: '#C5A47E',
            'soft-beige': '#F5F0EB',
            'luxury-black': '#111111',
          },
          fontFamily: {
            serif: ['Playfair Display', 'Georgia', 'serif'],
            sans: ['Inter', 'system-ui', 'sans-serif'],
          },
          animation: {
            'fade-in-up': 'fadeInUp 0.8s ease-out forwards',
            'shimmer': 'shimmer 3s infinite',
          },
          keyframes: {
            fadeInUp: {
              '0%': { opacity: '0', transform: 'translateY(30px)' },
              '100%': { opacity: '1', transform: 'translateY(0)' },
            },
            shimmer: {
              '0%': { backgroundPosition: '-200% 0' },
              '100%': { backgroundPosition: '200% 0' },
            },
          },
        },
      },
    }
  </script>
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;500;600;700;800;900&family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  <style>

    html {
      scroll-behavior: smooth;
    }
    body {
      background-color: #FFFFFF;
    }
    .hover-glow:hover {
      box-shadow: 0 0 20px rgba(197, 164, 126, 0.6);
      transition: box-shadow 0.4s ease;
    }
    .gold-shimmer {
      background: linear-gradient(120deg, #C5A47E, #E4D5C0, #C5A47E);
      background-size: 200% auto;
      -webkit-background-clip: text;
      background-clip: text;
      color: transparent;
      animation: shimmer 4s linear infinite;
    }
    @keyframes shimmer {
      0% { background-position: -200% 0; }
      100% { background-position: 200% 0; }
    }
    .card-hover {
      transition: transform 0.4s cubic-bezier(0.2, 0.9, 0.4, 1.1), box-shadow 0.4s ease;
    }
    .card-hover:hover {
      transform: translateY(-8px);
      box-shadow: 0 25px 35px -12px rgba(0, 0, 0, 0.15);
    }
    .img-zoom-container {
      overflow: hidden;
      border-radius: 1rem;
    }
    .img-zoom {
      transition: transform 0.5s cubic-bezier(0.2, 0.9, 0.4, 1.1);
      will-change: transform;
    }
    .group:hover .img-zoom {
      transform: scale(1.12);
    }
    .portrait-video-container {
      transition: all 0.5s cubic-bezier(0.2, 0.9, 0.4, 1.1);
      overflow: hidden;
      border-radius: 2rem;
      width: 100%;
      max-width: 520px;
      margin: 0 auto;
    }
    .portrait-video-container:hover {
      transform: scale(1.03);
      box-shadow: 0 30px 50px -20px rgba(0,0,0,0.4);
    }
    .portrait-video {
      aspect-ratio: 9 / 16;
      width: 100%;
      height: auto;
      object-fit: cover;
      transition: transform 0.7s ease;
      min-height: 500px;
    }
    .portrait-video-container:hover .portrait-video {
      transform: scale(1.02);
    }
    .fade-scroll {
      opacity: 0;
      transform: translateY(30px);
      transition: opacity 0.9s ease, transform 0.9s ease;
    }
    .fade-scroll.visible {
      opacity: 1;
      transform: translateY(0);
    }
    /* Parallax effect */
    .parallax-bg {
      background-attachment: fixed;
      background-position: center;
      background-repeat: no-repeat;
      background-size: cover;
    }
    @media (max-width: 768px) {
      .parallax-bg {
        background-attachment: scroll;
      }
      .portrait-video {
        min-height: 400px;
      }
    }
    /* Underline animation */
    .nav-link {
      position: relative;
      padding-bottom: 4px;
    }
    .nav-link::after {
      content: '';
      position: absolute;
      width: 0;
      height: 1px;
      bottom: 0;
      left: 0;
      background-color: #C5A47E;
      transition: width 0.3s ease;
    }
    .nav-link:hover::after {
      width: 100%;
    }
    .section-title {
      position: relative;
      display: inline-block;
    }
    .section-title:after {
      content: '';
      position: absolute;
      bottom: -12px;
      left: 50%;
      transform: translateX(-50%);
      width: 60px;
      height: 2px;
      background: #C5A47E;
    }

  </style>
</head>
<body class="font-sans antialiased">

  
   <%- include('../partials/header') %>
  <!-- ==================== HERO SECTION with Portrait Video ==================== -->
  <section class="relative h-screen w-full overflow-hidden">
    <!-- Video Background -->
    <div class="absolute inset-0 w-full h-full">
      <video autoplay muted loop playsinline class="absolute min-w-full min-h-full object-cover">
        <source src="/Images/9430543-uhd_4096_2160_25fps.mp4" type="video/mp4">
      </video>
      <div class="absolute inset-0 bg-black/20"></div>
    </div>
    
    <!-- Centered Hero Text -->
    <div class="relative h-full flex flex-col justify-center items-center text-center px-6 z-10 animate-fade-in-up">
      <h1 class="text-white font-serif text-5xl md:text-7xl lg:text-8xl font-bold tracking-wide drop-shadow-lg">
        Timeless <span class="gold-shimmer">Elegance</span>
      </h1>
      <p class="text-white/90 text-lg md:text-2xl mt-6 tracking-wider font-light max-w-2xl">Luxury Earrings Collection</p>
      <a href="/shop" 
   class="mt-10 inline-block px-10 py-4 bg-white/10 backdrop-blur-sm border border-white/40 text-white font-medium text-lg tracking-wide rounded-full hover:bg-gold hover:border-gold hover:text-black transition-all duration-500 hover-glow">
  Shop Now →
</a>
    </div>
    
    <!-- Scroll Down Indicator -->
    <div class="absolute bottom-8 left-1/2 transform -translate-x-1/2 animate-bounce">
      <div class="w-6 h-10 border-2 border-white/60 rounded-full flex justify-center"><div class="w-1 h-2 bg-white/80 rounded-full mt-2"></div></div>
    </div>
  </section>

  <!-- ==================== VIDEO SECTION: LARGER Portrait Video ==================== -->
  <section class="py-24 bg-soft-beige">
    <div class="container mx-auto px-6 md:px-12 flex flex-col lg:flex-row items-center gap-16">
      <div class="flex-1 text-center lg:text-left fade-scroll">
        <span class="text-gold uppercase tracking-[0.3em] text-sm font-semibold">Artistry in Motion</span>
        <h2 class="font-serif text-4xl md:text-5xl mt-4 text-luxury-black">Crafted to Perfection</h2>
        <p class="text-gray-600 mt-6 leading-relaxed max-w-md">Each piece is meticulously handcrafted, celebrating the harmony between modern design and timeless heritage.</p>
        <button class="mt-8 border-b-2 border-gold pb-1 text-luxury-black font-medium hover:text-gold transition">Discover the process →</button>
      </div>
      <div class="flex-[1.2] flex justify-center fade-scroll">
        <!-- LARGER container with hover zoom effect - Increased size significantly -->
        <div class="portrait-video-container shadow-2xl rounded-3xl cursor-pointer">
          <img src="/Images/Be Bold in the Parker Capsule Collection ✨.jfif" alt="">
        </div>
      </div>
    </div>
  </section>

  <!-- ==================== NEW ARRIVALS SECTION ==================== -->
  <section class="py-24 bg-white">
    <div class="container mx-auto px-6 md:px-12">
      <div class="text-center mb-16 fade-scroll">
        <h2 class="font-serif text-4xl md:text-5xl text-luxury-black section-title pb-4">New Arrivals</h2>
        <p class="text-gray-500 max-w-md mx-auto mt-8">Be the first to wear our latest masterpieces</p>
      </div>
      
      <!-- New Arrivals Grid -->
<div class="grid md:grid-cols-4 gap-10">
  <% newArrivals.forEach(product => { %>
    <div class="group relative card-hover fade-scroll">
      <div class="img-zoom-container relative rounded-2xl overflow-hidden bg-soft-beige">
        <img 
          src="<%= product.variants[0]?.images[0] %>" 
          alt="<%= product.name %>" 
          class="img-zoom w-full h-80 object-cover transition duration-500" 
          loading="lazy"
        >
        <div class="absolute top-4 left-4 bg-gold text-black text-xs font-semibold px-3 py-1 rounded-full">
          Just In
        </div>
        <div class="absolute inset-0 bg-black/40 opacity-0 group-hover:opacity-100 transition-all duration-300 flex items-center justify-center gap-6">
          <a href="/productDetail/<%= product._id %>" class="bg-white text-black px-5 py-2 rounded-full text-sm font-medium hover:bg-gold hover:text-white transition transform hover:scale-105">
            Quick View
          </a>
        </div>
      </div>
      <div class="mt-5 text-center">
        <h3 class="font-serif text-lg font-semibold text-luxury-black"><%= product.name %></h3>
        <p class="text-gold font-medium tracking-wide mt-1">
          ₹<%= product.variants[0]?.price?.toLocaleString() %>
        </p>
      </div>
    </div>
  <% }) %>
</div>
    </div>
  </section>

  <!-- ==================== TRENDING COLLECTIONS SECTION ==================== -->
  <section class="py-24 bg-soft-beige">
    <div class="container mx-auto px-6 md:px-12">
      <div class="text-center mb-16 fade-scroll">
        <h2 class="font-serif text-4xl md:text-5xl text-luxury-black section-title pb-4">Trending Collections</h2>
        <p class="text-gray-500 max-w-md mx-auto mt-8">Our most coveted pieces loved by thousands</p>
      </div>
<div class="grid md:grid-cols-4 gap-10">
  <% trendingProducts.forEach(product => { %>

    <div class="group relative card-hover fade-scroll">
      
      <!-- IMAGE -->
      <div class="img-zoom-container relative rounded-2xl overflow-hidden bg-soft-beige">
        <img 
          src="<%= product.variants[0]?.images[0] || '/images/default.png' %>" 
          alt="<%= product.name %>" 
          class="img-zoom w-full h-80 object-cover transition duration-500"
        >

        <div class="absolute top-4 left-4 bg-gold text-black text-xs font-semibold px-3 py-1 rounded-full">
          Trending
        </div>

        <div class="absolute inset-0 bg-black/40 opacity-0 group-hover:opacity-100 transition flex items-center justify-center">
          <a href="/productDetail/<%= product._id %>" class="bg-white px-5 py-2 rounded-full text-sm">
            Quick View
          </a>
        </div>
      </div>

      <!-- TEXT -->
      <div class="mt-5 text-center">
        <h3 class="font-serif text-lg font-semibold text-luxury-black">
          <%= product.name %>
        </h3>
        <p class="text-gold mt-1">
          ₹<%= product.variants[0]?.price?.toLocaleString() || '0' %>
        </p>
      </div>

    </div>

  <% }) %>
</div>     
      <div class="text-center mt-16">
        <a href="/shop" class="px-10 py-3 border border-gold text-gold rounded-full hover:bg-gold hover:text-white transition-all duration-300 font-medium">Explore All Trends →</a>
      </div>
    </div>
  </section>

  <!-- ==================== FEATURED COLLECTION BANNER ==================== -->
  <section class="relative py-28 bg-luxury-black text-white overflow-hidden parallax-bg" style="background-image: url('https://images.unsplash.com/photo-1611085583191-a3b181a88401?q=80&w=2070&auto=format'); background-blend-mode: overlay; background-color: #111;">
    <div class="absolute inset-0 bg-black/50"></div>
    <div class="relative container mx-auto px-6 text-center fade-scroll">
      <span class="text-gold text-sm tracking-[0.2em] uppercase">Limited Edition</span>
      <h2 class="font-serif text-5xl md:text-7xl mt-4">La Collection Royale</h2>
      <p class="max-w-xl mx-auto mt-6 text-white/80">Exquisite diamonds set in 18k gold. A tribute to timeless elegance.</p>
      <button class="mt-10 inline-block bg-gold text-black px-8 py-3 rounded-full font-medium hover:bg-white hover:text-black transition-all duration-300">Discover Now</button>
    </div>
  </section>

  <!-- ==================== CUSTOMER TESTIMONIALS ==================== -->
  <section class="py-24 bg-white">
    <div class="container mx-auto px-6 md:px-12 text-center">
      <div class="fade-scroll">
        <h2 class="font-serif text-4xl text-luxury-black">Whispers of Elegance</h2>
        <div class="w-16 h-px bg-gold mx-auto my-6"></div>
      </div>
      <div class="grid md:grid-cols-3 gap-10 mt-12">
        <div class="p-8 rounded-2xl bg-soft-beige fade-scroll text-center shadow-sm hover:shadow-md transition">
          <p class="text-gray-700 italic">“The craftsmanship is unparalleled. Every detail shines, feels like wearing art.”</p>
          <div class="mt-6 text-gold font-semibold">— Victoria H.</div>
        </div>
        <div class="p-8 rounded-2xl bg-soft-beige fade-scroll text-center shadow-sm hover:shadow-md transition">
          <p class="text-gray-700 italic">“Lumière earrings are my go-to for every gala. Absolutely stunning quality.”</p>
          <div class="mt-6 text-gold font-semibold">— Alistair W.</div>
        </div>
        <div class="p-8 rounded-2xl bg-soft-beige fade-scroll text-center shadow-sm hover:shadow-md transition">
          <p class="text-gray-700 italic">“Minimal yet luxurious. Perfect for the modern woman who desires elegance.”</p>
          <div class="mt-6 text-gold font-semibold">— Catherine D.</div>
        </div>
      </div>
    </div>
  </section>

 

  <%- include('../partials/footer') %>
  <!-- ==================== JAVASCRIPT ==================== -->
  <script>
    (function() {
      const header = document.getElementById('mainHeader');
      const logo = document.getElementById('logo');
      window.addEventListener('scroll', () => {
        if (window.scrollY > 50) {
          header.classList.add('bg-white', 'shadow-md');
          header.classList.remove('bg-transparent');
          if(logo) logo.classList.add('text-luxury-black');
          if(logo) logo.classList.remove('text-white');
          document.querySelectorAll('nav a, header button').forEach(el => {
            if(window.scrollY > 50) {
              el.classList.add('text-luxury-black');
              el.classList.remove('text-white');
            } else {
              el.classList.remove('text-luxury-black');
              el.classList.add('text-white');
            }
          });
        } else {
          header.classList.remove('bg-white', 'shadow-md');
          header.classList.add('bg-transparent');
          if(logo) logo.classList.add('text-white');
          if(logo) logo.classList.remove('text-luxury-black');
          document.querySelectorAll('nav a, header button').forEach(el => {
            if(window.scrollY <= 50) {
              el.classList.remove('text-luxury-black');
              el.classList.add('text-white');
            }
          });
        }
      });
      
      const fadeElements = document.querySelectorAll('.fade-scroll');
      const observer = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            entry.target.classList.add('visible');
            observer.unobserve(entry.target);
          }
        });
      }, { threshold: 0.2, rootMargin: "0px 0px -30px 0px" });
      
      fadeElements.forEach(el => observer.observe(el));
      
      document.querySelectorAll('a[href^="#"]').forEach(anchor => {
        anchor.addEventListener('click', function(e) {
          const href = this.getAttribute('href');
          if(href !== "#" && href !== "") {
            const target = document.querySelector(href);
            if(target) {
              e.preventDefault();
              target.scrollIntoView({ behavior: 'smooth' });
            }
          }
        });
      });
    })();
  </script>
</body>
</html>