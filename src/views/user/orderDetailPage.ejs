<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Order Details | ELARA Luxury Jewelry</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="/css/profile.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,600;1,400&family=Lato:wght@300;400;700&display=swap" rel="stylesheet">
    
    <style>
        :root {
            --primary-taupe: #7A5C4D; 
            --dark-brown: #3D2B24;    
            --bg-cream: #F4F1EE;      
            --elara-ivory: #FDFBF9;
            --white: #ffffff;
            --border-color: #e0dcd0;
        }

        body {
            font-family: 'Lato', sans-serif; /* Back to Lato */
            background-color: var(--bg-cream);
            color: #333;
        }

        .account-container {
            display: flex;
            max-width: 1200px;
            margin: 40px auto;
            padding: 0 20px;
            gap: 40px;
        }

        .details-content { flex: 1; }

        .card {
            background: var(--elara-ivory);
            padding: 30px;
            border-radius: 12px;
            border: 1px solid var(--border-color);
            margin-bottom: 25px;
            box-shadow: 0 2px 8px rgba(0,0,0,0.04);
        }

        .card h3 {
            font-family: 'Playfair Display', serif; /* Back to Playfair */
            font-size: 1.2rem;
            margin-bottom: 25px;
            color: var(--dark-brown);
            font-weight: 600;
        }

        /* Order Tracker */
        .order-tracker {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            margin: 20px 0 15px;
            position: relative;
        }

        .tracker-step {
            display: flex;
            flex-direction: column;
            align-items: center;
            flex: 1;
            position: relative;
            z-index: 1;
        }

        .tracker-step::after {
            content: '';
            position: absolute;
            top: 15px;
            left: 50%;
            width: 100%;
            height: 2px;
            background: #eee;
            z-index: -1;
        }

        .tracker-step:last-child::after { display: none; }

        .step-circle {
            width: 34px;
            height: 34px;
            background: white;
            border: 2px solid #eee;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 12px;
            color: #ccc;
            transition: 0.3s;
            margin-bottom: 10px;
        }

        .tracker-step.active .step-circle {
            background: var(--dark-brown); 
            border-color: var(--dark-brown);
            color: white;
        }

        .tracker-step.active::after { background: var(--dark-brown); } 

        .step-label {
            font-size: 0.7rem;
            font-weight: 700;
            color: #bbb;
            text-align: center;
            letter-spacing: 0.5px;
        }

        .tracker-step.active .step-label { color: var(--dark-brown); }

        /* Order Items */
        .order-item {
            display: flex;
            align-items: center;
            gap: 15px;
            padding: 20px;
            background: white;
            border: 1px solid #f0f0f0;
            border-radius: 10px;
            margin-bottom: 15px;
            position: relative;
            justify-content: space-between;
        }

        .order-item img {
            width: 75px;
            height: 75px;
            object-fit: cover;
            border-radius: 8px;
            background: #fdfdfd;
        }

        .item-details { flex: 1; }
        .item-name { display: block; font-weight: 700; font-size: 1rem; color: #1a1a1a; margin-bottom: 4px; }
        .item-info-text { font-size: 0.9rem; color: #666; margin-bottom: 10px; }

        .status-badge { display: inline-block; padding: 4px 14px; border-radius: 20px; font-size: 0.8rem; font-weight: 600; }
        .badge-pending { background: #eef2ff; color: #3730a3; }
        .badge-shipped { background: #e0f2fe; color: #0369a1; }
        .badge-out { background: #fff7ed; color: #c2410c; }
        .badge-delivered { background: #e8f5e9; color: #2e7d32; }
        .badge-cancelled { background: #fee2e2; color: #d32f2f; }

        .btn-cancel-item, .btn-return-item {
            border: 1px solid #ff4d4d;
            color: #ff4d4d;
            background: transparent;
            padding: 7px 15px;
            border-radius: 6px;
            font-size: 0.75rem;
            font-weight: 700;
            text-transform: uppercase;
            cursor: pointer;
            transition: 0.2s;
             position: static;
            right: 20px;
        }

        .btn-return-item {
            border-color: var(--primary-taupe);
            color: var(--primary-taupe);
        }

        .btn-cancel-item:hover { background: #fff5f5; }
        .btn-return-item:hover { background: var(--primary-taupe); color: white; }

        .btn-action { padding: 14px 30px; border-radius: 8px; font-weight: 600; text-align: center; cursor: pointer; transition: 0.3s; }
        .btn-primary { background: var(--primary-taupe); color: white; border: none; }
        .btn-primary:hover { background: var(--dark-brown); }
        .btn-secondary { background: #f0f0f0; color: #555; border: none; }

        /* MODAL UI STYLING */
        .modal {
            display: none;
            position: fixed;
            z-index: 1000;
            left: 0;
            top: 0;
            width: 100%;
            height: 100%;
            background-color: rgba(61, 43, 36, 0.7); 
            align-items: center;
            justify-content: center;
            backdrop-filter: blur(2px);
        }

        .modal-content {
            background-color: var(--white);
            padding: 0;
            border-radius: 15px;
            width: 90%;
            max-width: 480px;
            position: relative;
            border: 1px solid var(--border-color);
            box-shadow: 0 15px 40px rgba(0,0,0,0.15);
            overflow: hidden;
        }

        .modal-header {
            padding: 30px 30px 15px;
            border-bottom: 1px solid var(--bg-cream);
        }

        .modal-header h2 {
            font-family: 'Playfair Display', serif;
            font-size: 1.5rem;
            color: var(--dark-brown);
            margin: 0;
        }

        .modal-body { padding: 25px 30px 35px; }

        .modal-close-btn {
            position: absolute;
            top: 18px;
            right: 20px;
            font-size: 1.2rem;
            color: #999;
            cursor: pointer;
            transition: 0.2s;
        }

        .modal-close-btn:hover { color: var(--dark-brown); }

        .return-select {
            width: 100%;
            padding: 12px;
            border: 1px solid var(--border-color);
            border-radius: 8px;
            background-color: var(--bg-cream);
            font-size: 0.9rem;
            outline: none;
            transition: 0.3s;
            margin-top: 10px;
        }

        .return-select:focus { border-color: var(--primary-taupe); }

        .btn-modal-submit {
            background: var(--dark-brown);
            color: white;
            padding: 14px 25px;
            border-radius: 8px;
            font-weight: 600;
            width: 100%;
            margin-top: 20px;
            transition: 0.3s;
            cursor: pointer;
            border: none;
        }

        .btn-modal-submit:hover { background: var(--primary-taupe); }

        @media (max-width: 768px) {
            .account-container { flex-direction: column; }
            .btn-cancel-item, .btn-return-item { position: static; margin-top: 12px; width: 100%; text-align: center; }
            .order-item { flex-direction: column; align-items: flex-start; }
        }
    </style>
</head>
<body>

    <%- include('../partials/header') %>

    <main class="account-container">
        <%- include('../partials/profileSidebar', { user, path: '/profile/orders' }) %>

        <section class="details-content">
            <h1 class="font-serif text-3xl mb-8 text-stone-800" style="font-family: 'Playfair Display', serif;">Order Details</h1>

            <div class="card">
                <h3>Order Status</h3>
                
                <%
                let itemStatuses = order.items.map(i => i.itemStatus);
                let trackerStatus = "pending";

                if (itemStatuses.some(s => s === "delivered")) {
                    trackerStatus = "delivered";
                } else if (itemStatuses.some(s => s === "out for delivery")) {
                    trackerStatus = "out for delivery";
                } else if (itemStatuses.some(s => s === "shipped")) {
                    trackerStatus = "shipped";
                } else if (itemStatuses.every(s => s === "cancelled")) {
                    trackerStatus = "cancelled";
                } else {
                    trackerStatus = "pending";
                }
                %>

                <div class="order-tracker">
                    <div class="tracker-step active">
                        <div class="step-circle"><i class="fa-solid fa-box"></i></div>
                        <div class="step-label">PLACED</div>
                    </div>

                    <div class="tracker-step <%= ['shipped','out for delivery','delivered'].includes(trackerStatus) ? 'active' : '' %>">
                        <div class="step-circle"><i class="fa-solid fa-truck"></i></div>
                        <div class="step-label">SHIPPED</div>
                    </div>

                    <div class="tracker-step <%= ['out for delivery','delivered'].includes(trackerStatus) ? 'active' : '' %>">
                        <div class="step-circle"><i class="fa-solid fa-motorcycle"></i></div>
                        <div class="step-label">OUT FOR DELIVERY</div>
                    </div>

                    <div class="tracker-step <%= trackerStatus === 'delivered' ? 'active' : '' %>">
                        <div class="step-circle"><i class="fa-solid fa-house-chimney"></i></div>
                        <div class="step-label">DELIVERED</div>
                    </div>
                </div>
            </div>

            <div class="card">
                <h3>Items in this order</h3>
                <div class="mb-4 text-sm text-gray-600">
                Order ID: <strong><%= order.orderId %></strong>
                </div>
                <div class="mb-2 text-sm">
                Payment Method: <strong><%= order.paymentMethod.toUpperCase() %></strong>
                </div>

            <div class="mb-4 text-sm">
            Payment Status: 
            <strong class="<%= order.paymentStatus === 'paid' ? 'text-green-600' : 'text-red-500' %>">
                  <%= order.paymentStatus.toUpperCase() %>
            </strong>
            </div>
                <% order.items.forEach(item => { %>
                <div class="order-item">
                    <% let variant = item.product?.variants?.find(v => v.color === item.variantColor); %>
                    <img src="<%= (variant && variant.images?.length > 0) ? variant.images[0] : '/images/no-image.png' %>">

                    <div class="item-details">
                        <span class="item-name"><%= item.product?.name || "Jewelry Item" %></span>
                        <div class="item-info-text">
                            Qty: <%= item.quantity %>, Price: ₹<%= item.total.toLocaleString() %>
                        </div>
                        <div class="item-info-text">
                                Color: <%= item.variantColor %>
                        </div>
                        
                        <%
                        let displayStatus = item.itemStatus;
                        let badgeClass = 'badge-pending';

                        if(item.returnRequest?.status === 'pending'){
                            displayStatus = 'Return Requested';
                            badgeClass = 'badge-out';
                        }
                        else if(item.returnRequest?.status === 'accepted'){
                            displayStatus = 'Returned';
                            badgeClass = 'badge-delivered';
                        }
                        else if(item.returnRequest?.status === 'rejected'){
                            displayStatus = 'Return Rejected';
                            badgeClass = 'badge-cancelled';
                        }
                        else {
                            if(item.itemStatus === 'pending' || item.itemStatus === 'confirmed') badgeClass = 'badge-pending';
                            if(item.itemStatus === 'shipped') badgeClass = 'badge-shipped';
                            if(item.itemStatus === 'out for delivery') badgeClass = 'badge-out';
                            if(item.itemStatus === 'delivered') badgeClass = 'badge-delivered';
                            if(item.itemStatus === 'cancelled') badgeClass = 'badge-cancelled';
                        }
                        %>

                        <span class="status-badge <%= badgeClass %>">
                            <%= displayStatus.toUpperCase() %>
                        </span>
                    </div>

                 <% if (['pending','confirmed','shipped','out for delivery'].includes(item.itemStatus)) { %>

    <!-- CANCEL BUTTON -->
    <button onclick="openCancelModal('<%= order._id %>','<%= item._id %>')" class="btn-cancel-item">
        CANCEL
    </button>

<% } else if (item.itemStatus === 'delivered') { %>

    <div style="display:flex; flex-direction:column; gap:8px;">

        <!-- REVIEW BUTTON (TOP) -->
        <button 
            onclick="openReviewModal('<%= item.product._id %>')" 
            class="btn-return-item">
            WRITE REVIEW
        </button>

        <!-- RETURN BUTTON (ONLY IF NOT REQUESTED) -->
        <% if (!item.returnRequest || item.returnRequest.status === 'none') { %>
            <button 
                onclick="openReturnModal('<%= order._id %>','<%= item._id %>')" 
                class="btn-return-item">
                RETURN
            </button>
        <% } %>

    </div>

<% } %>
            </div>
            <% }) %>

            <div class="flex justify-center gap-4 mt-8">
                <a href="/profile/orders/<%= order._id %>/invoice" class="btn-action btn-primary">Download Invoice</a>
                <a href="/profile/orders" class="btn-action btn-secondary">Back to My Orders</a>
            </div>
        </section>
    </main>

    <div id="returnModal" class="modal">
        <div class="modal-content">
            <div class="modal-close-btn" onclick="closeReturnModal()">×</div>
            <div class="modal-header">
                <h2>Return Request</h2>
            </div>
            <div class="modal-body">
                <form id="returnForm">
                    <input type="hidden" id="returnOrderId">
                    <input type="hidden" id="returnItemId">

                    <label style="font-size: 0.8rem; font-weight: 700; color: #777; text-transform: uppercase;">Reason for Return</label>
                    <select id="returnReason" class="return-select" required>
                        <option value="">Choose a reason</option>
                        <option value="Damaged product">Damaged product</option>
                        <option value="Wrong item received">Wrong item received</option>
                        <option value="Quality not as expected">Quality not as expected</option>
                        <option value="Colour issue">Colour issue</option>
                        <option value="Other">Other</option>
                    </select>
                    <div id="otherReasonContainer" style="display:none; margin-top:10px;">
                    <input 
                     type="text" 
                     id="otherReasonInput"
                     placeholder="Enter your reason..."
                     style="width:100%; padding:12px; border:1px solid #ddd; border-radius:8px;">
                    </div>

                    <button type="submit" class="btn-modal-submit">SUBMIT RETURN REQUEST</button>
                </form>
            </div>
        </div>
    </div>

    <div id="cancelModal" class="modal">
    <div class="modal-content">
        <div class="modal-close-btn" onclick="closeCancelModal()">×</div>

        <div class="modal-header">
            <h2>Cancel Order</h2>
        </div>

        <div class="modal-body">
            <form id="cancelForm">
                <input type="hidden" id="cancelOrderId">
                <input type="hidden" id="cancelItemId">

                <label style="font-size: 0.8rem; font-weight: 700;">Reason for Cancellation</label>

                <select id="cancelReason" class="return-select" required>
                    <option value="">Choose a reason</option>
                    <option value="Ordered by mistake">Ordered by mistake</option>
                    <option value="Found better price">Found better price</option>
                    <option value="Delivery delay">Delivery delay</option>
                    <option value="Changed my mind">Changed my mind</option>
                    <option value="Other">Other</option>
                </select>

                <!-- OTHER INPUT -->
                <div id="cancelOtherBox" style="display:none; margin-top:10px;">
                    <input 
                        type="text" 
                        id="cancelOtherInput"
                        placeholder="Enter your reason..."
                        style="width:100%; padding:12px; border:1px solid #ddd; border-radius:8px;">
                </div>

                <button type="submit" class="btn-modal-submit">
                    SUBMIT CANCEL REQUEST
                </button>
            </form>
        </div>
      

    </div>
</div>

<div id="reviewModal" class="modal">
    <div class="modal-content">
        <div class="modal-close-btn" onclick="closeReviewModal()">×</div>

        <div class="modal-header">
            <h2>Write a Review</h2>
        </div>

        <div class="modal-body">
            <form id="reviewForm">
                <input type="hidden" id="reviewProductId">

                <!-- Rating -->
                <label style="font-size: 0.8rem; font-weight: 700;">Rating</label>
                <select id="reviewRating" class="return-select" required>
                    <option value="">Select Rating</option>
                    <option value="5">⭐⭐⭐⭐⭐ (5)</option>
                    <option value="4">⭐⭐⭐⭐ (4)</option>
                    <option value="3">⭐⭐⭐ (3)</option>
                    <option value="2">⭐⭐ (2)</option>
                    <option value="1">⭐ (1)</option>
                </select>

                <!-- Comment -->
                <label style="font-size: 0.8rem; font-weight: 700; margin-top:10px;">Review</label>
                <textarea 
                    id="reviewComment"
                    placeholder="Write your experience..."
                    style="width:100%; padding:12px; border:1px solid #ddd; border-radius:8px; margin-top:10px;"
                    required></textarea>

                <button type="submit" class="btn-modal-submit">
                    SUBMIT REVIEW
                </button>
            </form>
        </div>
    </div>
</div>

    <%- include('../partials/footer') %>

    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        function openReturnModal(orderId, itemId) {
            document.getElementById('returnOrderId').value = orderId;
            document.getElementById('returnItemId').value = itemId;
            document.getElementById('returnModal').style.display = 'flex';
        }

        function closeReturnModal() {
            document.getElementById('returnModal').style.display = 'none';
        }

        window.onclick = function(event) {
            const modal = document.getElementById('returnModal');
            if (event.target == modal) closeReturnModal();
        }

        document.getElementById('returnForm').addEventListener('submit', function(e) {
            e.preventDefault();
            const orderId = document.getElementById('returnOrderId').value;
            const itemId = document.getElementById('returnItemId').value;
            let reason = document.getElementById('returnReason').value;

            if (reason === "Other") {
         const customReason = document.getElementById('otherReasonInput').value.trim();

         if (!customReason) {
                 Swal.fire("Error", "Please enter your reason", "error");
             return;
         }

            reason = customReason;
        }
            fetch(`/profile/orders/${orderId}/return/${itemId}`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ reason })
            })
            .then(res => res.json())
            .then(data => {
                if(data.success){
                    Swal.fire('Success','Return requested','success').then(()=>location.reload());
                }
            });
        });
    document.getElementById("returnReason").addEventListener("change", function () {
    const otherBox = document.getElementById("otherReasonContainer");

    if (this.value === "Other") {
        otherBox.style.display = "block";
    } else {
        otherBox.style.display = "none";
    }
});
function openReviewModal(productId) {
    document.getElementById('reviewProductId').value = productId;
    document.getElementById('reviewModal').style.display = 'flex';
}

function closeReviewModal() {
    document.getElementById('reviewModal').style.display = 'none';
}
function openCancelModal(orderId, itemId) {
    document.getElementById('cancelOrderId').value = orderId;
    document.getElementById('cancelItemId').value = itemId;
    document.getElementById('cancelModal').style.display = 'flex';
}

function closeCancelModal() {
    document.getElementById('cancelModal').style.display = 'none';
}

document.getElementById("cancelReason").addEventListener("change", function () {
    const box = document.getElementById("cancelOtherBox");

    if (this.value === "Other") {
        box.style.display = "block";
        document.getElementById("cancelOtherInput").focus();
    } else {
        box.style.display = "none";
    }
});
document.getElementById("cancelForm").addEventListener("submit", function(e){
    e.preventDefault();

    const orderId = document.getElementById("cancelOrderId").value;
    const itemId = document.getElementById("cancelItemId").value;

    let reason = document.getElementById("cancelReason").value;

    if (reason === "Other") {
        const custom = document.getElementById("cancelOtherInput").value.trim();

        if (!custom) {
            Swal.fire("Error", "Please enter reason", "error");
            return;
        }

        reason = custom;
    }

    fetch(`/profile/orders/${orderId}/cancel/${itemId}`, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ reason })
    })
    .then(res => res.json())
    .then(data => {
        if(data.success){
            Swal.fire("Cancelled", "Item cancelled successfully", "success")
            .then(()=>location.reload());
        } else {
            Swal.fire("Error", data.message, "error");
        }
    })
    .catch(() => {
        Swal.fire("Error", "Something went wrong", "error");
    });
});

      function cancelItem(orderId, itemId) {
    Swal.fire({
        title: 'Are you sure?',
        text: "Do you want to cancel this item?",
        icon: 'warning',
        showCancelButton: true,
        confirmButtonColor: '#3D2B24',
        cancelButtonColor: '#d33',
        confirmButtonText: 'Yes, cancel'
    }).then((result) => {
        if (result.isConfirmed) {
            fetch(`/profile/orders/${orderId}/cancel/${itemId}`, { method: "POST" })
            .then(res => res.json())
            .then(data => {
                if (data.success) {
                    Swal.fire('Cancelled', data.message, 'success')
                        .then(() => location.reload());
                } else {
                    Swal.fire('Error', data.message, 'error');
                }
            })
            .catch(() => {
                Swal.fire('Error', 'Something went wrong', 'error');
            });
        }
    });
}
document.getElementById("reviewForm").addEventListener("submit", function(e){
    e.preventDefault();

    const productId = document.getElementById("reviewProductId").value;
    const rating = document.getElementById("reviewRating").value;
    const comment = document.getElementById("reviewComment").value.trim();

    if (!rating || !comment) {
        Swal.fire("Error", "Please fill all fields", "error");
        return;
    }

    fetch(`/review/add`, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ productId, rating, comment })
    })
    .then(res => res.json())
    .then(data => {
        if(data.success){
            Swal.fire("Success", "Review submitted", "success")
            .then(()=>location.reload());
        } else {
            Swal.fire("Error", data.message, "error");
        }
    })
    .catch(() => {
        Swal.fire("Error", "Something went wrong", "error");
    });
});
    </script>
</body>
</html>