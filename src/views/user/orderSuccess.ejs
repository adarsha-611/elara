<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Order Confirmed | ELARA</title>
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,600;1,400&family=Poppins:wght@300;400;500&display=swap" rel="stylesheet">
    <style>
        :root {
            --bg-color: #F9F8F3;
            --gold: #C5A371;
            --gold-light: #D4B996;
            --text-dark: #2D2926;
            --text-muted: #706C61;
            --white: #FFFFFF;
            --font-serif: 'Playfair Display', serif;
            --font-sans: 'Poppins', sans-serif;
        }

        body, html {
            margin: 0;
            padding: 0;
            height: 100%;
            font-family: var(--font-sans);
            background-color: var(--bg-color);
            color: var(--text-dark);
            display: flex;
            justify-content: center;
            align-items: center;
            overflow-x: hidden;
        }

        /* Luxury Silk/Marble Texture Overlay */
        body::before {
            content: "";
            position: absolute;
            top: 0; left: 0; width: 100%; height: 100%;
            background: url('https://www.transparenttextures.com/patterns/natural-paper.png');
            opacity: 0.4;
            pointer-events: none;
            z-index: 0;
        }

        /* Soft Shimmer Background Animation */
        .shimmer {
            position: absolute;
            top: 0; left: 0; width: 100%; height: 100%;
            background: radial-gradient(circle at 50% 50%, rgba(197, 163, 113, 0.08) 0%, transparent 70%);
            animation: pulse 10s infinite ease-in-out;
            z-index: 1;
        }

        @keyframes pulse {
            0%, 100% { transform: scale(1); opacity: 0.5; }
            50% { transform: scale(1.3); opacity: 0.8; }
        }

        /* Main Success Card */
        .success-card {
            position: relative;
            z-index: 10;
            background: var(--white);
            padding: 70px 50px;
            width: 100%;
            max-width: 500px;
            text-align: center;
            border-radius: 8px;
            border: 1px solid rgba(197, 163, 113, 0.2);
            box-shadow: 0 25px 50px rgba(0,0,0,0.04);
            animation: cardFadeIn 1.2s cubic-bezier(0.21, 0.6, 0.35, 1);
        }

        @keyframes cardFadeIn {
            from { opacity: 0; transform: translateY(30px); }
            to { opacity: 1; transform: translateY(0); }
        }

        /* Refined Checkmark Animation */
        .checkmark-container {
            position: relative;
            margin-bottom: 35px;
            display: flex;
            justify-content: center;
        }

        .checkmark-glow {
            position: absolute;
            top: 50%; left: 50%;
            transform: translate(-50%, -50%);
            width: 90px; height: 90px;
            background: var(--gold);
            filter: blur(25px);
            opacity: 0.15;
            border-radius: 50%;
        }

        .checkmark-circle {
            width: 80px; height: 80px;
            border: 1px solid var(--gold);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            background: white;
            position: relative;
        }

        .checkmark-icon {
            stroke: var(--gold);
            stroke-width: 2.5;
            stroke-linecap: round;
            stroke-linejoin: round;
            width: 35px;
            height: 35px;
        }

        .checkmark-path {
            stroke-dasharray: 100;
            stroke-dashoffset: 100;
            animation: drawCheck 0.8s ease-out forwards 0.5s;
        }

        @keyframes drawCheck {
            to { stroke-dashoffset: 0; }
        }

        /* Typography */
        h1 {
            font-family: var(--font-serif);
            font-size: 2.4rem;
            font-weight: 400;
            margin: 0 0 10px 0;
            letter-spacing: -0.5px;
            color: var(--text-dark);
        }

        .gold-divider {
            width: 50px;
            height: 1px;
            background: var(--gold);
            margin: 0 auto 25px;
            opacity: 0.7;
        }

        .success-message {
            color: var(--text-muted);
            font-weight: 300;
            font-size: 1rem;
            line-height: 1.7;
            margin-bottom: 30px;
            max-width: 90%;
            margin-left: auto;
            margin-right: auto;
        }

        /* Order Badge - Using your dynamic ID */
        .order-badge {
            display: inline-block;
            background: var(--bg-color);
            padding: 10px 24px;
            border-radius: 50px;
            font-size: 0.85rem;
            letter-spacing: 1.5px;
            color: var(--text-dark);
            margin-bottom: 45px;
            border: 1px solid rgba(197, 163, 113, 0.15);
            font-weight: 500;
        }

        /* Actions */
        .button-group {
            display: flex;
            flex-direction: column;
            gap: 15px;
        }

        .btn {
            padding: 18px 30px;
            border-radius: 4px;
            font-size: 0.75rem;
            font-weight: 500;
            letter-spacing: 2px;
            text-transform: uppercase;
            cursor: pointer;
            transition: all 0.4s cubic-bezier(0.165, 0.84, 0.44, 1);
            text-decoration: none;
            display: block;
        }

        .btn-primary {
            background: var(--gold);
            color: white;
            border: 1px solid var(--gold);
        }

        .btn-primary:hover {
            background: var(--gold-light);
            border-color: var(--gold-light);
            transform: translateY(-3px);
            box-shadow: 0 10px 20px rgba(197, 163, 113, 0.2);
        }

        .btn-secondary {
            background: transparent;
            color: var(--text-dark);
            border: 1px solid #D1C9C1;
        }

        .btn-secondary:hover {
            background: rgba(197, 163, 113, 0.05);
            border-color: var(--gold);
            transform: translateY(-3px);
        }

        @media (max-width: 480px) {
            .success-card {
                margin: 20px;
                padding: 50px 30px;
            }
            h1 { font-size: 1.9rem; }
        }
    </style>
</head>
<body>

    <div class="shimmer"></div>

    <div class="success-card">
        <div class="checkmark-container">
            <div class="checkmark-glow"></div>
            <div class="checkmark-circle">
                <svg class="checkmark-icon" viewBox="0 0 52 52" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path class="checkmark-path" d="M14 27l7 7 17-17" />
                </svg>
            </div>
        </div>

        <h1>Your Order Has Been Placed</h1>
        <div class="gold-divider"></div>
        
        <p class="success-message">
            Thank you for choosing ELARA. Your order has been successfully received .
        </p>

        <div class="order-badge">ORDER #<%= order.orderId %></div>

        <div class="button-group">
            <a href="/profile/orders/<%= order._id %>" class="btn btn-primary">View Order Detail</a>
            <a href="/shop" class="btn btn-secondary">Continue Shopping</a>
        </div>
    </div>

</body>
</html>