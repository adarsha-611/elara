<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Checkout | ELARA Luxury Jewelry</title>
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@500;600&family=Lato:wght@300;400;700&display=swap" rel="stylesheet">
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        'elara-brown': '#7A5C4D'
                    }
                }
            }
        }
    </script>
    <style>
        :root {
            --primary-gold: #a3866a;
            --dark-gold:   #8a7055;
            --bg-cream:     #f8f5f2;
            --charcoal:     #2d2d2d;
            --border:       #e0d9ce;
            --error:        #c94b4b;
            --success:      #4a7043;
            --gray:         #6b6b6b;
            --light:        #ffffff;
        }

        * { box-sizing: border-box; }
        body {
            font-family: 'Lato', sans-serif;
            background: var(--bg-cream);
            color: var(--charcoal);
            margin: 0;
            line-height: 1.6;
        }

        .checkout-header {
            background: var(--light);
            border-bottom: 1px solid var(--border);
            padding: 1rem 5%;
            display: flex;
            justify-content: space-between;
            align-items: center;
            position: sticky;
            top: 0;
            z-index: 100;
        }

        .logo {
            font-family: 'Playfair Display', serif;
            font-size: 2rem;
            letter-spacing: 3px;
            color: #3f2a1d;
            text-decoration: none;
        }

        .secure-badge {
            font-size: 0.95rem;
            color: var(--gray);
        }

        .secure-badge i { color: var(--success); margin-right: 6px; }

        .container {
            max-width: 1180px;
            margin: 40px auto;
            padding: 0 20px;
            display: grid;
            grid-template-columns: 1fr 380px;
            gap: 50px;
        }

        h1.page-title {
            font-family: 'Playfair Display', serif;
            font-size: 2.4rem;
            margin: 0 0 1.8rem;
            color: #3f2a1d;
        }

        .section {
            background: var(--light);
            border: 1px solid var(--border);
            border-radius: 10px;
            padding: 28px;
            margin-bottom: 28px;
        }

        .section-title {
            font-family: 'Playfair Display', serif;
            font-size: 1.55rem;
            margin: 0 0 1.4rem;
            padding-bottom: 12px;
            border-bottom: 1px solid var(--border);
        }

        .address-list {
            display: grid;
            gap: 16px;
            margin-bottom: 24px;
        }

        .address-card {
            padding: 18px;
            border: 2px solid var(--border);
            border-radius: 8px;
            cursor: pointer;
            transition: all 0.18s;
            position: relative;
        }

        .address-card:hover,
        .address-card.selected {
            border-color: var(--primary-gold);
            box-shadow: 0 0 0 3px rgba(163,134,106,0.15);
        }

        .address-card input[type="radio"] {
            position: absolute;
            opacity: 0;
        }

        .address-card label {
            display: block;
            cursor: pointer;
        }

        .address-name {
            font-weight: 700;
            font-size: 1.05rem;
            margin-bottom: 6px;
        }

        .address-meta {
            color: #555;
            font-size: 0.94rem;
        }

        .address-actions {
            position: absolute;
            top: 16px;
            right: 16px;
            display: flex;
            gap: 10px;
        }

        .action-btn {
            background: #f8f5f2;
            border: none;
            width: 36px;
            height: 36px;
            border-radius: 6px;
            cursor: pointer;
            color: #555;
            transition: all 0.2s;
            font-size: 1rem;
        }

        .action-btn:hover { background: #e8e2d9; color: #222; }

        .add-address-btn {
            background: var(--primary-gold);
            color: white;
            border: none;
            padding: 12px 24px;
            border-radius: 6px;
            font-size: 1rem;
            cursor: pointer;
            transition: background 0.2s;
        }

        .add-address-btn:hover { background: var(--dark-gold); }

        /* Payment */
        .payment-option {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 16px;
            border: 2px solid var(--border);
            border-radius: 8px;
            margin-bottom: 12px;
            cursor: pointer;
            transition: all 0.18s;
        }

        .payment-option:hover,
        .payment-option.selected {
            border-color: var(--primary-gold);
            background: rgba(163,134,106,0.04);
        }

        .payment-option input[type="radio"] { margin: 0; }

        .payment-label {
            font-weight: 600;
        }

        /* Order Summary */
        .order-summary {
            position: sticky;
            top: 100px;
            align-self: start;
        }

        .summary-inner {
            background: var(--light);
            border: 1px solid var(--border);
            border-radius: 10px;
            padding: 28px;
        }

        .summary-title {
            font-family: 'Playfair Display', serif;
            font-size: 1.45rem;
            margin: 0 0 20px;
        }

        .summary-item {
            display: flex;
            gap: 14px;
            margin-bottom: 18px;
        }

        .item-thumb {
            width: 64px;
            height: 64px;
            border-radius: 6px;
            overflow: hidden;
            flex-shrink: 0;
            background: #f0ece5;
        }

        .item-thumb img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

        .item-info h4 {
            margin: 0 0 4px;
            font-size: 0.98rem;
        }

        .item-qty {
            font-size: 0.86rem;
            color: #666;
        }

        .summary-line {
            display: flex;
            justify-content: space-between;
            margin: 10px 0;
            font-size: 0.96rem;
        }

        .grand-total {
            font-size: 1.28rem;
            font-weight: 700;
            border-top: 1px solid var(--border);
            padding-top: 16px;
            margin-top: 12px;
        }

        .place-order-btn {
            background: var(--primary-gold);
            color: white;
            border: none;
            width: 100%;
            padding: 16px;
            font-size: 1.1rem;
            font-weight: 600;
            border-radius: 8px;
            cursor: pointer;
            margin: 24px 0 16px;
            transition: background 0.2s;
        }

        .place-order-btn:hover { background: var(--dark-gold); }

        .return-link {
            color: var(--primary-gold);
            text-decoration: none;
            font-size: 0.95rem;
            display: inline-block;
        }

        .return-link:hover { text-decoration: underline; }

        /* Modal Styles - Enhanced like address page */
        .modal-overlay {
            display: none;
            position: fixed;
            inset: 0;
            background: rgba(61, 43, 36, 0.4);
            backdrop-filter: blur(4px);
            z-index: 2000;
            justify-content: center;
            align-items: center;
            padding: 20px;
        }

        .modal-content {
            background: white;
            width: 100%;
            max-width: 620px;
            max-height: 92vh;
            overflow-y: auto;
            border-radius: 12px;
            padding: 32px;
            position: relative;
        }

        .close-modal {
            position: absolute;
            top: 20px;
            right: 24px;
            font-size: 32px;
            background: none;
            border: none;
            cursor: pointer;
            color: #999;
            transition: color 0.2s;
        }
        .close-modal:hover { color: #3d2b24; }

        .form-group {
            margin-bottom: 18px;
        }

        .form-group label {
            display: block;
            margin-bottom: 7px;
            font-weight: 600;
            font-size: 0.92rem;
        }

        .form-group input,
        .form-group textarea,
        .form-group select {
            width: 100%;
            padding: 12px 14px;
            border: 1px solid #d3ccc1;
            border-radius: 6px;
            font-size: 0.97rem;
            transition: all 0.2s;
        }
        .form-group input:focus,
        .form-group textarea:focus {
            border-color: #7a5c4d;
            outline: none;
            box-shadow: 0 0 0 2px rgba(122, 92, 77, 0.1);
        }
        .form-group input.is-invalid,
        .form-group textarea.is-invalid {
            border-color: #dc3545;
            background-color: #fff8f8;
        }
        .error-text {
            color: #dc3545;
            font-size: 0.75rem;
            margin-top: 4px;
            min-height: 1.2em;
        }

        .form-row {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 18px;
        }

        .checkbox-group {
            display: flex;
            align-items: center;
            gap: 10px;
            margin-top: 8px;
        }

        .modal-actions {
            display: flex;
            justify-content: flex-end;
            gap: 16px;
            margin-top: 28px;
        }

        .btn-secondary {
            background: #f0ece5;
            color: #444;
            border: none;
            padding: 12px 28px;
            border-radius: 6px;
            cursor: pointer;
        }

        .btn-primary {
            background: var(--primary-gold);
            color: white;
            border: none;
            padding: 12px 32px;
            border-radius: 6px;
            cursor: pointer;
            font-weight: 600;
        }

        .loading-spinner {
            display: inline-block;
            width: 16px;
            height: 16px;
            border: 2px solid #f3f3f3;
            border-top: 2px solid #7A5C4D;
            border-radius: 50%;
            animation: spin 1s linear infinite;
            margin-right: 8px;
        }
        @keyframes spin {
            0% { transform: rotate(0deg); }
            100% { transform: rotate(360deg); }
        }

        @media (max-width: 980px) {
            .container {
                grid-template-columns: 1fr;
                gap: 32px;
            }
            .order-summary {
                position: static;
            }
        }

        @media (max-width: 600px) {
            .form-row { grid-template-columns: 1fr; }
            .section { padding: 20px; }
        }
    </style>
</head>
<body>
    <%- include('../partials/header') %>

    <div class="container">
        <main>
            <h1 class="page-title">Checkout</h1>

            <!-- 1. Delivery Address -->
            <section class="section">
                <h2 class="section-title">1. Delivery Address</h2>

                <% if (addresses?.length > 0) { %>
                    <div class="address-list" id="addressListContainer">
                        <% addresses.forEach(addr => { %>
                            <div class="address-card <%= addr.isDefault ? 'selected' : '' %>" data-address-id="<%= addr._id %>">
                                <input type="radio" name="addressId" value="<%= addr._id %>"
                                       id="addr-<%= addr._id %>"
                                       <%= addr.isDefault ? 'checked' : '' %>>
                                <label for="addr-<%= addr._id %>">
                                    <div class="address-name"><%= addr.fullName %></div>
                                    <div class="address-meta">
                                        <%= addr.street %>, <%= addr.city %>, <%= addr.state %> <%= addr.pincode %><br>
                                        Phone: <%= addr.phoneNumber %>
                                    </div>
                                </label>

                                <div class="address-actions">
                                    <button type="button" class="action-btn edit-address-btn" data-address-id="<%= addr._id %>">
                                        ✎
                                    </button>
                                    <button type="button" class="action-btn delete-address-btn" data-address-id="<%= addr._id %>">
                                        🗑
                                    </button>
                                </div>
                            </div>
                        <% }) %>
                    </div>
                <% } else { %>
                    <p style="color:#666; text-align:center; padding:20px 0;" id="noAddressMsg">
                        No saved addresses yet. Please add one below.
                    </p>
                <% } %>

                <button type="button" class="add-address-btn" id="addNewAddressBtn">
                    + Add New Address
                </button>
            </section>

            <!-- 2. Payment Method -->
            <section class="section">
                <h2 class="section-title">2. Payment Method</h2>

                <div class="payment-option" data-value="razorpay">
                    <input type="radio" name="payment" value="razorpay" id="pay-razorpay">
                    <label for="pay-razorpay" class="payment-label">Pay with Razorpay (UPI, Cards, Netbanking)</label>
                </div>

                <div class="payment-option" data-value="wallet">
                    <input type="radio" name="payment" value="wallet" id="pay-wallet">
                    <label for="pay-wallet" class="payment-label">Wallet Payment</label>
                </div>

                <div class="payment-option" data-value="cod">
                    <input type="radio" name="payment" value="cod" id="pay-cod" checked>
                    <label for="pay-cod" class="payment-label">Cash on Delivery</label>
                </div>
            </section>
        </main>

        <!-- Order Summary -->
        <aside class="order-summary">
            <div class="summary-inner">
                <h2 class="summary-title">Order Summary</h2>

                <div class="summary-items">
                    <% cartItems.forEach(item => { %>
                        <div class="summary-item">
                            <div class="item-thumb">
                                <img src="<%= item.image && item.image.startsWith('/') ? item.image : '/' + item.image %>" alt="<%= item.name %>">
                            </div>
                            <div class="item-info">
                                <h4><%= item.name %></h4>
                                <div class="item-qty">Qty: <%= item.quantity %> × ₹<%= (item.price || 0).toLocaleString('en-IN') %></div>
                                <div style="font-weight:600; margin-top:4px;">₹ <%= (item.itemTotal || 0).toLocaleString('en-IN') %></div>
                            </div>
                        </div>
                    <% }) %>
                </div>

                <div class="summary-totals">
                    <div class="summary-line">
                        <span>Subtotal</span>
                        <span>₹ <%= subtotal.toLocaleString('en-IN') %></span>
                    </div>
                    <div class="summary-line">
                        <span>Tax</span>
                        <span>₹0</span>
                    </div>
                    <div class="summary-line">
                        <span>Shipping</span>
                        <span>₹0</span>
                    </div>
                    <div class="summary-line grand-total">
                        <span>Total</span>
                        <span>₹ <%= subtotal.toLocaleString('en-IN') %></span>
                    </div>
                </div>

                <form id="placeOrderForm" action="/checkout/place-order" method="POST">
                    <input type="hidden" name="addressId" id="selectedAddress" required>
                    <input type="hidden" name="paymentMethod" id="selectedPayment" required>
                    <button type="submit" class="place-order-btn">Place Order →</button>
                </form>
                <a href="/cart" class="return-link">← Return to Cart</a>
            </div>
        </aside>
    </div>

    <div id="addressModal" class="modal-overlay">
        <div class="modal-content">
            <button class="close-modal" onclick="closeAddressModal()">×</button>
            <h2 id="modalTitle">Add New Address</h2>
            <p style="color:#666; margin:0 0 28px;">Enter your shipping details below.</p>

            <form id="addressForm">
                <input type="hidden" name="addressId" id="addressId">

                <div class="form-row">
                    <div class="form-group">
                        <label>Full Name *</label>
                        <input type="text" name="fullName" id="fullName" maxlength="20" class="luxury-input">
                        <div class="error-text" id="fullName-error"></div>
                    </div>
                    <div class="form-group">
                        <label>Phone Number *</label>
                        <input type="tel" name="phoneNumber" id="phoneNumber" maxlength="10" class="luxury-input">
                        <div class="error-text" id="phoneNumber-error"></div>
                    </div>
                </div>

                <div class="form-group">
                    <label>Street Address *</label>
                    <textarea name="street" id="street" rows="3" maxlength="50" class="luxury-input"></textarea>
                    <div class="error-text" id="street-error"></div>
                </div>

                <div class="form-row">
                    <div class="form-group">
                        <label>City *</label>
                        <input type="text" name="city" id="city" maxlength="10" class="luxury-input">
                        <div class="error-text" id="city-error"></div>
                    </div>
                    <div class="form-group">
                        <label>State *</label>
                        <input type="text" name="state" id="state" maxlength="10" class="luxury-input">
                        <div class="error-text" id="state-error"></div>
                    </div>
                </div>

                <div class="form-row">
                    <div class="form-group">
                        <label>Pincode *</label>
                        <input type="text" name="pincode" id="pincode" maxlength="6" class="luxury-input">
                        <div class="error-text" id="pincode-error"></div>
                    </div>
                    <div class="form-group">
                        <label>Address Type</label>
                        <div style="display:flex; align-items:center; gap:20px; margin-top:10px;">
                            <label style="display:flex; align-items:center; gap:6px; font-weight:500;">
                                <input type="radio" name="addressType" value="Home" checked> Home
                            </label>
                            <label style="display:flex; align-items:center; gap:6px; font-weight:500;">
                                <input type="radio" name="addressType" value="Work"> Work
                            </label>
                        </div>
                    </div>
                </div>

                <div class="form-group checkbox-group" style="margin-top:10px;">
                    <label style="display:flex; align-items:center; gap:10px; cursor:pointer;">
                        <input type="checkbox" id="makeDefault" name="isDefault">
                        Make this my default address
                    </label>
                </div>

                <div class="modal-actions">
                    <button type="button" class="btn-secondary" onclick="closeAddressModal()">Cancel</button>
                    <button type="submit" class="btn-primary" id="submitBtn">Save Address</button>
                </div>
            </form>
        </div>
    </div>

    <div id="flash-data"
         data-success='<%- JSON.stringify(successMessages || []) %>'
         data-error='<%- JSON.stringify(errorMessages || []) %>'>
    </div>
    <%- include('../partials/footer') %>

    <script>
        const Toast = Swal.mixin({
            toast: true,
            position: 'top-end',
            showConfirmButton: false,
            timer: 3000,
            timerProgressBar: true
        });

        let currentFormMode = 'add';
        const modal = document.getElementById("addressModal");

        function closeAddressModal() {
            modal.style.display = "none";
            clearErrors();
            document.getElementById('addressForm').reset();
            document.getElementById('addressId').value = '';
        }

        function clearErrors() {
            document.querySelectorAll('.error-text').forEach(el => el.textContent = '');
            document.querySelectorAll('.luxury-input').forEach(el => el.classList.remove('is-invalid'));
        }

        function displayErrors(errors) {
            clearErrors();
            errors.forEach(err => {
                const errorEl = document.getElementById(`${err.field}-error`);
                const inputEl = document.getElementById(err.field);
                if (errorEl && inputEl) {
                    errorEl.textContent = err.message;
                    inputEl.classList.add('is-invalid');
                }
            });
        }

        function refreshPageWithMessage(message, isSuccess = true) {
            if (isSuccess) {
                Toast.fire({ icon: 'success', title: message });
                setTimeout(() => window.location.reload(), 1500);
            } else {
                Swal.fire({ icon: 'error', title: 'Error', text: message, confirmButtonColor: '#7A5C4D' });
            }
        }

        // Add New Address Modal
        document.getElementById("addNewAddressBtn").onclick = () => {
            currentFormMode = 'add';
            document.getElementById("modalTitle").textContent = "Add New Address";
            document.getElementById("submitBtn").textContent = "Save Address";
            document.getElementById("addressForm").reset();
            document.getElementById("addressId").value = "";
            clearErrors();
            modal.style.display = "flex";
        };

        async function openEditModal(addressId) {
            try {
                const response = await fetch(`/profile/address/get/${addressId}`);
                const data = await response.json();
                if (data.success) {
                    currentFormMode = 'edit';
                    const addr = data.address;
                    document.getElementById("modalTitle").textContent = "Edit Address";
                    document.getElementById("submitBtn").textContent = "Update Address";
                    document.getElementById("addressId").value = addr._id;
                    document.getElementById("fullName").value = addr.fullName || '';
                    document.getElementById("phoneNumber").value = addr.phoneNumber || '';
                    document.getElementById("street").value = addr.street || '';
                    document.getElementById("city").value = addr.city || '';
                    document.getElementById("state").value = addr.state || '';
                    document.getElementById("pincode").value = addr.pincode || '';
                    
                    document.querySelectorAll('input[name="addressType"]').forEach(radio => {
                        radio.checked = radio.value === addr.addressType;
                    });
                    document.getElementById("makeDefault").checked = addr.isDefault || false;
                    clearErrors();
                    modal.style.display = "flex";
                } else {
                    Toast.fire({ icon: 'error', title: data.message || 'Failed to load address' });
                }
            } catch (error) {
                console.error('Edit error:', error);
                Toast.fire({ icon: 'error', title: 'Failed to load address details' });
            }
        }

        async function deleteAddress(addressId) {
            const result = await Swal.fire({
                title: 'Delete Address?',
                text: "Are you sure you want to delete this address? This action cannot be undone.",
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#d33',
                cancelButtonColor: '#7A5C4D',
                confirmButtonText: 'Yes, delete it!',
                cancelButtonText: 'Cancel'
            });
            if (result.isConfirmed) {
                Swal.fire({ title: 'Deleting...', allowOutsideClick: false, didOpen: () => Swal.showLoading() });
                try {
                    const response = await fetch(`/profile/address/delete/${addressId}`, {
                        method: 'GET',
                        headers: { 'X-Requested-With': 'XMLHttpRequest' }
                    });
                    const data = await response.json();
                    if (data.success) {
                        Swal.fire({ icon: 'success', title: 'Deleted!', text: 'Address has been deleted.', confirmButtonColor: '#7A5C4D' })
                            .then(() => window.location.reload());
                    } else {
                        Swal.fire({ icon: 'error', title: 'Error!', text: data.message || 'Failed to delete', confirmButtonColor: '#7A5C4D' });
                    }
                } catch (error) {
                    Swal.fire({ icon: 'error', title: 'Error!', text: 'Something went wrong.', confirmButtonColor: '#7A5C4D' });
                }
            }
        }

        async function setDefaultAddress(addressId) {
            if (!addressId) {
                Swal.fire({ icon: 'error', title: 'Error!', text: 'No address selected', confirmButtonColor: '#7A5C4D' });
                return;
            }
            const result = await Swal.fire({
                title: 'Set as Default?',
                text: "Do you want to set this as your default shipping address?",
                icon: 'question',
                showCancelButton: true,
                confirmButtonColor: '#7A5C4D',
                cancelButtonColor: '#d33',
                confirmButtonText: 'Yes, set as default',
                cancelButtonText: 'Cancel'
            });
            if (result.isConfirmed) {
                Swal.fire({ title: 'Updating...', allowOutsideClick: false, didOpen: () => Swal.showLoading() });
                try {
                    const response = await fetch(`/profile/address/setdefault/${addressId}`, {
                        method: 'GET',
                        headers: { 'X-Requested-With': 'XMLHttpRequest', 'Accept': 'application/json' }
                    });
                    const data = await response.json();
                    if (data.success) {
                        Swal.fire({ icon: 'success', title: 'Success!', text: data.message || 'Default address updated', confirmButtonColor: '#7A5C4D', timer: 2000, timerProgressBar: true })
                            .then(() => window.location.reload());
                    } else {
                        throw new Error(data.message || 'Failed to update default address');
                    }
                } catch (error) {
                    Swal.fire({ icon: 'error', title: 'Error!', text: error.message, confirmButtonColor: '#7A5C4D' });
                }
            }
        }

        document.getElementById('addressForm').addEventListener('submit', async function(e) {
            e.preventDefault();
            const formData = new FormData(this);
            const data = Object.fromEntries(formData.entries());
            data.isDefault = data.isDefault === 'on';
            
            const submitBtn = document.getElementById('submitBtn');
            const originalText = submitBtn.innerHTML;
            submitBtn.innerHTML = '<span class="loading-spinner"></span> Saving...';
            submitBtn.disabled = true;
            
            try {
                const url = currentFormMode === 'add' ? '/profile/address/add' : '/profile/address/edit';
                const response = await fetch(url, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json', 'X-Requested-With': 'XMLHttpRequest' },
                    body: JSON.stringify(data)
                });
                const result = await response.json();
                if (result.success) {
                    Swal.fire({
                        icon: 'success',
                        title: currentFormMode === 'add' ? 'Address Added!' : 'Address Updated!',
                        text: result.message,
                        confirmButtonColor: '#7A5C4D'
                    }).then(() => {
                        closeAddressModal();
                        window.location.reload();
                    });
                } else {
                    if (result.errors && result.errors.length > 0) {
                        displayErrors(result.errors);
                        Swal.fire({ icon: 'error', title: 'Validation Error', text: 'Please fix the errors in the form', confirmButtonColor: '#7A5C4D' });
                    } else {
                        Swal.fire({ icon: 'error', title: 'Error!', text: result.message || 'Failed to save address', confirmButtonColor: '#7A5C4D' });
                    }
                }
            } catch (error) {
                console.error('Submit error:', error);
                Swal.fire({ icon: 'error', title: 'Error!', text: 'Something went wrong. Please try again.', confirmButtonColor: '#7A5C4D' });
            } finally {
                submitBtn.innerHTML = originalText;
                submitBtn.disabled = false;
            }
        });

        document.getElementById('addressListContainer')?.addEventListener('click', (e) => {
            const editBtn = e.target.closest('.edit-address-btn');
            const deleteBtn = e.target.closest('.delete-address-btn');
            if (editBtn) {
                const addrId = editBtn.getAttribute('data-address-id');
                if (addrId) openEditModal(addrId);
            }
            if (deleteBtn) {
                const addrId = deleteBtn.getAttribute('data-address-id');
                if (addrId) deleteAddress(addrId);
            }
        });

        document.querySelectorAll('.edit-address-btn').forEach(btn => {
            if (!btn.hasAttribute('data-listener')) {
                btn.setAttribute('data-listener', 'true');
                btn.addEventListener('click', (e) => {
                    e.preventDefault();
                    const addrId = btn.getAttribute('data-address-id');
                    if (addrId) openEditModal(addrId);
                });
            }
        });
        document.querySelectorAll('.delete-address-btn').forEach(btn => {
            if (!btn.hasAttribute('data-listener')) {
                btn.setAttribute('data-listener', 'true');
                btn.addEventListener('click', (e) => {
                    e.preventDefault();
                    const addrId = btn.getAttribute('data-address-id');
                    if (addrId) deleteAddress(addrId);
                });
            }
        });

        document.querySelectorAll('.set-default-btn').forEach(btn => {
            btn.addEventListener('click', (e) => {
                const addrId = btn.getAttribute('data-address-id');
                if (addrId) setDefaultAddress(addrId);
            });
        });

        function updateSelected() {
            const addr = document.querySelector('input[name="addressId"]:checked');
            document.getElementById('selectedAddress').value = addr ? addr.value : '';
            document.querySelectorAll('.address-card').forEach(c => c.classList.remove('selected'));
            if (addr) addr.closest('.address-card').classList.add('selected');
        }

        function updatePayment() {
            const pay = document.querySelector('input[name="payment"]:checked');
            document.getElementById('selectedPayment').value = pay ? pay.value : '';
        }

        document.querySelectorAll('input[name="addressId"]').forEach(r => {
            r.addEventListener('change', updateSelected);
        });

        document.querySelectorAll('input[name="payment"], .payment-option').forEach(el => {
            el.addEventListener('change', e => {
                document.querySelectorAll('.payment-option').forEach(p => p.classList.remove('selected'));
                if (e.target.closest('.payment-option')) {
                    e.target.closest('.payment-option').classList.add('selected');
                }
                updatePayment();
            });
        });

        document.querySelectorAll('.payment-option').forEach(opt => {
            opt.addEventListener('click', () => {
                const radio = opt.querySelector('input[type="radio"]');
                if (radio) {
                    radio.checked = true;
                    updatePayment();
                }
            });
        });

        updateSelected();
        updatePayment();

        const flashDiv = document.getElementById("flash-data");
        if (flashDiv) {
            const successMessages = JSON.parse(flashDiv.dataset.success || "[]");
            const errorMessages = JSON.parse(flashDiv.dataset.error || "[]");
            successMessages.forEach(msg => Toast.fire({ icon: 'success', title: msg }));
            errorMessages.forEach(msg => Toast.fire({ icon: 'error', title: msg }));
        }

        const stockIssue = <%= stockIssue ? "true" : "false" %>;
        const stockMessage = "<%= stockMessage %>";
        if (stockIssue && stockMessage) {
            Toast.fire({ icon: 'error', title: stockMessage });
        }

        modal.onclick = e => { if (e.target === modal) closeAddressModal(); };
    </script>
</body>
</html>