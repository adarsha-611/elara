<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Checkout | ELARA Luxury Jewelry</title>
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@500;600&family=Lato:wght@300;400;700&display=swap" rel="stylesheet">
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        'elara-brown': '#7A5C4D'
                    }
                }
            }
        }
    </script>
    <script src="https://checkout.razorpay.com/v1/checkout.js"></script>
    <style>
        :root {
            --primary-gold: #a3866a;
            --dark-gold:   #8a7055;
            --bg-cream:     #f8f5f2;
            --charcoal:     #2d2d2d;
            --border:       #e0d9ce;
            --error:        #c94b4b;
            --success:      #4a7043;
            --gray:         #6b6b6b;
            --light:        #ffffff;
        }

        * { box-sizing: border-box; }
        body {
            font-family: 'Lato', sans-serif;
            background: var(--bg-cream);
            color: var(--charcoal);
            margin: 0;
            line-height: 1.6;
        }

        .checkout-header {
            background: var(--light);
            border-bottom: 1px solid var(--border);
            padding: 1rem 5%;
            display: flex;
            justify-content: space-between;
            align-items: center;
            position: sticky;
            top: 0;
            z-index: 100;
        }

        .logo {
            font-family: 'Playfair Display', serif;
            font-size: 2rem;
            letter-spacing: 3px;
            color: #3f2a1d;
            text-decoration: none;
        }

        .secure-badge {
            font-size: 0.95rem;
            color: var(--gray);
        }

        .secure-badge i { color: var(--success); margin-right: 6px; }

        .container {
            max-width: 1180px;
            margin: 40px auto;
            padding: 0 20px;
            display: grid;
            grid-template-columns: 1fr 380px;
            gap: 50px;
        }

        h1.page-title {
            font-family: 'Playfair Display', serif;
            font-size: 2.4rem;
            margin: 0 0 1.8rem;
            color: #3f2a1d;
        }

        .section {
            background: var(--light);
            border: 1px solid var(--border);
            border-radius: 10px;
            padding: 28px;
            margin-bottom: 28px;
        }

        .section-title {
            font-family: 'Playfair Display', serif;
            font-size: 1.55rem;
            margin: 0 0 1.4rem;
            padding-bottom: 12px;
            border-bottom: 1px solid var(--border);
        }

        .address-list {
            display: grid;
            gap: 16px;
            margin-bottom: 24px;
        }

        .address-card {
            padding: 18px;
            border: 2px solid var(--border);
            border-radius: 8px;
            cursor: pointer;
            transition: all 0.18s;
            position: relative;
        }

        .address-card:hover,
        .address-card.selected {
            border-color: var(--primary-gold);
            box-shadow: 0 0 0 3px rgba(163,134,106,0.15);
        }

        .address-card input[type="radio"] {
            position: absolute;
            opacity: 0;
        }

        .address-card label {
            display: block;
            cursor: pointer;
        }

        .address-name {
            font-weight: 700;
            font-size: 1.05rem;
            margin-bottom: 6px;
        }

        .address-meta {
            color: #555;
            font-size: 0.94rem;
        }

        .address-actions {
            position: absolute;
            top: 16px;
            right: 16px;
            display: flex;
            gap: 10px;
        }

        .action-btn {
            background: #f8f5f2;
            border: none;
            width: 36px;
            height: 36px;
            border-radius: 6px;
            cursor: pointer;
            color: #555;
            transition: all 0.2s;
            font-size: 1rem;
        }

        .action-btn:hover { background: #e8e2d9; color: #222; }

        .add-address-btn {
            background: var(--primary-gold);
            color: white;
            border: none;
            padding: 12px 24px;
            border-radius: 6px;
            font-size: 1rem;
            cursor: pointer;
            transition: background 0.2s;
        }

        .add-address-btn:hover { background: var(--dark-gold); }

        /* Payment */
        .payment-option {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 16px;
            border: 2px solid var(--border);
            border-radius: 8px;
            margin-bottom: 12px;
            cursor: pointer;
            transition: all 0.18s;
        }

        .payment-option:hover,
        .payment-option.selected {
            border-color: var(--primary-gold);
            background: rgba(163,134,106,0.04);
        }

        .payment-option input[type="radio"] { margin: 0; }

        .payment-label {
            font-weight: 600;
        }

        /* Order Summary */
        .order-summary {
            position: sticky;
            top: 100px;
            align-self: start;
        }

        .summary-inner {
            background: var(--light);
            border: 1px solid var(--border);
            border-radius: 10px;
            padding: 28px;
        }

        .summary-title {
            font-family: 'Playfair Display', serif;
            font-size: 1.45rem;
            margin: 0 0 20px;
        }

        .summary-item {
            display: flex;
            gap: 14px;
            margin-bottom: 18px;
        }

        .item-thumb {
            width: 64px;
            height: 64px;
            border-radius: 6px;
            overflow: hidden;
            flex-shrink: 0;
            background: #f0ece5;
        }

        .item-thumb img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

        .item-info h4 {
            margin: 0 0 4px;
            font-size: 0.98rem;
        }

        .item-qty {
            font-size: 0.86rem;
            color: #666;
        }

        .summary-line {
            display: flex;
            justify-content: space-between;
            margin: 10px 0;
            font-size: 0.96rem;
        }

        .grand-total {
            font-size: 1.28rem;
            font-weight: 700;
            border-top: 1px solid var(--border);
            padding-top: 16px;
            margin-top: 12px;
        }

        .place-order-btn {
            background: var(--primary-gold);
            color: white;
            border: none;
            width: 100%;
            padding: 16px;
            font-size: 1.1rem;
            font-weight: 600;
            border-radius: 8px;
            cursor: pointer;
            margin: 24px 0 16px;
            transition: background 0.2s;
        }

        .place-order-btn:hover { background: var(--dark-gold); }

        .return-link {
            color: var(--primary-gold);
            text-decoration: none;
            font-size: 0.95rem;
            display: inline-block;
        }

        .return-link:hover { text-decoration: underline; }

        /* Modal Styles - Enhanced Luxury Design */
        .modal-overlay {
            display: none;
            position: fixed;
            inset: 0;
            background: rgba(61, 43, 36, 0.5);
            backdrop-filter: blur(6px);
            z-index: 2000;
            justify-content: center;
            align-items: center;
            padding: 20px;
        }

        .modal-content {
            background: white;
            width: 100%;
            max-width: 620px;
            max-height: 92vh;
            overflow-y: auto;
            border-radius: 16px;
            padding: 36px 32px;
            position: relative;
            box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.25);
            animation: modalSlideIn 0.3s ease-out;
        }

        @keyframes modalSlideIn {
            from {
                opacity: 0;
                transform: translateY(20px) scale(0.96);
            }
            to {
                opacity: 1;
                transform: translateY(0) scale(1);
            }
        }

        .close-modal {
            position: absolute;
            top: 20px;
            right: 24px;
            font-size: 32px;
            background: none;
            border: none;
            cursor: pointer;
            color: #999;
            transition: all 0.2s;
            width: 40px;
            height: 40px;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 50%;
        }
        .close-modal:hover { 
            color: #3d2b24; 
            background: #f5f0eb;
        }

        .form-group {
            margin-bottom: 22px;
        }

        .form-group label {
            display: block;
            margin-bottom: 8px;
            font-weight: 600;
            font-size: 0.9rem;
            color: #4a3a2f;
            letter-spacing: 0.3px;
        }

        .form-group input,
        .form-group textarea,
        .form-group select {
            width: 100%;
            padding: 12px 16px;
            border: 1.5px solid #e2dad0;
            border-radius: 10px;
            font-size: 0.97rem;
            transition: all 0.2s;
            background: #fefcf9;
            font-family: 'Lato', sans-serif;
        }
        .form-group input:focus,
        .form-group textarea:focus {
            border-color: #a3866a;
            outline: none;
            box-shadow: 0 0 0 3px rgba(163,134,106,0.15);
            background: white;
        }
        .form-group input.is-invalid,
        .form-group textarea.is-invalid {
            border-color: #dc3545;
            background-color: #fff8f8;
        }
        .error-text {
            color: #dc3545;
            font-size: 0.75rem;
            margin-top: 6px;
            min-height: 1.2em;
            font-weight: 500;
        }

        .form-row {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 20px;
        }

        .checkbox-group {
            display: flex;
            align-items: center;
            gap: 12px;
            margin-top: 8px;
            background: #faf8f5;
            padding: 12px 16px;
            border-radius: 12px;
        }

        .checkbox-group label {
            margin-bottom: 0;
            font-weight: 500;
            cursor: pointer;
        }

        .modal-actions {
            display: flex;
            justify-content: flex-end;
            gap: 16px;
            margin-top: 32px;
        }

        .btn-secondary {
            background: #f0ece5;
            color: #5a4a3a;
            border: none;
            padding: 12px 28px;
            border-radius: 40px;
            cursor: pointer;
            font-weight: 600;
            transition: all 0.2s;
        }
        .btn-secondary:hover {
            background: #e6dfd5;
        }

        .btn-primary {
            background: #a3866a;
            color: white;
            border: none;
            padding: 12px 32px;
            border-radius: 40px;
            cursor: pointer;
            font-weight: 700;
            letter-spacing: 0.5px;
            transition: all 0.2s;
            box-shadow: 0 2px 8px rgba(163,134,106,0.3);
        }
        .btn-primary:hover {
            background: #8a7055;
            transform: translateY(-1px);
            box-shadow: 0 4px 12px rgba(163,134,106,0.4);
        }

        .loading-spinner {
            display: inline-block;
            width: 18px;
            height: 18px;
            border: 2px solid rgba(255,255,255,0.3);
            border-top: 2px solid white;
            border-radius: 50%;
            animation: spin 0.8s linear infinite;
            margin-right: 8px;
            vertical-align: middle;
        }
        @keyframes spin {
            0% { transform: rotate(0deg); }
            100% { transform: rotate(360deg); }
        }

        /* Radio group styling */
        .radio-group {
            display: flex;
            align-items: center;
            gap: 24px;
            margin-top: 8px;
        }
        .radio-group label {
            display: flex;
            align-items: center;
            gap: 8px;
            font-weight: 500;
            cursor: pointer;
            margin-bottom: 0;
        }
        .radio-group input[type="radio"] {
            width: 18px;
            height: 18px;
            accent-color: #a3866a;
        }

        @media (max-width: 980px) {
            .container {
                grid-template-columns: 1fr;
                gap: 32px;
            }
            .order-summary {
                position: static;
            }
        }

        @media (max-width: 600px) {
            .form-row { grid-template-columns: 1fr; gap: 16px; }
            .section { padding: 20px; }
            .modal-content { padding: 28px 20px; }
        }

        .coupon-section {
            margin-top: 20px;
            padding-top: 20px;
            border-top: 1px solid #eee;
        }

        .coupon-toggle {
            color: var(--primary-gold);
            font-family: 'Playfair Display', serif;
            font-size: 0.95rem;
            font-weight: 600;
            cursor: pointer;
            display: inline-flex;
            align-items: center;
            letter-spacing: 0.5px;
            transition: color 0.3s ease;
        }

        .coupon-toggle:hover {
            color: var(--dark-gold);
        }

        .coupon-input-group {
            display: flex;
            gap: 0;
            margin-top: 12px;
        }

        .coupon-input {
            flex: 1;
            padding: 10px 15px;
            border: 1px solid var(--border);
            border-right: none;
            border-radius: 4px 0 0 4px;
            font-family: 'Lato', sans-serif;
            font-size: 0.85rem;
            text-transform: uppercase;
            letter-spacing: 1px;
        }

        .apply-coupon-btn {
            background: var(--primary-gold);
            color: white;
            border: none;
            padding: 0 20px;
            border-radius: 0 4px 4px 0;
            font-size: 0.8rem;
            font-weight: 700;
            text-transform: uppercase;
            cursor: pointer;
        }

        .coupon-item {
            border: 1px solid #f0ece5;
            background: #faf9f6;
            padding: 18px;
            margin-bottom: 15px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            border-radius: 2px;
        }

        .coupon-info h5 {
            font-family: 'Playfair Display', serif;
            color: var(--charcoal);
            font-size: 1.1rem;
            margin: 0;
        }

        .coupon-info p {
            font-size: 0.8rem;
            color: #888;
            margin-top: 5px;
            font-style: italic;
        }

        .select-coupon-link {
            color: var(--primary-gold);
            font-weight: 700;
            font-size: 0.75rem;
            text-transform: uppercase;
            letter-spacing: 1px;
            cursor: pointer;
            border-bottom: 1px solid var(--primary-gold);
        }
    </style>
</head>
<body>
    <%- include('../partials/header') %>

    <div class="container">
        <main>
            <h1 class="page-title">Checkout</h1>

            <!-- 1. Delivery Address -->
            <section class="section">
                <h2 class="section-title">1. Delivery Address</h2>

                <% if (addresses?.length > 0) { %>
                    <div class="address-list" id="addressListContainer">
                        <% addresses.forEach(addr => { %>
                            <div class="address-card <%= addr.isDefault ? 'selected' : '' %>" data-address-id="<%= addr._id %>">
                                <input type="radio" name="addressId" value="<%= addr._id %>"
                                       id="addr-<%= addr._id %>"
                                       <%= addr.isDefault ? 'checked' : '' %>>
                                <label for="addr-<%= addr._id %>">
                                    <div class="address-name"><%= addr.fullName %></div>
                                    <div class="address-meta">
                                        <%= addr.street %>, <%= addr.city %>, <%= addr.state %> <%= addr.pincode %><br>
                                        Phone: <%= addr.phoneNumber %>
                                    </div>
                                </label>

                                <div class="address-actions">
                                    <button type="button" class="action-btn edit-address-btn" data-address-id="<%= addr._id %>">
                                        ✎
                                    </button>
                                    <button type="button" class="action-btn delete-address-btn" data-address-id="<%= addr._id %>">
                                        🗑
                                    </button>
                                </div>
                            </div>
                        <% }) %>
                    </div>
                <% } else { %>
                    <p style="color:#666; text-align:center; padding:20px 0;" id="noAddressMsg">
                        No saved addresses yet. Please add one below.
                    </p>
                <% } %>

                <button type="button" class="add-address-btn" id="addNewAddressBtn">
                    + Add New Address
                </button>
            </section>

            <!-- 2. Payment Method -->
            <section class="section">
                <h2 class="section-title">2. Payment Method</h2>

                <div class="payment-option" data-value="razorpay">
                    <input type="radio" name="paymentMethod" value="razorpay" id="pay-razorpay">
                    <label for="pay-razorpay" class="payment-label">Pay with Razorpay (UPI, Cards, Netbanking)</label>
                </div>

                <div class="payment-option" data-value="wallet">
                    <input type="radio" name="paymentMethod" value="wallet" id="pay-wallet">
                    <label for="pay-wallet" class="payment-label">Wallet Payment</label>
                </div>

                <div class="payment-option" data-value="cod">
                    <input type="radio" name="paymentMethod" value="cod" id="pay-cod" checked>
                    <label for="pay-cod" class="payment-label">Cash on Delivery</label>
                </div>
            </section>
        </main>

        <!-- Order Summary -->
        <aside class="order-summary">
            <div class="summary-inner">
                <h2 class="summary-title">Order Summary</h2>
                <div class="summary-items">
                    <% cartItems.forEach(item => { %>
                        <div class="summary-item">
                            <div class="item-thumb">
                                <img src="<%= item.image && item.image.startsWith('/') ? item.image : '/' + item.image %>" alt="<%= item.name %>">
                            </div>
                            <div class="item-info">
                                <h4><%= item.name %></h4>
                                <div class="item-qty">Qty: <%= item.quantity %> × ₹<%= (item.price || 0).toLocaleString('en-IN') %></div>
                                <div style="font-weight:600; margin-top:4px;">₹ <%= (item.itemTotal || 0).toLocaleString('en-IN') %></div>
                            </div>
                        </div>
                    <% }) %>
                </div>

                <div class="summary-totals">
                    <div class="summary-line">
                        <span>Subtotal</span>
                        <span>₹ <%= subtotal.toLocaleString('en-IN') %></span>
                    </div>

                    <div class="coupon-section">
                        <div class="coupon-toggle" onclick="openCouponModal()">
                            <span style="margin-right: 8px;">✧</span> View Available Offers
                        </div>
                        <div class="coupon-input-group">
                            <input type="text" id="couponCode" class="coupon-input" placeholder="Enter Promo Code">
                            <button type="button" class="apply-coupon-btn" onclick="applyCoupon()">Apply</button>
                        </div>
                    </div>

                    <div class="summary-line discount-line" id="discountLine" style="display: none;">
                        <span>Discount</span>
                        <span id="discountAmount">- ₹0</span>
                    </div>

                    <div class="summary-line">
                        <span>Shipping</span>
                        <span>₹0</span>
                    </div>
                    <div class="summary-line grand-total">
                        <span>Total</span>
                        <span id="grandTotalDisplay">₹ <%= subtotal.toLocaleString('en-IN') %></span>
                    </div>
                </div>

                <form id="placeOrderForm" action="/checkout/place-order" method="POST">
                    <input type="hidden" name="addressId" id="selectedAddress" required>
                    <input type="hidden" name="paymentMethod" id="selectedPayment" required>
                    <input type="hidden" name="appliedCoupon" id="appliedCouponHidden">
                    <button type="submit" class="place-order-btn">Place Order →</button>
                </form>
                <a href="/cart" class="return-link">← Return to Cart</a>
            </div>
        </aside>
    </div>

    <!-- Address Modal - Enhanced -->
    <div id="addressModal" class="modal-overlay">
        <div class="modal-content">
            <button class="close-modal" onclick="closeAddressModal()">×</button>
            <h2 id="modalTitle" style="font-family: 'Playfair Display', serif; font-size: 1.8rem; margin-bottom: 8px;">Add New Address</h2>
            <p style="color:#7a6a5c; margin:0 0 28px; font-size: 0.9rem;">Please fill in your shipping details below</p>

            <form id="addressForm">
                <input type="hidden" name="addressId" id="addressId">
                <input type="hidden" name="paymentStatus" id="paymentStatus">
                <div class="form-row">
                    <div class="form-group">
                        <label>Full Name *</label>
                        <input type="text" name="fullName" id="fullName" maxlength="20" class="luxury-input" placeholder="John Doe">
                        <div class="error-text" id="fullName-error"></div>
                    </div>
                    <div class="form-group">
                        <label>Phone Number *</label>
                        <input type="tel" name="phoneNumber" id="phoneNumber" maxlength="10" class="luxury-input" placeholder="9876543210">
                        <div class="error-text" id="phoneNumber-error"></div>
                    </div>
                </div>

                <div class="form-group">
                    <label>Street Address *</label>
                    <textarea name="street" id="street" rows="3" maxlength="50" class="luxury-input" placeholder="House/Flat No., Building Name, Street"></textarea>
                    <div class="error-text" id="street-error"></div>
                </div>

                <div class="form-row">
                    <div class="form-group">
                        <label>City *</label>
                        <input type="text" name="city" id="city" maxlength="10" class="luxury-input" placeholder="Mumbai">
                        <div class="error-text" id="city-error"></div>
                    </div>
                    <div class="form-group">
                        <label>State *</label>
                        <input type="text" name="state" id="state" maxlength="10" class="luxury-input" placeholder="Maharashtra">
                        <div class="error-text" id="state-error"></div>
                    </div>
                </div>

                <div class="form-row">
                    <div class="form-group">
                        <label>Pincode *</label>
                        <input type="text" name="pincode" id="pincode" maxlength="6" class="luxury-input" placeholder="400001">
                        <div class="error-text" id="pincode-error"></div>
                    </div>
                    <div class="form-group">
                        <label>Address Type</label>
                        <div class="radio-group">
                            <label>
                                <input type="radio" name="addressType" value="Home" checked>  Home
                            </label>
                            <label>
                                <input type="radio" name="addressType" value="Work">  Work
                            </label>
                        </div>
                    </div>
                </div>

                <div class="checkbox-group">
                    <label style="display:flex; align-items:center; gap:10px; cursor:pointer;">
                        <input type="checkbox" id="makeDefault" name="isDefault" style="width: 18px; height: 18px;">
                        <span>Make this my default shipping address</span>
                    </label>
                </div>

                <div class="modal-actions">
                    <button type="button" class="btn-secondary" onclick="closeAddressModal()">Cancel</button>
                    <button type="submit" class="btn-primary" id="submitBtn">Save Address</button>
                </div>
            </form>
        </div>
    </div>

    <div id="couponModal" class="modal-overlay">
        <div class="modal-content" style="max-width: 450px; background: #fff;">
            <button class="close-modal" onclick="closeCouponModal()">×</button>
            <h2 class="section-title" style="text-align: center; border: none;">Exclusive Offers</h2>
            <p style="text-align: center; font-size: 0.9rem; color: #999; margin-bottom: 30px; font-family: 'Playfair Display', serif;">
                Apply a code to your luxury selection
            </p>
            <div id="availableCouponsList">
                <% if (availableCoupons && availableCoupons.length > 0) { %>
                    <% availableCoupons.forEach(coupon => { %>
                        <div class="coupon-item">
                            <div class="coupon-info">
                                <h5><%= coupon.code %></h5>
                                <p>
                                    <% if (coupon.discountType === 'percentage') { %>
                                        <%= coupon.discountValue %>% off
                                    <% } else { %>
                                        ₹<%= coupon.discountValue %> off
                                    <% } %>
                                    <% if (coupon.minOrder > 0) { %>
                                        on orders above ₹<%= coupon.minOrder %>
                                    <% } %>
                                </p>
                            </div>
                            <div class="select-coupon-link" onclick="selectCoupon('<%= coupon.code %>')">Apply</div>
                        </div>
                    <% }) %>
                <% } else { %>
                    <p style="text-align:center; color:#999;">No coupons available</p>
                <% } %>
            </div>
        </div>
    </div>

    <div id="flash-data"
         data-success='<%- JSON.stringify(successMessages || []) %>'
         data-error='<%- JSON.stringify(errorMessages || []) %>'>
    </div>
    <%- include('../partials/footer') %>

    <script>
        const Toast = Swal.mixin({
            toast: true,
            position: 'top-end',
            showConfirmButton: false,
            timer: 3000,
            timerProgressBar: true
        });

        let currentFormMode = 'add';
        const modal = document.getElementById("addressModal");

        function closeAddressModal() {
            modal.style.display = "none";
            clearErrors();
            document.getElementById('addressForm').reset();
            document.getElementById('addressId').value = '';
            document.getElementById('makeDefault').checked = false;
            document.querySelector('input[name="addressType"][value="Home"]').checked = true;
        }

        function clearErrors() {
            document.querySelectorAll('.error-text').forEach(el => el.textContent = '');
            document.querySelectorAll('.luxury-input').forEach(el => el.classList.remove('is-invalid'));
        }

        function displayErrors(errors) {
            clearErrors();
            errors.forEach(err => {
                const errorEl = document.getElementById(`${err.field}-error`);
                const inputEl = document.getElementById(err.field);
                if (errorEl && inputEl) {
                    errorEl.textContent = err.message;
                    inputEl.classList.add('is-invalid');
                }
            });
        }

        // Enhanced SweetAlert for Address Success
        async function showAddressSuccessMessage(mode, addressName = '') {
            const title = mode === 'add' ? 'Address Added!' : 'Address Updated!';
            const text = mode === 'add' 
                ? `Your shipping address has been successfully saved.` 
                : `Your address has been updated successfully.`;
            
            const result = await Swal.fire({
                icon: 'success',
                title: title,
                text: text,
                confirmButtonColor: '#7A5C4D',
                confirmButtonText: 'Continue',
                background: '#fff',
                backdrop: true,
                timer: 2500,
                showConfirmButton: true,
                willClose: () => {
                    window.location.reload();
                }
            });
        }

        // Add New Address Modal
        document.getElementById("addNewAddressBtn").onclick = () => {
            currentFormMode = 'add';
            document.getElementById("modalTitle").textContent = "Add New Address";
            document.getElementById("submitBtn").textContent = "Save Address";
            document.getElementById("addressForm").reset();
            document.getElementById("addressId").value = "";
            document.getElementById('makeDefault').checked = false;
            document.querySelector('input[name="addressType"][value="Home"]').checked = true;
            clearErrors();
            modal.style.display = "flex";
        };

        async function openEditModal(addressId) {
            try {
                const response = await fetch(`/checkout/address/get/${addressId}`);
                const data = await response.json();
                if (data.success) {
                    currentFormMode = 'edit';
                    const addr = data.address;
                    document.getElementById("modalTitle").textContent = "Edit Address";
                    document.getElementById("submitBtn").textContent = "Update Address";
                    document.getElementById("addressId").value = addr._id;
                    document.getElementById("fullName").value = addr.fullName || '';
                    document.getElementById("phoneNumber").value = addr.phoneNumber || '';
                    document.getElementById("street").value = addr.street || '';
                    document.getElementById("city").value = addr.city || '';
                    document.getElementById("state").value = addr.state || '';
                    document.getElementById("pincode").value = addr.pincode || '';
                    
                    document.querySelectorAll('input[name="addressType"]').forEach(radio => {
                        radio.checked = radio.value === addr.addressType;
                    });
                    document.getElementById("makeDefault").checked = addr.isDefault || false;
                    clearErrors();
                    modal.style.display = "flex";
                } else {
                    Toast.fire({ icon: 'error', title: data.message || 'Failed to load address' });
                }
            } catch (error) {
                console.error('Edit error:', error);
                Toast.fire({ icon: 'error', title: 'Failed to load address details' });
            }
        }

        async function deleteAddress(addressId) {
            const result = await Swal.fire({
                title: 'Delete Address?',
                text: "Are you sure you want to delete this address? This action cannot be undone.",
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#d33',
                cancelButtonColor: '#7A5C4D',
                confirmButtonText: 'Yes, delete it!',
                cancelButtonText: 'Cancel',
                background: '#fff'
            });
            if (result.isConfirmed) {
                Swal.fire({ title: 'Deleting...', allowOutsideClick: false, didOpen: () => Swal.showLoading() });
                try {
                    const response = await fetch(`/checkout/address/delete/${addressId}`, {
                        method: 'GET',
                        headers: { 'X-Requested-With': 'XMLHttpRequest' }
                    });
                    const data = await response.json();
                    if (data.success) {
                        await Swal.fire({ 
                            icon: 'success', 
                            title: 'Deleted!', 
                            text: 'Address has been removed successfully.', 
                            confirmButtonColor: '#7A5C4D',
                            timer: 1800
                        });
                        window.location.reload();
                    } else {
                        Swal.fire({ icon: 'error', title: 'Error!', text: data.message || 'Failed to delete', confirmButtonColor: '#7A5C4D' });
                    }
                } catch (error) {
                    Swal.fire({ icon: 'error', title: 'Error!', text: 'Something went wrong.', confirmButtonColor: '#7A5C4D' });
                }
            }
        }

        // Enhanced Address Form Submission with improved SweetAlert
        document.getElementById('addressForm').addEventListener('submit', async function(e) {
            e.preventDefault();
            const formData = new FormData(this);
            const data = Object.fromEntries(formData.entries());
            data.isDefault = data.isDefault === 'on';
            
            const submitBtn = document.getElementById('submitBtn');
            const originalText = submitBtn.innerHTML;
            submitBtn.innerHTML = '<span class="loading-spinner"></span> Saving...';
            submitBtn.disabled = true;
            
            try {
                const url = currentFormMode === 'add' ? '/checkout/address/add' : '/checkout/address/edit';
                const response = await fetch(url, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json', 'X-Requested-With': 'XMLHttpRequest' },
                    body: JSON.stringify(data)
                });
                const result = await response.json();
                if (result.success) {
                    closeAddressModal();
                    await showAddressSuccessMessage(currentFormMode);
                } else {
                    if (result.errors && result.errors.length > 0) {
                        displayErrors(result.errors);
                        Swal.fire({ 
                            icon: 'error', 
                            title: 'Validation Error', 
                            text: 'Please fix the highlighted fields', 
                            confirmButtonColor: '#7A5C4D' 
                        });
                    } else {
                        Swal.fire({ 
                            icon: 'error', 
                            title: 'Error!', 
                            text: result.message || 'Failed to save address', 
                            confirmButtonColor: '#7A5C4D' 
                        });
                    }
                }
            } catch (error) {
                console.error('Submit error:', error);
                Swal.fire({ 
                    icon: 'error', 
                    title: 'Something went wrong', 
                    text: 'Please try again later.', 
                    confirmButtonColor: '#7A5C4D' 
                });
            } finally {
                submitBtn.innerHTML = originalText;
                submitBtn.disabled = false;
            }
        });

        // Event delegation for address actions
        document.getElementById('addressListContainer')?.addEventListener('click', (e) => {
            const editBtn = e.target.closest('.edit-address-btn');
            const deleteBtn = e.target.closest('.delete-address-btn');
            if (editBtn) {
                const addrId = editBtn.getAttribute('data-address-id');
                if (addrId) openEditModal(addrId);
            }
            if (deleteBtn) {
                const addrId = deleteBtn.getAttribute('data-address-id');
                if (addrId) deleteAddress(addrId);
            }
        });

        function updateSelected() {
            const addr = document.querySelector('input[name="addressId"]:checked');
            document.getElementById('selectedAddress').value = addr ? addr.value : '';
            document.querySelectorAll('.address-card').forEach(c => c.classList.remove('selected'));
            if (addr) addr.closest('.address-card').classList.add('selected');
        }

        function updatePayment() {
            const pay = document.querySelector('input[name="paymentMethod"]:checked');
            document.getElementById('selectedPayment').value = pay ? pay.value : '';
        }

        document.querySelectorAll('input[name="addressId"]').forEach(r => {
            r.addEventListener('change', updateSelected);
        });

        document.querySelectorAll('input[name="paymentMethod"], .payment-option').forEach(el => {
            el.addEventListener('change', e => {
                document.querySelectorAll('.payment-option').forEach(p => p.classList.remove('selected'));
                if (e.target.closest('.payment-option')) {
                    e.target.closest('.payment-option').classList.add('selected');
                }
                updatePayment();
            });
        });

        document.querySelectorAll('.payment-option').forEach(opt => {
            opt.addEventListener('click', () => {
                const radio = opt.querySelector('input[type="radio"]');
                if (radio) {
                    radio.checked = true;
                    updatePayment();
                }
            });
        });

        updateSelected();
        updatePayment();

        const flashDiv = document.getElementById("flash-data");
        if (flashDiv) {
            const successMessages = JSON.parse(flashDiv.dataset.success || "[]");
            const errorMessages = JSON.parse(flashDiv.dataset.error || "[]");
            successMessages.forEach(msg => Toast.fire({ icon: 'success', title: msg }));
            errorMessages.forEach(msg => Toast.fire({ icon: 'error', title: msg }));
        }

        const stockIssue = <%= stockIssue ? "true" : "false" %>;
        const stockMessage = "<%= stockMessage %>";
        if (stockIssue && stockMessage) {
            Toast.fire({ icon: 'error', title: stockMessage });
        }

        modal.onclick = e => { if (e.target === modal) closeAddressModal(); };

        // Coupon functions
        const couponModal = document.getElementById("couponModal");
        function openCouponModal() { couponModal.style.display = "flex"; }
        function closeCouponModal() { couponModal.style.display = "none"; }
        
        function selectCoupon(code) {
            document.getElementById('couponCode').value = code;
            closeCouponModal();
            applyCoupon();
        }

        async function applyCoupon() {
            const couponCode = document.getElementById('couponCode').value.trim();
            if (!couponCode) {
                return Toast.fire({ icon: 'warning', title: 'Please enter a code' });
            }
            try {
                const response = await fetch('/checkout/apply-coupon', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({code: couponCode })
                });
                const data = await response.json();
                if (data.success) {
                    document.getElementById('discountLine').style.display = 'flex';
                    document.getElementById('discountAmount').textContent = `- ₹${data.discountAmount.toLocaleString('en-IN')}`;
                    document.getElementById('grandTotalDisplay').textContent = `₹${data.newTotal.toLocaleString('en-IN')}`;
                    document.getElementById('appliedCouponHidden').value = couponCode;
                    Toast.fire({ icon: 'success', title: 'Discount Applied!' });
                } else {
                    Toast.fire({ icon: 'error', title: data.message || 'Invalid Coupon' });
                }
            } catch (error) {
                Toast.fire({ icon: 'error', title: 'Error applying coupon' });
            }
        }

        window.onclick = function(event) {
            if (event.target == couponModal) closeCouponModal();
            if (event.target == modal) closeAddressModal();
        }

        // Place order handler
        document.getElementById("placeOrderForm").addEventListener("submit", async function (e) {
            e.preventDefault();
            const paymentMethod = document.getElementById("selectedPayment").value;
            const addressId = document.getElementById("selectedAddress").value;
            if (!addressId) return Toast.fire({ icon: 'error', title: 'Please select an address' });
            if (!paymentMethod) return Toast.fire({ icon: 'error', title: 'Please select a payment method' });
            if (paymentMethod === "cod" || paymentMethod === "wallet") {
                this.submit();
                return;
            }
            if (paymentMethod === "razorpay") {
                startRazorpayPayment();
            }
        });

        async function startRazorpayPayment() {
            const addressId = document.getElementById("selectedAddress").value;
            const totalText = document.getElementById("grandTotalDisplay").textContent;
            const amount = parseInt(totalText.replace(/[₹, ]/g, ""));
            if (!addressId) return Toast.fire({ icon: 'error', title: 'Please select a delivery address' });
            try {
                const res = await fetch("/create-order", {
                    method: "POST",
                    headers: { "Content-Type": "application/json" },
                    body: JSON.stringify({ amount, addressId }),
                });
                const data = await res.json();
                if (!data.success) return Swal.fire("Error", data.message || "Failed to initiate payment", "error");
                const { orderId, razorpayOrder } = data;
                const options = {
                    key: "<%= razorpayKey %>",
                    amount: razorpayOrder.amount,
                    currency: "INR",
                    order_id: razorpayOrder.id,
                    name: "ELARA Luxury Jewelry",
                    description: "Luxury Jewelry Order",
                    handler: async function (response) {
                        const addressId = document.getElementById("selectedAddress").value;
                        const verifyRes = await fetch("/verify-payment", {
                            method: "POST",
                            headers: { "Content-Type": "application/json" },
                            body: JSON.stringify({
                                razorpay_order_id: response.razorpay_order_id,
                                razorpay_payment_id: response.razorpay_payment_id,
                                razorpay_signature: response.razorpay_signature,
                                orderId: orderId,
                                addressId: addressId
                            })
                        });
                        const verifyData = await verifyRes.json();
                        if (verifyData.success) {
                            Swal.fire({ icon: 'success', title: 'Payment Successful!', text: 'Your order has been placed successfully.', confirmButtonColor: '#7A5C4D' })
                                .then(() => window.location.href = `/order-success/${orderId || verifyData.orderId}`);
                        } else {
                            Swal.fire({ icon: 'error', title: 'Verification Failed', text: verifyData.message || "Payment verification failed", confirmButtonColor: '#7A5C4D' });
                        }
                    },
                    theme: { color: "#7A5C4D" }
                };
 const rzp = new Razorpay(options);

rzp.on("payment.failed", function (response) {
    console.log("Payment Failed:", response.error);

  
    window.location.href = `/payment-failed/${orderId}`;
});

rzp.open();
            } catch (error) {
                console.error(error);
                Swal.fire("Error", "Something went wrong while initiating payment", "error");
            }
        }
    </script>
</body>
</html>