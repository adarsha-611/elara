<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Wishlist | ELARA</title>

    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;600&family=Poppins:wght@300;400;500&display=swap" rel="stylesheet">
    <style>
        :root {
    --bg-color: #FAF7F5;
    --text-dark: #4A302C;
    --accent-gold: #A17C6B;
    --border-color: #E0D6D0;
    --white: #FFFFFF;
}

body {
    margin: 0;
    font-family: 'Poppins', sans-serif;
    background-color: var(--bg-color);
    color: var(--text-dark);
}

.container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 60px 20px;
}

/* Header/Navigation */
header {
    background-color: var(--white);
    border-bottom: 1px solid var(--border-color);
    padding: 20px 0;
}

.nav-container {
    max-width: 1200px;
    margin: 0 auto;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0 20px;
}

.logo {
    font-family: 'Playfair Display', serif;
    letter-spacing: 2px;
    font-size: 24px;
}

nav a {
    text-decoration: none;
    color: var(--text-dark);
    margin: 0 15px;
    font-size: 13px;
    letter-spacing: 1px;
}

/* Wishlist Header */
.wishlist-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 40px;
}

.page-title {
    font-family: 'Playfair Display', serif;
    font-size: 32px;
    font-weight: 400;
}

.search-bar {
    display: flex;
    border: 1px solid var(--border-color);
    border-radius: 4px;
    overflow: hidden;
    background: var(--white);
}

.search-bar input {
    border: none;
    padding: 10px 15px;
    outline: none;
}

/* Product Cards */
.product-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 25px;
}

.product-card {
    background: var(--white);
    border-radius: 8px;
    overflow: hidden;
    box-shadow: 0 4px 15px rgba(74, 48, 44, 0.05);
    transition: transform 0.3s ease;
}

.product-card:hover {
    transform: translateY(-5px);
}

.img-container {
    position: relative;
    background: #F0EBE7; /* Soft base for images */
}

.img-container img {
    width: 100%;
    display: block;
    aspect-ratio: 1/1;
    object-fit: cover;
}

.wishlist-btn {
    position: absolute;
    top: 10px;
    right: 10px;
    background: var(--white);
    border: none;
    border-radius: 50%;
    width: 30px;
    height: 30px;
    color: #e74c3c;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 2px 5px rgba(0,0,0,0.1);
}

.product-info {
    padding: 20px;
    text-align: center;
}

.product-info h3 {
    font-size: 14px;
    font-weight: 500;
    margin-bottom: 8px;
}

.price {
    color: var(--accent-gold);
    font-weight: 600;
    margin-bottom: 15px;
}

.add-to-cart {
    background-color: var(--accent-gold);
    color: var(--white);
    border: none;
    width: 100%;
    padding: 10px 0;
    border-radius: 4px;
    cursor: pointer;
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 1px;
}

/* Footer Style from Theme */
footer {
    background-color: var(--text-dark);
    color: var(--bg-color);
    padding: 80px 0 20px;
}

.footer-container {
    max-width: 1200px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 40px;
    padding: 0 20px;
}

.footer-col h4 {
    font-family: 'Playfair Display', serif;
    font-size: 18px;
    margin-bottom: 25px;
}

.footer-col p {
    font-size: 13px;
    margin-bottom: 15px;
    opacity: 0.8;
}

.subscribe-box {
    display: flex;
    border-bottom: 1px solid var(--accent-gold);
    padding-bottom: 5px;
}

.subscribe-box input {
    background: transparent;
    border: none;
    color: var(--white);
    outline: none;
}

.pagination {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 15px;
    margin-top: 60px;
}

.pagination span {
    cursor: pointer;
    font-size: 14px;
}

.pagination .active {
    background-color: var(--accent-gold);
    color: var(--white);
    padding: 5px 12px;
    border-radius: 4px;
}
.toast {
    position: fixed;
    top: 30px;
    left: 80%;
    transform: translateX(-50%) translateY(-20px);

    background: #28a745;   
    color: #fff;

    padding: 18px 35px;    
    font-size: 16px;
    font-weight: 500;

    border-radius: 10px;
    box-shadow: 0 10px 30px rgba(0,0,0,0.15);

    opacity: 0;
    transition: all 0.3s ease;
    z-index: 9999;
}

.toast.show {
    opacity: 1;
    transform: translateX(-50%) translateY(0);
}
    </style>
</head>
<body>

  <%- include('../partials/header') %>


    <main class="container">
        <div class="wishlist-header">
            <h2 class="page-title">Wishlist</h2>
            <div class="search-bar">
                <input type="text" placeholder="Search products...">
                <button>search</button>
            </div>
        </div>

       <section class="product-grid">

<% if (!wishlistItems || wishlistItems.length === 0) { %>
    <p>Your wishlist is empty ❤️</p>
<% } %>

<% wishlistItems.forEach(product => { %>

    <div class="product-card">
        <div class="img-container">
            <img 
              src="<%= product.variants?.[0]?.images?.[0] %>" 
              alt="<%= product.name %>">

            <button 
              class="wishlist-btn"
              data-id="<%= product._id %>">
              ❤
            </button>
        </div>

        <div class="product-info">
            <h3><%= product.name %></h3>

            <p class="price">
                ₹ <%= product.price || product.variants?.[0]?.price %>
            </p>

            <form action="/wishlist/addtocart/<%= product._id %>" method="POST">
                <button type="submit" class="add-to-cart">
                    Add to Cart
                </button>
            </form>
        </div>
    </div>

<% }) %>   <!-- ✅ CLOSE LOOP HERE -->

</section>

<% if (successMessage) { %>
    <div id="toast" class="toast">
        <%= successMessage %>
    </div>
<% } %>

        <div class="pagination">
            <span class="arrow">‹</span>
            <span>1</span>
            <span class="active">2</span>
            <span>3</span>
            <span>4</span>
            <span class="arrow">›</span>
        </div>
    </main>
    <script>
document.querySelectorAll(".wishlist-btn").forEach(btn => {
    btn.addEventListener("click", async function () {

        const productId = this.dataset.id;

        const res = await fetch(`/wishlist/toggle/${productId}`, {
            method: "POST"
        });

        const data = await res.json();

        if (data.status === "removed") {
            this.closest(".product-card").remove();
        }
    });
});
</script>
<script>
    const toast = document.getElementById("toast");

    if (toast) {
        toast.classList.add("show");

        setTimeout(() => {
            toast.classList.remove("show");
        }, 3000);
    }
</script>
</body>
</html>