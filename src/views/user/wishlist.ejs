<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Wishlist | ELARA</title>

    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;600&family=Poppins:wght@300;400;500&display=swap" rel="stylesheet">
    <style>
        :root {
    --bg-color: #FAF7F5;
    --text-dark: #4A302C;
    --accent-gold: #A17C6B;
    --border-color: #E0D6D0;
    --white: #FFFFFF;
}

body {
    margin: 0;
    font-family: 'Poppins', sans-serif;
    background-color: var(--bg-color);
    color: var(--text-dark);
}

.container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 60px 20px;
}

/* Header/Navigation */
header {
    background-color: var(--white);
    border-bottom: 1px solid var(--border-color);
    padding: 20px 0;
}

.nav-container {
    max-width: 1200px;
    margin: 0 auto;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0 20px;
}

.logo {
    font-family: 'Playfair Display', serif;
    letter-spacing: 2px;
    font-size: 24px;
}

nav a {
    text-decoration: none;
    color: var(--text-dark);
    margin: 0 15px;
    font-size: 13px;
    letter-spacing: 1px;
}


.wishlist-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 40px;
}

.page-title {
    font-family: 'Playfair Display', serif;
    font-size: 32px;
    font-weight: 400;
}

.search-bar {
    display: flex;
    border: 1px solid var(--border-color);
    border-radius: 4px;
    overflow: hidden;
    background: var(--white);
}

.search-bar input {
    border: none;
    padding: 10px 15px;
    outline: none;
}

/* Product Cards */
.product-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 25px;
}

.product-card {
    background: var(--white);
    border-radius: 8px;
    overflow: hidden;
    box-shadow: 0 4px 15px rgba(74, 48, 44, 0.05);
    transition: transform 0.3s ease;
}

.product-card:hover {
    transform: translateY(-5px);
}

.img-container {
    position: relative;
    background: #F0EBE7; /* Soft base for images */
}

.img-container img {
    width: 100%;
    display: block;
    aspect-ratio: 1/1;
    object-fit: cover;
}

.wishlist-btn {
    position: absolute;
    top: 10px;
    right: 10px;
    background: var(--white);
    border: none;
    border-radius: 50%;
    width: 30px;
    height: 30px;
    color: #e74c3c;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 2px 5px rgba(0,0,0,0.1);
}

.product-info {
    padding: 20px;
    text-align: center;
}

.product-info h3 {
    font-size: 14px;
    font-weight: 500;
    margin-bottom: 8px;
}

.price {
    color: var(--accent-gold);
    font-weight: 600;
    margin-bottom: 15px;
}

.add-to-cart {
    background-color: var(--accent-gold);
    color: var(--white);
    border: none;
    width: 100%;
    padding: 10px 0;
    border-radius: 4px;
    cursor: pointer;
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 1px;
}

/* Footer Style from Theme */
footer {
    background-color: var(--text-dark);
    color: var(--bg-color);
    padding: 80px 0 20px;
}

.footer-container {
    max-width: 1200px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 40px;
    padding: 0 20px;
}

.footer-col h4 {
    font-family: 'Playfair Display', serif;
    font-size: 18px;
    margin-bottom: 25px;
}

.footer-col p {
    font-size: 13px;
    margin-bottom: 15px;
    opacity: 0.8;
}

.subscribe-box {
    display: flex;
    border-bottom: 1px solid var(--accent-gold);
    padding-bottom: 5px;
}

.subscribe-box input {
    background: transparent;
    border: none;
    color: var(--white);
    outline: none;
}

.pagination {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 15px;
    margin-top: 60px;
}

.pagination span {
    cursor: pointer;
    font-size: 14px;
}

.pagination .active {
    background-color: var(--accent-gold);
    color: var(--white);
    padding: 5px 12px;
    border-radius: 4px;
}
.toast {
    position: fixed;
    top: 30px;
    left: 80%;
    transform: translateX(-50%) translateY(-20px);

    color: #fff;
    padding: 18px 35px;    
    font-size: 16px;
    font-weight: 500;

    border-radius: 10px;
    box-shadow: 0 10px 30px rgba(0,0,0,0.15);

    opacity: 0;
    transition: all 0.3s ease;
    z-index: 9999;
}

.toast.show {
    opacity: 1;
    transform: translateX(-50%) translateY(0);
}


.toast.success {
    background: #28a745;
}


.toast.error {
    background: #dc3545;
}
    </style>
</head>
<body>

  <%- include('../partials/header') %>


    <main class="container">
        <div class="wishlist-header">
            <h2 class="page-title">Wishlist</h2>
            <form class="search-bar" action="/wishlist" method="GET">
    <input 
        type="text" 
        name="search" 
        placeholder="Search products..." 
        value="<%= search %>">
    <button type="submit">search</button>
</form>
        </div>

 <section class="product-grid">

<% if (!wishlistItems || wishlistItems.length === 0) { %>
    <p>Your wishlist is empty ❤️</p>
<% } else { %>

<% wishlistItems.forEach(product => { %>
<div class="product-card">
    <div class="img-container">
        <% if (product.variants && product.variants.length > 0 && product.variants[0].images && product.variants[0].images.length > 0) { %>
            <img 
                src="<%= product.variants[0].images[0] %>" 
                alt="<%= product.name %>"
                onerror="this.src='/images/placeholder.jpg'">
        <% } else if (product.images && product.images.length > 0) { %>
            <img 
                src="<%= product.images[0] %>" 
                alt="<%= product.name %>">
        <% } else { %>
            <img src="/images/placeholder.jpg" alt="No image">
        <% } %>

        <button 
            class="wishlist-btn"
            data-id="<%= product._id %>">
            ❤
        </button>
    </div>

    <div class="product-info">
        <h3><%= product.name %></h3>

        <p class="price">
            ₹ <%= product.price || (product.variants?.[0]?.price || 'N/A') %>
        </p>

        <!-- ✅ Changed to button with onclick instead of form -->
        <button 
            type="button"
            class="add-to-cart"
            onclick="addToCartFromWishlist('<%= product._id %>', this)">
            Add to Cart
        </button>
    </div>
</div>
<% }) %>

<% } %>

</section>

<% if (successMessage) { %>
    <div id="toast" class="toast">
        <%= successMessage %>
    </div>
<% } %>

        <div class="pagination">

    <% if (currentPage > 1) { %>
        <a href="/wishlist?page=<%= currentPage - 1 %>&search=<%= search %>">‹</a>
    <% } %>

    <% for (let i = 1; i <= totalPages; i++) { %>
        <a 
          href="/wishlist?page=<%= i %>&search=<%= search %>" 
          class="<%= i === currentPage ? 'active' : '' %>">
          <%= i %>
        </a>
    <% } %>

    <% if (currentPage < totalPages) { %>
        <a href="/wishlist?page=<%= currentPage + 1 %>&search=<%= search %>">›</a>
    <% } %>

</div>
    </main>
  <script>
document.addEventListener('DOMContentLoaded', () => {

    // Wishlist Heart Toggle
    document.querySelectorAll(".wishlist-btn").forEach(btn => {
        btn.addEventListener("click", async function () {
            const productId = this.dataset.id;
            const card = this.closest(".product-card");

            try {
                const res = await fetch(`/wishlist/toggle/${productId}`, {
                    method: "POST",
                    headers: { "Content-Type": "application/json" }
                });

                const data = await res.json();

                if (data.success) {
                    if (data.status === "removed") {
                        card.remove();
                        showToast("Removed from wishlist", "success");
                    } else {
                        this.style.color = "#e74c3c";
                        showToast("Added to wishlist", "success");
                    }
                } else {
                    showToast(data.message || "Failed to update wishlist", "error");
                }
            } catch (err) {
                console.error("Wishlist toggle failed", err);
                showToast("Something went wrong", "error");
            }
        });
    });

});

// ---------- Add to Cart from Wishlist ----------
async function addToCartFromWishlist(productId, buttonElement) {
    const originalText = buttonElement.innerText;
    buttonElement.innerText = "Adding...";
    buttonElement.disabled = true;

    try {
        const res = await fetch(`/wishlist/addtocart/${productId}`, {
            method: "POST",
            headers: { "Content-Type": "application/json" }
        });

        const data = await res.json();

        if (data.success) {
            showToast("Product added to cart successfully!", "success");

            // Remove card after adding to cart
            buttonElement.closest('.product-card').remove();
        } else {
            showToast(data.message || "Failed to add to cart", "error");
        }

    } catch (error) {
        console.error("Add to cart from wishlist failed:", error);
        showToast("Server error. Please try again.", "error");
    } finally {
        buttonElement.innerText = originalText;
        buttonElement.disabled = false;
    }
}

// ---------- Toast ----------
function showToast(message, type = "success") {
    const toast = document.createElement('div');
    toast.className = `toast show ${type}`;
    toast.textContent = message;

    document.body.appendChild(toast);

    setTimeout(() => {
        toast.classList.remove("show");
        setTimeout(() => toast.remove(), 300);
    }, 3000);
}
</script>
</body>
</html>