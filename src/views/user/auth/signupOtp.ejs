<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Verify Your Account - ELARA</title>
    
    <script src="https://cdn.tailwindcss.com"></script>
    
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet">
    
    <style>
        body {
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
        }
        
        .otp-input {
            width: 52px;
            height: 52px;
            text-align: center;
            font-size: 20px;
            font-weight: 500;
            border: 1.5px solid #d0c4b8;
            border-radius: 8px;
            background-color: #faf8f6;
            color: #4a3f35;
            transition: all 0.2s ease;
            outline: none;
        }
        
        /* Red border for validation errors */
        .otp-input.error-border {
            border-color: #ef4444;
            background-color: #fef2f2;
        }
        
        .otp-input:focus {
            border-color: #a78a7f;
            background-color: #ffffff;
            box-shadow: 0 0 0 3px rgba(167, 138, 127, 0.1);
        }
        
        .otp-input::-webkit-outer-spin-button,
        .otp-input::-webkit-inner-spin-button {
            -webkit-appearance: none;
            margin: 0;
        }
        
        .otp-input[type=number] {
            -moz-appearance: textfield;
        }
        
        @media (max-width: 640px) {
            .otp-input {
                width: 44px;
                height: 44px;
                font-size: 18px;
            }
        }
    </style>
</head>
<body class="bg-[#e8dfd6] min-h-screen flex items-center justify-center p-4">
    
    <div class="bg-white rounded-2xl shadow-lg p-8 sm:p-12 w-full max-w-xl">
        
        <div class="text-center mb-8">
            <h1 class="text-3xl sm:text-4xl font-light text-gray-800 tracking-wide mb-2">
                ELARA
            </h1>
            <p class="text-sm text-gray-500 font-light tracking-wide">
                Elegance Redefined
            </p>
        </div>
        
        <h2 class="text-2xl font-normal text-gray-700 text-center mb-4">
            Verify Your Account
        </h2>

        <% if (locals.error && error.length > 0) { %>
            <div class="bg-red-50 border border-red-200 text-red-600 px-4 py-3 rounded-lg mb-6 text-sm text-center">
                <%= error %>
            </div>
        <% } %>

        <% if (locals.success && success.length > 0) { %>
            <div class="bg-green-50 border border-green-200 text-green-600 px-4 py-3 rounded-lg mb-6 text-sm text-center">
                <%= success %>
            </div>
        <% } %>
        
        <p class="text-sm text-gray-500 text-center mb-6 leading-relaxed">
            We've sent a one-time password to your email <span class="font-medium text-gray-700"><%= email %></span>. Please enter the 6-digit code below to complete your sign-up.
        </p>
        
        <p class="text-xs text-gray-400 text-center mb-8">
            Resend OTP in <span id="timer" class="font-medium text-gray-600">00:45</span> sec
        </p>
        
        <form action="/verify-otp" method="POST" id="otpForm" novalidate>
            
            <div class="flex justify-center gap-2 sm:gap-3 mb-2">
                <input type="number" maxlength="1" class="otp-input" name="otp1" id="otp1" autocomplete="off" pattern="[0-9]" inputmode="numeric" />
                <input type="number" maxlength="1" class="otp-input" name="otp2" id="otp2" autocomplete="off" pattern="[0-9]" inputmode="numeric" />
                <input type="number" maxlength="1" class="otp-input" name="otp3" id="otp3" autocomplete="off" pattern="[0-9]" inputmode="numeric" />
                <input type="number" maxlength="1" class="otp-input" name="otp4" id="otp4" autocomplete="off" pattern="[0-9]" inputmode="numeric" />
                <input type="number" maxlength="1" class="otp-input" name="otp5" id="otp5" autocomplete="off" pattern="[0-9]" inputmode="numeric" />
                <input type="number" maxlength="1" class="otp-input" name="otp6" id="otp6" autocomplete="off" pattern="[0-9]" inputmode="numeric" />
            </div>

            <div id="otpError" class="text-red-500 text-xs text-center mb-6 min-h-[1rem]"></div>
            
            <input type="hidden" name="otp" id="completeOtp" value="">
            
            <button 
                type="submit" 
                class="w-full bg-[#a78a7f] hover:bg-[#8f7568] text-white font-medium py-3.5 rounded-lg transition-colors duration-200 uppercase tracking-wide text-sm shadow-sm"
            >
                Verify Account
            </button>
            
        </form>
        
        <div class="text-center mt-6">
            <p class="text-sm text-gray-500 mb-1">Didn't receive the code?</p>
            <button 
                id="resendBtn"
                type="button"
                class="text-sm text-gray-400 hover:text-[#a78a7f] transition-colors duration-200 disabled:cursor-not-allowed font-medium underline"
                disabled
            >
                Click to resend
            </button>
        </div>
    </div>
    
    <script>
        const otpInputs = document.querySelectorAll('.otp-input');
        const completeOtpField = document.getElementById('completeOtp');
        const otpError = document.getElementById('otpError');
        const otpForm = document.getElementById('otpForm');
        
        // Auto-focus Logic
        otpInputs.forEach((input, index) => {
            input.addEventListener('input', (e) => {
                const value = e.target.value;
                
                // Clear errors on input
                otpError.textContent = '';
                input.classList.remove('error-border');

                if (value.length > 1) {
                    e.target.value = value.slice(0, 1);
                }
                
                if (value.length === 1 && index < otpInputs.length - 1) {
                    otpInputs[index + 1].focus();
                }
                updateCompleteOtp();
            });
            
            input.addEventListener('keydown', (e) => {
                if (e.key === 'Backspace' && !e.target.value && index > 0) {
                    otpInputs[index - 1].focus();
                }
            });
            
            input.addEventListener('paste', (e) => {
                e.preventDefault();
                const pasteData = e.clipboardData.getData('text').slice(0, 6);
                pasteData.split('').forEach((char, i) => {
                    if (otpInputs[i] && /^\d$/.test(char)) {
                        otpInputs[i].value = char;
                        otpInputs[i].classList.remove('error-border');
                    }
                });
                updateCompleteOtp();
                otpError.textContent = '';
            });
        });
        
        function updateCompleteOtp() {
            completeOtpField.value = Array.from(otpInputs).map(input => input.value).join('');
        }

        // --- Client-side Validation ---
        otpForm.addEventListener('submit', (e) => {
            updateCompleteOtp();
            if (completeOtpField.value.length < 6) {
                e.preventDefault();
                otpError.textContent = 'Please enter the complete 6-digit verification code.';
                otpInputs.forEach(input => {
                    if (!input.value) input.classList.add('error-border');
                });
            }
        });
        
        // --- Timer Logic ---
        let timeLeft = 45;
        const timerElement = document.getElementById('timer');
        const resendBtn = document.getElementById('resendBtn');
        
        function updateTimer() {
            const minutes = Math.floor(timeLeft / 60);
            const seconds = timeLeft % 60;
            timerElement.textContent = `${String(minutes).padStart(2, '0')}:${String(seconds).padStart(2, '0')}`;
            
            if (timeLeft <= 0) {
                clearInterval(timerInterval);
                resendBtn.disabled = false;
                resendBtn.classList.remove('text-gray-400');
                resendBtn.classList.add('text-[#a78a7f]', 'cursor-pointer');
            }
            timeLeft--;
        }
        
        const timerInterval = setInterval(updateTimer, 1000);
        updateTimer();

        // Resend Logic
        resendBtn.addEventListener('click', async () => {
            if (!resendBtn.disabled) {
                // ... Existing resend logic ...
                // Note: I kept your logic but removed the alert to keep the UI clean
                timeLeft = 45;
                resendBtn.disabled = true;
                resendBtn.classList.replace('text-[#a78a7f]', 'text-gray-400');
                otpInputs.forEach(input => {
                    input.value = '';
                    input.classList.remove('error-border');
                });
                otpError.textContent = '';
                otpInputs[0].focus();
            }
        });

        window.addEventListener('load', () => otpInputs[0].focus());
    </script>
</body>
</html>