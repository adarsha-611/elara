<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Verify Your Account - ELARA</title>
    
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet">
    
    <style>
        body {
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
        }
        
        .otp-input {
            width: 52px;
            height: 52px;
            text-align: center;
            font-size: 20px;
            font-weight: 500;
            border: 1.5px solid #d0c4b8;
            border-radius: 8px;
            background-color: #faf8f6;
            color: #4a3f35;
            transition: all 0.2s ease;
            outline: none;
        }
        
        .otp-input:focus {
            border-color: #a78a7f;
            background-color: #ffffff;
            box-shadow: 0 0 0 3px rgba(167, 138, 127, 0.1);
        }
        
        .otp-input::-webkit-outer-spin-button,
        .otp-input::-webkit-inner-spin-button {
            -webkit-appearance: none;
            margin: 0;
        }
        
        .otp-input[type=number] {
            -moz-appearance: textfield;
        }
        
        @media (max-width: 640px) {
            .otp-input {
                width: 44px;
                height: 44px;
                font-size: 18px;
            }
        }
    </style>
</head>
<body class="bg-[#e8dfd6] min-h-screen flex items-center justify-center p-4">
    
    <!-- OTP Verification Card -->
    <div class="bg-white rounded-2xl shadow-lg p-8 sm:p-12 w-full max-w-xl">
        
        <!-- Brand Logo/Name -->
        <div class="text-center mb-8">
            <h1 class="text-3xl sm:text-4xl font-light text-gray-800 tracking-wide mb-2">
                ELARA
            </h1>
            <p class="text-sm text-gray-500 font-light tracking-wide">
                Elegance Redefined
            </p>
        </div>
        
        <!-- Page Title -->
        <h2 class="text-2xl font-normal text-gray-700 text-center mb-4">
            Verify Your Account
        </h2>
        
        <!-- Description Text -->
        <p class="text-sm text-gray-500 text-center mb-6 leading-relaxed">
            We've sent a one-time password to your email. Please enter the 6-digit code below to complete your sign-up.
        </p>
        
        <!-- Resend Timer -->
        <p class="text-xs text-gray-400 text-center mb-8">
            Resend OTP in <span id="timer" class="font-medium text-gray-600">00:45</span> sec
        </p>
        
        <!-- OTP Verification Form -->
        <form action="/verify-otp" method="POST" id="otpForm">
            
            <!-- OTP Input Boxes -->
            <div class="flex justify-center gap-2 sm:gap-3 mb-8">
                <input 
                    type="number" 
                    maxlength="1" 
                    class="otp-input" 
                    name="otp1" 
                    id="otp1"
                    required
                    autocomplete="off"
                    pattern="[0-9]"
                    inputmode="numeric"
                />
                <input 
                    type="number" 
                    maxlength="1" 
                    class="otp-input" 
                    name="otp2" 
                    id="otp2"
                    required
                    autocomplete="off"
                    pattern="[0-9]"
                    inputmode="numeric"
                />
                <input 
                    type="number" 
                    maxlength="1" 
                    class="otp-input" 
                    name="otp3" 
                    id="otp3"
                    required
                    autocomplete="off"
                    pattern="[0-9]"
                    inputmode="numeric"
                />
                <input 
                    type="number" 
                    maxlength="1" 
                    class="otp-input" 
                    name="otp4" 
                    id="otp4"
                    required
                    autocomplete="off"
                    pattern="[0-9]"
                    inputmode="numeric"
                />
                <input 
                    type="number" 
                    maxlength="1" 
                    class="otp-input" 
                    name="otp5" 
                    id="otp5"
                    required
                    autocomplete="off"
                    pattern="[0-9]"
                    inputmode="numeric"
                />
                <input 
                    type="number" 
                    maxlength="1" 
                    class="otp-input" 
                    name="otp6" 
                    id="otp6"
                    required
                    autocomplete="off"
                    pattern="[0-9]"
                    inputmode="numeric"
                />
            </div>
            
            <!-- Hidden field to store complete OTP -->
            <input type="hidden" name="otp" id="completeOtp" value="">
            
            <!-- Verify Button -->
            <button 
                type="submit" 
                class="w-full bg-[#a78a7f] hover:bg-[#8f7568] text-white font-medium py-3.5 rounded-lg transition-colors duration-200 uppercase tracking-wide text-sm shadow-sm"
            >
                Verify Account
            </button>
            
        </form>
        
        <!-- Resend Link -->
        <div class="text-center mt-6">
            <p class="text-sm text-gray-500 mb-1">Didn't receive the code?</p>
            <button 
                id="resendBtn"
                type="button"
                class="text-sm text-gray-400 hover:text-[#a78a7f] transition-colors duration-200 disabled:cursor-not-allowed font-medium underline"
                disabled
            >
                Click to resend
            </button>
        </div>
        
    </div>
    
    <!-- JavaScript for OTP Input Auto-focus and Timer -->
    <script>
        // OTP Input Auto-focus Logic
        const otpInputs = document.querySelectorAll('.otp-input');
        const completeOtpField = document.getElementById('completeOtp');
        
        otpInputs.forEach((input, index) => {
            // Auto-focus next input on entry
            input.addEventListener('input', (e) => {
                const value = e.target.value;
                
                // Only allow single digit
                if (value.length > 1) {
                    e.target.value = value.slice(0, 1);
                }
                
                // Move to next input
                if (value.length === 1 && index < otpInputs.length - 1) {
                    otpInputs[index + 1].focus();
                }
                
                // Update hidden field with complete OTP
                updateCompleteOtp();
            });
            
            // Handle backspace
            input.addEventListener('keydown', (e) => {
                if (e.key === 'Backspace' && !e.target.value && index > 0) {
                    otpInputs[index - 1].focus();
                }
            });
            
            // Paste handling
            input.addEventListener('paste', (e) => {
                e.preventDefault();
                const pasteData = e.clipboardData.getData('text').slice(0, 6);
                
                pasteData.split('').forEach((char, i) => {
                    if (otpInputs[i] && /^\d$/.test(char)) {
                        otpInputs[i].value = char;
                    }
                });
                
                // Focus last filled input
                const lastIndex = Math.min(pasteData.length, otpInputs.length) - 1;
                if (lastIndex >= 0) {
                    otpInputs[lastIndex].focus();
                }
                
                updateCompleteOtp();
            });
        });
        
        // Update complete OTP hidden field
        function updateCompleteOtp() {
            const otp = Array.from(otpInputs).map(input => input.value).join('');
            completeOtpField.value = otp;
        }
        
        // Countdown Timer Logic
        let timeLeft = 45;
        const timerElement = document.getElementById('timer');
        const resendBtn = document.getElementById('resendBtn');
        
        function updateTimer() {
            const minutes = Math.floor(timeLeft / 60);
            const seconds = timeLeft % 60;
            timerElement.textContent = `${String(minutes).padStart(2, '0')}:${String(seconds).padStart(2, '0')}`;
            
            if (timeLeft <= 0) {
                clearInterval(timerInterval);
                resendBtn.disabled = false;
                resendBtn.classList.remove('text-gray-400');
                resendBtn.classList.add('text-[#a78a7f]', 'cursor-pointer');
            }
            
            timeLeft--;
        }
        
        const timerInterval = setInterval(updateTimer, 1000);
        updateTimer(); // Initial call
        
        // Resend OTP functionality
        const userEmail = 'user@example.com';
        resendBtn.addEventListener('click', async () => {
            if (!resendBtn.disabled) {
                try {
                    // Send resend request to server
                    const response = await fetch('/resend-otp', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                        },
                        body: JSON.stringify({
                            email: userEmail
                        })
                    });
                    
                    if (response.ok) {
                        // Reset timer
                        timeLeft = 45;
                        resendBtn.disabled = true;
                        resendBtn.classList.remove('text-[#a78a7f]', 'cursor-pointer');
                        resendBtn.classList.add('text-gray-400');
                        
                        // Clear OTP inputs
                        otpInputs.forEach(input => input.value = '');
                        otpInputs[0].focus();
                        
                        // Show success message
                        alert('OTP has been resent to your email!');
                    } else {
                        alert('Failed to resend OTP. Please try again.');
                    }
                } catch (error) {
                    console.error('Error resending OTP:', error);
                    alert('An error occurred. Please try again.');
                }
            }
        });
        
        // Auto-submit when all 6 digits are entered (optional)
        otpInputs[5].addEventListener('input', () => {
            if (otpInputs[5].value) {
                // Uncomment to enable auto-submit
                // document.getElementById('otpForm').submit();
            }
        });
        
        // Focus first input on page load
        window.addEventListener('load', () => {
            otpInputs[0].focus();
        });
    </script>
    
</body>
</html>