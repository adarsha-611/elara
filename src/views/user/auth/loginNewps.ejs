<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Set a New Password</title>
    <link rel="stylesheet" href="../../../public/css/loginNewps.css">
</head>
<body>
    <div class="container">
        <div class="card">
            <h1>Set a New Password</h1>
            <p class="description">Your new password must be different from previous passwords.</p>
            
            <form>
                <input type="password" class="password-input" placeholder="New Password" required>
                <input type="password" class="password-input" placeholder="Confirm Password" required>
                
                <div class="password-strength">/
                    <p class="strength-label">Password strength:</p>
                    <ul class="strength-list">
                        <li>Use 8 or more characters</li>
                        <li>Use a mix of letters, numbers & symbols</li>
                    </ul>
                </div>
                
                <button type="submit" class="submit-btn">Set New Password</button>
            </form>
        </div>
    </div>
</body>
</html>