<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Forgot Password - ELARA</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=Playfair+Display:ital,wght@0,400;0,500;0,600;0,700;1,400&display=swap" rel="stylesheet">
    <style>
        body { 
            font-family: 'Inter', sans-serif;
            background: linear-gradient(135deg, #FEFAF6 0%, #f5ede5 100%);
        }
    </style>
</head>
<body class="bg-gradient-to-br from-[#FEFAF6] to-[#f5ede5] min-h-screen flex items-center justify-center p-4">
    <div class="bg-white rounded-3xl shadow-2xl p-8 sm:p-12 w-full max-w-md border border-[#e8ddd0]">
        <h1 class="text-[#c9a96e] text-4xl font-display font-semibold text-center mb-6 tracking-wide">ELARA</h1>
        <h2 class="text-2xl font-normal text-[#1E1A17] text-center mb-4 font-display">Forgot Password?</h2>
        <p class="text-sm text-gray-500 text-center mb-8 leading-relaxed">
            Enter your email below to receive an OTP to reset your password.
        </p>

        <% if (locals.error && error.length > 0) { %>
            <div class="bg-red-50 border border-red-200 text-red-600 px-4 py-3 rounded-xl mb-6 text-sm text-center">
                <%= error %>
            </div>
        <% } %>

        <% if (locals.success && success.length > 0) { %>
            <div class="bg-green-50 border border-green-200 text-green-600 px-4 py-3 rounded-xl mb-6 text-sm text-center">
                <%= success %>
            </div>
        <% } %>

        <form id="forgotPasswordForm" action="/forgot-password" method="POST" class="space-y-6" novalidate>
            <div>
                <label for="email" class="block text-[#1E1A17] text-sm font-medium mb-2">Email Address</label>
                <input 
                    type="email" 
                    id="email" 
                    name="email" 
                    placeholder="Enter your email"
                    class="w-full px-4 py-3 bg-gray-50 border border-gray-200 rounded-xl text-gray-700 focus:ring-2 focus:ring-[#c9a96e] focus:border-transparent outline-none transition"
                >
                <div id="emailError" class="text-red-500 text-xs mt-1 min-h-[1rem]"></div>
            </div>
            <button 
                type="submit" 
                class="w-full bg-[#8a7055] hover:bg-[#6d5942] text-white font-medium py-3.5 rounded-xl transition-all duration-300 uppercase tracking-wide text-sm shadow-md hover:shadow-lg transform hover:-translate-y-0.5"
            >
                Send OTP
            </button>
        </form>

        <div class="text-center mt-8">
            <a href="/login" class="text-sm text-gray-500 hover:text-[#c9a96e] transition-colors font-medium">
                ← Back to Login
            </a>
        </div>
    </div>

    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const form = document.getElementById('forgotPasswordForm');
            const emailInput = document.getElementById('email');
            const emailError = document.getElementById('emailError');

            form.addEventListener('submit', (e) => {
                let isValid = true;
                const emailValue = emailInput.value.trim();
                const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;

                // Reset Error State
                emailError.textContent = '';
                emailInput.classList.remove('border-red-400');

                // Validation Logic
                if (!emailValue) {
                    emailError.textContent = 'Please enter your email address.';
                    emailInput.classList.add('border-red-400');
                    isValid = false;
                } else if (!emailRegex.test(emailValue)) {
                    emailError.textContent = 'Please enter a valid email format.';
                    emailInput.classList.add('border-red-400');
                    isValid = false;
                }

                if (!isValid) {
                    e.preventDefault(); // Stop form submission
                }
            });

            // Clear errors while the user types
            emailInput.addEventListener('input', () => {
                if (emailError.textContent !== '') {
                    emailError.textContent = '';
                    emailInput.classList.remove('border-red-400');
                }
            });
        });
    </script>
</body>
</html>