<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Create Account - ELARA</title>
    
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    
    <style>
        body {
            font-family: 'Inter', sans-serif;
        }
    </style>
</head>
<body class="bg-[#e8dfd3] min-h-screen flex items-center justify-center p-4">
    
    <!-- Registration Card Container -->
    <div class="bg-white rounded-lg shadow-sm border border-gray-200 w-full max-w-md p-8 md:p-12">
        
        <!-- Brand Name -->
        <h1 class="text-[#a98968] text-3xl md:text-4xl font-semibold text-center mb-6 tracking-wide">
            ELARA
        </h1>
        
        <!-- Page Title -->
        <h2 class="text-gray-700 text-2xl font-medium text-center mb-2">
            Create Your Account
        </h2>
        
        <!-- Subtitle -->
        <p class="text-gray-500 text-sm text-center mb-8">
            Let's get started with your free account.
        </p>
        
        <!-- Display error messages -->
        <% if (typeof errors !== 'undefined' && errors.length > 0) { %>
            <div class="bg-red-50 border border-red-200 rounded-md p-4 mb-6">
                <ul class="text-red-700 text-sm space-y-1">
                    <% errors.forEach(function(error) { %>
                        <li>• <%= error %></li>
                    <% }); %>
                </ul>
            </div>
        <% } %>
        
        <!-- Registration Form -->
        <form id="signform" action="/signup" method="POST">
            
            <!-- Full Name Field -->
            <div class="mb-5">
                <label for="fullName" class="block text-gray-600 text-sm font-medium mb-2">
                    Full Name
                </label>
                <input 
                    type="text" 
                    id="fullName" 
                    name="fullName" 
                    class="w-full px-4 py-2.5 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-[#a98968] focus:border-transparent transition"
                    required
                >
                <div id="err1" class="error.message"></div>
            </div>
            
            <!-- Email Address Field -->
            <div class="mb-5">
                <label for="email" class="block text-gray-600 text-sm font-medium mb-2">
                    Email address
                </label>
                <input 
                    type="email" 
                    id="email" 
                    name="email" 
                    class="w-full px-4 py-2.5 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-[#a98968] focus:border-transparent transition"
                    required
                >
                <div id="err2" class="error.message"></div>
            </div>
            
            <!-- Password Field -->
            <div class="mb-5">
                <label for="password" class="block text-gray-600 text-sm font-medium mb-2">
                    Password
                </label>
                <input 
                    type="password" 
                    id="password" 
                    name="password" 
                    class="w-full px-4 py-2.5 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-[#a98968] focus:border-transparent transition"
                    required
                >
                <div id="err3" class="error.message"></div>
            </div>
            
            <!-- Confirm Password Field -->
            <div class="mb-6">
                <label for="confirmPassword" class="block text-gray-600 text-sm font-medium mb-2">
                    Confirm password
                </label>
                <input 
                    type="password" 
                    id="confirmPassword" 
                    name="confirmPassword" 
                    class="w-full px-4 py-2.5 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-[#a98968] focus:border-transparent transition"
                    required
                >
                <div id="err4" class="error.message"></div>
            </div>
            
            <!-- Referral Code Button (Optional Field) -->
            <div class="mb-6">
                <button 
                    type="button" 
                    id="referralToggle"
                    class="bg-[#c4a88a] hover:bg-[#b39878] text-white text-sm font-medium px-5 py-2.5 rounded-md transition"
                >
                    Referral Code
                </button>
                
                <!-- Hidden Referral Input (shows when button clicked) -->
                <div id="referralInput" class="hidden mt-3">
                    <input 
                        type="text" 
                        name="referralCode" 
                        placeholder="Enter referral code (optional)"
                        class="w-full px-4 py-2.5 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-[#a98968] focus:border-transparent transition"
                    >
                </div>
            </div>
            
            <!-- Create Account Button -->
            <button 
                type="submit" 
                class="w-full bg-[#c4a88a] hover:bg-[#b39878] text-white font-medium py-3 rounded-md transition mb-6"
            >
                Create Account
            </button>
            
        </form>
        
        <!-- Login Link -->
        <p class="text-center text-gray-600 text-sm mb-4">
            Already have an account? 
            <a href="/login" class="text-[#a98968] hover:underline font-medium">
                Login in
            </a>
        </p>
        
        <!-- Divider -->
        <div class="relative mb-6">
            <div class="absolute inset-0 flex items-center">
                <div class="w-full border-t border-gray-200"></div>
            </div>
            <div class="relative flex justify-center text-sm">
                <span class="px-4 bg-white text-gray-500">or</span>
            </div>
        </div>
        
        <!-- Google Sign In Button -->
        <a 
            href="/auth/google" 
            class="flex items-center justify-center w-full bg-gray-50 hover:bg-gray-100 border border-gray-300 text-gray-700 font-medium py-3 rounded-md transition"
        >
            <svg class="w-5 h-5 mr-2" viewBox="0 0 24 24">
                <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/>
                <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
                <path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z"/>
                <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z"/>
            </svg>
            Google
        </a>
        
    </div>
    
    <!-- JavaScript for Referral Code Toggle -->
    <script>
        document.getElementById('referralToggle').addEventListener('click', function() {
            const referralInput = document.getElementById('referralInput');
            referralInput.classList.toggle('hidden');
        });
    </script>
    
</body>
</html>