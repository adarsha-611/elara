<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Welcome to ELARA</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@600&family=Montserrat:wght@300;500&family=Inter:wght@400&display=swap" rel="stylesheet">
    <script src="https://unpkg.com/lucide@latest"></script>
    <style>
        body { font-family: 'Inter', sans-serif; }
        .brand-logo { font-family: 'Cinzel', serif; letter-spacing: 0.4em; }
        .welcome-header { font-family: 'Montserrat', sans-serif; letter-spacing: 0.05em; }
        .image-overlay {
            background: linear-gradient(to bottom, rgba(61, 43, 36, 0.4) 0%, rgba(0,0,0,0) 40%);
        }
    </style>
</head>
<body class="bg-[#FAF9F7] min-h-screen flex items-center justify-center p-4">

    <div class="bg-white rounded-[2rem] shadow-2xl w-full max-w-4xl flex flex-col md:flex-row overflow-hidden border border-[#EDE9E3]">
        
        <div class="w-full md:w-1/2 p-6 md:p-10 flex items-center justify-center bg-[#F4F1EE]">
            <div class="aspect-square w-full max-w-[340px] rounded-[2rem] overflow-hidden relative shadow-xl group">
                <div class="absolute inset-x-0 top-8 z-10 text-center">
                    <h1 class="brand-logo text-white text-2xl drop-shadow-lg">ELARA</h1>
                </div>
                <div class="absolute inset-0 image-overlay"></div>
                <img src="https://images.unsplash.com/photo-1617038260897-41a1f14a8ca0?w=800&h=800&fit=crop" 
                     alt="Luxury Jewelry" 
                     class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110">
            </div>
        </div>

        <div class="w-full md:w-1/2 p-8 md:p-12 flex flex-col justify-center">
            <div class="max-w-sm mx-auto w-full">
                
                <h2 class="welcome-header text-[#3D2B24] text-2xl font-light text-center mb-1">
                    Welcome to <span class="font-medium text-[#A68B67]">Elara</span>
                </h2>
                <p class="text-[#A68B67]/60 text-[11px] uppercase tracking-widest text-center mb-6">Create your bespoke account</p>

                <% if (locals.error && error.length > 0) { %>
                    <div class="bg-red-50 border border-red-100 text-red-600 px-4 py-2 rounded-lg mb-4 text-[11px] text-center italic">
                        <%= error %>
                    </div>
                <% } %>

                <% if (locals.success && success.length > 0) { %>
                    <div class="bg-green-50 border border-green-100 text-green-600 px-4 py-2 rounded-lg mb-4 text-[11px] text-center italic">
                        <%= success %>
                    </div>
                <% } %>

                <form id="signform" action="/signup" method="POST" novalidate class="space-y-3">
                    
                    <div>
                        <label class="block text-[#A68B67] text-[10px] font-bold mb-1 uppercase tracking-widest">Full Name</label>
                        <input type="text" id="fullName" name="fullName" class="w-full px-4 py-2 border border-[#EDE9E3] rounded-lg focus:outline-none focus:ring-1 focus:ring-[#A68B67] bg-[#FAF9F7] text-sm transition-all" maxlength="10">
                        <div id="err1" class="text-red-400 text-[10px] h-3 mt-0.5"></div>
                    </div>

                    <div>
                        <label class="block text-[#A68B67] text-[10px] font-bold mb-1 uppercase tracking-widest">Email address</label>
                        <input type="email" id="email" name="email" class="w-full px-4 py-2 border border-[#EDE9E3] rounded-lg focus:outline-none focus:ring-1 focus:ring-[#A68B67] bg-[#FAF9F7] text-sm transition-all">
                        <div id="err2" class="text-red-400 text-[10px] h-3 mt-0.5"></div>
                    </div>

                    <div class="grid grid-cols-2 gap-3">
                        <div class="relative">
                            <label class="block text-[#A68B67] text-[10px] font-bold mb-1 uppercase tracking-widest">Password</label>
                            <input type="password" id="password" name="password" class="w-full px-4 py-2 border border-[#EDE9E3] rounded-lg focus:outline-none focus:ring-1 focus:ring-[#A68B67] bg-[#FAF9F7] text-sm transition-all">
                            <button type="button" onclick="togglePass('password', this)" class="absolute right-3 top-[26px] text-gray-300 hover:text-[#A68B67]">
                                <i data-lucide="eye" class="w-4 h-4"></i>
                            </button>
                        </div>
                        <div class="relative">
                            <label class="block text-[#A68B67] text-[10px] font-bold mb-1 uppercase tracking-widest">Confirm</label>
                            <input type="password" id="confirmPassword" name="confirmPassword" class="w-full px-4 py-2 border border-[#EDE9E3] rounded-lg focus:outline-none focus:ring-1 focus:ring-[#A68B67] bg-[#FAF9F7] text-sm transition-all">
                            <button type="button" onclick="togglePass('confirmPassword', this)" class="absolute right-3 top-[26px] text-gray-300 hover:text-[#A68B67]">
                                <i data-lucide="eye" class="w-4 h-4"></i>
                            </button>
                        </div>
                    </div>
                    <div class="flex gap-4">
                        <div id="err3" class="text-red-400 text-[10px] h-3 w-1/2"></div>
                        <div id="err4" class="text-red-400 text-[10px] h-3 w-1/2"></div>
                    </div>

                    <div class="pt-1">
                        <button type="button" id="referralToggle" class="text-[#A68B67] text-[10px] font-bold uppercase tracking-widest hover:text-[#3D2B24] transition-all">
                            + Referral Code
                        </button>
                        <div id="referralInput" class="hidden mt-2">
                            <input type="text" name="referralCode" placeholder="Enter code (optional)" class="w-full px-4 py-2 border border-[#EDE9E3] rounded-lg text-sm bg-[#FAF9F7]">
                        </div>
                    </div>

                    <button type="submit" class="w-full bg-[#3D2B24] hover:bg-[#523C32] text-white text-xs font-medium py-3.5 rounded-lg transition-all shadow-xl mt-2 uppercase tracking-[0.2em]">
                        Create Account
                    </button>
                </form>

                <div class="mt-6 text-center">
                    <p class="text-gray-400 text-xs">Already have an account? <a href="/login" class="text-[#A68B67] font-bold ml-1 hover:underline">Log in</a></p>
                </div>

                <div class="relative my-6 flex items-center">
                    <div class="flex-grow border-t border-[#EDE9E3]"></div>
                    <span class="px-3 text-[10px] text-gray-300 uppercase tracking-widest">or</span>
                    <div class="flex-grow border-t border-[#EDE9E3]"></div>
                </div>

                <a href="/auth/google" class="flex items-center justify-center w-full bg-white border border-[#EDE9E3] text-[#3D2B24] text-[10px] font-bold uppercase tracking-widest py-2.5 rounded-lg hover:bg-[#FAF9F7] transition-colors">
                    <svg class="w-4 h-4 mr-2" viewBox="0 0 24 24">
                        <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/>
                        <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
                        <path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z"/>
                        <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z"/>
                    </svg>
                    Google
                </a>
            </div>
        </div>
    </div>

    <script>
        lucide.createIcons();

        document.getElementById('referralToggle').addEventListener('click', () => {
            const input = document.getElementById('referralInput');
            input.classList.toggle('hidden');
        });

        function togglePass(inputId, btn) {
            const input = document.getElementById(inputId);
            const icon = btn.querySelector("svg");

            if (input.type === "password") {
                input.type = "text";
                icon.outerHTML = lucide.icons["eye-off"].toSvg({ class: "w-4 h-4" });
            } else {
                input.type = "password";
                icon.outerHTML = lucide.icons["eye"].toSvg({ class: "w-4 h-4" });
            }
        }

        const form = document.getElementById('signform');
        form.addEventListener('submit', function(e) {
            let isValid = true;
            const fullName = document.getElementById('fullName');
            const email = document.getElementById('email');
            const password = document.getElementById('password');
            const confirmPassword = document.getElementById('confirmPassword');

            const err1 = document.getElementById('err1');
            const err2 = document.getElementById('err2');
            const err3 = document.getElementById('err3');
            const err4 = document.getElementById('err4');

            [err1, err2, err3, err4].forEach(el => el.textContent = "");

            if (fullName.value.trim() === "") {
                err1.textContent = "Full name is required";
                isValid = false;
            } else if (fullName.value.trim().length < 3) {
                err1.textContent = "Name must be at least 3 characters";
                isValid = false;
            }

            const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
            if (email.value.trim() === "") {
                err2.textContent = "Email address is required";
                isValid = false;
            } else if (!emailRegex.test(email.value.trim())) {
                err2.textContent = "Enter a valid email address";
                isValid = false;
            }

            if (password.value === "") {
                err3.textContent = "Password is required";
                isValid = false;
            } else if (password.value.length < 8) {
                err3.textContent = "Minimum 8 characters";
                isValid = false;
            }

            if (confirmPassword.value === "") {
                err4.textContent = "Please confirm password";
                isValid = false;
            } else if (confirmPassword.value !== password.value) {
                err4.textContent = "Passwords do not match";
                isValid = false;
            }

            if (!isValid) e.preventDefault();
        });
    </script>
</body>
</html>