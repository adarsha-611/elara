<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Create Account - ELARA</title>
    
    <script src="https://cdn.tailwindcss.com"></script>
    
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <script src="https://unpkg.com/lucide@latest"></script>
    <style>
        body {
            font-family: 'Inter', sans-serif;
        }
    </style>
</head>
<body class="bg-[#e8dfd3] min-h-screen flex items-center justify-center p-4">
    
    <div class="bg-white rounded-lg shadow-sm border border-gray-200 w-full max-w-md p-8 md:p-12">
        
        <h1 class="text-[#a98968] text-3xl md:text-4xl font-semibold text-center mb-6 tracking-wide">
            ELARA
        </h1>
        
        <h2 class="text-gray-700 text-2xl font-medium text-center mb-2">
            Create Your Account
        </h2>
        
        <p class="text-gray-500 text-sm text-center mb-8">
            Let's get started with your free account.
        </p>
        
        <% if (locals.error && error.length > 0) { %>
            <div class="bg-red-50 border border-red-200 text-red-600 px-4 py-3 rounded-lg mb-6 text-sm text-center">
                <%= error %>
            </div>
        <% } %>

        <% if (locals.success && success.length > 0) { %>
            <div class="bg-green-50 border border-green-200 text-green-600 px-4 py-3 rounded-lg mb-6 text-sm text-center">
                <%= success %>
            </div>
        <% } %>
        
        <form id="signform" action="/signup" method="POST" novalidate>
            
            <div class="mb-5">
                <label for="fullName" class="block text-gray-600 text-sm font-medium mb-2">
                    Full Name
                </label>
                <input 
                    type="text" 
                    id="fullName" 
                    name="fullName" 
                    class="w-full px-4 py-2.5 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-[#a98968] focus:border-transparent transition"
                >
                <div id="err1" class="text-red-500 text-xs mt-1"></div>
            </div>
            
            <div class="mb-5">
                <label for="email" class="block text-gray-600 text-sm font-medium mb-2">
                    Email address
                </label>
                <input 
                    type="email" 
                    id="email" 
                    name="email" 
                    class="w-full px-4 py-2.5 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-[#a98968] focus:border-transparent transition"
                >
                <div id="err2" class="text-red-500 text-xs mt-1"></div>
            </div>
            
           <div class="mb-5">
    <label for="password" class="block text-gray-600 text-sm font-medium mb-2">Password</label>
   <div class="relative">
    <input 
        type="password" 
        id="password" 
        name="password" 
        class="w-full px-4 py-2.5 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-[#a98968] focus:border-transparent transition"
    >
    <button type="button" onclick="togglePass('password', this)" class="absolute inset-y-0 right-0 px-3 flex items-center text-gray-400 hover:text-[#a98968] z-10">
        <i data-lucide="eye" class="w-5 h-5"></i>
    </button>
</div>
    <div id="err3" class="text-red-500 text-xs mt-1"></div>
</div>
            
           <div class="mb-6">
    <label for="confirmPassword" class="block text-gray-600 text-sm font-medium mb-2">Confirm password</label>
    <div class="relative">
    <input 
        type="password" 
        id="confirmPassword" 
        name="confirmPassword" 
        class="w-full px-4 py-2.5 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-[#a98968] focus:border-transparent transition"
    >
    <button type="button" onclick="togglePass('confirmPassword', this)" class="absolute inset-y-0 right-0 px-3 flex items-center text-gray-400 hover:text-[#a98968] z-10">
        <i data-lucide="eye" class="w-5 h-5"></i>
    </button>
</div>
    <div id="err4" class="text-red-500 text-xs mt-1"></div>
</div>
            
            <div class="mb-6">
                <button 
                    type="button" 
                    id="referralToggle"
                    class="bg-[#c4a88a] hover:bg-[#b39878] text-white text-sm font-medium px-5 py-2.5 rounded-md transition"
                >
                    Referral Code
                </button>
                
                <div id="referralInput" class="hidden mt-3">
                    <input 
                        type="text" 
                        name="referralCode" 
                        placeholder="Enter referral code (optional)"
                        class="w-full px-4 py-2.5 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-[#a98968] focus:border-transparent transition"
                    >
                </div>
            </div>
            
            <button 
                type="submit" 
                class="w-full bg-[#c4a88a] hover:bg-[#b39878] text-white font-medium py-3 rounded-md transition mb-6"
            >
                Create Account
            </button>
            
        </form>
        
        <p class="text-center text-gray-600 text-sm mb-4">
            Already have an account? 
            <a href="/login" class="text-[#a98968] hover:underline font-medium">
                Login in
            </a>
        </p>
        
        <div class="relative mb-6">
            <div class="absolute inset-0 flex items-center">
                <div class="w-full border-t border-gray-200"></div>
            </div>
            <div class="relative flex justify-center text-sm">
                <span class="px-4 bg-white text-gray-500">or</span>
            </div>
        </div>
        
        <a 
            href="/auth/google" 
            class="flex items-center justify-center w-full bg-gray-50 hover:bg-gray-100 border border-gray-300 text-gray-700 font-medium py-3 rounded-md transition"
        >
            <svg class="w-5 h-5 mr-2" viewBox="0 0 24 24">
                <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/>
                <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
                <path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z"/>
                <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z"/>
            </svg>
            Google
        </a>
    </div>

    <script>
        // Referral Toggle Logic
        document.getElementById('referralToggle').addEventListener('click', function() {
            const referralInput = document.getElementById('referralInput');
            referralInput.classList.toggle('hidden');
        });

        // Client-side Validation Logic
        const form = document.getElementById('signform');
        
        form.addEventListener('submit', function(e) {
            let isValid = true;

            // Select inputs
            const fullName = document.getElementById('fullName');
            const email = document.getElementById('email');
            const password = document.getElementById('password');
            const confirmPassword = document.getElementById('confirmPassword');

            // Select error divs
            const err1 = document.getElementById('err1');
            const err2 = document.getElementById('err2');
            const err3 = document.getElementById('err3');
            const err4 = document.getElementById('err4');

            // Reset errors
            [err1, err2, err3, err4].forEach(el => el.textContent = "");

            // 1. Full Name Validation
            if (fullName.value.trim() === "") {
                err1.textContent = "Full name is required";
                isValid = false;
            } else if (fullName.value.trim().length < 3) {
                err1.textContent = "Name must be at least 3 characters";
                isValid = false;
            }

            // 2. Email Validation
            const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
            if (email.value.trim() === "") {
                err2.textContent = "Email address is required";
                isValid = false;
            } else if (!emailRegex.test(email.value.trim())) {
                err2.textContent = "Please enter a valid email address";
                isValid = false;
            }

            // 3. Password Validation
            if (password.value === "") {
                err3.textContent = "Password is required";
                isValid = false;
            } else if (password.value.length < 8) {
                err3.textContent = "Password must be at least 8 characters long";
                isValid = false;
            }

            // 4. Confirm Password Validation
            if (confirmPassword.value === "") {
                err4.textContent = "Please confirm your password";
                isValid = false;
            } else if (confirmPassword.value !== password.value) {
                err4.textContent = "Passwords do not match";
                isValid = false;
            }

            // If any validation failed, prevent form submission
            if (!isValid) {
                e.preventDefault();
            }
        });
        
    </script>
    <script>
    // Initialize icons
    lucide.createIcons();

    function togglePass(inputId, btn) {
        const input = document.getElementById(inputId);
        const icon = btn.querySelector('svg') || btn.querySelector('i');
        
        if (input.type === 'password') {
            input.type = 'text';
            icon.setAttribute('data-lucide', 'eye-off');
        } else {
            input.type = 'password';
            icon.setAttribute('data-lucide', 'eye');
        }
        // Force Lucide to re-scan the button for the new attribute
        lucide.createIcons();
    }
</script>
</body>
</html>