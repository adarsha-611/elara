<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            'elara-brown': '#7A5C4D',
            'elara-dark': '#3D2B24',
            'elara-ivory': '#FDFBF9',
            'elara-beige': '#F4F1EE'
          }
        }
      }
    }
    </script>
    <title>Refer & Earn | ELARA</title>
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }

        body {
            min-height: 100vh;
            background-color: #f0e8e0;
            font-family: 'Segoe UI', 'Poppins', system-ui, sans-serif;
            display: flex;
            flex-direction: column;
        }

        .profile-layout {
            display: flex;
            gap: 40px;
            max-width: 1280px;
            margin: 100px auto 60px auto;
            padding: 0 24px;
            flex: 1;
            align-items: flex-start;
        }

        .profile-content {
            flex: 1;
            display: flex;
            flex-direction: column;
            gap: 20px;
        }

        /* Page title */
        .page-title {
            font-size: 2rem;
            font-weight: 700;
            color: #3D2B24;
            letter-spacing: 1px;
            text-transform: uppercase;
            margin-bottom: 4px;
        }

        .page-title span {
            color: #A68B67;
        }

        /* Stats row */
        .stats-row {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 16px;
        }

        .stat-card {
            background: #fff9f5;
            border: 1px solid #e8ddd5;
            border-radius: 16px;
            padding: 1.5rem 2rem;
            display: flex;
            align-items: center;
            gap: 16px;
            box-shadow: 0 4px 16px rgba(61,43,36,0.05);
        }

        .stat-icon {
            width: 48px;
            height: 48px;
            border-radius: 12px;
            background: #f0e8e0;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.4rem;
            flex-shrink: 0;
        }

        .stat-label {
            font-size: 0.78rem;
            color: #9a7060;
            text-transform: uppercase;
            letter-spacing: 0.8px;
            font-weight: 600;
            margin-bottom: 4px;
        }

        .stat-value {
            font-size: 1.6rem;
            font-weight: 700;
            color: #3D2B24;
        }

        /* Invite card */
        .invite-card {
            background: #fff9f5;
            border: 1px solid #e8ddd5;
            border-radius: 20px;
            padding: 2.5rem 2rem;
            text-align: center;
            box-shadow: 0 4px 16px rgba(61,43,36,0.05);
        }

        .invite-card h2 {
            font-size: 1.3rem;
            font-weight: 700;
            color: #3D2B24;
            margin-bottom: 8px;
        }

        .invite-card p {
            font-size: 0.88rem;
            color: #7A5C4D;
            margin-bottom: 2rem;
        }

        .code-row {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 16px;
            flex-wrap: wrap;
        }

        .referral-code-box {
            background: #f0e8e0;
            border: 2px solid #c7a78b;
            border-radius: 12px;
            padding: 14px 32px;
            font-size: 1.4rem;
            font-weight: 700;
            color: #3D2B24;
            letter-spacing: 3px;
            font-family: monospace;
        }

        .copy-btn {
            background: #3D2B24;
            color: #fff;
            border: none;
            border-radius: 10px;
            padding: 14px 28px;
            font-size: 0.88rem;
            font-weight: 600;
            cursor: pointer;
            letter-spacing: 0.5px;
            transition: background 0.2s, transform 0.1s;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .copy-btn:hover { background: #A68B67; transform: translateY(-1px); }
        .copy-btn:active { transform: scale(0.97); }
        .copy-btn.copied { background: #5e8a6a; }

        .toast-msg {
            margin-top: 1rem;
            font-size: 0.82rem;
            color: #5e8a6a;
            font-weight: 600;
            opacity: 0;
            transition: opacity 0.25s ease;
            min-height: 24px;
        }

        .toast-msg.show { opacity: 1; }

        /* Steps row */
        .steps-row {
            display: grid;
            grid-template-columns: 1fr 1fr 1fr;
            gap: 16px;
        }

        .step-card {
            background: #fff9f5;
            border: 1px solid #e8ddd5;
            border-radius: 16px;
            padding: 2rem 1.5rem;
            text-align: center;
            box-shadow: 0 4px 16px rgba(61,43,36,0.05);
            transition: transform 0.2s;
        }

        .step-card:hover { transform: translateY(-3px); }

        .step-number {
            width: 40px;
            height: 40px;
            border-radius: 50%;
            background: #A68B67;
            color: #fff;
            font-size: 1rem;
            font-weight: 700;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto 1rem;
        }

        .step-card h3 {
            font-size: 0.95rem;
            font-weight: 700;
            color: #3D2B24;
            margin-bottom: 8px;
        }

        .step-card p {
            font-size: 0.82rem;
            color: #7A5C4D;
            line-height: 1.5;
        }

        .step-card p strong {
            color: #A68B67;
        }

        @media (max-width: 900px) {
            .profile-layout { flex-direction: column; gap: 28px; margin-top: 30px; }
            .stats-row { grid-template-columns: 1fr; }
            .steps-row { grid-template-columns: 1fr; }
            .code-row { flex-direction: column; }
        }
    </style>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
</head>
<body>

    <%- include('../../partials/header') %>

    <div class="profile-layout">

        <div style="width: 288px; min-width: 288px; flex-shrink: 0;">
            <%- include('../../partials/profileSidebar', { user: user, path: '/profile/referral' }) %>
        </div>

        <div class="profile-content">

            <!-- Title -->
            <h1 class="page-title">Refer & <span>Earn</span></h1>

            <!-- Invite Card -->
            <div class="invite-card">
                <h2>Invite your friends to ELARA</h2>
                <p>Share your code and get rewards for every new signup.</p>

                <div class="code-row">
                    <div class="referral-code-box" id="referral-code">
                        <%= user && user.referralCode ? user.referralCode : 'ELARA2026' %>
                    </div>
                    <button class="copy-btn" id="copy-btn">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
                        COPY CODE
                    </button>
                </div>
                <div class="toast-msg" id="toastMsg">✓ Copied to clipboard!</div>
            </div>

            <!-- Steps Row -->
            <div class="steps-row">
                <div class="step-card">
                    <div class="step-number">1</div>
                    <h3>Share Your Code</h3>
                    <p>Send your unique referral code to your friends and family.</p>
                </div>
                <div class="step-card">
                    <div class="step-number">2</div>
                    <h3>They Sign Up</h3>
                    <p>When they create an account using your code, they get <strong>₹100</strong> bonus credit.</p>
                </div>
                <div class="step-card">
                    <div class="step-number">3</div>
                    <h3>You Earn</h3>
                    <p>You receive <strong>₹200</strong> in your wallet for every successful referral!</p>
                </div>
            </div>

        </div>
    </div>

    <%- include('../../partials/footer') %>

    <script>
        (function() {
            const copyBtn = document.getElementById('copy-btn');
            const codeSpan = document.getElementById('referral-code');
            const toastEl = document.getElementById('toastMsg');

            if (!copyBtn || !codeSpan) return;

            copyBtn.addEventListener('click', async () => {
                const code = codeSpan.innerText.trim();
                if (!code) return;

                try {
                    await navigator.clipboard.writeText(code);
                } catch (err) {
                    const ta = document.createElement('textarea');
                    ta.value = code;
                    document.body.appendChild(ta);
                    ta.select();
                    document.execCommand('copy');
                    document.body.removeChild(ta);
                }

                const orig = copyBtn.innerHTML;
                copyBtn.innerHTML = '✅ COPIED!';
                copyBtn.classList.add('copied');
                toastEl.classList.add('show');

                setTimeout(() => {
                    copyBtn.innerHTML = orig;
                    copyBtn.classList.remove('copied');
                    toastEl.classList.remove('show');
                }, 2000);
            });
        })();
    </script>
</body>
</html>