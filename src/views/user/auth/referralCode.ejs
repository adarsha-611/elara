<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= pageTitle || 'Referral Code - Welcome' %></title>
    
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    
    <!-- Custom Styles -->
    <style>
        body {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
        }
        
        .bg-beige {
            background-color: #E8DDD4;
        }
        
        .btn-apply {
            background-color: #B08968;
        }
        
        .btn-apply:hover {
            background-color: #9A7555;
        }
    </style>
</head>
<body class="bg-beige min-h-screen flex items-center justify-center p-4">
    
    <div class="bg-white rounded-2xl shadow-lg p-8 md:p-12 max-w-lg w-full">
        
        <!-- Heading Section -->
        <div class="text-center mb-6">
            <h1 class="text-3xl md:text-4xl font-normal text-gray-700 mb-4">
                Have a Referral<br>Code?
            </h1>
            
            <!-- Description Text (Dynamic) -->
            <p class="text-gray-500 text-sm md:text-base leading-relaxed px-4">
                <%= description || "Enter your friend's referral code below to unlock a special discount on your first order. It's our little way of saying welcome to the family!" %>
            </p>
        </div>
        
        <!-- Referral Code Form -->
        <form action="<%= submitUrl || '/apply-referral' %>" method="POST" class="mt-8">
            
            <!-- Input Field -->
            <div class="mb-6">
                <input 
                    type="text" 
                    name="referralCode" 
                    id="referralCode"
                    placeholder="Enter Referral Code"
                    class="w-full px-4 py-3 bg-gray-100 text-gray-700 text-center rounded-lg focus:outline-none focus:ring-2 focus:ring-gray-300 transition duration-200"
                    value="<%= referralCode || '' %>"
                    required
                />
            </div>
            
            <!-- Apply Button -->
            <button 
                type="submit" 
                class="btn-apply w-full py-3 text-white font-medium rounded-lg transition duration-200 hover:shadow-md"
            >
                APPLY CODE
            </button>
            
        </form>
        
        <!-- Skip Link -->
        <div class="text-center mt-6">
            <a 
                href="<%= skipUrl || '/dashboard' %>" 
                class="text-gray-400 text-sm hover:text-gray-600 transition duration-200"
            >
                Skip for now
            </a>
        </div>
        
    </div>
    
    <!-- Optional: Error/Success Messages -->
    <% if (typeof errorMessage !== 'undefined' && errorMessage) { %>
        <div class="fixed top-4 right-4 bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded shadow-lg">
            <%= errorMessage %>
        </div>
    <% } %>
    
    <% if (typeof successMessage !== 'undefined' && successMessage) { %>
        <div class="fixed top-4 right-4 bg-green-100 border border-green-400 text-green-700 px-4 py-3 rounded shadow-lg">
            <%= successMessage %>
        </div>
    <% } %>
    
</body>
</html>