<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Forgot Password</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
            background-color: #f5f1ed;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 20px;
        }

        .container {
            width: 100%;
            max-width: 450px;
        }

        .card {
            background-color: #ffffff;
            border-radius: 12px;
            border: 1px solid #e8e4df;
            box-shadow: 0 2px 8px rgba(0, 0, 0, 0.04);
            padding: 48px 40px;
            text-align: center;
        }

        h1 {
            font-size: 28px;
            font-weight: 600;
            color: #5a4a42;
            margin-bottom: 12px;
        }

        .subtext {
            font-size: 14px;
            color: #8b7e74;
            line-height: 1.6;
            margin-bottom: 32px;
        }

        form {
            margin-bottom: 24px;
        }

        .email-input {
            width: 100%;
            padding: 14px 16px;
            font-size: 15px;
            background-color: #faf8f6;
            border: 1px solid #e8e4df;
            border-radius: 8px;
            outline: none;
            transition: border-color 0.2s;
            margin-bottom: 20px;
        }

        .email-input::placeholder {
            color: #b5a99f;
        }

        .email-input:focus {
            border-color: #8b7e74;
        }

        .submit-btn {
            width: 100%;
            padding: 14px 16px;
            font-size: 15px;
            font-weight: 500;
            color: #ffffff;
            background-color: #6b5b52;
            border: none;
            border-radius: 8px;
            cursor: pointer;
            transition: background-color 0.2s;
        }

        .submit-btn:hover {
            background-color: #5a4a42;
        }

        .back-link {
            display: inline-block;
            font-size: 14px;
            color: #8b7e74;
            text-decoration: none;
            transition: color 0.2s;
        }

        .back-link:hover {
            color: #5a4a42;
        }

        @media (max-width: 480px) {
            .card {
                padding: 36px 28px;
            }
            
            h1 {
                font-size: 24px;
            }
            
            .subtext {
                font-size: 13px;
            }
        }
    </style>
</head>
<body>
    <div class="container">
        <div class="card">
            <h1>Forgot Password?</h1>
            <p class="subtext">Enter your email below to receive instructions on how to reset your password.</p>
            
            <form>
                <input type="email" class="email-input" placeholder="Enter your email address" required>
                <button type="submit" class="submit-btn">Send Reset Link</button>
            </form>
            
            <a href="#" class="back-link">← Back to Login</a>
        </div>
    </div>
</body>
</html>