<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Shopping Cart | ELARA</title>
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;600&family=Poppins:wght@300;400;500&display=swap" rel="stylesheet">
    <style>
        :root {
    --bg-color: #FAF7F5;
    --text-dark: #4A302C;
    --accent-gold: #A17C6B;
    --border-color: #E0D6D0;
    --white: #FFFFFF;
}

body {
    margin: 0;
    font-family: 'Poppins', sans-serif;
    background-color: var(--bg-color);
    color: var(--text-dark);
}

.container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 60px 20px;
}

/* Header & Logo */
header {
    background-color: var(--white);
    border-bottom: 1px solid var(--border-color);
    padding: 20px 0;
}

.nav-container {
    display: flex;
    justify-content: space-between;
    align-items: center;
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 20px;
}

.logo {
    font-family: 'Playfair Display', serif;
    font-size: 26px;
    letter-spacing: 2px;
}

nav a {
    text-decoration: none;
    color: var(--text-dark);
    margin: 0 15px;
    font-size: 13px;
    letter-spacing: 1px;
}

/* Cart Page Layout */
.page-title {
    font-family: 'Playfair Display', serif;
    text-align: center;
    font-size: 36px;
    margin-bottom: 50px;
}

.cart-layout {
    display: grid;
    grid-template-columns: 1.5fr 0.5fr;
    gap: 40px;
}

/* Items Section */
.cart-items {
    background: var(--white);
    border: 1px solid var(--border-color);
    border-radius: 8px;
    padding: 30px;
}

.table-header {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr;
    font-weight: 500;
    padding-bottom: 20px;
    border-bottom: 1px solid var(--border-color);
}

.cart-row {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr;
    align-items: center;   /* THIS IS IMPORTANT */
    padding: 25px 0;
    border-bottom: 1px solid #f0f0f0;
}


.product-info {
    display: flex;
    gap: 20px;
    align-items: center;
    min-height: 80px;   /* important */
}


.product-info img {
    width: 70px;
    height: 70px;
    object-fit: cover;
    border-radius: 4px;
}

.product-info h4 { margin: 0; font-size: 14px; }
.metal { font-size: 12px; color: #888; margin: 2px 0; }
.price { font-size: 13px; font-weight: 500; }

.quantity-controls {
    display: flex;
    align-items: center;
    justify-content: center;
}


.qty-btn {
    background: none;
    border: none;
    padding: 5px 12px;
    cursor: pointer;
    color: var(--text-dark);
}

.quantity-controls input {
    width: 30px;
    text-align: center;
    border: none;
    background: transparent;
    font-size: 14px;
}

.total-price {
    display: flex;
    align-items: center;
    justify-content: space-between;
}


.remove-btn {
    background: none;
    border: none;
    color: #A17C6B;
    cursor: pointer;
    font-size: 18px;
}

/* Summary Sidebar */
.cart-summary {
    background: var(--white);
    border: 1px solid var(--border-color);
    border-radius: 8px;
    padding: 40px;
    height: fit-content;
}

.summary-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 15px;
}

.subtotal-label { font-size: 18px; font-weight: 500; }
.subtotal-value { font-size: 20px; font-weight: 600; }

.shipping-note {
    font-size: 12px;
    color: #666;
    margin-bottom: 30px;
}

.btn-checkout {
    width: 100%;
    background-color: var(--accent-gold);
    color: var(--white);
    border: none;
    padding: 10px;
    border-radius: 4px;
    cursor: pointer;
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 1px;
    margin-bottom: 15px;
}

.btn-back {
    width: 100%;
    background: transparent;
    border: 1px solid var(--text-dark);
    padding: 10px;
    border-radius: 4px;
    cursor: pointer;
    font-size: 12px;
}


.subscribe-box {
    display: flex;
    border-bottom: 1px solid var(--accent-gold);
    padding-bottom: 5px;
}

.subscribe-box input {
    background: transparent;
    border: none;
    color: var(--white);
    outline: none;
    width: 100%;
}

.arrow-btn {
    background: none;
    border: none;
    color: var(--white);
    font-size: 20px;
    cursor: pointer;
}
.total-price {
  display: flex;
  align-items: center;
  gap: 12px;
}
.qty-box {
  display: flex;
  align-items: center;
  border: 2px solid #d9d9d9;
  border-radius: 12px;
  width: 130px;
  height: 45px;
  justify-content: space-between;
  padding: 0 10px;
}

.qty-btn {
  background: none;
  border: none;
  font-size: 22px;
  cursor: pointer;
  color: #444;
}

.qty-input {
  width: 40px;
  text-align: center;
  border: none;
  font-size: 18px;
  font-weight: 600;
  background: transparent;
}

.cart-row {
  display: grid;
  grid-template-columns: 2.5fr 1fr 1fr; /* increase product column */
  align-items: center;
  padding: 20px 0;
  border-bottom: 1px solid #f0f0f0;
  gap: 10px;
}

.total-price {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.qty-box {
  display: flex;
  align-items: center;
  justify-content: space-between;
  width: 120px;
  border: 1px solid #d9d9d9;
  border-radius: 8px;
  padding: 0 8px;
  height: 40px;
}

.qty-btn {
  font-size: 20px;
  cursor: pointer;
  border: none;
  background: none;
}
.qty-input {
  width: 40px;
  text-align: center;
  border: none;
  background: transparent;
}




 </style>
</head>
<body>
      <%- include('../partials/header') %>


    <main class="container">
        <h2 class="page-title">Shopping Cart</h2>

        <div class="cart-layout">
            <section class="cart-items">
  <div class="table-header">
      <span>PRODUCT</span>
      <span>Quantity</span>
      <span>TOTAL</span>
  </div>

  <% if(cartItems.length > 0){ %>
    <% cartItems.forEach(item => { %>
      <div class="cart-row" data-id="<%= item.productId %>" data-price="<%= item.price %>">
        <!-- Product Info -->
        <div class="product-info">
          <img src="<%= item.image %>" alt="<%= item.name %>">
          <div>
            <h4><%= item.name %></h4>
            <p class="price">₹ <%= item.price %></p>
          </div>
        </div>

        <!-- Quantity Controls -->
        <div class="quantity-controls">
          <div class="qty-box">
            <button class="qty-btn minus">−</button>
            <input type="text" value="<%= item.quantity %>" class="qty-input">
            <button class="qty-btn plus">+</button>
          </div>
        </div>

        <!-- Total & Remove -->
        <div class="total-price">
          <span class="item-total">₹ <%= item.price * item.quantity %></span>
          <form action="/cart/remove/<%= item.productId %>" method="POST">
            <button type="submit" class="remove-btn">
              🗑
            </button>
          </form>
        </div>
      </div>
    <% }) %>
  <% } else { %>
    <p>Your cart is empty</p>
  <% } %>
</section>

            <aside class="cart-summary">
                <div class="summary-box">
                    <div class="summary-row">
                        <span class="subtotal-label">Subtotal :</span>
                        <span class="subtotal-value">₹ 1298.00</span>
                    </div>
                    <p class="shipping-note">Tax and Shipping calculated at checkout</p>
                    
<button class="btn-checkout" onclick="window.location.href='/checkout'">
    Proceed to Checkout
</button>
<button class="btn-back" onclick="window.location.href='/shop'">
    Back To Shopping
</button>

                    
                </div>
            </aside>
        </div>
    </main>
   

     <%- include('../partials/footer') %>

 <script>
document.querySelectorAll(".cart-row").forEach(row => {
  const minus = row.querySelector(".minus");
  const plus = row.querySelector(".plus");
  const input = row.querySelector(".qty-input");
  const total = row.querySelector(".item-total");
  const price = parseInt(row.dataset.price);

  minus.addEventListener("click", () => {
    let val = parseInt(input.value);
    if (val > 1) {
      input.value = val - 1;
      total.innerText = `₹ ${price * (val - 1)}`;
      updateSubtotal();
    }
  });

  plus.addEventListener("click", () => {
    let val = parseInt(input.value);
    input.value = val + 1;
    total.innerText = `₹ ${price * (val + 1)}`;
    updateSubtotal();
  });
});

function updateSubtotal() {
  let subtotal = 0;
  document.querySelectorAll(".cart-row").forEach(row => {
    const qty = parseInt(row.querySelector(".qty-input").value);
    const price = parseInt(row.dataset.price);
    subtotal += qty * price;
  });
  document.querySelector(".subtotal-value").innerText = `₹ ${subtotal}`;
}

// Initial calculation
updateSubtotal();
</script>



</body>
</html>