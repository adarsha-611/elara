<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ELARA - My Profile</title>
    <script src="https://cdn.tailwindcss.com"></script>

    <link rel="stylesheet" href="/css/profile.css">
    <style>

    </style>
</head>
<body>
    <!-- Navigation Bar -->
    <%- include('../partials/header') %>


    <div class="page-header">
        <h2>Welcome, <%= user.fullName %></h2>
    </div>

    <main class="main-content">
        <div class="content-wrapper">
            <!-- Left Sidebar -->
       <%- include('../partials/profileSidebar', { user, path: '/profile' }) %>

            <!-- Right Content Card -->
            <section class="profile-card">
                <% if (success && success.length > 0) { %>
                    <div style="background: #d4edda; color: #155724; padding: 10px; margin-bottom: 10px;">
                        <%= success %>
                    </div>
                <% } %>
                <% if (error && error.length > 0) { %>
                    <div style="background: #f8d7da; color: #721c24; padding: 10px; margin-bottom: 10px;">
                        <%= error %>
                    </div>
                <% } %>

                <div class="card-header">
                    <h1>My Profile</h1>
                    <p>Manage your personal information</p>
                </div>

                <div class="profile-content">
                    <div class="profile-form">
                         <div class="form-group">
                             <label>Full Name</label>
                             <div class="display-field"><%= user.fullName %></div>
                         </div>
                         <div class="form-group">
                             <label>Email</label>
                             <div class="display-field"><%= user.email %></div>
                         </div>
                    </div>
                </div>

                <div class="action-buttons">
                    <a href="/profile/edit" class="btn btn-primary">Edit Profile</a>
                    <a href="/profile/change-password" class="btn btn-secondary">Change Password</a>
                </div>
            </section>
        </div>
    </main>
     <%- include('../partials/footer') %>
    <script>
      
    </script>
</body>
</html>
