<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ELARA - My Profile</title>
    <link rel="stylesheet" href="/css/profile.css">
</head>
<body>
    <!-- Navigation Bar -->
    <header class="navbar">
        <div class="nav-container">
            <div class="logo">ELARA</div>
            <nav class="nav-links">
                <a href="#home">HOME</a>
                <a href="#shop">SHOP</a>
                <a href="#about">ABOUT US</a>
                <a href="#contact">CONTACT</a>
            </nav>
            <div class="nav-icons">
                <a href="#wishlist">♡</a>
                <a href="#profile">👤</a>
                <a href="#cart">🛒</a>
            </div>
        </div>
    </header>

    <!-- Page Header -->
    <div class="page-header">
        <h2>Welcome, Adarsha</h2>
    </div>

    <!-- Main Content -->
    <main class="main-content">
        <div class="content-wrapper">
            <!-- Left Sidebar -->
            <aside class="sidebar">
                <div class="user-info">
                    <div class="user-avatar">A</div>
                    <div class="user-details">
                        <h3>Adarsha</h3>
                        <p>adar*********@gmail.com</p>
                    </div>
                </div>
                <nav class="sidebar-menu">
                    <a href="#profile" class="menu-item active">
                        <span class="icon">👤</span>
                        <span>My Profile</span>
                    </a>
                    <a href="#orders" class="menu-item">
                        <span class="icon">📦</span>
                        <span>My Orders</span>
                    </a>
                    <a href="#wallet" class="menu-item">
                        <span class="icon">💳</span>
                        <span>Wallet</span>
                    </a>
                    <a href="#address" class="menu-item">
                        <span class="icon">📍</span>
                        <span>My Address</span>
                    </a>
                    <a href="#refer" class="menu-item">
                        <span class="icon">🎁</span>
                        <span>Refer & Earn</span>
                    </a>
                    <a href="#logout" class="menu-item">
                        <span class="icon">🚪</span>
                        <span>Log Out</span>
                    </a>
                </nav>
            </aside>

            <!-- Right Content Card -->
            <section class="profile-card">
                <div class="card-header">
                    <h1>My Profile</h1>
                    <p>Manage your personal information and preferences</p>
                </div>

                <div class="profile-content">
                    <div class="profile-image-section">
                        <label class="image-label">Profile Image</label>
                        <div class="avatar-circle">
                            <div class="avatar-icon">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor">
                                    <circle cx="12" cy="8" r="4"/>
                                    <path d="M6 21v-2a4 4 0 0 1 4-4h4a4 4 0 0 1 4 4v2"/>
                                </svg>
                            </div>
                        </div>
                        <button class="choose-image-btn">+ Choose Image</button>
                    </div>

                    <div class="profile-form">
                        <div class="form-group">
                            <label>Full Name</label>
                            <input type="text" value="Adarsha">
                        </div>
                        <div class="form-group">
                            <label>Email</label>
                            <input type="email" value="adarsha@gmail.com">
                        </div>
                        <div class="form-group">
                            <label>Phone Number</label>
                            <input type="tel" value="9999999999">
                        </div>
                    </div>
                </div>

                <div class="action-buttons">
                    <button class="btn btn-primary">Edit Details</button>
                    <button class="btn btn-secondary">Change password</button>
                </div>
            </section>
        </div>
    </main>

    <!-- Footer -->
    <footer class="footer">
        <div class="footer-container">
            <div class="footer-column">
                <h4>Exclusive</h4>
                <p class="footer-subtitle">Subscribe</p>
                <p class="small-text">Get 10% off on your first order</p>
                <div class="subscribe-box">
                    <input type="email" placeholder="Enter your email">
                    <button>→</button>
                </div>
            </div>
            <div class="footer-column">
                <h4>Support</h4>
                <p>9th Floor DRBR<br>Business Park, MRC Nagar<br>Chennai - 600028</p>
                <p>hishadevice@gmail.com</p>
                <p>+91 88 4473 4581</p>
            </div>
            <div class="footer-column">
                <h4>Account</h4>
                <a href="#">My Account</a>
                <a href="#">Login / Register</a>
                <a href="#">Cart</a>
                <a href="#">Wishlist</a>
                <a href="#">Shop</a>
            </div>
            <div class="footer-column">
                <h4>Quick Link</h4>
                <a href="#">Privacy Policy</a>
                <a href="#">Terms Of Use</a>
                <a href="#">FAQ</a>
                <a href="#">Contact</a>
            </div>
            <div class="footer-column">
                <h4>Download App</h4>
                <p class="small-text">Save $3 with App New User Only</p>
                <div class="qr-code"></div>
                <div class="app-badges">
                    <div class="badge">Google Play</div>
                    <div class="badge">App Store</div>
                </div>
                <div class="social-icons">
                    <a href="#">f</a>
                    <a href="#">t</a>
                    <a href="#">in</a>
                    <a href="#">in</a>
                </div>
            </div>
        </div>
        <div class="footer-bottom">
            <p>© Copyright ELARA 2024. All rights reserved</p>
        </div>
    </footer>
</body>
</html>