<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ELARA - Luxury Jewelry</title>
    <link rel="stylesheet" href="/css/HomePage.css">
</head>
<body>
    <!-- Navigation Bar -->
    <header class="navbar">
        <div class="nav-container">
            <div class="logo">ELARA</div>
            <nav class="nav-links">
                <a href="/home">HOME</a>
                <a href="#shop">SHOP</a>
                <a href="#about">ABOUT US</a>
                <a href="#contact">CONTACT</a>
            </nav>
            <div class="nav-icons">
                <a href="wishlist">♡</a>
                <a href="profile">👤</a>
                <a href="cart">🛒</a>
            </div>
        </div>
    </header>

    <!-- Hero Image Strip -->
    <section class="hero-strip">
        <div class="hero-strip-container">
            <div class="hero-strip-item">
                <div class="strip-text">SHOW NOW</div>
                <img src="/Images/sideImg1.jfif" alt="Jewelry detail">
            </div>
            <div class="hero-strip-item center">
                <img src="/Images/mainimage.jpg" alt="Model with hat" class="circle-image">
            </div>
            <div class="hero-strip-item">
                <div class="strip-text right">SHOW NOW</div>
                <img src="/Images/sideimg2.jfif" alt="Jewelry detail">
            </div>
        </div>
    </section>

    <!-- Welcome Section -->
    <section class="welcome">
        <div class="welcome-container">
            <div class="welcome-image">
                <img src="/Images/Main.jfif" alt="Model with palm leaf">
            </div>
            <div class="welcome-text">
                <h1>WELCOME, ELARA</h1>
                <p>where every piece is crafted to<br>illuminate your inner shine</p>
            </div>
        </div>
    </section>

    <!-- Featured Jewelry Images -->
    <section class="featured-jewelry">
        <div class="featured-container">
            <div class="featured-item">
                <img src="/Images/model3.jpg" alt="Earring closeup">
            </div>
            <div class="featured-item">
                <img src="/Images/model5.jfif" alt="Earring closeup">
            </div>
            <div class="featured-item">
                <img src="/Images/model1.jpeg" alt="Earring closeup">
            </div>
            <div class="featured-item">
                <img src="/Images/model6.jpg" alt="Earring closeup">
            </div>
        </div>
    </section>

    <!-- New Arrivals Section -->
    <section class="new-arrivals">
        <h2 class="section-title">NEW ARRIVALS</h2>
        <div class="products-grid">
            <div class="product-card">
                <div class="product-image">
                    <img src="/Images/Gold Jewellery.jpg" alt="Golden Pearl Circle Studs">
                </div>
                <h3>Golden Pearl Circle Studs</h3>
                <p class="price">₹1,299.00</p>
            </div>
            <div class="product-card">
                <div class="product-image">
                    <img src="/Images/landingpg-1.jpg" alt="Textured Drop Earrings">
                </div>
                <h3>Textured Drop Earrings</h3>
                <p class="price">₹1,599.00</p>
            </div>
            <div class="product-card">
                <div class="product-image">
                    <img src="/Images/homepg2.jfif" alt="Rose Gold Stud Earrings">
                </div>
                <h3>Rose Gold Stud Earrings</h3>
                <p class="price">₹2,199.00</p>
            </div>
            <div class="product-card">
                <div class="product-image">
                    <img src="/Images/homepg3.jpg" alt="Polygon Leaf Studs">
                </div>
                <h3>Polygon Leaf Studs</h3>
                <p class="price">₹1,899.00</p>
            </div>
        </div>
    </section>

    <!-- Trending More Section -->
    <section class="trending-more">
        <h2 class="section-title">TRENDING MORE</h2>
        <div class="products-grid three-cols">
            <div class="product-card">
                <div class="product-image">
                    <img src="/Images/Circle Drop Earrings.jpg" alt="Golden Circles Studs">
                </div>
                <h3>Golden Circles Studs</h3>
                <p class="price">₹1,499.00</p>
            </div>
            <div class="product-card">
                <div class="product-image">
                    <img src="/Images/homePg1.jfif" alt="Golden Pearl Mono Studs">
                </div>
                <h3>Golden Pearl Mono Studs</h3>
                <p class="price">₹1,799.00</p>
            </div>
            <div class="product-card">
                <div class="product-image">
                    <img src="/Images/Lotus Studs.jfif" alt="Golden Lotus Studs">
                </div>
                <h3>Golden Lotus Studs</h3>
                <p class="price">₹2,299.00</p>
            </div>
        </div>
    </section>

    <!-- Footer -->
    <footer class="footer">
        <div class="footer-container">
            <div class="footer-column">
                <h4>Exclusive</h4>
                <p class="footer-subtitle">Subscribe</p>
                <p class="small-text">Get 10% off on your first order</p>
                <div class="subscribe-box">
                    <input type="email" placeholder="Enter your email">
                    <button>→</button>
                </div>
            </div>
            <div class="footer-column">
                <h4>Support</h4>
                <p>9th Floor DRBR<br>Tharamani, Tamil Nadu<br>Chennai - 600113</p>
                <p>elara@support.com</p>
                <p>+91 88 4473 4581</p>
            </div>
            <div class="footer-column">
                <h4>Account</h4>
                <a href="#">My Account</a>
                <a href="#">Login / Register</a>
                <a href="#">Cart</a>
                <a href="#">Wishlist</a>
                <a href="#">Shop</a>
            </div>
            <div class="footer-column">
                <h4>Quick Link</h4>
                <a href="#">Privacy Policy</a>
                <a href="#">Terms Of Use</a>
                <a href="#">FAQ</a>
                <a href="#">Contact</a>
            </div>
            <div class="footer-column download">
                <h4>Download App</h4>
                <p class="small-text">Save $3 with App New User Only</p>
                <div class="app-download">
                    <div class="qr-code"></div>
                    <div class="app-badges">
                        <div class="badge">Google Play</div>
                        <div class="badge">App Store</div>
                    </div>
                </div>
                <div class="social-icons">
                    <a href="#">f</a>
                    <a href="#">t</a>
                    <a href="#">in</a>
                    <a href="#">in</a>
                </div>
            </div>
        </div>
        <div class="footer-bottom">
            <p>© Copyright ELARA 2024. All rights reserved</p>
        </div>
    </footer>
</body>
</html>