<!DOCTYPE html>
<html lang="en"><head>
<meta charset="utf-8"/>
<meta content="width=device-width, initial-scale=1.0" name="viewport"/>
<title>Elara - Luxury Jewelry</title>
<script src="https://cdn.tailwindcss.com?plugins=forms,typography"></script>
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,500;0,600;0,700;1,400&amp;family=Lato:wght@300;400;700&amp;display=swap" rel="stylesheet"/>
<script src="https://cdn.tailwindcss.com"></script>

    <script>
tailwind.config = {
  theme: {
    extend: {
      colors: {
        'elara-brown': '#7A5C4D'
      }
    }
  }
}
</script><script>
        tailwind.config = {
            darkMode: "class",
            theme: {
                extend: {
                    colors: {
                        primary: "#a3866a", 
                        "primary-dark": "#8a7055",
                        "background-light": "#f6f3f0", 
                        "background-dark": "#1a1a1a", 
                        "charcoal": "#333333",
                        "charcoal-dark": "#1f1f1f", 
                        "card-light": "#ffffff",
                        "card-dark": "#2a2a2a",
                    },
                    fontFamily: {
                        display: ["'Playfair Display'", "serif"],
                        body: ["'Lato'", "sans-serif"],
                    },
                    borderRadius: {
                        DEFAULT: "4px",
                    },
                },
            },
        };
    </script>
<style>.aspect-h-4 {
            padding-bottom: 56.25%;
        }
    </style>
</head>
<body class="bg-background-light dark:bg-background-dark text-charcoal dark:text-gray-200 transition-colors duration-300 font-body">
<%- include('../partials/header') %>

<header class="w-full max-w-[1400px] mx-auto grid grid-cols-1 md:grid-cols-12 gap-4 px-4 md:px-8 mb-16">
<div class="md:col-span-8 relative h-[600px] bg-gray-200 overflow-hidden group">
<img alt="Woman wearing elegant black blazer and gold statement earrings" class="w-full h-full object-cover" src="/Images/Gemini_Generated_Image_i22pa3i22pa3i22p.png"/>
<div class="absolute inset-0 bg-gradient-to-r from-black/40 to-transparent flex flex-col justify-center px-12 md:px-20 text-white">
<h2 class="font-display text-4xl mb-4 tracking-wider">ELARA</h2>
<h1 class="font-display text-5xl md:text-6xl mb-4 leading-tight">Statement Gold Earrings</h1>
<p class="font-body text-lg mb-8 font-light tracking-wide opacity-90">Shop the latest collection.</p>
<a class="bg-[#a3866a] hover:bg-[#8a7055] text-white px-8 py-3 w-max uppercase text-sm tracking-widest transition-colors shadow-lg" href="/shop">Shop Now</a>
</div>
</div>
<div class="md:col-span-4 flex flex-col gap-4 h-[600px]">
<div class="h-1/2 overflow-hidden bg-gray-200 relative">
<img alt="Close up of gold drop earrings" class="w-full h-full object-cover" src="/Images/Earrings fo Daily Use _ Earrings.jfif"/>
</div>
<div class="h-1/2 overflow-hidden bg-gray-200 relative">
<img alt="Woman touching her gold necklace and earrings" class="w-full h-full object-cover" src="/Images/night women.jfif"/>
</div>
</div>
</header>
<section class="w-full bg-primary py-16 text-center text-white px-4">
<h2 class="font-display text-3xl md:text-4xl mb-4 tracking-wide">WELCOME, ELARA</h2>
<p class="font-body font-light tracking-wide text-sm opacity-90">Slow luxury, handcrafted for the modern woman.</p>
</section>
<section class="max-w-6xl mx-auto py-20 px-4 md:px-8">
<h3 class="font-display text-3xl md:text-4xl text-center mb-16 tracking-widest text-charcoal dark:text-white uppercase">New Arrivals</h3>
<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">

<% if(products && products.length > 0){ %>

  <% products.forEach(product => { %>

    <% 
       const firstVariant = product.variants[0];
       const image = firstVariant && firstVariant.images.length > 0 
                     ? firstVariant.images[0] 
                     : '/Images/default.png';

       const price = firstVariant ? firstVariant.price : 0;
    %>

    <div class="group cursor-pointer">
        <a href="/productDetail/<%= product._id %>">

            <div class="bg-gray-100 dark:bg-card-dark aspect-square overflow-hidden mb-4 relative">
                <img 
                    src="<%= image %>" 
                    alt="<%= product.name %>"
                    class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                />
            </div>

            <div class="bg-white dark:bg-card-dark p-4 border border-gray-100 dark:border-gray-700 shadow-sm">
                <h4 class="font-display text-lg mb-1 text-charcoal dark:text-white">
                    <%= product.name %>
                </h4>

                <p class="text-gray-500 dark:text-gray-400 text-sm font-light">
                    ₹ <%= price %>
                </p>
            </div>

        </a>
    </div>

  <% }) %>

<% } else { %>

    <p>No products available</p>

<% } %>

</div>
</section>
<section class="max-w-6xl mx-auto pb-24 px-4 md:px-8">
<h3 class="font-display text-3xl md:text-4xl text-center mb-16 tracking-widest text-charcoal dark:text-white uppercase">Trending More</h3>
<div class="grid grid-cols-1 md:grid-cols-3 gap-8">
<div class="group cursor-pointer">
<div class="bg-gray-100 dark:bg-card-dark h-64 overflow-hidden mb-0 relative">
<img alt="Heritage Link chain earrings" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" src="https://lh3.googleusercontent.com/aida-public/AB6AXuBPomr9scrmG6vOsefYgSXfLxE_Q5PPdIlK9pO1NiED39ikj-nQxBvjTI9v3sGE5p1rOUNWxd1QtiF8KwLwB_WkCqBpaPdc-N_-U_KwFn-U67A3WS0iuM1WirBlUtKfuThKTGCx1QhyjcwGFMYcZo9dNW_PDEr59RKAlk6X4hayFoDH_4x_gUoSTh7CN88qy1T14C_dhnrbZr2YsEgOvDGbwxfBgjF2GChSLTZfgbuUkVLzvW5TUnrgLxuxdBjRzguEV0sd8qG13EeZ"/>
</div>
<div class="bg-white dark:bg-card-dark p-6 border border-gray-100 dark:border-gray-700 shadow-sm">
<h4 class="font-display text-xl mb-2 text-charcoal dark:text-white">Heritage Link</h4>
<p class="text-gray-500 dark:text-gray-400 font-light">₹ 32,560</p>
</div>
</div>
<div class="group cursor-pointer">
<div class="bg-gray-100 dark:bg-card-dark h-64 overflow-hidden mb-0 relative">
<img alt="Dawn Develraps floral earrings" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" src="https://lh3.googleusercontent.com/aida-public/AB6AXuDmWiShuSOxx26NlwAgQboD4Mddnya1ZXqR5UDl1W5epkTLGU1ose1BFd0D8WWPku8C08kOWqXSzTkL7DaTwTcD4JDqR6wurQj1zQXNrtNIJgQv9s1_H_Bq0eKgPWsdRaKiwuj1gOP2nM7i7AMdczHWVnlVmWPyKOji6rYXQ1aWV8xAO-qibgwbZVHSFZHqQyxZQ7eFbmb4a3tOj6BxtKaKY5JEZL_ecJ8rRuaWKbl8NXRugnbKXw8P-uHvdMF236NraG9Okt1ywQ2z"/>
</div>
<div class="bg-white dark:bg-card-dark p-6 border border-gray-100 dark:border-gray-700 shadow-sm">
<h4 class="font-display text-xl mb-2 text-charcoal dark:text-white">Dawn Develraps</h4>
<p class="text-gray-500 dark:text-gray-400 font-light">₹ 19,800</p>
</div>
</div>
<div class="group cursor-pointer">
<div class="bg-gray-100 dark:bg-card-dark h-64 overflow-hidden mb-0 relative">
<img alt="Luna Crescent moon earrings" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" src="https://lh3.googleusercontent.com/aida-public/AB6AXuCTTHblRaYj3qbN3y7JieryDZnZE9mGtYzLL4yRm532pjScBKtGE_rzoWLAySJaqhgTOGJWskaw-ZnyB2O83ddYtCiSdPIiygn10z6pD1a5btGDLdmFqflHcFx6YddXQ1eTLdUg1VfiSmMxgxBQX9xaIoji9jFOU7vCZPFMKndfKLZrtMNgzaUUrohLt2cg2HBEMMNUTL0hhha15ATIY9xTYhKyHEKHJSQMrkQ1lYZcas98_CW0lwRlOHorBM9aT-ir800yO9MwB3By"/>
</div>
<div class="bg-white dark:bg-card-dark p-6 border border-gray-100 dark:border-gray-700 shadow-sm">
<h4 class="font-display text-xl mb-2 text-charcoal dark:text-white">Luna Crescent</h4>
<p class="text-gray-500 dark:text-gray-400 font-light">₹ 21,000</p>
</div>
</div>
</div>
</section>
<%- include('../partials/footer') %>

</body></html>