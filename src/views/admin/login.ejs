<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ELARA - Admin Login</title>
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,500;0,600;0,700;1,400&family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Inter', sans-serif;
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 100vh;
            background: linear-gradient(135deg, #FEFAF6 0%, #f0e8e0 100%);
            position: relative;
            overflow: hidden;
        }

        
        body::before {
            content: '';
            position: absolute;
            width: 300px;
            height: 300px;
            background: radial-gradient(circle, rgba(201,169,110,0.1) 0%, transparent 70%);
            top: -150px;
            right: -150px;
            border-radius: 50%;
        }

        body::after {
            content: '';
            position: absolute;
            width: 400px;
            height: 400px;
            background: radial-gradient(circle, rgba(201,169,110,0.08) 0%, transparent 70%);
            bottom: -200px;
            left: -200px;
            border-radius: 50%;
        }

        .login-card {
            background: #ffffff;
            padding: 48px 40px;
            border-radius: 24px;
            box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.15);
            width: 100%;
            max-width: 440px;
            text-align: center;
            position: relative;
            z-index: 1;
            border: 1px solid rgba(201, 169, 110, 0.2);
            transition: transform 0.3s ease, box-shadow 0.3s ease;
        }

        .login-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 30px 60px -12px rgba(0, 0, 0, 0.2);
        }

        /* Logo */
        .logo {
            font-family: 'Playfair Display', serif;
            font-size: 2.5rem;
            font-weight: 600;
            background: linear-gradient(135deg, #c9a96e 0%, #8a7055 100%);
            background-clip: text;
            -webkit-background-clip: text;
            color: transparent;
            margin-bottom: 12px;
            letter-spacing: 2px;
        }

        .logo-sub {
            font-size: 0.7rem;
            text-transform: uppercase;
            letter-spacing: 4px;
            color: #a68b67;
            font-weight: 500;
            margin-bottom: 32px;
        }

        h2 {
            font-family: 'Playfair Display', serif;
            font-size: 1.8rem;
            font-weight: 500;
            color: #1E1A17;
            margin-bottom: 8px;
        }

        .admin-badge {
            display: inline-block;
            background: linear-gradient(135deg, #c9a96e20 0%, #8a705520 100%);
            color: #8a7055;
            font-size: 0.7rem;
            padding: 4px 12px;
            border-radius: 20px;
            font-weight: 600;
            margin-bottom: 32px;
            letter-spacing: 1px;
        }

        .form-group {
            margin-bottom: 24px;
            text-align: left;
        }

        label {
            display: block;
            margin-bottom: 8px;
            font-weight: 600;
            color: #1E1A17;
            font-size: 0.85rem;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .input-wrapper {
            position: relative;
        }

        .input-wrapper i {
            position: absolute;
            left: 14px;
            top: 50%;
            transform: translateY(-50%);
            color: #c9a96e;
            font-size: 1rem;
        }

        input {
            width: 100%;
            padding: 12px 12px 12px 42px;
            border: 1.5px solid #e8ddd0;
            border-radius: 12px;
            box-sizing: border-box;
            background: #fefaf6;
            font-size: 0.95rem;
            transition: all 0.3s ease;
            font-family: 'Inter', sans-serif;
        }

        input:focus {
            outline: none;
            border-color: #c9a96e;
            background: #ffffff;
            box-shadow: 0 0 0 3px rgba(201, 169, 110, 0.1);
        }

        input:hover {
            border-color: #c9a96e;
        }

        button {
            background: linear-gradient(135deg, #8a7055 0%, #6d5942 100%);
            color: white;
            padding: 14px;
            width: 100%;
            border: none;
            border-radius: 12px;
            cursor: pointer;
            font-size: 0.9rem;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 1.5px;
            transition: all 0.3s ease;
            margin-top: 8px;
            position: relative;
            overflow: hidden;
        }

        button::before {
            content: '';
            position: absolute;
            top: 0;
            left: -100%;
            width: 100%;
            height: 100%;
            background: linear-gradient(90deg, transparent, rgba(255,255,255,0.2), transparent);
            transition: left 0.5s;
        }

        button:hover {
            background: linear-gradient(135deg, #6d5942 0%, #5a4733 100%);
            transform: translateY(-2px);
            box-shadow: 0 10px 20px -5px rgba(109, 89, 66, 0.3);
        }

        button:hover::before {
            left: 100%;
        }

        button:active {
            transform: translateY(0);
        }

        .error {
            color: #dc2626;
            background: #fef2f2;
            padding: 12px 16px;
            margin-bottom: 24px;
            border-radius: 12px;
            border: 1px solid #fecaca;
            font-size: 0.85rem;
            font-weight: 500;
            display: flex;
            align-items: center;
            gap: 8px;
            text-align: left;
        }

        .error i {
            font-size: 1rem;
        }

        .footer-text {
            margin-top: 24px;
            font-size: 0.7rem;
            color: #a68b67;
            letter-spacing: 0.5px;
        }

        @media (max-width: 480px) {
            .login-card {
                margin: 16px;
                padding: 32px 24px;
            }
            
            .logo {
                font-size: 2rem;
            }
            
            h2 {
                font-size: 1.5rem;
            }
        }
    </style>
</head>
<body>
    <div class="login-card">
        <div class="logo">ELARA</div>
        <div class="logo-sub">Administration</div>
        <h2>Welcome Back</h2>
        <div class="admin-badge">
            <i class="fas fa-shield-alt" style="font-size: 0.7rem; margin-right: 4px;"></i> Admin Portal
        </div>
        
        <% if (error && error.length > 0) { %>
            <div class="error">
                <i class="fas fa-exclamation-circle"></i>
                <span><%= error[0] %></span>
            </div>
        <% } %>
        
        <form action="/admin/login" method="POST">
            <div class="form-group">
                <label><i class="far fa-envelope" style="margin-right: 6px;"></i> Email</label>
                <div class="input-wrapper">
                    <i class="far fa-envelope"></i>
                    <input type="email" name="email" placeholder="admin@elara.com" required>
                </div>
            </div>
            <div class="form-group">
                <label><i class="fas fa-lock" style="margin-right: 6px;"></i> Password</label>
                <div class="input-wrapper">
                    <i class="fas fa-lock"></i>
                    <input type="password" name="password" placeholder="••••••••" required>
                </div>
            </div>
            <button type="submit">
                <i class="fas fa-arrow-right-to-bracket" style="margin-right: 8px;"></i> Login
            </button>
        </form>
        <div class="footer-text">
            Secure access for authorized personnel only
        </div>
    </div>
    
    <script>
        setTimeout(() => {
            const err = document.querySelector(".error");
            if (err) {
                err.style.transition = "opacity 0.3s ease";
                err.style.opacity = "0";
                setTimeout(() => {
                    err.style.display = "none";
                }, 300);
            }
        }, 3000);
    </script>
</body>
</html>