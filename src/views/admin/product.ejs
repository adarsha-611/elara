<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ELARA Admin | Products</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600&family=Playfair+Display:wght@600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/product.css">
</head>
<body>

    
    <%- include('../partials/adminSidebar') %>

    <main class="main-content">
        <header class="content-header">
            <div class="header-top">
                <h2>Products</h2>
                <div class="header-actions">
                    <div class="search-wrapper">
                        <span class="search-icon">🔍</span>
                        <input type="text" placeholder="Search products..." id="productSearch">
                    </div>
                    <a href="/admin/add-product" class="btn-add">+ Add New Product</a>
                </div>
            </div>

        </header>

        <section class="table-card">
            <table class="product-table">
                <thead>
                    <tr>
                        <th>Image</th>
                        <th>Product Name</th>
                        <th>Category</th>
                        <th>Variants</th>
                        <th>Price</th>
                        <th>Stock</th>
                        <th>List / Unlist</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    <% if (products && products.length > 0) { %>
                        <% products.forEach(product => { %>
                            <% 
                                const firstVariant = product.variants && product.variants[0] ? product.variants[0] : null;
                                const imageUrl = firstVariant && firstVariant.images && firstVariant.images[0] 
                                    ? firstVariant.images[0] 
                                    : "/images/default-product.png";
                                
                                let priceDisplay = "—";
                                let stockTotal = 0;
                                
                                if (product.variants && product.variants.length > 0) {
                                    const prices = product.variants.map(v => v.price).filter(p => p != null);
                                    if (prices.length > 0) {
                                        const min = Math.min(...prices);
                                        const max = Math.max(...prices);
                                        priceDisplay = min === max ? `₹${min.toLocaleString()}` : `₹${min.toLocaleString()} – ₹${max.toLocaleString()}`;
                                    }
                                    stockTotal = product.variants.reduce((sum, v) => sum + (v.stock || 0), 0);
                                }
                            %>
                            <tr data-active="<%= product.isActive %>">
                                <td>
                                <div class="prod-img-placeholder"
     style="background-image: url('<%= imageUrl && imageUrl.startsWith('/') ? imageUrl : '/' + imageUrl %>')">
</div>

                                </td>
                                <td class="prod-name">
                                    <%= product.name %>
                                    <% if (product.variants && product.variants.length > 1) { %>
                                        <span class="variant-count">(<%= product.variants.length %> variants)</span>
                                    <% } %>
                                </td>
                                <td><%= product.category || "—" %></td>
                                <td>
                                    <% if (product.variants && product.variants.length > 0) { %>
                                        <%= product.variants.map(v => v.color || "—").join(" / ") %>
                                    <% } else { %>
                                        —
                                    <% } %>
                                </td>
                                <td class="price"><%= priceDisplay %></td>
                                <td class="<%= stockTotal === 0 ? 'out-of-stock' : '' %>">
                                    <%= stockTotal > 0 ? stockTotal + " Units" : "Out of Stock" %>
                                </td>
                                <td>
                                    <label class="toggle-switch">
                                        <input type="checkbox" 
                                               class="toggle-active" 
                                               data-id="<%= product._id %>"
                                               <%= product.isActive ? "checked" : "" %>>
                                        <span class="slider"></span>
                                    </label>
                                </td>
                              <td class="actions">
    <a href="/admin/edit-product/<%= product._id %>" title="Edit" class="edit-link">
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="edit-icon">
            <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path>
            <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path>
        </svg>
    </a>
</td>                   </tr>
                        <% }) %>
                    <% } else { %>
                        <tr>
                            <td colspan="8" style="text-align:center; padding: 2rem;">
                                No products found
                            </td>
                        </tr>
                    <% } %>
                </tbody>
            </table>
        </section>
        <div class="pagination">
  <% if (currentPage > 1) { %>
    <a href="?page=<%= currentPage - 1 %>" class="page-btn">« Prev</a>
  <% } %>

  <% for(let i = 1; i <= totalPages; i++) { %>
    <a href="?page=<%= i %>" 
       class="page-btn <%= i === currentPage ? 'active' : '' %>">
       <%= i %>
    </a>
  <% } %>

  <% if (currentPage < totalPages) { %>
    <a href="?page=<%= currentPage + 1 %>" class="page-btn">Next »</a>
  <% } %>
</div>
    </main>

    <!-- Optional: basic client-side toggle handler (you can move to separate JS file) -->
    <script>
        document.querySelectorAll('.toggle-active').forEach(toggle => {
            toggle.addEventListener('change', async function() {
                const productId = this.dataset.id;
                const isActive = this.checked;

                try {
                    const res = await fetch(`/admin/toggle-product-status/${productId}`, {
                        method: 'PATCH',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ isActive })
                    });

                    if (!res.ok) {
                        alert('Failed to update status');
                        this.checked = !isActive; // revert
                    }
                } catch (err) {
                    console.error(err);
                    alert('Error updating status');
                    this.checked = !isActive;
                }
            });
        });
    </script>

</body>
</html>