<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ELARA Admin | Products</title>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600&display=swap" rel="stylesheet">
    <style>
        :root {
            --sidebar-tan: #B18E7B;
            --main-bronze: #5D4037; /* Consistent Roasted Brown */
            --main-bronze-hover: #795548;
            --bg-light: #F4F4F4;
            --white: #ffffff;
            --danger: #dc3545;
        }

        body {
            margin: 0;
            font-family: 'Poppins', sans-serif;
            background-color: var(--bg-light);
            color: #333;
        }

        .main-content {
            flex: 1;
            margin-left: 260px; /* Adjust based on sidebar */
            padding: 40px;
        }

        .content-header {
            margin-bottom: 30px;
        }

        .header-top {
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .header-top h2 {
            font-size: 26px;
            color: var(--main-bronze);
            font-weight: 600;
            margin: 0;
        }

        .header-actions {
            display: flex;
            gap: 15px;
            align-items: center;
        }

        /* Search Box */
        .search-wrapper {
            position: relative;
            background: var(--white);
            border: 1px solid #ddd;
            border-radius: 8px;
            padding: 8px 15px;
            display: flex;
            align-items: center;
            width: 280px;
        }

        .search-icon { font-size: 14px; margin-right: 10px; color: #888; }
        
        #productSearch {
            border: none;
            outline: none;
            font-size: 13px;
            width: 100%;
        }

        .btn-add {
            background-color: var(--main-bronze);
            color: white;
            padding: 10px 20px;
            border-radius: 8px;
            text-decoration: none;
            font-size: 13px;
            font-weight: 500;
            transition: 0.3s;
        }

        .btn-add:hover { background-color: var(--main-bronze-hover); }

        /* Table Card */
        .table-card {
            background: var(--white);
            border-radius: 12px;
            overflow: hidden;
            box-shadow: 0 4px 20px rgba(0,0,0,0.05);
        }

        .product-table {
            width: 100%;
            border-collapse: collapse;
            text-align: left;
        }

        .product-table th {
            background-color: #fcfcfc;
            padding: 18px 20px;
            font-weight: 600;
            font-size: 12px;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            color: #888;
            border-bottom: 1px solid #eee;
        }

        .product-table td {
            padding: 15px 20px;
            border-bottom: 1px solid #eee;
            font-size: 14px;
            vertical-align: middle;
        }

        .product-table tr:hover { background-color: #fafafa; }

        /* Product Image Placeholder */
        .prod-img-placeholder {
            width: 50px;
            height: 50px;
            border-radius: 6px;
            background-size: cover;
            background-position: center;
            border: 1px solid #eee;
        }

        .prod-name { font-weight: 600; color: #222; }
        .variant-count { font-size: 11px; color: var(--sidebar-tan); display: block; }
        .price { font-weight: 500; color: var(--main-bronze); }
        .out-of-stock { color: var(--danger); font-weight: 600; }

        /* Toggle Switch Styling */
        .toggle-switch {
        position: relative;
        display: inline-block;
        width: 40px;
        height: 20px;
    }

    .toggle-switch input { opacity: 0; width: 0; height: 0; }

    .slider {
        position: absolute;
        cursor: pointer;
        top: 0; left: 0; right: 0; bottom: 0;
        background-color: #dc3545; /* Red for Unlisted/Inactive */
        transition: .4s;
        border-radius: 34px;
    }

    .slider:before {
        position: absolute;
        content: "";
        height: 14px; width: 14px;
        left: 3px; bottom: 3px;
        background-color: white;
        transition: .4s;
        border-radius: 50%;
    }

    /* Changed from var(--main-bronze) to Green */
    input:checked + .slider { 
        background-color: #28a745; /* Green for Listed/Active */
    } 
    
    input:checked + .slider:before { transform: translateX(20px); }

        /* Action Icon */
        .edit-link {
            color: #666;
            transition: 0.3s;
        }

        .edit-link:hover { color: var(--main-bronze); }

        /* Pagination */
        .pagination {
            margin-top: 30px;
            display: flex;
            justify-content: center;
            gap: 8px;
        }

        .page-btn {
            min-width: 38px;
            height: 38px;
            border: 1px solid #ddd;
            background: var(--white);
            text-decoration: none;
            color: #333;
            border-radius: 8px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 14px;
            transition: 0.3s;
        }

        .page-btn.active {
            background: var(--main-bronze);
            color: white;
            border-color: var(--main-bronze);
        }

        .page-btn:hover:not(.active) { border-color: var(--main-bronze); color: var(--main-bronze); }
    </style>
</head>
<body>

    <%- include('../partials/adminSidebar') %>

    <main class="main-content">
        <header class="content-header">
            <div class="header-top">
                <h2>Product Management</h2>
                <div class="header-actions">
                    <div class="search-wrapper">
                        <span class="search-icon">🔍</span>
                        <input type="text" placeholder="Search products..." id="productSearch">
                    </div>
                    <a href="/admin/add-product" class="btn-add">+ Add New Product</a>
                </div>
            </div>
        </header>

        <section class="table-card">
            <table class="product-table">
                <thead>
                    <tr>
                        <th>Image</th>
                        <th>Product Details</th>
                        <th>Category</th>
                        <th>Variants (Colors)</th>
                        <th>Price Range</th>
                        <th>Total Stock</th>
                        <th>Listing</th>
                        <th style="text-align: right;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    <% if (products && products.length > 0) { %>
                        <% products.forEach(product => { %>
                            <% 
                                const firstVariant = product.variants && product.variants[0] ? product.variants[0] : null;
                                const imageUrl = firstVariant && firstVariant.images && firstVariant.images[0] 
                                    ? firstVariant.images[0] 
                                    : "/images/default-product.png";
                                
                                let priceDisplay = "—";
                                let stockTotal = 0;
                                
                                if (product.variants && product.variants.length > 0) {
                                    const prices = product.variants.map(v => v.price).filter(p => p != null);
                                    if (prices.length > 0) {
                                        const min = Math.min(...prices);
                                        const max = Math.max(...prices);
                                        priceDisplay = min === max ? `₹${min.toLocaleString()}` : `₹${min.toLocaleString()} – ₹${max.toLocaleString()}`;
                                    }
                                    stockTotal = product.variants.reduce((sum, v) => sum + (v.stock || 0), 0);
                                }
                            %>
                            <tr>
                                <td>
                                    <div class="prod-img-placeholder" style="background-image: url('<%= imageUrl && imageUrl.startsWith('/') ? imageUrl : '/' + imageUrl %>')"></div>
                                </td>
                                <td class="prod-name">
                                    <%= product.name %>
                                    <% if (product.variants && product.variants.length > 1) { %>
                                        <span class="variant-count"><%= product.variants.length %> variants available</span>
                                    <% } %>
                                </td>
                                <td><span style="color: #666;"><%= product.category ? product.category.name : "—" %></span></td>
                                <td style="font-size: 12px; color: #777;">
                                    <% if (product.variants && product.variants.length > 0) { %>
                                        <%= product.variants.map(v => v.color || "—").join(", ") %>
                                    <% } else { %> — <% } %>
                                </td>
                                <td class="price"><%= priceDisplay %></td>
                                <td class="<%= stockTotal === 0 ? 'out-of-stock' : '' %>">
                                    <%= stockTotal > 0 ? stockTotal + " Units" : "Out of Stock" %>
                                </td>
                                <td>
                                    <label class="toggle-switch">
                                        <input type="checkbox" class="toggle-active" data-id="<%= product._id %>" <%= product.isActive ? "checked" : "" %>>
                                        <span class="slider"></span>
                                    </label>
                                </td>
                                <td style="text-align: right;">
                                    <a href="/admin/edit-product/<%= product._id %>" title="Edit Product" class="edit-link">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path></svg>
                                    </a>
                                </td>
                            </tr>
                        <% }) %>
                    <% } else { %>
                        <tr>
                            <td colspan="8" style="text-align:center; padding: 40px; color: #999;">No products found in the catalog.</td>
                        </tr>
                    <% } %>
                </tbody>
            </table>
        </section>

        <div class="pagination">
            <% if (currentPage > 1) { %>
                <a href="?page=<%= currentPage - 1 %>" class="page-btn">‹ Prev</a>
            <% } %>

            <% for(let i = 1; i <= totalPages; i++) { %>
                <a href="?page=<%= i %>" class="page-btn <%= i === currentPage ? 'active' : '' %>"><%= i %></a>
            <% } %>

            <% if (currentPage < totalPages) { %>
                <a href="?page=<%= currentPage + 1 %>" class="page-btn">Next ›</a>
            <% } %>
        </div>
    </main>

    <script>
        document.querySelectorAll('.toggle-active').forEach(toggle => {
            toggle.addEventListener('change', async function() {
                const productId = this.dataset.id;
                const isActive = this.checked;

                try {
                    const res = await fetch(`/admin/toggle-product-status/${productId}`, {
                        method: 'PATCH',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ isActive })
                    });

                    if (!res.ok) {
                        alert('Failed to update status');
                        this.checked = !isActive; 
                    }
                } catch (err) {
                    console.error(err);
                    alert('Error updating status');
                    this.checked = !isActive;
                }
            });
        });

        // Simple Search Filtering for UI
        document.getElementById('productSearch').addEventListener('keyup', function() {
            let filter = this.value.toUpperCase();
            let rows = document.querySelector(".product-table tbody").rows;
            for (let i = 0; i < rows.length; i++) {
                let nameCol = rows[i].cells[1].textContent.toUpperCase();
                rows[i].style.display = nameCol.indexOf(filter) > -1 ? "" : "none";
            }
        });
    </script>
</body>
</html>