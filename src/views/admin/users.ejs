<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ELARA - Admin User Management</title>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600&display=swap" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

   <style>
    :root {
        --sidebar-tan: #B18E7B;
        --main-bronze: #5D4037; /* Consistent Roasted Brown */
        --main-bronze-hover: #795548;
        --bg-light: #F4F4F4;
        --white: #ffffff;
    }

    body { 
        font-family: 'Poppins', sans-serif; 
        background: var(--bg-light); 
        margin: 0; 
        display: flex; 
        color: #333;
    }
    
    .admin-layout {
        display: flex;
        min-height: 100vh;
        width: 100%;
    }

    .main-content { 
        flex: 1; 
        margin-left: 260px; 
        padding: 40px;
    }

    .content-header h1 {
        font-size: 26px;
        color: var(--main-bronze);
        font-weight: 600;
        margin-bottom: 30px;
    }

    /* Search Bar Styling */
    .filter-bar { 
        display: flex; 
        gap: 12px; 
        margin-bottom: 30px; 
        align-items: center;
    }

    input[type="text"] { 
        padding: 10px 15px; 
        border: 1px solid #ddd; 
        border-radius: 8px; 
        width: 300px; 
        background: var(--white);
        font-size: 13px;
        outline: none;
        transition: border-color 0.3s;
    }

    input[type="text"]:focus { border-color: var(--main-bronze); }

    .btn { 
        padding: 10px 22px; 
        border: none; 
        border-radius: 8px; 
        cursor: pointer; 
        font-size: 13px; 
        font-weight: 500;
        transition: all 0.3s;
    }

    .btn-primary { background: var(--main-bronze); color: var(--white); }
    .btn-primary:hover { background: var(--main-bronze-hover); }

    .btn-secondary { 
        background-color: transparent; 
        color: #666; 
        border: 1px solid #ccc;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
    }

    /* Table Styling */
    .table-container { 
        background: var(--white); 
        border-radius: 12px;
        overflow: hidden;
        box-shadow: 0 4px 20px rgba(0,0,0,0.05); 
    }

    table { 
        width: 100%; 
        border-collapse: collapse; 
        text-align: left;
    }

    th, td { padding: 18px 20px; border-bottom: 1px solid #eee; }

    th { 
        background: #fcfcfc; 
        font-weight: 600; 
        text-transform: uppercase; 
        font-size: 13px; 
        letter-spacing: 0.5px;
        color: #888;
    }

    td { font-size: 14px; }
    tr:hover { background-color: #fafafa; }

    /* Status Pills */
    .status-badge { 
        padding: 5px 12px; 
        border-radius: 20px; 
        font-size: 11px; 
        font-weight: 600; 
        text-transform: uppercase;
    }

    .status-active { background: #E8F5E9; color: #2E7D32; }
    .status-blocked { background: #FFEBEE; color: #C62828; }

    /* Action Buttons */
    .btn-table-action {
        padding: 7px 16px;
        border-radius: 20px;
        font-size: 12px;
        font-weight: 500;
        cursor: pointer;
        transition: 0.3s;
        border: 1px solid;
        background: transparent;
    }

    .btn-danger-outline { border-color: #dc3545; color: #dc3545; }
    .btn-danger-outline:hover { background: #dc3545; color: white; }

    .btn-success-outline { border-color: #28a745; color: #28a745; }
    .btn-success-outline:hover { background: #28a745; color: white; }

    /* Pagination */
    .admin-pagination { 
        margin-top: 30px; 
        display: flex; 
        justify-content: center; 
        gap: 8px; 
    }

    .page-link { 
        min-width: 38px;
        height: 38px;
        border: 1px solid #ddd; 
        background: var(--white); 
        text-decoration: none; 
        color: #333; 
        border-radius: 8px; 
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 14px;
        transition: 0.3s;
    }

    .page-link.active { 
        background: var(--main-bronze); 
        color: var(--white); 
        border-color: var(--main-bronze); 
    }
</style>
</head>
<body>

    <div class="admin-layout">
        <%- include('../partials/adminSidebar') %>

        <div class="main-content">
            <header class="content-header">
                <h1>User Management</h1>
            </header>

            <div class="filter-bar">
                <form action="/admin/users" method="GET" style="display: flex; gap: 10px;">
                    <input type="text" name="search" placeholder="Search by name or email" value="<%= search || '' %>">
                    <button type="submit" class="btn btn-primary">Search</button>
                    <% if (search) { %>
                        <a href="/admin/users" class="btn btn-secondary">Clear</a>
                    <% } %>
                </form>
            </div>

            <div class="table-container">
                <table>
                    <thead>
                        <tr>
                            <th>Name</th>
                            <th>Email</th>
                            <th>Created Date</th>
                            <th>Status</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if (users.length > 0) { %>
                            <% users.forEach(user => { %>
                                <tr>
                                    <td style="font-weight: 500;"><%= user.fullName %></td>
                                    <td style="color: #666;"><%= user.email %></td>
                                    <td><%= new Date(user.createdAt).toLocaleDateString() %></td>
                                    <td>
                                        <% if (user.isBlocked) { %>
                                            <span class="status-badge status-blocked">Blocked</span>
                                        <% } else { %>
                                            <span class="status-badge status-active">Active</span>
                                        <% } %>
                                    </td>
                                    <td>
                                        <form action="/admin/users/block/<%= user._id %>?page=<%= currentPage %>&search=<%= search || '' %>" method="POST">
                                            <% if (user.isBlocked) { %>
                                                <button type="button" class="btn-table-action btn-success-outline unblock-btn">Unblock</button>
                                            <% } else { %>
                                                <button type="button" class="btn-table-action btn-danger-outline block-btn">Block</button>
                                            <% } %>
                                        </form>
                                    </td>
                                </tr>
                            <% }) %>
                        <% } else { %>
                            <tr>
                                <td colspan="5" style="text-align: center; padding: 40px; color: #999;">No users found.</td>
                            </tr>
                        <% } %>
                    </tbody>
                </table>
            </div>

            <% if (totalPages > 1) { %>
                <div class="admin-pagination">
                    <% if (currentPage > 1) { %>
                        <a href="/admin/users?page=<%= currentPage - 1 %>&search=<%= search || '' %>" class="page-link">‹</a>
                    <% } %>
                    <% for(let i = 1; i <= totalPages; i++) { %>
                        <a href="/admin/users?page=<%= i %>&search=<%= search || '' %>" class="page-link <%= currentPage === i ? 'active' : '' %>"><%= i %></a>
                    <% } %>
                    <% if (currentPage < totalPages) { %>
                        <a href="/admin/users?page=<%= currentPage + 1 %>&search=<%= search || '' %>" class="page-link">›</a>
                    <% } %>
                </div>
            <% } %>
        </div>
    </div>

<script>
document.querySelectorAll('.block-btn').forEach(btn => {
  btn.addEventListener('click', function (e) {
    e.preventDefault();
    const form = this.closest("form");
    Swal.fire({
      title: 'Block User?',
      text: "Are you sure you want to block this user?",
      icon: 'warning',
      showCancelButton: true,
      confirmButtonColor: '#dc3545',
      cancelButtonColor: '#6c757d',
      confirmButtonText: 'Yes, Block'
    }).then((result) => {
      if (result.isConfirmed) form.submit();
    });
  });
});

document.querySelectorAll('.unblock-btn').forEach(btn => {
  btn.addEventListener('click', function (e) {
    e.preventDefault();
    const form = this.closest("form");
    Swal.fire({
      title: 'Unblock User?',
      text: "Restore access for this user?",
      icon: 'question',
      showCancelButton: true,
      confirmButtonColor: '#28a745',
      cancelButtonColor: '#6c757d',
      confirmButtonText: 'Yes, Unblock'
    }).then((result) => {
      if (result.isConfirmed) form.submit();
    });
  });
});
</script>
</body>
</html>