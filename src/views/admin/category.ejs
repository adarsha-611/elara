<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ELARA Admin | Category Management</title>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600&display=swap" rel="stylesheet">
    <style>
        :root {
            --main-bronze: #5D4037;
            --main-bronze-hover: #795548;
            --bg-light: #F9F8F3; /* Luxury Ivory Background */
            --white: #ffffff;
            --success-green: #28a745;
            --danger-red: #dc3545;
            --border-color: #EAE7E1;
            --text-main: #333;
            --text-muted: #888;
        }

        body {
            margin: 0;
            font-family: 'Poppins', sans-serif;
            background-color: var(--bg-light);
            color: var(--text-main);
        }

        .main-content {
            margin-left: 260px;
            padding: 40px;
        }

        /* Header Styling */
        .header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 30px;
        }

        .header h1 {
            font-size: 24px;
            color: var(--main-bronze);
            font-weight: 600;
            margin: 0;
        }

        .header-right {
            display: flex;
            gap: 15px;
            align-items: center;
        }

        /* REFINED SEARCH BOX UI */
        .search-container {
            display: flex;
            align-items: center;
            background: var(--white);
            border: 1px solid var(--border-color);
            border-radius: 8px;
            padding: 4px;
            width: 350px;
            transition: 0.3s;
        }

        .search-container:focus-within {
            border-color: var(--main-bronze);
            box-shadow: 0 0 0 3px rgba(93, 64, 55, 0.05);
        }

        .search-bar {
            flex: 1;
            border: none;
            padding: 8px 12px;
            outline: none;
            font-size: 13px;
            background: transparent;
        }

        /* The Clear Button - Subtle & Integrated */
        .btn-clear {
            text-decoration: none;
            color: #ccc;
            font-size: 18px;
            padding: 0 10px;
            line-height: 1;
            transition: 0.2s;
            display: flex;
            align-items: center;
        }

        .btn-clear:hover {
            color: var(--danger-red);
        }

        .btn-search {
            background-color: var(--main-bronze);
            color: white;
            border: none;
            padding: 8px 20px;
            border-radius: 6px;
            font-size: 13px;
            font-weight: 500;
            cursor: pointer;
            transition: 0.3s;
        }

        .btn-search:hover {
            background-color: var(--main-bronze-hover);
        }

        .btn-add-category {
            background-color: var(--main-bronze);
            color: white;
            padding: 10px 20px;
            border-radius: 6px;
            font-size: 13px;
            text-decoration: none;
            transition: 0.3s;
        }

        
        .table-container {
            background: var(--white);
            border-radius: 12px;
            overflow: hidden;
            box-shadow: 0 4px 20px rgba(0,0,0,0.03);
            border: 1px solid var(--border-color);
        }

        .category-table {
            width: 100%;
            border-collapse: collapse;
            text-align: left;
        }

        .category-table th {
            background: #fafafa;
            padding: 18px 20px;
            font-size: 12px;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            color: var(--text-muted);
            border-bottom: 1px solid var(--border-color);
        }

        .category-table td {
            padding: 15px 20px;
            border-bottom: 1px solid var(--border-color);
            font-size: 14px;
        }

        .category-table tr:hover { background-color: #fdfdfd; }

        .bold { font-weight: 600; }
        .text-muted { color: var(--text-muted); font-size: 13px; }

        /* TOGGLE SWITCH */
        .toggle-switch {
            position: relative;
            display: inline-block;
            width: 40px;
            height: 20px;
        }
        .toggle-switch input { opacity: 0; width: 0; height: 0; }
        .slider {
            position: absolute;
            cursor: pointer;
            top: 0; left: 0; right: 0; bottom: 0;
            background-color: #ddd;
            transition: .4s;
            border-radius: 34px;
        }
        .slider:before {
            position: absolute; content: "";
            height: 14px; width: 14px;
            left: 3px; bottom: 3px;
            background-color: white;
            transition: .4s;
            border-radius: 50%;
        }
        input:checked + .slider { background-color: var(--success-green); }
        input:checked + .slider:before { transform: translateX(20px); }

        /* Pagination & Modals (Standard) */
        .pagination { margin-top: 30px; display: flex; justify-content: center; gap: 8px; }
        .page-btn { min-width: 38px; height: 38px; border: 1px solid var(--border-color); background: var(--white); text-decoration: none; color: #333; border-radius: 8px; display: flex; align-items: center; justify-content: center; font-size: 14px; }
        .page-btn.active { background: var(--main-bronze); color: white; }

        .modal-overlay { position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.4); display: none; justify-content: center; align-items: center; z-index: 1000; }
        .modal-card { background: white; padding: 30px; border-radius: 12px; width: 400px; }
        .modal-title { margin-top: 0; color: var(--main-bronze); }
        .modal-input, .modal-textarea { width: 100%; padding: 10px; margin-bottom: 15px; border: 1px solid #ddd; border-radius: 6px; box-sizing: border-box; font-family: inherit; }
        .modal-actions { display: flex; justify-content: flex-end; gap: 10px; }
        .btn-submit { background: var(--main-bronze); color: white; border: none; padding: 10px 20px; border-radius: 6px; cursor: pointer; }
        .btn-cancel { text-decoration: none; color: #666; padding: 10px; font-size: 13px; }
    </style>
</head>
<body>

    <%- include('../partials/adminSidebar') %>

    <main class="main-content">
        <header class="header">
            <h1>Manage Category</h1>
            <div class="header-right">
                <form action="/admin/category" method="GET" class="search-container">
                    <input type="text" name="search" placeholder="Search categories..." class="search-bar" value="<%= typeof search !== 'undefined' ? search : '' %>">
                    
                    <% if (typeof search !== 'undefined' && search) { %>
                        <a href="/admin/category" class="btn-clear" title="Clear search">&times;</a>
                    <% } %>
                    
                    <button type="submit" class="btn-search">Search</button>
                </form>
                <a href="#add-category-modal" class="btn-add-category">+ Add Category</a>
            </div>
        </header>

        <section class="table-container">
            <table class="category-table">
                <thead>
                    <tr>
                        <th>Category Name</th>
                        <th>Description</th>
                        <th>Status</th>
                        <th style="text-align: right;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    <% if (categories && categories.length > 0) { %>
                        <% categories.forEach(cat => { %>
                            <tr>
                                <td class="bold"><%= cat.name %></td>
                                <td class="text-muted"><%= cat.description || "No description" %></td>
                                <td>
                                    <form action="/admin/delete-category/<%= cat._id %>" method="POST" style="margin:0;">
                                        <label class="toggle-switch">
                                            <input type="checkbox" onchange="this.form.submit()" <%= cat.isActive ? "checked" : "" %>>
                                            <span class="slider"></span>
                                        </label>
                                    </form>
                                </td>
                                <td style="text-align: right;">
<a href="javascript:void(0)" onclick="openEditModal('<%= cat._id %>', '<%= cat.name %>', `<%= cat.description %>`)">                                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
                                    </a>
                                </td>
                            </tr>
                        <% }) %>
                    <% } else { %>
                        <tr><td colspan="4" style="text-align:center; padding: 40px; color: #999;">No Categories Found</td></tr>
                    <% } %>
                </tbody>
            </table>
        </section>

        <div class="pagination">
            <% if(currentPage > 1){ %> <a href="?page=<%= currentPage-1 %>" class="page-btn">‹</a> <% } %>
            <% for(let i=1; i <= totalPages; i++){ %>
                <a href="?page=<%= i %>" class="page-btn <%= i === currentPage ? 'active' : '' %>"><%= i %></a>
            <% } %>
            <% if(currentPage < totalPages){ %> <a href="?page=<%= currentPage+1 %>" class="page-btn">›</a> <% } %>
        </div>
    </main>

   <div id="add-category-modal" class="modal-overlay">
    <div class="modal-card">
        <h2 class="modal-title">Add Category</h2>

        <% if (modal === 'add' && error && error.length > 0) { %>
            <div style="background:#fff0f0; border:1px solid #dc3545; color:#dc3545; padding:10px 14px; border-radius:6px; font-size:12px; margin-bottom:15px;">
                <%= error[0] %>
            </div>
        <% } %>

        <form action="/admin/add-category" method="POST">
            <input type="text" name="name" placeholder="Category Name" 
                class="modal-input" maxlength="50"
                oninput="this.value = this.value.replace(/[^a-zA-Z\s]/g, '')">
            <textarea name="description" placeholder="Description (optional)" 
                class="modal-textarea" rows="4" maxlength="200"></textarea>
            <div class="modal-actions">
                <a href="#" class="btn-cancel">Cancel</a>
                <button type="submit" class="btn-submit">Add</button>
            </div>
        </form>
    </div>
</div>

  <div id="edit-category-modal" class="modal-overlay">
    <div class="modal-card">
        <h2 class="modal-title">Edit Category</h2>

        <!-- Error Box - Made more visible for debugging -->
        <% if (modal === 'edit' && error && error.length > 0) { %>
            <div id="edit-error-box" style="background:#fff0f0; border:2px solid #dc3545; color:#dc3545; padding:12px 14px; border-radius:6px; font-size:13px; margin-bottom:15px; font-weight:500;">
                <%= error[0] %>
            </div>
        <% } %>

        <form action="/admin/edit-category" method="POST">
            <input type="hidden" name="id" id="edit-id" value="<%= editData?.id || '' %>">
            
            <input type="text" name="name" id="edit-name" class="modal-input" 
                maxlength="50" 
                value="<%= editData?.name || '' %>"
                oninput="this.value = this.value.replace(/[^a-zA-Z\s]/g, '')">

            <textarea name="description" id="edit-description" 
                class="modal-textarea" rows="4" maxlength="200"><%= editData?.description || '' %></textarea>

            <div class="modal-actions">
                <a href="#" class="btn-cancel">Cancel</a>
                <button type="submit" class="btn-submit">Save</button>
            </div>
        </form>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script>
    function openEditModal(id, name, description) {
        // Clear error only when opening from table (not from validation error)
        const errorBox = document.getElementById('edit-error-box');
        if (errorBox) errorBox.style.display = 'none';

        document.getElementById("edit-id").value = id;
        document.getElementById("edit-name").value = name;
        document.getElementById("edit-description").value = description || "";

        document.getElementById('edit-category-modal').style.display = 'flex';
    }

    function openModal(id) {
        document.getElementById(id).style.display = 'flex';
    }

    function closeAllModals() {
        document.querySelectorAll('.modal-overlay').forEach(m => m.style.display = 'none');
    }

    window.addEventListener('DOMContentLoaded', () => {

        // Open modal if coming from server validation error
        <% if (modal === 'add') { %>
            openModal('add-category-modal');
        <% } else if (modal === 'edit') { %>
            openModal('edit-category-modal');
            // Do NOT hide error box when opening from validation
        <% } %>

        // Add Category Button
        document.querySelector('a[href="#add-category-modal"]').addEventListener('click', (e) => {
            e.preventDefault();
            closeAllModals();
            openModal('add-category-modal');
        });

        // Cancel buttons
        document.querySelectorAll('.btn-cancel').forEach(btn => {
            btn.addEventListener('click', (e) => {
                e.preventDefault();
                closeAllModals();
                history.replaceState({}, document.title, "/admin/category");
            });
        });

        // Click outside
        document.querySelectorAll('.modal-overlay').forEach(overlay => {
            overlay.addEventListener('click', function(e) {
                if (e.target === this) {
                    closeAllModals();
                    history.replaceState({}, document.title, "/admin/category");
                }
            });
        });

        // Success Toast
        <% if (success && success.length > 0) { %>
            Swal.fire({
                icon: 'success',
                text: '<%= success[0] %>',
                timer: 2000,
                showConfirmButton: false,
                toast: true,
                position: 'top-end'
            });
        <% } %>
    });
</script>
</body>
</html>