<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit Product - Elara Dashboard</title>

    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;600&family=Poppins:wght@300;400;500&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.5.13/cropper.min.css">

    <style>
        :root {
            --bg-main: #FAF7F5;
            --bg-panel: #FFFFFF;
            --text-dark: #4A302C;
            --text-body: #5D4037;
            --color-accent: #A17C6B;
            --color-accent-hover: #8D6E63;
            --border-color: #E0D6D0;
            --font-serif: 'Playfair Display', serif;
            --font-sans: 'Poppins', sans-serif;
        }
        body { margin: 0; padding: 40px 20px; background: var(--bg-main); font-family: var(--font-sans); color: var(--text-body); line-height: 1.6; }
        h1, h2, h3 { font-family: var(--font-serif); color: var(--text-dark); font-weight: 600; }
        h1 { text-align: center; font-size: 2.5rem; margin-bottom: 40px; }
        h2 { font-size: 1.8rem; border-bottom: 1px solid var(--border-color); padding-bottom: 10px; margin: 0 0 20px; }
        .container { max-width: 900px; margin: 0 auto; }
        .form-section { background: var(--bg-panel); padding: 35px; border-radius: 6px; box-shadow: 0 4px 20px rgba(93,64,55,0.06); margin-bottom: 30px; border: 1px solid var(--border-color); }
        .form-group { margin-bottom: 24px; }
        label { display: block; margin-bottom: 8px; font-weight: 500; color: var(--text-dark); font-size: 0.95rem; }
        input[type="text"], input[type="number"], textarea, select { width: 100%; padding: 12px 15px; border: 1px solid var(--border-color); background: #FCFCFB; border-radius: 4px; font-size: 1rem; color: var(--text-body); box-sizing: border-box; transition: border-color 0.3s; }
        input:focus, textarea:focus, select:focus { outline: none; border-color: var(--color-accent); background: white; }
        textarea { resize: vertical; min-height: 110px; }
        .variant-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 24px; border-bottom: 1px solid var(--border-color); padding-bottom: 12px; }
        .variant-block { background: #FAF9F8; border: 1px dashed var(--border-color); padding: 24px; border-radius: 6px; margin-bottom: 28px; position: relative; }
        .variant-remove-btn { position: absolute; top: 16px; right: 16px; background: none; border: none; color: #d32f2f; cursor: pointer; font-size: 0.9rem; text-decoration: underline; }
        .image-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(140px, 1fr)); gap: 12px; margin-top: 12px; }
        .image-upload-box { position: relative; padding-top: 100%; }
        .upload-label, .preview-container { position: absolute; inset: 0; display: flex; flex-direction: column; align-items: center; justify-content: center; background: white; border: 2px dashed var(--border-color); border-radius: 6px; cursor: pointer; color: #BCAAA4; transition: all 0.2s; overflow: hidden; }
        .upload-label:hover { border-color: var(--color-accent); color: var(--color-accent); background: #FEFCFB; }
        .preview-container { border-style: solid; display: none; }
        .preview-container img { width: 100%; height: 100%; object-fit: cover; }
        .remove-image-btn { position: absolute; top: 6px; right: 6px; background: rgba(255,255,255,0.92); border: none; color: #d32f2f; border-radius: 50%; width: 26px; height: 26px; font-size: 16px; line-height: 1; cursor: pointer; z-index: 2; }
        .main-image-tag { position: absolute; top: 0; left: 0; background: var(--color-accent); color: white; font-size: 0.7rem; padding: 3px 9px; font-weight: 500; border-bottom-right-radius: 6px; z-index: 2; }
        .variant-details-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 20px; margin-top: 24px; }
        .btn { padding: 11px 28px; font-weight: 500; text-transform: uppercase; letter-spacing: 0.8px; border: none; border-radius: 4px; cursor: pointer; transition: all 0.25s; font-size: 0.92rem; }
        .btn-primary { background: var(--color-accent); color: white; }
        .btn-primary:hover { background: var(--color-accent-hover); }
        .btn-secondary { background: transparent; border: 1px solid var(--color-accent); color: var(--color-accent); }
        .btn-secondary:hover { background: var(--color-accent); color: white; }
        .form-actions { text-align: right; margin-top: 36px; }
        .modal-overlay { display: none; position: fixed; inset: 0; background: rgba(0,0,0,0.65); z-index: 2000; justify-content: center; align-items: center; }
        .modal-content { background: white; padding: 24px; border-radius: 8px; width: 90%; max-width: 680px; max-height: 92vh; display: flex; flex-direction: column; }
        .crop-container { height: 420px; background: #f5f5f5; margin: 16px 0 24px; overflow: hidden; border-radius: 6px; }
        .modal-actions { display: flex; justify-content: flex-end; gap: 12px; }
        @media (max-width: 768px) {
            .variant-details-grid { grid-template-columns: 1fr; }
            .image-grid { grid-template-columns: repeat(2, 1fr); }
        }
    </style>
</head>
<body>

<div class="container">
    <h1>Edit Jewelry Product</h1>

    <form id="productForm" enctype="multipart/form-data">

        <section class="form-section">
            <h2>Basic Information</h2>
            <div class="form-group">
                <label>Product Name</label>
                <input type="text" name="name" value="<%= product.name %>" required>
            </div>
            <div class="form-group">
                <label>Description</label>
                <textarea name="description" required><%= product.description %></textarea>
            </div>
            <div class="form-group">
                <label>Category</label>
                <select name="category" id="categorySelect" required>
                    <option value="" disabled>Loading categories...</option>
                </select>
            </div>
        </section>

        <section class="form-section">
            <div class="variant-header">
                <h2>Product Variants</h2>
                <button type="button" id="addVariantBtn" class="btn btn-secondary">+ Add Variant</button>
            </div>

            <div id="variantsContainer">
                <% product.variants.forEach((variant, vIndex) => { %>
                    <div class="variant-block" data-variant-index="<%= vIndex %>">
                        <% if (vIndex > 0) { %>
                            <button type="button" class="variant-remove-btn" onclick="removeVariant(this)">Remove Variant</button>
                        <% } %>
                        <h3>Variant #<%= vIndex + 1 %></h3>

                        <div class="image-upload-container">
                            <label>Images (max 4 – first is main)</label>
                            <div class="image-grid">
                                <% for (let i = 0; i < 4; i++) { 
                                    const hasImage = variant.images?.[i];
                                    const src = hasImage || '';
                                %>
                                    <div class="image-upload-box" data-img-index="<%= i %>">
                                        <input type="file" class="file-input" accept="image/*" style="display:none">

                                        <% if (hasImage) { %>
                                            <input type="hidden" 
                                                   name="variants[<%= vIndex %>][images][<%= i %>]" 
                                                   value="<%= src %>">
                                        <% } %>

                                        <div class="upload-label" style="display: <%= hasImage ? 'none' : 'flex' %>;">
                                            <%= i === 0 ? '<span class="main-image-tag">MAIN</span>' : '' %>
                                            <span style="font-size:28px; margin-bottom:6px;">+</span>
                                            <span>Upload</span>
                                        </div>

                                        <div class="preview-container" style="display: <%= hasImage ? 'flex' : 'none' %>;">
                                            <%= i === 0 ? '<span class="main-image-tag">MAIN</span>' : '' %>
                                            <img src="<%= src %>" alt="Variant image" data-original="<%= src %>">
                                            <button type="button" class="remove-image-btn" title="Remove">×</button>
                                        </div>
                                    </div>
                                <% } %>
                            </div>
                            <small style="color:#BCAAA4; margin-top:8px; display:block;">Click image to replace • Crop enabled</small>
                        </div>

                        <div class="variant-details-grid">
                            <div class="form-group">
                                <label>Price (₹)</label>
                                <input type="number" name="variants[<%= vIndex %>][price]" value="<%= variant.price %>" step="0.01" min="0" required>
                            </div>
                            <div class="form-group">
                                <label>Color</label>
                                <input type="text" name="variants[<%= vIndex %>][color]" value="<%= variant.color %>" required>
                            </div>
                            <div class="form-group">
                                <label>Stock</label>
                                <input type="number" name="variants[<%= vIndex %>][stock]" value="<%= variant.stock %>" min="0" required>
                            </div>
                        </div>
                    </div>
                <% }); %>
            </div>
        </section>

        <div class="form-actions">
            <button type="submit" class="btn btn-primary" id="submitBtn">UPDATE PRODUCT</button>
        </div>
    </form>
</div>

<!-- Crop Modal -->
<div class="modal-overlay" id="cropModal">
    <div class="modal-content">
        <h3>Crop Image</h3>
        <div class="crop-container">
            <img id="imageToCrop" src="" alt="Crop preview">
        </div>
        <div class="modal-actions">
            <button type="button" class="btn btn-secondary" id="cancelCrop">Cancel</button>
            <button type="button" class="btn btn-primary" id="cropAndSave">Crop & Apply</button>
        </div>
    </div>
</div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.5.13/cropper.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<script>
let variantCounter = <%= product.variants.length %>;
let currentCropTarget = null;
let cropper = null;

const variantsContainer = document.getElementById('variantsContainer');
const cropModal        = document.getElementById('cropModal');
const imageToCrop      = document.getElementById('imageToCrop');
const cropAndSaveBtn   = document.getElementById('cropAndSave');
const cancelCropBtn    = document.getElementById('cancelCrop');

// ── Initialize existing upload boxes ────────────────────────────────────────
function attachImageListeners(container = document) {
    container.querySelectorAll('.image-upload-box').forEach(box => {
        const fileInput = box.querySelector('.file-input');
        const label = box.querySelector('.upload-label');
        const preview = box.querySelector('.preview-container');

        if (label) {
            label.addEventListener('click', () => fileInput.click());
        }

        fileInput.addEventListener('change', e => {
            const file = e.target.files?.[0];
            if (!file) return;

            currentCropTarget = box;
            const reader = new FileReader();
            reader.onload = ev => {
                imageToCrop.src = ev.target.result;
                cropModal.style.display = 'flex';
                if (cropper) cropper.destroy();
                cropper = new Cropper(imageToCrop, {
                    aspectRatio: 1,
                    viewMode: 1,
                    autoCropArea: 0.95,
                    responsive: true
                });
            };
            reader.readAsDataURL(file);
            fileInput.value = '';
        });

        box.addEventListener('click', e => {
            if (e.target.classList.contains('remove-image-btn')) {
                preview.style.display = 'none';
                if (label) label.style.display = 'flex';
                fileInput.value = '';
                // Remove hidden old-image input if exists
                const hidden = box.querySelector('input[type="hidden"]');
                if (hidden) hidden.remove();
            }
        });
    });
}

attachImageListeners();

// ── Crop handling ────────────────────────────────────────────────────────────
cropAndSaveBtn.addEventListener('click', () => {
    if (!cropper || !currentCropTarget) return;

    const canvas = cropper.getCroppedCanvas({ width: 800, height: 800 });
    const url = canvas.toDataURL('image/jpeg', 0.88);

    const preview = currentCropTarget.querySelector('.preview-container');
    const label   = currentCropTarget.querySelector('.upload-label');
    const img     = preview.querySelector('img');

    img.src = url;
    label.style.display = 'none';
    preview.style.display = 'flex';

    // Remove old hidden input when replacing
    const oldHidden = currentCropTarget.querySelector('input[type="hidden"]');
    if (oldHidden) oldHidden.remove();

    closeCropModal();
});

function closeCropModal() {
    cropModal.style.display = 'none';
    if (cropper) {
        cropper.destroy();
        cropper = null;
    }
    currentCropTarget = null;
}

cancelCropBtn.addEventListener('click', closeCropModal);

// ── Add new variant ──────────────────────────────────────────────────────────
document.getElementById('addVariantBtn').addEventListener('click', () => {
    const vIndex = variantCounter++;
    const block = document.createElement('div');
    block.className = 'variant-block';
    block.dataset.variantIndex = vIndex;

    block.innerHTML = `
        <button type="button" class="variant-remove-btn" onclick="removeVariant(this)">Remove Variant</button>
        <h3>Variant #${vIndex + 1}</h3>

        <div class="image-upload-container">
            <label>Images (max 4 – first is main)</label>
            <div class="image-grid">
                ${[0,1,2,3].map(i => `
                    <div class="image-upload-box" data-img-index="${i}">
                        <input type="file" class="file-input" accept="image/*" style="display:none">
                        <div class="upload-label">
                            ${i===0 ? '<span class="main-image-tag">MAIN</span>' : ''}
                            <span style="font-size:28px; margin-bottom:6px;">+</span>
                            <span>Upload</span>
                        </div>
                        <div class="preview-container" style="display:none;">
                            ${i===0 ? '<span class="main-image-tag">MAIN</span>' : ''}
                            <img src="" alt="Preview">
                            <button type="button" class="remove-image-btn" title="Remove">×</button>
                        </div>
                    </div>
                `).join('')}
            </div>
            <small style="color:#BCAAA4; margin-top:8px; display:block;">Click to upload • Crop enabled</small>
        </div>

        <div class="variant-details-grid">
            <div class="form-group"><label>Price (₹)</label><input type="number" name="variants[${vIndex}][price]" step="0.01" min="0" required></div>
            <div class="form-group"><label>Color</label><input type="text" name="variants[${vIndex}][color]" required></div>
            <div class="form-group"><label>Stock</label><input type="number" name="variants[${vIndex}][stock]" min="0" required></div>
        </div>
    `;

    variantsContainer.appendChild(block);
    attachImageListeners(block);
});

// ── Remove variant ───────────────────────────────────────────────────────────
window.removeVariant = function(btn) {
    btn.closest('.variant-block').remove();
};

// ── Form submit ──────────────────────────────────────────────────────────────
document.getElementById('productForm').addEventListener('submit', async e => {
    e.preventDefault();
    const btn = document.getElementById('submitBtn');
    btn.disabled = true;
    btn.textContent = 'UPDATING...';

    const formData = new FormData(e.target);

    // Only keep hidden inputs when NO new file was selected
    document.querySelectorAll('.image-upload-box').forEach(box => {
        const fileInput = box.querySelector('.file-input');
        const previewVisible = box.querySelector('.preview-container').style.display !== 'none';

        if (fileInput.files?.length > 0 && previewVisible) {
            // New file → remove old hidden (if any)
            box.querySelector('input[type="hidden"]')?.remove();

            const vIdx = box.closest('.variant-block').dataset.variantIndex;
            const iIdx = box.dataset.imgIndex;
            formData.append(`variants[${vIdx}][images][${iIdx}]`, fileInput.files[0]);
        }
        // If no file → hidden stays → old URL preserved
    });

    try {
        const res = await fetch(`/admin/edit-product/<%= product._id %>`, {
            method: 'POST',
            body: formData
        });

        const data = await res.json();

        if (!res.ok || !data.success) {
            throw new Error(data.message || 'Update failed');
        }

        await Swal.fire({
            title: 'Success',
            text: 'Product updated successfully',
            icon: 'success',
            confirmButtonColor: '#A17C6B'
        });

        window.location.href = '/admin/products';

    } catch (err) {
        Swal.fire({
            title: 'Error',
            text: err.message || 'Could not update product',
            icon: 'error'
        });
    } finally {
        btn.disabled = false;
        btn.textContent = 'UPDATE PRODUCT';
    }
});

// ── Load categories ──────────────────────────────────────────────────────────
document.addEventListener('DOMContentLoaded', async () => {
    const select = document.getElementById('categorySelect');
    try {
        const res = await fetch('/admin/categories/active');
        if (!res.ok) throw new Error('Categories endpoint failed');

        const { success, categories } = await res.json();
        if (!success || !Array.isArray(categories)) throw new Error('Invalid response');

        select.innerHTML = '<option value="" disabled>Select category...</option>';

        categories.forEach(cat => {
            const opt = new Option(cat.name, cat._id);
            if (cat._id === '<%= product.category %>') opt.selected = true;
            select.appendChild(opt);
        });

        if (select.options.length === 1) {
            select.innerHTML += '<option disabled>No active categories</option>';
        }
    } catch (err) {
        console.error(err);
        select.innerHTML = '<option disabled selected>Failed to load categories</option>';
    }
});
</script>
</body>
</html>