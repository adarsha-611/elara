<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <title>Offer Management — ELARA Admin</title>
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;500;600&family=Poppins:wght@300;400;500;600&display=swap" rel="stylesheet"/>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    
    <style>
        *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

        :root {
            --elara-gold: #A68B67;
            --elara-dark: #3D2B24; 
            --elara-beige: #F4F1EE;
            --elara-ivory: #FDFBF9;
            --bg: #FAF9F7;
            --surface: #FFFFFF;
            --text: #2E2E2E;
            --muted: #7A7A7A;
            --border: #EDE9E3;
            --shadow: 0 10px 40px rgba(61, 43, 36, 0.15);
        }

        body {
            font-family: 'Poppins', sans-serif;
            background: var(--bg);
            color: var(--text);
            font-size: 13px;
            min-height: 100vh;
        }
        .page {
            margin-left: 280px;
        }

        .serif { font-family: 'Playfair Display', serif; }

        .header {
            background: var(--surface);
            border-bottom: 1px solid var(--border);
            padding: 1.2rem 3rem;
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-left: 6px;
            position: sticky;
            top: 0;
            z-index: 100;
        }

        .header-left h1 { font-size: 26px; color: var(--elara-dark); letter-spacing: 1px; }

        .main { padding: 2.5rem 3rem; max-width: 1400px; margin: 0 auto; width: 100%; }

        .btn {
            display: inline-flex; align-items: center; gap: 8px;
            padding: 12px 24px; cursor: pointer; border: none; 
            transition: 0.3s; text-decoration: none;
            text-transform: uppercase; letter-spacing: 1.5px; font-size: 10px; font-weight: 700;
        }
        .btn-gold { background: var(--elara-dark); color: #fff; }
        .btn-gold:hover { background: var(--elara-gold); transform: translateY(-1px); }
        .btn-outline { background: transparent; color: var(--elara-dark); border: 1px solid var(--elara-dark); }

        .modal-overlay {
            position: fixed; inset: 0; background: rgba(61, 43, 36, 0.4);
            backdrop-filter: blur(4px); z-index: 1000; 
            display: none; align-items: center; justify-content: center;
            opacity: 0; transition: 0.3s;
        }

        body.modal-open .modal-overlay { display: flex; opacity: 1; }

        #form-section {
            background: var(--surface); 
            width: 500px; 
            max-width: 95%;
            padding: 40px;
            box-shadow: var(--shadow);
            transform: translateY(20px);
            transition: 0.4s cubic-bezier(0.16, 1, 0.3, 1);
        }
        body.modal-open #form-section { transform: translateY(0); }

        .form-group { margin-bottom: 20px; display: flex; flex-direction: column; gap: 8px; }
        .form-group label { font-size: 10px; color: var(--elara-gold); font-weight: 700; text-transform: uppercase; letter-spacing: 1px; }
        .form-group input, .form-group select {
            padding: 12px; border: 1px solid var(--elara-beige); background: var(--elara-ivory);
            outline: none; font-family: 'Poppins'; width: 100%;
        }
        .form-group input:focus { border-color: var(--elara-dark); }

        .tabs { display: flex; border-bottom: 1px solid var(--elara-beige); margin-bottom: 25px; gap: 20px; }
        .tab { 
            padding: 10px 0; background: none; border: none; cursor: pointer; 
            font-size: 11px; text-transform: uppercase; letter-spacing: 1px; color: var(--muted);
            border-bottom: 2px solid transparent; transition: 0.3s;
        }
        .tab.active { color: var(--elara-dark); border-color: var(--elara-dark); font-weight: 700; }

        .table-card { background: var(--surface); border: 1px solid var(--border); padding: 2rem; }
        table { width: 100%; border-collapse: separate; border-spacing: 0 10px; }
        thead th { padding: 10px 15px; text-align: left; font-size: 10px; text-transform: uppercase; color: var(--muted); letter-spacing: 1px; }
        tbody tr { background: var(--surface); transition: 0.3s; }
        tbody tr:hover { background: #FCFBFA; }
        tbody td { padding: 18px 15px; border-top: 1px solid var(--elara-beige); border-bottom: 1px solid var(--elara-beige); }

        .badge { padding: 4px 10px; font-size: 9px; font-weight: 700; text-transform: uppercase; }
        .discount-pill { color: rgb(48, 18, 18); padding: 4px 8px; font-weight: 600; border-radius: 4px; }

        .icon-btn { 
            width: 34px; height: 34px; display: inline-flex; align-items: center; justify-content: center; 
            border: 1px solid var(--elara-beige); cursor: pointer; background: none; transition: 0.2s; color: var(--muted);
        }
        .icon-btn:hover { border-color: var(--elara-dark); color: var(--elara-dark); background: var(--elara-ivory); }
        
        .hidden { display: none !important; }

        .status-badge {
            display: inline-block;
            padding: 4px 10px;
            border-radius: 4px;
            font-size: 10px;
            font-weight: 600;
            text-transform: uppercase;
        }
        .status-active {
            background: #e8f5e9;
            color: #2e7d32;
        }
        .status-inactive {
            background: #ffebee;
            color: #c62828;
        }
        .validity-cell {
            font-size: 11px;
            font-weight: 500;
            color: #5D4037;
        }
        .no-validity {
            color: #aaa;
            font-style: italic;
        }
        /* Switch toggle style */
        .switch {
            position: relative;
            display: inline-block;
            width: 50px;
            height: 24px;
        }
        .switch input {
            opacity: 0;
            width: 0;
            height: 0;
        }
        .slider {
            position: absolute;
            cursor: pointer;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background-color: #ccc;
            transition: 0.3s;
            border-radius: 34px;
        }
        .slider:before {
            position: absolute;
            content: "";
            height: 18px;
            width: 18px;
            left: 3px;
            bottom: 3px;
            background-color: white;
            transition: 0.3s;
            border-radius: 50%;
        }
        input:checked + .slider {
            background-color: var(--elara-dark);
        }
        input:checked + .slider:before {
            transform: translateX(26px);
        }
    </style>
</head>
<body>
    <!-- Sidebar partial placeholder - adjust path as needed -->
    <%- include('../partials/adminSidebar') %>

    <div class="modal-overlay" id="modalOverlay">
        <div id="form-section">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 30px;">
                <h2 class="serif" id="modal-title" style="font-size: 24px;">New Offer</h2>
                <button class="icon-btn" onclick="closeOfferModal()"><i class="fa-solid fa-xmark"></i></button>
            </div>

            <div class="tabs">
                <button class="tab active" id="tab-product" onclick="switchTab('product')">Product</button>
                <button class="tab" id="tab-category" onclick="switchTab('category')">Category</button>
            </div>

            <form id="offerForm" action="/admin/offers/create" method="POST">
                <input type="hidden" id="offerType" name="offerType" value="product">
                <input type="hidden" id="edit-id">
                <div class="form-group">
                    <label>Offer Name</label>
                    <input type="text" id="offer-name" name="name" placeholder="e.g. Elara Special" required>
                </div>

                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 15px;">
                    <div class="form-group">
                        <label>Discount Type</label>
                        <select id="discount-type" name="discountType">
                            <option value="percentage">Percentage (%)</option>
                            <option value="fixed">Fixed (₹)</option>
                        </select>
                    </div>
                    <div class="form-group">
                        <label>Amount</label>
                        <input type="number" id="discount-val" name="discountValue" placeholder="10">
                    </div>
                </div>

                <div class="form-group" id="product-fields">
                    <label>Target Product</label>
                    <select id="product-select" name="productId">
                        <option value="">Select product</option>
                        <% products.forEach(p => { %>
                            <option value="<%= p._id %>"><%= p.name %></option>
                        <% }) %>
                    </select>
                </div>

                <div class="form-group hidden" id="category-fields">
                    <label>Target Category</label>
                    <select id="category-select" name="categoryId">
                        <option value="">Select category</option>
                        <% categories.forEach(c => { %>
                            <option value="<%= c._id %>"><%= c.name %></option>
                        <% }) %>
                    </select>
                </div>

                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 15px;">
                    <div class="form-group">
                        <label>Start Date</label>
                        <input type="date" name="startDate" id="start-date">
                    </div>
                    <div class="form-group">
                        <label>End Date</label>
                        <input type="date" name="endDate" id="end-date">
                    </div>
                </div>

                <div class="form-group">
                    <label>Active Status</label>
                    <label class="switch">
                        <input type="checkbox" name="isActive" value="true" checked>
                        <span class="slider"></span>
                    </label>
                </div>

                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 15px; margin-top: 40px;">
                    <button type="button" class="btn btn-outline" onclick="closeOfferModal()">Cancel</button>
                    <button type="submit" class="btn btn-gold">Save Offer</button>
                </div>
            </form>
        </div>
    </div>

    <div class="page">
        <header class="header">
            <div class="header-left"><h1 class="serif">Offer Management</h1></div>
            <div class="header-right">
                <button class="btn btn-gold" onclick="openOfferModal()">
                    <i class="fa-solid fa-plus"></i> Create Offer
                </button>
            </div>
        </header>

        <main class="main">
            <!-- Flash messages handled via SweetAlert on page load (if any) -->
            <div class="table-card">
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 25px;">
                    <h2 class="serif" style="font-size: 18px;">OFFERS</h2>
                    <input type="text" placeholder="Search offers..." id="search-input" style="padding: 10px; border: 1px solid var(--elara-beige); width: 250px;">
                </div>
                 <table style="width:100%">
                    <thead>
                        <tr>
                            <th>Offer Details</th>
                            <th>Type</th>
                            <th>Value</th>
                            <th>Listing Status</th>
                            <th>Validity</th>
                            <th style="text-align: right;">Action</th>
                        </tr>
                    </thead>
                    <tbody id="offers-table-body">
                        <% if(offers && offers.length > 0) { 
                            offers.forEach(o => { 
                                // Format validity text
                                let validityText = '';
                                let validityClass = '';
                                if(o.startDate && o.endDate) {
                                    const start = new Date(o.startDate).toLocaleDateString('en-GB');
                                    const end = new Date(o.endDate).toLocaleDateString('en-GB');
                                    validityText = `${start} - ${end}`;
                                    validityClass = 'validity-cell';
                                } else if(o.startDate && !o.endDate) {
                                    validityText = `From ${new Date(o.startDate).toLocaleDateString('en-GB')} (No end)`;
                                    validityClass = 'validity-cell';
                                } else if(!o.startDate && o.endDate) {
                                    validityText = `Until ${new Date(o.endDate).toLocaleDateString('en-GB')}`;
                                    validityClass = 'validity-cell';
                                } else {
                                    validityText = 'No date range';
                                    validityClass = 'no-validity';
                                }
                        %>
                        <tr>
                            <td>
                                <div style="font-weight:600;"><%= o.name %></div>
                                <div style="font-size:10px; color: #6b4c3b;">
                                    <%= o.productId ? o.productId.name : (o.categoryId ? o.categoryId.name : 'N/A') %>
                                </div>
                            </td>
                            <td><span style="text-transform:capitalize"><%= o.offerType %></span></td>
                            <td>
    <span class="discount-pill">
        <%= o.discountValue != null 
            ? (o.discountType === "percentage" ? o.discountValue + "%" : "₹" + o.discountValue)
            : "N/A" %>
    </span>
</td>
                            <td>
                                <span class="status-badge <%= o.isActive ? 'status-active' : 'status-inactive' %>">
                                    <%= o.isActive ? "ACTIVE" : "INACTIVE" %>
                                </span>
                            </td>
                            <td class="<%= validityClass %>"><%= validityText %></td>
                            <td style="text-align:right;">
                                <button class="icon-btn" onclick='openOfferModalForEdit(
                                    "<%= o._id %>",
                                    "<%= o.name.replace(/"/g, '&quot;') %>",
                                    "<%= o.offerType %>",
                                    "<%= o.discountType %>",
                                    "<%= o.discountValue %>",
                                    "<%= o.productId ? o.productId._id : '' %>",
                                    "<%= o.categoryId ? o.categoryId._id : '' %>",
                                    "<%= o.startDate ? new Date(o.startDate).toISOString().split('T')[0] : '' %>",
                                    "<%= o.endDate ? new Date(o.endDate).toISOString().split('T')[0] : '' %>",
                                    <%= o.isActive %>
                                )'>
                                    <i class="fa-solid fa-pen-to-square"></i>
                                </button>
                             </td>
                        </tr>
                        <% }); } else { %>
                            <tr><td colspan="6" style="text-align:center; padding: 40px;">No offers found. Create your first offer!</td></tr>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </main>
    </div>

    <script>
     
    // Better flash message handling
    <% if (success_msg && success_msg.length > 0) { %>
        Swal.fire({
            icon: 'success',
            title: 'Success',
            text: '<%= success_msg %>',
            timer: 3000,
            showConfirmButton: false
        });
    <% } %>

    <% if (error_msg && error_msg.length > 0) { %>
        Swal.fire({
            icon: 'error',
            title: 'Error',
            text: '<%= error_msg %>',
            confirmButtonColor: '#3D2B24'
        });
    <% } %>


        function openOfferModal() {
            document.getElementById("modal-title").innerText = "New Offer";
            document.getElementById("offerForm").reset();
            document.getElementById("offerForm").action = "/admin/offers/create";
            document.getElementById("edit-id").value = "";
            document.getElementById("offerType").value = "product";
            // Reset checkbox to checked (default active)
            document.querySelector('input[name="isActive"]').checked = true;
            switchTab('product');
            document.body.classList.add("modal-open");
        }

        function openOfferModalForEdit(id, name, offerType, discountType, discountValue, productId, categoryId, startDate, endDate, isActive) {
            document.getElementById("modal-title").innerText = "Update Offer";
            document.getElementById("edit-id").value = id;
            document.getElementById("offer-name").value = name;
            document.getElementById("discount-type").value = discountType;
            document.getElementById("discount-val").value = discountValue;
            
            if(startDate) document.getElementById("start-date").value = startDate;
            else document.getElementById("start-date").value = '';
            if(endDate) document.getElementById("end-date").value = endDate;
            else document.getElementById("end-date").value = '';
            
            document.querySelector('input[name="isActive"]').checked = isActive === true || isActive === "true";
            
            switchTab(offerType);
            
            if(offerType === "product" && productId){
                document.getElementById("product-select").value = productId;
            } else if(offerType === "category" && categoryId){
                document.getElementById("category-select").value = categoryId;
            } else {
                if(offerType === "product") document.getElementById("product-select").value = "";
                if(offerType === "category") document.getElementById("category-select").value = "";
            }
            
            document.getElementById("offerForm").action = `/admin/offers/update/${id}`;
            document.body.classList.add("modal-open");
        }

        function closeOfferModal() { 
            document.body.classList.remove('modal-open'); 
        }

        document.getElementById('modalOverlay').addEventListener('click', function(e) {
            if(e.target === this) closeOfferModal();
        });

        function switchTab(t) {
            const tabProduct = document.getElementById('tab-product');
            const tabCategory = document.getElementById('tab-category');
            if(t === 'product') {
                tabProduct.classList.add('active');
                tabCategory.classList.remove('active');
                document.getElementById('product-fields').classList.remove('hidden');
                document.getElementById('category-fields').classList.add('hidden');
            } else {
                tabCategory.classList.add('active');
                tabProduct.classList.remove('active');
                document.getElementById('category-fields').classList.remove('hidden');
                document.getElementById('product-fields').classList.add('hidden');
            }
            document.getElementById('offerType').value = t;
        }

        // Search functionality
        document.getElementById('search-input').addEventListener('input', function() {
            const searchTerm = this.value.toLowerCase();
            const rows = document.querySelectorAll('#offers-table-body tr');
            rows.forEach(row => {
                if(row.cells && row.cells.length >= 1) {
                    const offerName = row.cells[0]?.innerText.toLowerCase() || '';
                    const targetDetail = row.cells[0]?.querySelector('div:last-child')?.innerText.toLowerCase() || '';
                    if(offerName.includes(searchTerm) || targetDetail.includes(searchTerm)) {
                        row.style.display = '';
                    } else {
                        row.style.display = 'none';
                    }
                }
            });
        });
    </script>
</body>
</html>