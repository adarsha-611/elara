<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Order Details - <%= order.orderId %> | Elara Admin</title>
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@600&family=Poppins:wght@300;400;500;600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/adminOrderdetail.css">
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <style>
      .product-cell{
display:flex;
align-items:center;
gap:10px;
}

.product-img{
width:45px;
height:45px;
object-fit:cover;
border-radius:6px;
}
.details-container {
  margin: 0 auto; 
}
    </style>
</head>
<body>

<div class="admin-wrapper">
    <main class="details-container">
        <h1 class="page-title">Order Details - <%= order.orderId %></h1>
        <button class="btn-back" onclick="window.history.back()">Back to orders</button>

        <div class="details-layout">
            <div class="main-info-column">
                <!-- Summary Card -->
                <div class="info-card summary-card">
                    <div class="grid-row">
                        <div class="info-item">
                            <label>Order id :</label>
                            <span><%= order.orderId %></span>
                        </div>
                        <div class="info-item">
                            <label>Order date:</label>
                            <span><%= new Date(order.createdAt).toLocaleDateString() %></span>
                        </div>
                    </div>
                    <div class="grid-row">
                        <div class="info-item">
                            <label>Status :</label>
                            <span class="status-badge <%= order.orderStatus %>"><%= order.orderStatus %></span>
                        </div>
                        <div class="info-item">
                            <label>Phone:</label>
                            <span><%= order.shippingAddress.phoneNumber %></span>
                        </div>
                    </div>
                    <div class="grid-row">
                        <div class="info-item">
                            <label>Customer :</label>
                            <div class="customer-data">
                                <strong><%= order.user.name %></strong>
                                <%= order.user.email %>
                            </div>
                        </div>
                        <div class="info-item">
                            <label>Total:</label>
                            <span>₹ <%= order.totalAmount %></span>
                        </div>
                    </div>
                    
                    <div class="shipping-section">
                        <label>Shipping Address</label>
                        <p>
                            <%= order.shippingAddress.fullName %><br>
                            <%= order.shippingAddress.street %>, <%= order.shippingAddress.city %><br>
                            <%= order.shippingAddress.state %>, <%= order.shippingAddress.pincode %>
                        </p>
                    </div>
                </div>

                <!-- Order Items -->
                <div class="items-section">
                    <h2>Order Items</h2>
                    <table class="order-table">
                        <thead>
                            <tr>
                                <th>Product</th>
                                <th>Colour</th>
                                <th>Qty</th>
                                <th>Price</th>
                                <th>Status</th>
                                <th>Return Request</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% order.items.forEach(item => { %>
                            <tr>
                             <td class="product-cell">
  <% if(item.product && item.product.images && item.product.images.length > 0){ %>
    <img src="/uploads/<%= item.product.images[0] %>" class="product-img">
  <% } %>
  <span><%= item.product?.name || "N/A" %></span>
</td>                            
                                <td><%= item.variantColor %></td>
                                <td><%= item.quantity %></td>
                                <td>₹ <%= item.price %></td>
                                <td>
                                    <span class="status-badge <%= item.itemStatus || 'pending' %>">
                                        <%= item.itemStatus || 'pending' %>
                                    </span>
                                </td>
                                <td>
  <% if (item.returnRequest?.requested) { %>
    <% if (item.returnRequest.status === "pending") { %>
      <button 
        class="btn-view" 
        data-order="<%= order._id.toString() %>" 
        data-item="<%= item._id.toString() %>">
        View
      </button>
    <% } else if (item.returnRequest.status === "accepted") { %>
      <span class="badge-accepted">Accepted</span>
    <% } else if (item.returnRequest.status === "rejected") { %>
      <span class="badge-rejected">Rejected</span>
    <% } %>
  <% } else { %>
    <span class="badge-none">No Request</span>
  <% } %>
</td>
                            </tr>
                            <% }) %>
                        </tbody>
                    </table>
                </div>
            </div>

           
        </div>
    </main>
</div>

<!-- Return Modal -->
<!-- Return Modal -->
<div id="returnModal" class="modal">
  <div class="modal-content modal-large">
    <!-- Close Icon -->
    <span class="close-btn" onclick="closeModal()">×</span>

    <h2>Return Details</h2>

    <div class="return-info">
      <p><strong>Product:</strong> <span id="modalProduct"></span></p>
      <p><strong>Price:</strong> ₹ <span id="modalPrice"></span></p>
      <p><strong>Reason:</strong></p>
      <div id="modalReason" class="reason-box"></div>
    </div>

    <!-- Action Buttons -->
    <div class="modal-actions">
      <button id="acceptBtn" class="btn-accept">Accept</button>
      <button id="rejectBtn" class="btn-reject">Reject</button>
    </div>
  </div>
</div>

<script>
 // Open return modal
document.querySelectorAll('.btn-view').forEach(btn => {
  btn.addEventListener('click', async () => {
    const orderId = btn.dataset.order;
    const itemId = btn.dataset.item;

    try {
      const res = await fetch(`/admin/return/details/${orderId}/${itemId}`);
      if (!res.ok) throw new Error('Return details not found');
      const data = await res.json();

      document.getElementById("modalProduct").textContent = data.productName || "N/A";
      document.getElementById("modalPrice").textContent = data.price || "0";
      document.getElementById("modalReason").textContent = data.reason || "No reason provided";

      document.getElementById("acceptBtn").dataset.order = orderId;
      document.getElementById("acceptBtn").dataset.item = itemId;
      document.getElementById("rejectBtn").dataset.order = orderId;
      document.getElementById("rejectBtn").dataset.item = itemId;

      document.getElementById("returnModal").style.display = "block";

    } catch (err) {
      Swal.fire('Error', err.message, 'error');
    }
  });
});

// Close modal
function closeModal() {
  document.getElementById("returnModal").style.display = "none";
}

window.onclick = function(event) {
  const modal = document.getElementById("returnModal");
  if (event.target == modal) closeModal();
};

// Handle accept/reject with confirmation Swal
function handleReturnAction(action) {
  const btn = document.getElementById(action === 'accept' ? 'acceptBtn' : 'rejectBtn');
  const orderId = btn.dataset.order;
  const itemId = btn.dataset.item;

  Swal.fire({
    title: 'Are you sure?',
    text: `Do you want to ${action} this return request?`,
    icon: 'warning',
    showCancelButton: true,
    confirmButtonText: 'Yes, Confirm',
    cancelButtonText: 'No',
  }).then(() => {
    // Show loading
    Swal.fire({
      title: 'Processing...',
      allowOutsideClick: false,
      didOpen: () => Swal.showLoading()
    });

    fetch(`/admin/return/${action}/${orderId}/${itemId}`, { method: 'POST' })
      .then(res => res.json().then(data => ({ status: res.status, body: data })))
      .then(({ status, body }) => {
        Swal.close(); // close loading
        if (!body.success) throw new Error(body.message || `Failed to ${action} return`);

        Swal.fire({
          icon: 'success',
          title: `Return ${action}ed!`,
          text: body.message,
          timer: 1500,
          showConfirmButton: false
        });

        closeModal();
        setTimeout(() => location.reload(), 1600);

      })
      .catch(err => {
        Swal.close();
        Swal.fire('Error', err.message || 'Something went wrong', 'error');
      });
  });
}

// Attach event listeners
document.getElementById("acceptBtn").addEventListener("click", () => handleReturnAction('accept'));
document.getElementById("rejectBtn").addEventListener("click", () => handleReturnAction('reject'));
</script>
</body>
</html>