<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Order Management | Elara Admin</title>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600&display=swap" rel="stylesheet">
    <style>
        :root {
            --sidebar-tan: #B18E7B;
            --main-bronze: #5D4037; /* Consistent Roasted Brown */
            --main-bronze-hover: #795548;
            --bg-light: #F4F4F4;
            --white: #ffffff;
        }

        body {
            margin: 0;
            font-family: 'Poppins', sans-serif;
            background-color: var(--bg-light);
            color: #333;
        }

        .admin-layout {
            display: flex;
            min-height: 100vh;
        }

        /* Content Area */
        .content-area {
            flex: 1;                                 
            padding: 40px;
            margin-left: 260px; /* Adjust based on your actual sidebar width */
        }

        .content-header h1 {
            font-size: 26px;
            color: var(--main-bronze);
            font-weight: 600;
            margin-bottom: 30px;
        }

        /* Filter Bar - Same style as Detail buttons */
        .filter-bar {
            display: flex;
            gap: 12px;
            margin-bottom: 30px;
            align-items: center;
            flex-wrap: wrap;
        }

        .admin-input {
            padding: 10px 15px;
            border: 1px solid #ddd;
            border-radius: 8px;
            background: white;
            font-size: 13px;
            outline: none;
            transition: border-color 0.3s;
        }

        .admin-input:focus {
            border-color: var(--main-bronze);
        }

        .search-id { width: 250px; }

        .btn-admin-action {
            background-color: var(--main-bronze);
            color: white;
            border: none;
            padding: 10px 22px;
            border-radius: 8px;
            cursor: pointer;
            font-size: 13px;
            font-weight: 500;
            transition: 0.3s;
        }

        .btn-admin-action:hover {
            background-color: var(--main-bronze-hover);
        }

        .btn-clear {
            background-color: transparent;
            color: #666;
            border: 1px solid #ccc;
        }

        .btn-clear:hover {
            background-color: #eee;
            color: #333;
        }

        /* Table Styling - Clean & Modern */
        .table-container {
            background: white;
            border-radius: 12px;
            overflow: hidden;
            box-shadow: 0 4px 20px rgba(0,0,0,0.05);
        }

        .admin-table {
            width: 100%;
            border-collapse: collapse;
            text-align: left;
        }

        .admin-table th {
            background-color: #fcfcfc;
            padding: 18px 20px;
            font-weight: 600;
            font-size: 13px;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            color: #888;
            border-bottom: 1px solid #eee;
        }

        .admin-table td {
            padding: 18px 20px;
            border-bottom: 1px solid #eee;
            font-size: 14px;
            vertical-align: middle;
        }

        .admin-table tr:hover {
            background-color: #fafafa; /* Subtle row hover */
        }

        .order-id-text {
            font-family: monospace;
            color: var(--main-bronze);
            font-weight: 600;
        }

        /* Status Badges */
        .status-badge {
            padding: 5px 12px;
            border-radius: 20px;
            font-size: 11px;
            font-weight: 600;
            text-transform: uppercase;
        }
        .status-pending { background: #FFF9E6; color: #D4A017; }
        .status-delivered { background: #E8F5E9; color: #2E7D32; }
        .status-cancelled { background: #FFEBEE; color: #C62828; }
        .status-shipped { background: #E3F2FD; color: #1565C0; }

        /* View Details Button */
        .view-outline {
            padding: 7px 16px;
            border: 1px solid var(--main-bronze);
            color: var(--main-bronze);
            border-radius: 20px;
            font-size: 12px;
            text-decoration: none;
            font-weight: 500;
            transition: 0.3s ease;
            display: inline-block;
        }

        .view-outline:hover {
            background-color: var(--main-bronze);
            color: white;
        }

        /* Pagination */
        .admin-pagination {
            margin-top: 30px;
            display: flex;
            justify-content: center;
            gap: 8px;
        }

        .page-num, .page-arrow {
            min-width: 38px;
            height: 38px;
            border: 1px solid #ddd;
            background: white;
            border-radius: 8px;
            cursor: pointer;
            font-weight: 500;
            transition: 0.3s;
        }

        .page-num.active {
            background-color: var(--main-bronze);
            color: white;
            border-color: var(--main-bronze);
        }

        .page-num:hover:not(.active) {
            border-color: var(--main-bronze);
            color: var(--main-bronze);
        }
    </style>
</head>
<body>

    <div class="admin-layout">
        <%- include('../partials/adminSidebar') %>

        <main class="content-area">
            <header class="content-header">
                <h1>Order Management</h1>
            </header>

            <form method="GET" action="/admin/orders" class="filter-bar">
                <select name="status" class="admin-input">
                    <option value="">All Status</option>
                    <option value="pending" <%= status === "pending" ? "selected" : "" %>>Pending</option>
                    <option value="shipped" <%= status === "shipped" ? "selected" : "" %>>Shipped</option>
                    <option value="out for delivery" <%= status === "out for delivery" ? "selected" : "" %>>Out for Delivery</option>
                    <option value="delivered" <%= status === "delivered" ? "selected" : "" %>>Delivered</option>
                    <option value="cancelled" <%= status === "cancelled" ? "selected" : "" %>>Cancelled</option>
                </select>

                <input type="text" name="search" value="<%= search %>" placeholder="Search Order ID or Customer" class="admin-input search-id" />

                <select name="sort" class="admin-input">
                    <option value="newest" <%= sort === "newest" ? "selected" : "" %>>Newest First</option>
                    <option value="oldest" <%= sort === "oldest" ? "selected" : "" %>>Oldest First</option>
                </select>

                <button type="submit" class="btn-admin-action">Search</button>
                <a href="/admin/orders" style="text-decoration: none;">
                    <button type="button" class="btn-admin-action btn-clear">Clear</button>
                </a>
            </form>

            <div class="table-container">
                <table class="admin-table">
                    <thead>
                        <tr>
                            <th>Customer</th>
                            <th>Order ID</th> 
                            <th>Date</th>
                            <th>Status</th> <th>Total</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% orders.forEach(order => { %>
                            <tr>
                                <td>
                                    <div style="font-weight: 600;"><%= order.user?.fullName || "N/A" %></div>
                                    <div style="font-size: 11px; color: #888;"><%= order.user?.email || "N/A" %></div>
                                </td>
                                <td class="order-id-text">#<%= order._id.toString().slice(-8).toUpperCase() %></td> 
                                <td><%= new Date(order.createdAt).toLocaleDateString() %></td>
                                <td>
                                    <span class="status-badge status-<%= order.orderStatus.toLowerCase().replace(/\s/g, '-') %>">
                                        <%= order.orderStatus %>
                                    </span>
                                </td>
                                <td style="font-weight: 500;">₹<%= order.totalAmount %></td>
                                <td>
                                    <a href="/admin/orders/<%= order._id %>" class="view-outline">View Details</a>
                                </td>
                            </tr>
                        <% }) %>
                    </tbody>
                </table>
            </div>

            <div class="admin-pagination">
                <% if(currentPage > 1){ %>
                    <a href="?page=<%= currentPage-1 %>&search=<%= search %>&status=<%= status %>&sort=<%= sort %>">
                        <button class="page-arrow">‹</button>
                    </a>
                <% } %>

                <% for(let i = 1; i <= totalPages; i++){ %>
                    <a href="?page=<%= i %>&search=<%= search %>&status=<%= status %>&sort=<%= sort %>">
                        <button class="page-num <%= currentPage === i ? 'active' : '' %>"><%= i %></button>
                    </a>
                <% } %>

                <% if(currentPage < totalPages){ %>
                    <a href="?page=<%= currentPage+1 %>&search=<%= search %>&status=<%= status %>&sort=<%= sort %>">
                        <button class="page-arrow">›</button>
                    </a>
                <% } %>
            </div>
        </main>
    </div>

    </body>
</html>